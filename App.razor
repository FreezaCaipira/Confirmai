@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using Confirmai.Shared
@using Confirmai.Services

@inject UiTextService T

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Confirmai.Shared.MainLayout)">
                <NotAuthorized>
                    <RouteNotAuthorized />
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(Confirmai.Shared.MainLayout)">
                <div class="not-found-card">
                    <span class="not-found-icon">&#9888;</span>
                    <h2 class="not-found-title">@T["App.NotFound.Title"]</h2>
                    <p class="not-found-description">
                        @T["App.NotFound.Description"]<br>
                        @T["App.NotFound.Help"]
                    </p>
                    <a href="/" class="not-found-home-link">
                        &#8592; @T["App.NotFound.BackToDashboard"]
                    </a>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

