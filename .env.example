# ============================================================
# Confirmai — variáveis de ambiente (copie para .env e preencha)
# NUNCA versione o .env — ele contém segredos.
# ============================================================

# ── Banco de dados ───────────────────────────────────────────
DB_PASSWORD=SuaSenhaForteAqui

# ── Domínio público (sem https://, sem barra final) ──────────
DOMAIN=seudominio.com

# ── Seed do admin inicial ────────────────────────────────────
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=SuaSenhaForte123!
ADMIN_FULLNAME=Seu Nome
# true  → atualiza a senha do admin a cada restart (útil no primeiro deploy)
# false → nunca sobrescreve a senha existente
ADMIN_SYNC_PASSWORD=true

# ── BtcPay Server ────────────────────────────────────────────
BTCPAY_URL=https://seu-btcpay-server.com
BTCPAY_STORE_ID=seu-store-id
BTCPAY_API_KEY=sua-api-key
BTCPAY_WEBHOOK_SECRET=seu-webhook-secret

# ── EfiBank (Pix) ────────────────────────────────────────────
EFIBANK_CLIENT_ID=seu-client-id
EFIBANK_CLIENT_SECRET=seu-client-secret
# Caminho local do certificado .p12 (montado como secret no Docker)
EFIBANK_CERT_PATH=./certs/efibank.p12
EFIBANK_CERT_PASSWORD=
EFIBANK_PIX_KEY=sua-chave-pix
EFIBANK_WEBHOOK_SECRET=seu-webhook-secret-efi
EFIBANK_WEBHOOK_CERT_SUBJECT=conta.efipay.com.br

# ── AbacatePay ───────────────────────────────────────────────
ABACATEPAY_API_KEY=sua-api-key-abacate
ABACATEPAY_WEBHOOK_SECRET=seu-webhook-secret-abacate

# ── E-mail (SMTP) ────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@seudominio.com
SMTP_PASSWORD=sua-senha-smtp
SMTP_FROM_EMAIL=no-reply@seudominio.com

# ── Google Maps ──────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=sua-chave-google-maps

# ── OpenTelemetry (opcional) ─────────────────────────────────
OTEL_ENDPOINT=http://otel-collector:4318
OTEL_HEADERS=
OTEL_SERVICE_NAME=Confirmai
OTEL_ENVIRONMENT=production
