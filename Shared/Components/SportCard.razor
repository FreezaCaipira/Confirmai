@using Confirmai.Enums
@inject UiTextService Ui

<a href="@Href" class="sport-card sport-card--@SportClass">
    <div class="sport-card-header">
        <span class="sport-card-label">@Icon @Name</span>
        @if (MatchCount.HasValue)
        {
            <span class="sport-card-count @(MatchCount.Value == 0 ? "sport-card-count--empty" : "")">
                @MatchCount.Value
            </span>
        }
    </div>
    <div class="sport-card-body">
        <p class="sport-card-desc">@Description</p>
        <span class="sport-card-cta">@CtaText</span>
    </div>
</a>

@code {
    [Parameter]
    public Sport Sport { get; set; }

    [Parameter]
    public string Href { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string? CtaText { get; set; }

    [Parameter]
    public int? MatchCount { get; set; }

    private string Icon => Sport == Sport.Futsal ? "⚽" : "🃏";
    private string Name => Sport == Sport.Futsal ? "Futsal" : "Poker";
    private string SportClass => Sport == Sport.Futsal ? "futsal" : "poker";
}
