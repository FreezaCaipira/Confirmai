@using Confirmai.Enums
@inject UiTextService Ui

<a href="@Href" class="sport-card sport-card--@SportClass">
    <div class="sport-card-header">
        <span class="sport-card-label">@Icon @Name</span>
        @if (ComingSoon)
        {
            <span class="sport-card-badge">Em breve</span>
        }
    </div>
    <div class="sport-card-body">
        <p class="sport-card-desc">@Description</p>
        @if (MatchCount.HasValue)
        {
            <span class="sport-card-events @(MatchCount.Value == 0 ? "sport-card-events--empty" : "")">
                <i class="fas fa-calendar-day"></i>
                @MatchCount.Value evento@(MatchCount.Value != 1 ? "s" : "")
            </span>
        }
        <span class="sport-card-cta">@CtaText</span>
    </div>
</a>

@code {
    [Parameter]
    public Sport Sport { get; set; }

    [Parameter]
    public string Href { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string? CtaText { get; set; }

    [Parameter]
    public int? MatchCount { get; set; }

    [Parameter]
    public bool ComingSoon { get; set; }

    private string Icon => Sport switch
    {
        Sport.Futsal => "⚽",
        Sport.Poker => "🃏",
        Sport.Volleyball => "🏐",
        Sport.BeachTennis => "🎾",
        Sport.Footvolley => "🏖️",
        Sport.Chess => "♟️",
        _ => "🏆"
    };

    private string Name => Sport switch
    {
        Sport.Futsal => "Futebol/Futsal",
        Sport.Poker => "Poker",
        Sport.Volleyball => "Vôlei",
        Sport.BeachTennis => "Beach Tennis",
        Sport.Footvolley => "Futevôlei",
        Sport.Chess => "Xadrez",
        _ => Sport.ToString()
    };

    private string SportClass => Sport switch
    {
        Sport.Futsal => "futsal",
        Sport.Poker => "poker",
        Sport.Volleyball => "volleyball",
        Sport.BeachTennis => "beachtennis",
        Sport.Footvolley => "footvolley",
        Sport.Chess => "chess",
        _ => "default"
    };
}
