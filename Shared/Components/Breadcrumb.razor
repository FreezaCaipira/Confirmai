@using System.Security.Claims
@using Confirmai.Data
@using Confirmai.Services
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@inject NavigationManager NavigationManager
@inject UiTextService T
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthState

@if (BackHref is not null)
{
    @* C42-A: no celular a trilha completa some e fica so "<- {pai}" com link real *@
    <a class="breadcrumb-back" href="@BackHref"><i class="fas fa-arrow-left" aria-hidden="true"></i> @BackLabel</a>
}

@if (Segments.Count >= 2)
{
    <nav class="breadcrumb-nav">
        @foreach (var (segment, index) in Segments.Select((s, i) => (s, i)))
        {
            if (index < Segments.Count - 1)
            {
                <a href="@Hrefs[index]">@segment</a>
                <span class="breadcrumb-sep"><i class="fas fa-chevron-right"></i></span>
            }
            else
            {
                <span class="breadcrumb-current">@segment</span>
            }
        }
    </nav>
}

@code {
    private List<string> Segments = new();
    private List<string> Hrefs = new();
    private List<string> OriginalSegments = new();
    private string? BackHref;
    private string? BackLabel;

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        await UpdateSegments();
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        await UpdateSegments();
        await InvokeAsync(StateHasChanged);
    }

    private async Task UpdateSegments()
    {
        var uri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var pathOnly = uri.Split('?', '#')[0];
        var rawSegments = pathOnly.Split('/', StringSplitOptions.RemoveEmptyEntries);
        BackHref = null;
        BackLabel = null;
        var allSegments = rawSegments
            .Where(s => !IsIdSegment(s))
            .ToList();

        OriginalSegments = allSegments;
        Segments = allSegments.Select(s => MapSegment(s)).ToList();
        Hrefs = Enumerable.Range(0, Segments.Count).Select(BuildUrl).ToList();

        // Group routes: "Grupos > {group name} > ..." instead of "Grupo > ...".
        if (rawSegments.Length >= 2
            && string.Equals(rawSegments[0], "grupo", StringComparison.OrdinalIgnoreCase)
            && int.TryParse(rawSegments[1], out var crumbGroupId)
            && Segments.Count >= 1)
        {
            var groupName = await LoadGroupNameAsync(crumbGroupId) ?? $"#{crumbGroupId}";
            Segments[0] = T["Breadcrumb.Groups"];
            Hrefs[0] = "/grupos";
            Segments.Insert(1, groupName);
            Hrefs.Insert(1, $"/grupo/{crumbGroupId}");
        }

        // On payment page, show the previous step based on returnUrl (real origin page).
        if (allSegments.Count >= 2
            && string.Equals(allSegments[0], "marketplace", StringComparison.OrdinalIgnoreCase)
            && string.Equals(allSegments[1], "buy", StringComparison.OrdinalIgnoreCase)
            && Segments.Count >= 2)
        {
            var currentUri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
            var query = QueryHelpers.ParseQuery(currentUri.Query);
            if (query.TryGetValue("returnUrl", out var returnUrlValues))
            {
                var originLabel = TryBuildReturnUrlLabel(returnUrlValues.LastOrDefault());
                if (!string.IsNullOrWhiteSpace(originLabel))
                {
                    Segments[0] = originLabel;
                }
            }
        }

        // Event detail (/futsal/{id}, /poker/{id}): the id is filtered out, so
        // the trail would be a single "Futsal". Resolve the event's group and
        // show "Grupos > {grupo} > {esporte}" — on mobile the back link points
        // at the group (the real parent), never history.back().
        if (rawSegments.Length == 2
            && (string.Equals(rawSegments[0], "futsal", StringComparison.OrdinalIgnoreCase)
                || string.Equals(rawSegments[0], "poker", StringComparison.OrdinalIgnoreCase))
            && int.TryParse(rawSegments[1], out var eventId))
        {
            var evt = await LoadEventGroupAsync(eventId);
            if (evt is not null)
            {
                Segments = new List<string>
                {
                    T["Breadcrumb.Groups"],
                    evt.Value.GroupName,
                    MapSegment(rawSegments[0])
                };
                Hrefs = new List<string> { "/grupos", $"/grupo/{evt.Value.GroupId}", "" };
            }
        }

        // Payment page (/pagamento/evento/{confirmationId}): the id is the
        // confirmation's, and "Pagamento > Evento" would be a meaningless
        // trail — resolve the confirmation and point the parent at the event.
        if (rawSegments.Length == 3
            && string.Equals(rawSegments[0], "pagamento", StringComparison.OrdinalIgnoreCase)
            && string.Equals(rawSegments[1], "evento", StringComparison.OrdinalIgnoreCase)
            && int.TryParse(rawSegments[2], out var confirmationId))
        {
            var evt = await LoadConfirmationEventAsync(confirmationId);
            if (evt is not null)
            {
                var eventUrl = evt.Value.Sport == Sport.Poker ? $"/poker/{evt.Value.EventId}" : $"/futsal/{evt.Value.EventId}";
                Segments = new List<string>
                {
                    T["Breadcrumb.Groups"],
                    evt.Value.GroupName,
                    MapSegment(evt.Value.Sport.ToString()),
                    T["Breadcrumb.Payments"]
                };
                Hrefs = new List<string> { "/grupos", $"/grupo/{evt.Value.GroupId}", eventUrl, "" };
            }
        }

        if (Segments.Count == 0)
            Segments.Add(T["Breadcrumb.Home"]);

        // Mobile back link: "<- {pai}" with a real URL (desktop keeps the trail).
        if (rawSegments.Length > 0)
        {
            if (Segments.Count >= 2)
            {
                BackHref = Hrefs[Segments.Count - 2];
                BackLabel = Segments[Segments.Count - 2];
            }
            else
            {
                BackHref = "/";
                BackLabel = T["Breadcrumb.Home"];
            }
        }
    }

    private async Task<(int EventId, int GroupId, string GroupName, Sport Sport)?> LoadConfirmationEventAsync(int confirmationId)
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        var userId = user.FindFirstValue(ClaimTypes.NameIdentifier);
        if (userId is null)
            return null;

        await using var db = await DbFactory.CreateDbContextAsync();
        var row = await db.EventConfirmations
            .Where(c => c.Id == confirmationId
                && (c.UserId == userId
                    || c.Event.Group.Members.Any(m => m.UserId == userId && m.Role == GroupMemberRole.Admin)))
            .Select(c => new { c.EventId, GroupId = c.Event.GroupId, GroupName = c.Event.Group.Name, c.Event.Sport })
            .FirstOrDefaultAsync();
        return row is null ? null : (row.EventId, row.GroupId, row.GroupName, row.Sport);
    }

    private async Task<(int GroupId, string GroupName, Sport Sport)?> LoadEventGroupAsync(int eventId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var row = await db.Events
            .Where(e => e.Id == eventId)
            .Select(e => new { e.GroupId, GroupName = e.Group.Name, e.Sport })
            .FirstOrDefaultAsync();
        return row is null ? null : (row.GroupId, row.GroupName, row.Sport);
    }

    private bool IsIdSegment(string s)
    {
        if (Guid.TryParse(s, out _) || long.TryParse(s, out _) || int.TryParse(s, out _))
            return true;
        // invite codes: 8-char hex strings generated from GUID
        return s.Length == 8 && s.All(c => (c >= '0' && c <= '9') || (c >= 'A' && c <= 'F') || (c >= 'a' && c <= 'f'));
    }

    private string MapSegment(string s)
    {
        var decoded = Uri.UnescapeDataString(s ?? string.Empty);

        var mapped = decoded.ToLower() switch
        {
            "admin" => T["Breadcrumb.Admin"],
            "users" => T["Breadcrumb.Users"],
            "payments" => T["Breadcrumb.Payments"],
            "logs" => T["Breadcrumb.Logs"],
            "escalacao" => "Escalação",
            "convite"   => "Convite",
            "grupos"    => T["Breadcrumb.Groups"],
            "grupo"     => T["Breadcrumb.Group"],
            "futsal"    => "Futsal",
            "poker"     => "Poker",
            "edit" => T["Breadcrumb.Edit"],
            "view" => T["Breadcrumb.View"],
            "buy" => T["Breadcrumb.Buy"],
            "items" => T["Breadcrumb.Items"],
            "products" => T["Breadcrumb.Products"],
            "about" => T["Breadcrumb.About"],
            "contact" => T["Breadcrumb.Contact"],
            "dashboard" => T["Breadcrumb.Dashboard"],
            "marketplace" => T["Breadcrumb.Marketplace"],
            "languages" => T["Breadcrumb.Languages"],
            _ => decoded
        };

        return ToCamelCaseLabel(mapped);
    }

    private static string ToCamelCaseLabel(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return value;
        }

        var normalized = value
            .Replace('-', ' ')
            .Replace('_', ' ');

        var words = normalized
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(word => word.Length == 1
                ? word.ToUpperInvariant()
                : char.ToUpper(word[0]) + word[1..].ToLowerInvariant());

        return string.Join(' ', words);
    }

    private async Task<string?> LoadGroupNameAsync(int groupId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        return await db.Groups
            .Where(g => g.Id == groupId)
            .Select(g => g.Name)
            .FirstOrDefaultAsync();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private string BuildUrl(int index)
    {
        if (index < 0) return "/";

        var currentUri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var currentQuery = QueryHelpers.ParseQuery(currentUri.Query);

        // Use the raw path segments (including IDs) to build intermediate URLs
        var rawPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#')[0];
        var rawSegments = rawPath.Split('/', StringSplitOptions.RemoveEmptyEntries);

        // Map raw segments to the same indices as filtered segments by walking both lists
        var filteredIndex = -1;
        var rawIndexUpTo = -1;
        for (int i = 0; i < rawSegments.Length; i++)
        {
            if (!IsIdSegment(rawSegments[i]))
                filteredIndex++;

            if (filteredIndex == index)
            {
                rawIndexUpTo = i;
                break;
            }
        }

        if (rawIndexUpTo < 0)
            return "/";

        var path = string.Join('/', rawSegments.Take(rawIndexUpTo + 1));
        var target = "/" + path;

        // For payment routes, prefer exact returnUrl (origin page) when available.
        if (string.Equals(target, "/marketplace", StringComparison.OrdinalIgnoreCase)
            && currentQuery.TryGetValue("returnUrl", out var returnUrlValues))
        {
            var normalizedReturnUrl = TryNormalizeLocalReturnUrl(returnUrlValues.LastOrDefault());
            if (!string.IsNullOrEmpty(normalizedReturnUrl))
            {
                return normalizedReturnUrl;
            }
        }

        return target;
    }

    private static string? TryNormalizeLocalReturnUrl(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return null;
        }

        var decoded = Uri.UnescapeDataString(raw).Trim();
        if (!decoded.StartsWith('/'))
        {
            return null;
        }

        if (decoded.StartsWith("//", StringComparison.Ordinal)
            || decoded.Contains("://", StringComparison.Ordinal))
        {
            return null;
        }

        return decoded;
    }

    private string? TryBuildReturnUrlLabel(string? rawReturnUrl)
    {
        var normalized = TryNormalizeLocalReturnUrl(rawReturnUrl);
        if (string.IsNullOrWhiteSpace(normalized))
        {
            return null;
        }

        var pathOnly = normalized.Split('?', '#')[0];
        var segments = pathOnly.Split('/', StringSplitOptions.RemoveEmptyEntries)
            .Where(s => !IsIdSegment(s))
            .ToList();

        if (segments.Count == 0)
        {
            return null;
        }

        // Use last non-id segment so item pages show item name (e.g., Bow).
        return MapSegment(segments[^1]);
    }
}

