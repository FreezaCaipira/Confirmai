@using Confirmai.Shared
@using Microsoft.JSInterop
@inject UiTextService Ui
@inject IJSRuntime JS

<div class="city-selector" aria-label="Filtro de cidade">
    <label class="city-label" for="city-select">
        <svg class="city-pin" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"
             aria-hidden="true">
            <path d="M20 10c0 6-8 13-8 13s-8-7-8-13a8 8 0 0 1 16 0Z" />
            <circle cx="12" cy="10" r="3" />
        </svg>
        @Ui["Index.CityLabel"]
    </label>
    <div class="city-controls">
        <select class="city-select" id="city-select" value="@SelectedCityKey" @onchange="OnSelectedCityKeyChanged">
            @foreach (var c in Cities)
            {
                <option value="@c.Key">@c.Label</option>
            }
            <option value="@OtherCityKey">@Ui["Index.OtherCity"]</option>
        </select>
        <button class="city-geo-btn" type="button" @onclick="GetUserLocation" title="Usar minha localização" aria-label="Usar minha localização">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="3 11 22 2 13 21 11 13 3 11" />
            </svg>
        </button>
        @if (SelectedCityKey == OtherCityKey)
        {
            <select class="city-select" value="@OtherStateCode" @onchange="OnOtherStateCodeChanged" @onchange:after="OnOtherStateChanged">
                <option value="">UF…</option>
                @foreach (var uf in BrazilianStates)
                {
                    <option value="@uf">@uf</option>
                }
            </select>
            <select class="city-select" value="@CustomCity" @onchange="OnCustomCityChanged">
                <option value="">Cidade…</option>
                @if (OtherCityOptions.Count > 0)
                {
                    @foreach (var opt in OtherCityOptions)
                    {
                        <option value="@opt.Nome">@opt.Nome</option>
                    }
                }
                else
                {
                    <option disabled>Selecione um estado primeiro</option>
                }
            </select>
        }
    </div>
</div>

@code {
    [Parameter]
    public string SelectedCityKey { get; set; } = "Pouso Alegre|MG";

    [Parameter]
    public EventCallback<string> SelectedCityKeyChanged { get; set; }

    [Parameter]
    public string OtherStateCode { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> OtherStateCodeChanged { get; set; }

    [Parameter]
    public string CustomCity { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> CustomCityChanged { get; set; }

    [Parameter]
    public List<CityOption> Cities { get; set; } = new();

    [Parameter]
    public List<IbgeMunicipio> OtherCityOptions { get; set; } = new();

    [Parameter]
    public EventCallback OnOtherCityChange { get; set; }

    private const string OtherCityKey = "__other__";

    private static readonly string[] BrazilianStates = new[]
    {
        "AC", "AL", "AP", "AM", "BA", "CE", "DF", "ES", "GO", "MA",
        "MT", "MS", "MG", "PA", "PB", "PR", "PE", "PI", "RJ", "RN",
        "RS", "RO", "RR", "SC", "SP", "SE", "TO"
    };

    private async Task OnOtherStateChanged()
    {
        await OnOtherCityChange.InvokeAsync();
    }

    private async Task OnSelectedCityKeyChanged(ChangeEventArgs e)
    {
        if (SelectedCityKeyChanged.HasDelegate)
            await SelectedCityKeyChanged.InvokeAsync(e.Value?.ToString());
    }

    private async Task OnOtherStateCodeChanged(ChangeEventArgs e)
    {
        if (OtherStateCodeChanged.HasDelegate)
            await OtherStateCodeChanged.InvokeAsync(e.Value?.ToString());
    }

    private async Task OnCustomCityChanged(ChangeEventArgs e)
    {
        if (CustomCityChanged.HasDelegate)
            await CustomCityChanged.InvokeAsync(e.Value?.ToString());
    }

    private async Task GetUserLocation()
    {
        try
        {
            var coords = await JS.InvokeAsync<GeolocationResult>("navigator.geolocation.getCurrentPosition");
            if (coords != null)
            {
                // Reverse geocoding using OpenStreetMap Nominatim API
                var http = new HttpClient();
                var result = await http.GetFromJsonAsync<NominatimResult>(
                    $"https://nominatim.openstreetmap.org/reverse?format=json&lat={coords.Latitude}&lon={coords.Longitude}&zoom=10");

                if (result != null && !string.IsNullOrEmpty(result.Address.City))
                {
                    var city = result.Address.City;
                    var stateCode = result.Address.StateCode ?? string.Empty;

                    // Check if this city exists in our list
                    var existingCity = Cities.FirstOrDefault(c =>
                        c.City.Equals(city, StringComparison.OrdinalIgnoreCase) &&
                        c.StateCode.Equals(stateCode, StringComparison.OrdinalIgnoreCase));

                    if (existingCity != null)
                    {
                        if (SelectedCityKeyChanged.HasDelegate)
                            await SelectedCityKeyChanged.InvokeAsync(existingCity.Key);
                    }
                    else
                    {
                        // Set as "Other city"
                        if (SelectedCityKeyChanged.HasDelegate)
                            await SelectedCityKeyChanged.InvokeAsync(OtherCityKey);

                        if (OtherStateCodeChanged.HasDelegate)
                            await OtherStateCodeChanged.InvokeAsync(stateCode);

                        if (CustomCityChanged.HasDelegate)
                            await CustomCityChanged.InvokeAsync(city);
                    }
                }
            }
        }
        catch
        {
            // Silently fail - geolocation may be denied or unavailable
        }
    }

    private record GeolocationResult(double Latitude, double Longitude);
    private record NominatimResult(NominatimAddress Address);
    private record NominatimAddress(string? City, string? StateCode);
}
