@using Confirmai.Data
@using Confirmai.Enums
@using Confirmai.Models
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@inject IDbContextFactory<AppDbContext> DbFactory

<div class="listing-block">
<div class="event-listing">

    @if (!string.IsNullOrEmpty(City))
    {
        <div class="listing-location">
            <svg class="listing-pin" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"
                 aria-hidden="true">
                <path d="M20 10c0 6-8 13-8 13s-8-7-8-13a8 8 0 0 1 16 0Z" />
                <circle cx="12" cy="10" r="3" />
            </svg>
            <span>@City@(!string.IsNullOrEmpty(StateCode) ? $" - {StateCode}" : "")</span>
            <a href="/eventos" class="listing-location-change">trocar</a>
        </div>
    }

    <section class="date-selector" aria-label="Selecionar data">
        <button class="date-nav" aria-label="Dia anterior" @onclick="PrevDay">&#8249;</button>
        @if (ShowDatePicker)
        {
            <input class="date-input"
                   type="date"
                   value="@SelectedDate.ToString("yyyy-MM-dd")"
                   @onchange="OnDateInputChange"
                   @onblur="() => ShowDatePicker = false"
                   autofocus />
        }
        else
        {
            <button class="date-display" @onclick="() => ShowDatePicker = true">
                @FormatDate(SelectedDate)
            </button>
        }
        <button class="date-nav" aria-label="Próximo dia" @onclick="NextDay">&#8250;</button>
    </section>

    @if (IsLoading)
    {
        <ul class="event-list" aria-label="Carregando @SportLabel" aria-busy="true">
            @for (var i = 0; i < 3; i++)
            {
                <li>
                    <div class="event-card-skel">
                        <div class="skel skel--time"></div>
                        <div class="skel-body">
                            <div class="skel skel--title"></div>
                            <div class="skel skel--venue"></div>
                            <div class="skel skel--loc"></div>
                            <div class="skel-chips">
                                <div class="skel skel--chip"></div>
                                <div class="skel skel--chip"></div>
                            </div>
                        </div>
                        <div class="skel skel--action"></div>
                    </div>
                </li>
            }
        </ul>
    }
    else if (LoadError is not null)
    {
        <div class="listing-state listing-empty">
            <p style="color:#f87171">@LoadError</p>
        </div>
    }
    else if (!Events.Any())
    {
        <div class="listing-state listing-empty">
            <p>Nenhum@(SportLabel == "torneios" ? "" : "a") @SportLabel@(!string.IsNullOrEmpty(City) ? $" em {City}" : "") neste dia.</p>
            @if (SelectedDate != DateOnly.FromDateTime(DateTime.Now))
            {
                <button class="btn-today" @onclick="SelectToday">Ver hoje</button>
            }
        </div>
    }
    else
    {
        <ol class="event-list" aria-label="@SportLabel disponíveis">
            @foreach (var ev in Events)
            {
                <li>@EventCard(ev)</li>
            }
        </ol>
    }

</div>
</div>

@code {
    private static readonly CultureInfo PtBr = new("pt-BR");

    [Parameter, EditorRequired] public Sport                  Sport       { get; set; }
    [Parameter, EditorRequired] public string                 SportLabel  { get; set; } = default!;
    [Parameter, EditorRequired] public RenderFragment<Event>  EventCard   { get; set; } = default!;
    [Parameter] public string? City      { get; set; }
    [Parameter] public string? StateCode { get; set; }

    private DateOnly      SelectedDate   = DateOnly.FromDateTime(DateTime.Now);
    private bool          ShowDatePicker = false;
    private bool          IsLoading      = true;
    private List<Event>   Events         = new();
    private string?       LoadError      = null;

    protected override async Task OnInitializedAsync() => await LoadEvents();

    private async Task LoadEvents()
    {
        IsLoading = true;
        LoadError = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var start = DateTime.SpecifyKind(SelectedDate.ToDateTime(TimeOnly.MinValue), DateTimeKind.Utc);
            var end   = start.AddDays(1);

            var query = db.Events
                .Include(e => e.Group)
                .Include(e => e.Confirmations)
                .Include(e => e.Venue)
                .Where(e => e.IsActive
                    && e.Group.Sport == Sport
                    && e.StartsAt >= start
                    && e.StartsAt < end);

            if (!string.IsNullOrEmpty(City))
                query = query.Where(e => e.Group.City == City);
            if (!string.IsNullOrEmpty(StateCode))
                query = query.Where(e => e.Group.StateCode == StateCode);

            Events = await query.OrderBy(e => e.StartsAt).ToListAsync();

            // Para poker: eventos com late reg ativo vêm primeiro (torneio em andamento que ainda aceita inscrições)
            if (Sport == Sport.Poker)
            {
                var now = DateTime.UtcNow;
                Events = Events
                    .OrderByDescending(e => e.LateRegEndsAt.HasValue && e.LateRegEndsAt.Value > now)
                    .ThenBy(e => e.LateRegEndsAt.HasValue && e.LateRegEndsAt.Value > now
                        ? e.LateRegEndsAt!.Value.Ticks
                        : e.StartsAt.Ticks)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            LoadError = $"Erro ao carregar {SportLabel}: {ex.Message}";
            Events    = new();
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task PrevDay()   { SelectedDate = SelectedDate.AddDays(-1); await LoadEvents(); }
    private async Task NextDay()   { SelectedDate = SelectedDate.AddDays(1);  await LoadEvents(); }
    private async Task SelectToday() { SelectedDate = DateOnly.FromDateTime(DateTime.Now); await LoadEvents(); }

    private async Task OnDateInputChange(ChangeEventArgs e)
    {
        // Browser always sends dates as "yyyy-MM-dd" (ISO 8601) regardless of locale
        if (DateOnly.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd",
                System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out var d))
            SelectedDate = d;
        ShowDatePicker = false;
        await LoadEvents();
    }

    private string FormatDate(DateOnly d)
    {
        var today = DateOnly.FromDateTime(DateTime.Now);
        var dt    = d.ToDateTime(TimeOnly.MinValue);
        if (d == today)             return "Hoje, "   + dt.ToString("d 'de' MMM", PtBr);
        if (d == today.AddDays(1))  return "Amanhã, " + dt.ToString("d 'de' MMM", PtBr);
        if (d == today.AddDays(-1)) return "Ontem, "  + dt.ToString("d 'de' MMM", PtBr);
        return dt.ToString("ddd, d 'de' MMM", PtBr);
    }
}
