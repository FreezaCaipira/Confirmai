@using Confirmai.Data
@using Confirmai.Enums
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject UiTextService T
@inject NavigationManager Navigation
@implements IDisposable

@* C43-A C3: proxima partida do usuario logado (membro ou organizador).
   So renderiza autenticado e quando existe partida futura. *@

<AuthorizeView>
    <Authorized>
        @if (match is not null)
        {
            var pct = match.MaxPlayers > 0 ? Math.Min(100, match.Confirmed * 100 / match.MaxPlayers) : 0;
            <section class="oldsite-widget sidebar-next-match">
                <h3><i class="fas fa-calendar-day" aria-hidden="true"></i> @T["SidebarNext.Title"]</h3>
                <div class="sidebar-next-body">
                    <div class="sidebar-next-top">
                        <span class="sidebar-next-date" aria-hidden="true">
                            <span class="sidebar-next-day">@match.StartsLocal.Day</span>
                            <span class="sidebar-next-month">@T.FormatDateTime(match.StartsLocal, "DateWeekday").Split(' ')[0].TrimEnd('.')</span>
                        </span>
                        <span class="sidebar-next-info">
                            <span class="sidebar-next-group">
                                <i class="fas @(match.Sport == Sport.Poker ? "fa-coins" : "fa-futbol")" aria-hidden="true"></i>
                                @match.GroupName
                            </span>
                            <span class="sidebar-next-when">
                                <i class="fas fa-clock" aria-hidden="true"></i>
                                @T.FormatDateTime(match.StartsLocal, "DateTimeFullShort")
                            </span>
                        </span>
                    </div>
                    @if (match.MaxPlayers > 0)
                    {
                        <div class="sidebar-next-progress">
                            <span class="sidebar-next-count">
                                <strong>@match.Confirmed/@match.MaxPlayers</strong> @T["SidebarNext.Confirmed"]
                            </span>
                            <span class="sidebar-next-bar" role="presentation">
                                <span class="sidebar-next-bar-fill @(pct >= 100 ? "is-full" : string.Empty)" style="width: @(pct)%"></span>
                            </span>
                        </div>
                    }
                    else
                    {
                        <span class="sidebar-next-count"><strong>@match.Confirmed</strong> @T["SidebarNext.Confirmed"]</span>
                    }
                    <a class="btn btn-primary btn-sm sidebar-next-link"
                       href="@(match.Sport == Sport.Poker ? $"/poker/{match.EventId}" : $"/futsal/{match.EventId}")">
                        @T["SidebarNext.Open"] <i class="fas fa-arrow-right" aria-hidden="true"></i>
                    </a>
                </div>
            </section>
        }
    </Authorized>
</AuthorizeView>

@code {
    private sealed record NextMatch(int EventId, string GroupName, DateTime StartsLocal,
        int Confirmed, int MaxPlayers, Sport Sport);

    private NextMatch? match;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        await LoadAsync();
    }

    // O layout persiste entre navegacoes: sem recarregar, a contagem
    // ficaria parada depois de confirmar/sair de uma partida.
    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        try
        {
            await LoadAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            // card decorativo: falha ao recarregar nao derruba o circuito
        }
    }

    private async Task LoadAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (userId is null) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var now = DateTime.UtcNow;

        var ev = await db.Events
            .Where(e => e.IsActive && e.StartsAt >= now
                && (e.Group.Members.Any(m => m.UserId == userId)
                    || e.CreatedByUserId == userId))
            .OrderBy(e => e.StartsAt)
            .Select(e => new NextMatch(
                e.Id,
                e.Group.Name,
                e.StartsAt.ToLocalTime(),
                e.Confirmations.Count,
                e.MaxPlayers,
                e.Sport))
            .FirstOrDefaultAsync();

        match = ev;
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
