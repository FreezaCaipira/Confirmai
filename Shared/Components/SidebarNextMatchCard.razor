@using Confirmai.Data
@using Confirmai.Enums
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject UiTextService T

@* C43-A C3: proxima partida do usuario logado (membro ou organizador).
   So renderiza autenticado e quando existe partida futura. *@

<AuthorizeView>
    <Authorized>
        @if (match is not null)
        {
            <section class="oldsite-widget sidebar-next-match">
                <h3>@T["SidebarNext.Title"]</h3>
                <p class="sidebar-next-group">@match.GroupName</p>
                <p class="sidebar-next-when">
                    <i class="fas fa-calendar" aria-hidden="true"></i>
                    @match.StartsLocal.ToString("ddd dd/MM HH:mm")
                </p>
                <p class="sidebar-next-count">@match.Confirmed/@match.MaxPlayers @T["SidebarNext.Confirmed"]</p>
                <a class="btn btn-secondary btn-sm sidebar-next-link"
                   href="@(match.Sport == Sport.Poker ? $"/poker/{match.EventId}" : $"/futsal/{match.EventId}")">
                    @T["SidebarNext.Open"]
                </a>
            </section>
        }
    </Authorized>
</AuthorizeView>

@code {
    private sealed record NextMatch(int EventId, string GroupName, DateTime StartsLocal,
        int Confirmed, int MaxPlayers, Sport Sport);

    private NextMatch? match;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (userId is null) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var now = DateTime.UtcNow;

        var ev = await db.Events
            .Where(e => e.IsActive && e.StartsAt >= now
                && (e.Group.Members.Any(m => m.UserId == userId)
                    || e.CreatedByUserId == userId))
            .OrderBy(e => e.StartsAt)
            .Select(e => new NextMatch(
                e.Id,
                e.Group.Name,
                e.StartsAt.ToLocalTime(),
                e.Confirmations.Count,
                e.MaxPlayers,
                e.Sport))
            .FirstOrDefaultAsync();

        match = ev;
    }
}
