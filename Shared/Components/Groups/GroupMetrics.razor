@namespace Confirmai.Shared.Components.Groups

@using Confirmai.Services.Groups

@inject GroupMetricsService MetricsService
@inject UiTextService Ui

<div class="group-metrics">
    <div class="metrics-grid">
        <div class="metric-card">
            <div class="metric-icon metric-icon--members">
                <i class="fas fa-users"></i>
            </div>
            <div class="metric-content">
                <div class="metric-value">@Metrics.TotalMembers</div>
                <div class="metric-label">@Ui["Group.Members"]</div>
            </div>
        </div>

        <div class="metric-card">
            <div class="metric-icon metric-icon--events">
                <i class="fas fa-calendar"></i>
            </div>
            <div class="metric-content">
                <div class="metric-value">@Metrics.TotalEvents</div>
                <div class="metric-label">Eventos</div>
                <div class="metric-sub">@Metrics.UpcomingEvents @Ui["Group.Upcoming"]</div>
            </div>
        </div>

        <div class="metric-card">
            <div class="metric-icon metric-icon--attendance">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="metric-content">
                <div class="metric-value">@Metrics.AverageAttendanceRate%</div>
                <div class="metric-label">@Ui["Group.AttendanceRate"]</div>
                <div class="metric-sub @(Metrics.AverageAttendanceRate >= 70 ? "metric-sub--good" : "metric-sub--warning")">
                    @(Metrics.AverageAttendanceRate >= 70 ? "Boa" : "Atenção")
                </div>
            </div>
        </div>

        <div class="metric-card">
            <div class="metric-icon metric-icon--payments">
                <i class="fas fa-wallet"></i>
            </div>
            <div class="metric-content">
                <div class="metric-value">@Metrics.PaymentCompletionRate%</div>
                <div class="metric-label">Pagamentos</div>
                <div class="metric-sub">@Metrics.PaidConfirmations/@Metrics.TotalConfirmations</div>
            </div>
        </div>

        @if (Metrics.PendingJoinRequests > 0)
        {
            <div class="metric-card metric-card--alert">
                <div class="metric-icon metric-icon--pending">
                    <i class="fas fa-user-clock"></i>
                </div>
                <div class="metric-content">
                    <div class="metric-value">@Metrics.PendingJoinRequests</div>
                    <div class="metric-label">@Ui["Group.PendingRequestsLabel"]</div>
                    <div class="metric-sub metric-sub--alert">@Ui["Group.ActionNeeded"]</div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public int GroupId { get; set; }

    private GroupMetricsSnapshot Metrics { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        Metrics = await MetricsService.GetSnapshotAsync(GroupId);
    }
}
