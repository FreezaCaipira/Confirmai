@using Confirmai.Enums
@using Confirmai.Models
@using Confirmai.Services
@inject UiTextService Ui

<section class="detail-section">
    <div class="detail-section-header">
        <h2 class="detail-section-title">
            <i class="fas fa-user-clock"></i> Solicitações pendentes (@PendingCount)
        </h2>
        <select class="input input--sm input--width-auto" value="@RequestSortOrder" @onchange="(e) => RequestSortOrderChanged.InvokeAsync((string)e.Value)">
            <option value="newest">Mais recentes</option>
            <option value="oldest">Mais antigas</option>
            <option value="name">Nome A-Z</option>
        </select>
    </div>
    @if (SelectedCount > 0)
    {
        <div class="bulk-actions-row">
            <div class="bulk-actions">
                <span class="bulk-count">@SelectedCount selecionado@(SelectedCount == 1 ? "" : "s")</span>
                <button class="btn-approve btn-approve--sm" type="button"
                        @onclick="OnApproveSelected"
                        disabled="@IsBulkProcessing">
                    <i class="fas fa-check"></i> Aprovar todos
                </button>
                <button class="btn-reject btn-reject--sm" type="button"
                        @onclick="OnRejectSelected"
                        disabled="@IsBulkProcessing">
                    <i class="fas fa-times"></i> Rejeitar todos
                </button>
                <button class="btn-cancel btn-cancel--sm" type="button"
                        @onclick="OnClearSelection"
                        disabled="@IsBulkProcessing">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>
    }
    <ul class="pending-requests-list">
        @foreach (var req in SortedPendingRequests)
        {
            var waitTime = DateTime.UtcNow - req.RequestedAt;
            var waitHours = (int)waitTime.TotalHours;
            var waitLabel = waitHours < 1 ? "agora mesmo" : waitHours < 24 ? $"{waitHours}h atrás" : $"{(int)waitTime.TotalDays}d atrás";
            var isUrgent = waitTime.TotalHours > 48;

            <li class="pending-request-item @(isUrgent ? "pending-request-item--urgent" : "") @(SelectedRequestIds.Contains(req.Id) ? "pending-request-item--selected" : "")">
                <div class="pending-request-checkbox">
                    <input type="checkbox" id="req-@req.Id" checked="@SelectedRequestIds.Contains(req.Id)" @onchange="(e) => OnToggleSelection.InvokeAsync((req.Id, e.Value is true))" />
                </div>
                <div class="pending-request-info">
                    <span class="pending-request-name">@(req.User?.FullName ?? req.User?.UserName ?? "Usuário")</span>
                    <span class="pending-request-email">@req.User?.Email</span>
                    <div class="pending-request-meta">
                        <span class="pending-request-date">@Ui.FormatDateTime(req.RequestedAt.ToLocalTime(), "DateTimeShortCompact")</span>
                        <span class="pending-request-wait @(isUrgent ? "pending-request-wait--urgent" : "")">@waitLabel</span>
                    </div>
                </div>
                <div class="pending-request-actions">
                    <button class="btn-approve" type="button"
                            @onclick="() => OnApprove.InvokeAsync(req.Id)"
                            title="Aprovar solicitação">
                        <i class="fas fa-check"></i> Aprovar
                    </button>
                    <button class="btn-reject" type="button"
                            @onclick="() => OnReject.InvokeAsync(req.Id)"
                            title="Rejeitar solicitação">
                        <i class="fas fa-times"></i> Rejeitar
                    </button>
                </div>
            </li>
        }
    </ul>
</section>

@code {
    [Parameter] public int                                    PendingCount         { get; set; }
    [Parameter] public int                                    SelectedCount        { get; set; }
    [Parameter] public bool                                   IsBulkProcessing     { get; set; }
    [Parameter] public string                                 RequestSortOrder     { get; set; } = "newest";
    [Parameter] public EventCallback<string>                  RequestSortOrderChanged { get; set; }
    [Parameter] public IEnumerable<GroupJoinRequest>          SortedPendingRequests { get; set; } = Enumerable.Empty<GroupJoinRequest>();
    [Parameter] public HashSet<int>                           SelectedRequestIds   { get; set; } = new();
    [Parameter] public EventCallback<int>                     OnApprove            { get; set; }
    [Parameter] public EventCallback<int>                     OnReject             { get; set; }
    [Parameter] public EventCallback                          OnApproveSelected    { get; set; }
    [Parameter] public EventCallback                          OnRejectSelected     { get; set; }
    [Parameter] public EventCallback                          OnClearSelection     { get; set; }
    [Parameter] public EventCallback<(int Id, bool IsSelected)> OnToggleSelection  { get; set; }
}
