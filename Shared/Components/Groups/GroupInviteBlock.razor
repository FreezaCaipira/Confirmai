@using Confirmai.Services.Core
@using Microsoft.JSInterop
@inject UiTextService Ui
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject IConfiguration Config
@implements IAsyncDisposable

<div class="invite-block">
    @{ var inviteUrl = $"{BaseUrl}/convite/{InviteCode}"; }

    @* CTA primeiro: e o caminho mais usado (C42-A item 8). C43-A D3.2:
       variante btn-whatsapp — cor de marca de terceiro, excecao registrada. *@
    <button class="btn btn-whatsapp invite-cta" type="button"
            @onclick="() => ShareInviteOnWhatsApp(inviteUrl)">
        <i class="fab fa-whatsapp" aria-hidden="true"></i> @Ui["Group.InviteWhatsApp"]
    </button>

    <div class="invite-row">
        <span class="invite-label"><i class="fas fa-link" aria-hidden="true"></i> @Ui["Group.InviteLink"]</span>
        <div class="invite-field">
            <code class="invite-field-text" id="invite-url-text">@inviteUrl</code>
            <button class="btn btn-secondary btn-sm" type="button"
                    @onclick="() => CopyInviteLink(inviteUrl)">
                <i class="fas fa-copy" aria-hidden="true"></i> @(copiedInvite ? @Ui["Group.Copied"] : @Ui["Group.Copy"])
            </button>
        </div>
    </div>
    <div class="invite-row">
        <span class="invite-label"><i class="fas fa-key" aria-hidden="true"></i> @Ui["Group.Code"]</span>
        <div class="invite-field">
            <code class="invite-field-text invite-field-text--code">@InviteCode</code>
            <button class="btn btn-secondary btn-sm" type="button"
                    @onclick="() => CopyCode(InviteCode)">
                <i class="fas fa-copy" aria-hidden="true"></i> @(copiedCode ? @Ui["Group.Copied"] : @Ui["Group.Copy"])
            </button>
        </div>
    </div>
    <p class="invite-feedback" aria-live="polite">@((copiedInvite || copiedCode) ? Ui["Group.Copied"] : "\u00a0")</p>
</div>

@code {
    [Parameter] public string InviteCode { get; set; } = string.Empty;

    private bool copiedInvite;
    private bool copiedCode;
    private CancellationTokenSource? _copyInviteCts;
    private CancellationTokenSource? _copyCodeCts;

    private string BaseUrl =>
        (Config["App:BaseUrl"]?.TrimEnd('/')) ?? NavigationManager.BaseUri.TrimEnd('/');

    private async Task CopyInviteLink(string url)
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", url); }
        catch { }
        _copyInviteCts?.Cancel();
        _copyInviteCts = new CancellationTokenSource();
        var ct = _copyInviteCts.Token;
        try
        {
            copiedInvite = true;
            await Task.Delay(2000, ct);
            if (!ct.IsCancellationRequested) copiedInvite = false;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            copiedInvite = false;
        }
    }

    private async Task CopyCode(string code)
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", code); }
        catch { }
        _copyCodeCts?.Cancel();
        _copyCodeCts = new CancellationTokenSource();
        var ct = _copyCodeCts.Token;
        try
        {
            copiedCode = true;
            await Task.Delay(2000, ct);
            if (!ct.IsCancellationRequested) copiedCode = false;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            copiedCode = false;
        }
    }

    private async Task ShareInviteOnWhatsApp(string url)
    {
        var shareUrl = $"https://wa.me/?text={Uri.EscapeDataString(url)}";
        try
        {
            await JS.InvokeVoidAsync("open", shareUrl, "_blank", "noopener,noreferrer");
        }
        catch
        {
            // C43-A D3.2: popup bloqueado / JSException nao derruba o circuito.
        }
    }

    public ValueTask DisposeAsync()
    {
        _copyInviteCts?.Cancel();
        _copyCodeCts?.Cancel();
        _copyInviteCts?.Dispose();
        _copyCodeCts?.Dispose();
        return ValueTask.CompletedTask;
    }
}
