@using Confirmai.Models
@using Confirmai.Enums
@inject UiTextService Ui

@if (Members is null || Members.Count == 0)
{
    <p class="text-muted">@Ui["Group.NoMembers"]</p>
}
else
{
    <ul class="member-list">
        @foreach (var m in VisibleMembers)
        {
            var isMe = m.UserId == CurrentUserId;
            <li class="member-row @(isMe ? "member-row--me" : "")">
                @if (!string.IsNullOrWhiteSpace(m.User?.AvatarPath))
                {
                    <img class="member-avatar" src="@m.User!.AvatarPath" alt="" />
                }
                else
                {
                    <span class="member-avatar member-avatar--initials">@Initials(m)</span>
                }
                <span class="member-name">@(m.User?.FullName ?? m.User?.UserName ?? "Membro")</span>
                @if (m.Role == GroupMemberRole.Admin) { <span class="member-badge member-badge--admin">@Ui["Group.Admin"]</span> }
                @if (isMe) { <span class="member-badge member-badge--me">@Ui["Group.You"]</span> }
            </li>
        }
    </ul>

    @if (HasHiddenMembers)
    {
        <button class="btn btn-ghost btn-sm member-toggle" type="button" @onclick="OnToggleMembersView">
            <i class="fas @(ShowAllMembers ? "fa-chevron-up" : "fa-chevron-down")"></i>
            @(ShowAllMembers ? Ui["Group.ShowLess"] : Ui.Get("Group.ViewAllMembers", Members.Count))
        </button>
    }
}

@code {
    [Parameter]
    public ICollection<GroupMember>? Members { get; set; }

    [Parameter]
    public string? CurrentUserId { get; set; }

    [Parameter]
    public bool ShowAllMembers { get; set; }

    [Parameter]
    public EventCallback OnToggleMembersView { get; set; }

    private const int MembersPreviewLimit = 10;

    private List<GroupMember> VisibleMembers
    {
        get
        {
            if (Members is null || Members.Count == 0)
                return new();

            var ordered = Members
                .OrderBy(m => m.Role == GroupMemberRole.Admin ? 0 : 1)
                .ThenBy(m => m.CreatedAt)
                .ToList();

            return ShowAllMembers ? ordered : ordered.Take(MembersPreviewLimit).ToList();
        }
    }

    private bool HasHiddenMembers =>
        Members is not null &&
        Members.Count > MembersPreviewLimit;

    private static string Initials(GroupMember m)
    {
        var name = m.User?.FullName ?? m.User?.UserName ?? "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant(),
            _ => string.Concat(parts[0][0], parts[^1][0]).ToUpperInvariant(),
        };
    }
}
