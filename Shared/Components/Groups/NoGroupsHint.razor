@using Confirmai.Services.Core
@inject UiTextService Ui

<div class="onboarding-hint">
    <div class="onboarding-hint-header">
        <i class="fas fa-info-circle"></i>
        <span>@Ui["Onboarding.Title"]</span>
    </div>
    <p class="onboarding-hint-intro">
        @Ui["Onboarding.Intro"]
    </p>
    <div class="onboarding-steps">
        <div class="onboarding-step">
            <span class="onboarding-step-num">1</span>
            <span class="onboarding-step-text">@Ui["Onboarding.Step1"]</span>
        </div>
        <div class="onboarding-step">
            <span class="onboarding-step-num">2</span>
            <span class="onboarding-step-text">@Ui["Onboarding.Step2"]</span>
        </div>
        <div class="onboarding-step">
            <span class="onboarding-step-num">3</span>
            <span class="onboarding-step-text">@Ui["Onboarding.Step3"]</span>
        </div>
    </div>
    @if (ShowGroupsButton)
    {
        <a href="/grupos" class="btn btn-secondary">
            <i class="fas fa-layer-group"></i> @Ui["Onboarding.AccessGroups"]
        </a>
    }
</div>

@code {
    [Parameter] public bool ShowGroupsButton { get; set; }
}
