@using Confirmai.Models
@using Confirmai.Enums
@using Confirmai.Services
@using Confirmai.Services.Admin
@inject UiTextService Ui

@if (IsOpen)
{
    <div class="payment-overlay" @onclick="async () => await OnClose.InvokeAsync()">
        <div class="payment-modal" @onclick:stopPropagation="true">
            <div class="payment-modal-header">
                <h2 class="payment-modal-title"><i class="fas fa-money-bill-wave"></i> Pagamentos</h2>
                <button class="payment-close-btn" type="button" @onclick="async () => await OnClose.InvokeAsync()">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="payment-tabs">
                <button class="payment-tab @(PaymentTab == "delinquent" ? "payment-tab--active" : "")" 
                        type="button"
                        @onclick="HandleTabDelinquent">
                    <i class="fas fa-exclamation-triangle"></i> Pendentes
                    @if (DelinquencyList?.Count > 0)
                    {
                        <span class="payment-tab-count">@DelinquencyList.Count</span>
                    }
                </button>
                <button class="payment-tab @(PaymentTab == "history" ? "payment-tab--active" : "")" 
                        type="button"
                        @onclick="HandleTabHistory">
                    <i class="fas fa-history"></i> Histórico
                    @if (PaymentHistory?.Count > 0)
                    {
                        <span class="payment-tab-count">@PaymentHistory.Count</span>
                    }
                </button>
                <button class="payment-refresh-btn" type="button" @onclick="HandleRefresh" title="@Ui["Group.PaymentsRefresh"]">
                    <i class="fas @(IsLoadingPayments ? "fa-spinner fa-spin" : "fa-sync-alt")"></i> <span>@Ui["Group.PaymentsRefreshShort"]</span>
                </button>
            </div>

            @if (IsLoadingPayments)
            {
                <div class="payment-loading"><i class="fas fa-spinner fa-spin"></i> Carregando…</div>
            }
            else if (PaymentTab == "history")
            {
                <div class="payment-history-filters">
                    <select @bind="HistoryFilterUserId">
                        <option value="">@Ui["Group.AllParticipants"]</option>
                        @foreach (var userName in PaymentHistory?.Select(h => h.UserName).Distinct().OrderBy(n => n) ?? Enumerable.Empty<string>())
                        {
                            <option value="@userName">@userName</option>
                        }
                    </select>
                </div>
                @if (FilteredHistory?.Count == 0)
                {
                    <div class="payment-empty">
                        <i class="fas fa-history"></i>
                        <span>@Ui["Group.NoManualPayments"]</span>
                    </div>
                }
                else
                {
                    <ul class="payment-history-list">
                        @foreach (var h in FilteredHistory ?? new())
                        {
                            <li class="payment-history-item">
                                <div class="payment-history-header">
                                    <div class="payment-history-user">@h.UserName</div>
                                    <div class="payment-history-price">R$ @h.EventPrice.ToString("F2")</div>
                                </div>
                                <div class="payment-history-body">
                                    <div class="payment-history-info">
                                        <span class="payment-history-date"><i class="fas fa-calendar-alt"></i> @Ui.FormatDateTime(h.EventDate.ToLocalTime(), "DateDefault")</span>
                                        <span class="payment-history-admin">
                                            <i class="fas fa-user-shield"></i> @h.AdminName
                                        </span>
                                    </div>
                                    <div class="payment-history-actions">
                                        <button class="payment-view-proof-btn" type="button"
                                                disabled="@(h.HasProof && h.ConfirmationId.HasValue ? null : true)"
                                                @onclick="@(e => h.HasProof && h.ConfirmationId.HasValue ? ViewProofHandler(h.ConfirmationId.Value) : System.Threading.Tasks.Task.CompletedTask)">
                                            <i class="fas fa-camera"></i> Comprovante
                                        </button>
                                        <a class="payment-entry-link" href="@h.EventHref" target="_blank" rel="noopener">
                                            <i class="fas fa-external-link-alt"></i> Ver partida
                                        </a>
                                    </div>
                                </div>
                                <div class="payment-history-footer">
                                    Marcado em @Ui.FormatDateTime(h.MarkedAt.ToLocalTime(), "DateTimeDefault")
                                </div>
                            </li>
                        }
                    </ul>
                }
            }
            else if (DelinquencyList?.Count == 0)
            {
                <div class="payment-empty">
                    <i class="fas fa-check-circle"></i>
                    <span>@Ui["Group.NoDelinquent"]</span>
                </div>
            }
            else
            {
                <ul class="payment-user-list">
                    @foreach (var d in DelinquencyList ?? new())
                    {
                        string userId = d.UserId;
                        bool isSelected = SelectedPaymentUserId == userId;
                        <li class="payment-user-item @(isSelected ? "payment-user-item--selected" : "")"
                            @onclick="@(e => SelectPaymentUserHandler(userId))">
                            <span class="payment-user-name">@d.UserName</span>
                            <div class="payment-user-meta">
                                <span class="payment-badge payment-badge--games">@d.Entries.Count jogo@(d.Entries.Count != 1 ? "s" : "")</span>
                                <span class="payment-badge payment-badge--amount">R$ @d.TotalAmount.ToString("F2")</span>
                                @if (d.Entries.Any(e => e.HasProof))
                                {
                                    <span class="payment-badge payment-badge--proof" title="@Ui["Group.PlayerSentProof"]">
                                        <i class="fas fa-camera"></i> Comprovante
                                    </span>
                                }
                            </div>
                            <div class="payment-notify-actions" @onclick:stopPropagation="true">
                                @if (NotifiedUserIds?.Contains(userId) == true)
                                {
                                    <span class="payment-notified-badge"><i class="fas fa-check"></i> Notificado</span>
                                }
                                else if (NotifyingUserId == userId)
                                {
                                    <span class="payment-notifying"><i class="fas fa-spinner fa-spin"></i></span>
                                }
                                else
                                {
                                    <button class="payment-notify-btn payment-notify-btn--email" type="button"
                                            title="@Ui["Group.NotifyEmail"]"
                                            @onclick="@(e => NotifyDelinquencyHandler(d))">
                                        <i class="fas fa-envelope"></i>
                                    </button>
                                    <button class="payment-notify-btn payment-notify-btn--whatsapp" type="button"
                                            title="Cobrar via WhatsApp"
                                            @onclick="@(e => OpenWhatsAppHandler(d))">
                                        <i class="fab fa-whatsapp"></i>
                                    </button>
                                }
                            </div>
                            <i class="fas fa-chevron-@(isSelected ? "up" : "down") payment-chevron"></i>
                        </li>

                        @if (isSelected)
                        {
                            <li class="payment-detail-panel">
                                <div class="payment-detail-summary">
                                    <span class="payment-summary-label">@Ui["Group.PendingMatches"]</span>
                                    <span class="payment-summary-total">R$ @d.TotalAmount.ToString("F2")</span>
                                </div>
                                <ul class="payment-detail-list">
                                    @foreach (var entry in d.Entries)
                                    {
                                        <li class="payment-detail-item">
                                            <span class="payment-detail-date">@Ui.FormatDateTime(entry.EventDate.ToLocalTime(), "DateDefault")</span>
                                            <span class="payment-detail-price">R$ @entry.EventPrice.ToString("F2")</span>
                                            <a href="@entry.EventHref" class="payment-entry-link" target="_blank">
                                                Ver
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>
                        }
                    }
                </ul>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public bool IsLoadingPayments { get; set; }

    [Parameter]
    public string PaymentTab { get; set; } = "delinquent";

    private string HistoryFilterUserId { get; set; } = "";

    private List<PaymentHistoryEntry>? FilteredHistory =>
        string.IsNullOrEmpty(HistoryFilterUserId)
            ? PaymentHistory
            : PaymentHistory?.Where(h => h.UserName == HistoryFilterUserId).ToList();

    [Parameter]
    public string? SelectedPaymentUserId { get; set; }

    [Parameter]
    public List<UserDelinquency>? DelinquencyList { get; set; }

    [Parameter]
    public List<PaymentHistoryEntry>? PaymentHistory { get; set; }

    [Parameter]
    public List<PendingProofEntry>? PendingProofList { get; set; }

    [Parameter]
    public int? MarkingPaidId { get; set; }

    [Parameter]
    public string? NotifyingUserId { get; set; }

    [Parameter]
    public HashSet<string>? NotifiedUserIds { get; set; }

    [Parameter]
    public int? ViewingProofConfirmationId { get; set; }

    [Parameter]
    public string? CurrentReceiverId { get; set; }

    [Parameter]
    public string? CurrentUserId { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<string> OnTabChange { get; set; }

    [Parameter]
    public EventCallback OnRefreshPayments { get; set; }

    [Parameter]
    public EventCallback<string> OnSelectPaymentUser { get; set; }

    [Parameter]
    public EventCallback<(int ConfirmationId, string UserId)> OnMarkPaid { get; set; }

    [Parameter]
    public EventCallback<UserDelinquency> OnNotifyDelinquency { get; set; }

    [Parameter]
    public EventCallback<UserDelinquency> OnOpenWhatsApp { get; set; }

    [Parameter]
    public EventCallback<int> OnViewProof { get; set; }

    private async Task HandleTabDelinquent()
    {
        await OnTabChange.InvokeAsync("delinquent");
    }


    private async Task HandleTabHistory()
    {
        await OnTabChange.InvokeAsync("history");
    }

    private async Task HandleRefresh()
    {
        await OnRefreshPayments.InvokeAsync();
    }

    private async Task SelectPaymentUserHandler(string userId)
    {
        await OnSelectPaymentUser.InvokeAsync(userId);
    }

    private async Task MarkPaidHandler(int confirmationId, string userId)
    {
        await OnMarkPaid.InvokeAsync((confirmationId, userId));
    }

    private async Task NotifyDelinquencyHandler(UserDelinquency d)
    {
        await OnNotifyDelinquency.InvokeAsync(d);
    }

    private async Task OpenWhatsAppHandler(UserDelinquency d)
    {
        await OnOpenWhatsApp.InvokeAsync(d);
    }

    private async Task ViewProofHandler(int confirmationId)
    {
        await OnViewProof.InvokeAsync(confirmationId);
    }
}
