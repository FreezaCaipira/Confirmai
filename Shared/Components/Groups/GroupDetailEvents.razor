@using Confirmai.Enums
@using Confirmai.Models
@using Confirmai.Services
@using Confirmai.Services.Events
@inject NavigationManager NavigationManager
@inject UiTextService Ui

<table class="events-table">
    <thead>
        <tr>
            <!-- Web headers -->
            <th class="web-only"></th>
            <th class="web-only">@Ui["Group.DateTimeHeader"]</th>
            <th class="web-only">@Ui["Group.PlayersHeader"]</th>
            <th class="web-only">@Ui["Group.StatusHeader"]</th>
            <th class="events-access-col web-only"></th>
            <!-- Mobile: no headers -->
        </tr>
    </thead>
    <tbody>
        @if (DisplayedEvents.Count == 0)
        {
            <tr>
                <td colspan="6" class="et-empty">
                    @if (ShowPastEvents)
                    {
                        <div class="et-empty-banner">
                            <i class="fas fa-calendar-plus"></i>
                            <span class="et-empty-text">@Ui["Group.NoMatchPlayed"]</span>
                        </div>
                    }
                    else if (IsAdmin)
                    {
                        <div class="et-empty-banner">
                            <i class="fas fa-calendar-plus"></i>
                            <span class="et-empty-text">@Ui["Group.NoMatchScheduledEmpty"]</span>
                            <a href="@NewEventHref" class="btn btn-primary">
                                <i class="fas fa-plus"></i> @Ui["Group.CreateFirstMatch"]
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="et-empty-banner">
                            <i class="fas fa-calendar-plus"></i>
                            <span class="et-empty-text">@Ui["Group.NoMatchOrganizer"]</span>
                        </div>
                    }
                </td>
            </tr>
        }
        else
        {
            var nextUpcomingEventId = UpcomingEvents.FirstOrDefault()?.Id;
            @foreach (var ev in DisplayedEvents)
            {
                var href   = Group!.Sport == Sport.Futsal ? $"/futsal/{ev.Id}" : $"/poker/{ev.Id}";
                var isFull = ev.Confirmations.Count >= ev.MaxPlayers;
                var isNextUpcoming = !ShowPastEvents && nextUpcomingEventId.HasValue && ev.Id == nextUpcomingEventId.Value;
                var eventNum = EventNumbers.TryGetValue(ev.Id, out var n) ? n : 0;
                <tr class="events-table-row" @onclick="() => NavigationManager.NavigateTo(href)">
                    <!-- Web: ID column -->
                    <td class="web-only">
                        <span class="et-num">#@eventNum</span>
                    </td>
                    
                    <!-- Web: Date column -->
                    <td class="web-only">
                        <span class="et-when" tabindex="0" aria-describedby="et-tip-@ev.Id">
                            @if (ev.RachaScheduleId.HasValue)
                            {
                                <i class="fas fa-sync-alt et-recurring-icon" title="@Ui["Group.WeeklyTitle"]"></i>
                            }
                            <span class="et-date">@Ui.FormatDateTime(ev.StartsAt.ToLocalTime(), "DateWeekday")</span>
                            <span class="et-time">@Ui.FormatDateTime(ev.StartsAt.ToLocalTime(), "TimeDefault")</span>
                            <span role="tooltip" id="et-tip-@ev.Id" class="et-tooltip">
                                <span class="et-tip-line">@Ui.FormatDateTime(ev.StartsAt.ToLocalTime(), "DateLong")</span>
                                <span class="et-tip-line et-tip-relative">@RelativeText(ev)</span>
                                @if (TipMeta(ev) is { } tipMeta)
                                {
                                    <span class="et-tip-line et-tip-meta">@tipMeta</span>
                                }
                            </span>
                        </span>
                    </td>
                    
                    <!-- Web: Players column -->
                    <td class="web-only">
                        <span class="et-players @(isFull ? "et-players--full" : string.Empty) @(ev.Confirmations.Count == 0 ? "et-players--empty" : string.Empty)">@ev.Confirmations.Count / @ev.MaxPlayers</span>
                    </td>
                    
                    <!-- Web: Status column -->
                    <td class="web-only et-status-col">
                        @if (!ev.IsActive)
                        {
                            <span class="et-status et-status--cancelled">@Ui["Group.EventCancelled"]</span>
                        }
                        else if (isFull)
                        {
                            <span class="et-status et-status--full">@Ui["Group.EventFull"]</span>
                        }
                        else
                        {
                            <span class="et-status et-status--open">@Ui["Group.EventOpen"]</span>
                        }
                        @if (isNextUpcoming)
                        {
                            <span class="et-status et-status--next">@Ui["Group.EventNext"]</span>
                        }
                    </td>
                    
                    <!-- Web: Access column -->
                    <td class="events-access-col web-only">
                        <button class="btn btn-secondary btn-sm"
                                type="button"
                                @onclick:stopPropagation="true"
                                @onclick="() => NavigationManager.NavigateTo(href)">
                            @Ui["Group.Access"]
                        </button>
                    </td>
                    
                    <!-- Mobile: Card with all info -->
                    <td class="mobile-only">
                        <span class="et-num">#@eventNum</span>
                        <div class="et-cell">
                            <div class="et-cell-header">
                                <div class="et-cell-right">
                                    <span class="et-when" tabindex="0" aria-describedby="et-tip-m-@ev.Id">
                                        @if (ev.RachaScheduleId.HasValue)
                                        {
                                            <i class="fas fa-sync-alt et-recurring-icon" title="@Ui["Group.WeeklyTitle"]"></i>
                                        }
                                        <span class="et-date">@Ui.FormatDateTime(ev.StartsAt.ToLocalTime(), "DateWeekday")</span>
                                        <span class="et-time">@Ui.FormatDateTime(ev.StartsAt.ToLocalTime(), "TimeDefault")</span>
                                        <span role="tooltip" id="et-tip-m-@ev.Id" class="et-tooltip">
                                            <span class="et-tip-line">@Ui.FormatDateTime(ev.StartsAt.ToLocalTime(), "DateLong")</span>
                                            <span class="et-tip-line et-tip-relative">@RelativeText(ev)</span>
                                            @if (TipMeta(ev) is { } tipMetaMobile)
                                            {
                                                <span class="et-tip-line et-tip-meta">@tipMetaMobile</span>
                                            }
                                        </span>
                                    </span>
                                </div>
                            </div>
                            <div class="et-cell-meta">
                                <span class="et-players-mobile @(isFull ? "et-players--full" : string.Empty) @(ev.Confirmations.Count == 0 ? "et-players--empty" : string.Empty)">
                                    <i class="fas fa-users"></i> @ev.Confirmations.Count / @ev.MaxPlayers
                                </span>
                                @if (!ev.IsActive)
                                {
                                    <span class="et-status et-status--cancelled">@Ui["Group.EventCancelled"]</span>
                                }
                                else if (isFull)
                                {
                                    <span class="et-status et-status--full">@Ui["Group.EventFull"]</span>
                                }
                                else
                                {
                                    <span class="et-status et-status--open">@Ui["Group.EventOpen"]</span>
                                }
                            </div>
                        </div>
                        <i class="fas fa-chevron-right et-chevron-icon"></i>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    [Parameter] public Group?                    Group            { get; set; }
    [Parameter] public List<Event>               DisplayedEvents  { get; set; } = new();
    [Parameter] public List<Event>               UpcomingEvents   { get; set; } = new();
    [Parameter] public bool                      ShowPastEvents   { get; set; }
    [Parameter] public Dictionary<int, int>      EventNumbers     { get; set; } = new();
    [Parameter] public bool                      IsAdmin          { get; set; }
    [Parameter] public string                    NewEventHref     { get; set; } = string.Empty;

    private string RelativeText(Event ev)
    {
        var rel = EventDateText.Relative(ev.StartsAt.ToLocalTime(), DateTime.Now);
        return rel.Kind switch
        {
            EventRelativeKind.Today    => Ui["Event.RelativeToday"],
            EventRelativeKind.Tomorrow => Ui["Event.RelativeTomorrow"],
            EventRelativeKind.InDays   => Ui.Get("Event.RelativeInDays", rel.Days),
            _                          => Ui.Get("Event.RelativeDaysAgo", rel.Days),
        };
    }

    private string? TipMeta(Event ev)
    {
        var venue = ev.Venue?.Name;
        if (string.IsNullOrWhiteSpace(venue)) venue = ev.Location;
        var weekly = ev.RachaScheduleId.HasValue;
        if (string.IsNullOrWhiteSpace(venue))
        {
            return weekly ? Ui["Group.WeeklyTitle"] : null;
        }
        return weekly ? $"{venue} · {Ui["Group.WeeklyTitle"]}" : venue;
    }
}
