@using Confirmai.Enums
@using Confirmai.Models
@using Confirmai.Services
@using Confirmai.Services.Events
@inject UiTextService Ui

@* C46 Fase 2: tabela substituida por lista .event-row (estouro mobile 390px).
   Data em coluna fixa, corpo com numero/local/jogadores, lado com status. *@
@if (DisplayedEvents.Count == 0)
{
    <div class="empty-state">
        <i class="fas fa-calendar-plus empty-state-icon"></i>
        @if (ShowPastEvents)
        {
            <span>@Ui["Group.NoMatchPlayed"]</span>
        }
        else if (IsAdmin)
        {
            <span>@Ui["Group.NoMatchScheduledEmpty"]</span>
            <a href="@NewEventHref" class="btn btn-primary">
                <i class="fas fa-plus"></i> @Ui["Group.CreateFirstMatch"]
            </a>
        }
        else
        {
            <span>@Ui["Group.NoMatchOrganizer"]</span>
        }
    </div>
}
else
{
    var nextUpcomingEventId = UpcomingEvents.FirstOrDefault()?.Id;
    <div class="event-list">
        @foreach (var ev in DisplayedEvents)
        {
            var href   = Group!.Sport == Sport.Futsal ? $"/futsal/{ev.Id}" : $"/poker/{ev.Id}";
            var isFull = ev.Confirmations.Count >= ev.MaxPlayers;
            var isNextUpcoming = !ShowPastEvents && nextUpcomingEventId.HasValue && ev.Id == nextUpcomingEventId.Value;
            var eventNum = EventNumbers.TryGetValue(ev.Id, out var n) ? n : 0;
            var venue = !string.IsNullOrWhiteSpace(ev.Venue?.Name) ? ev.Venue!.Name : ev.Location;
            <a class="event-row" href="@href">
                <span class="event-row-when gde-when" tabindex="0" aria-describedby="gde-tip-@ev.Id">
                    <span class="event-row-day">
                        @if (ev.RachaScheduleId.HasValue)
                        {
                            <i class="fas fa-sync-alt gde-recurring" title="@Ui["Group.WeeklyTitle"]"></i>
                        }
                        @Ui.FormatDateTime(ev.StartsAt.ToLocalTime(), "DateWeekday")
                    </span>
                    <span class="gde-time"><i class="fas fa-clock" aria-hidden="true"></i> @Ui.FormatDateTime(ev.StartsAt.ToLocalTime(), "TimeDefault")</span>
                    <span role="tooltip" id="gde-tip-@ev.Id" class="gde-tooltip">
                        <span class="gde-tip-line">@Ui.FormatDateTime(ev.StartsAt.ToLocalTime(), "DateLong")</span>
                        <span class="gde-tip-line gde-tip-relative">@RelativeText(ev)</span>
                        @if (TipMeta(ev) is { } tipMeta)
                        {
                            <span class="gde-tip-line gde-tip-meta">@tipMeta</span>
                        }
                    </span>
                </span>
                <span class="event-row-body">
                    <span class="event-row-title">#@eventNum@(string.IsNullOrWhiteSpace(venue) ? string.Empty : $" · {venue}")</span>
                    <span class="event-row-meta">
                        <span class="@(isFull ? "gde-players gde-players--full" : ev.Confirmations.Count == 0 ? "gde-players gde-players--empty" : "gde-players")">
                            <i class="fas fa-users"></i> @ev.Confirmations.Count / @ev.MaxPlayers
                        </span>
                    </span>
                </span>
                <span class="event-row-side">
                    @if (!ev.IsActive)
                    {
                        <span class="status-badge status-badge--cancelled">@Ui["Group.EventCancelled"]</span>
                    }
                    else if (isFull)
                    {
                        <span class="status-badge status-badge--full">@Ui["Group.EventFull"]</span>
                    }
                    else
                    {
                        <span class="status-badge status-badge--open">@Ui["Group.EventOpen"]</span>
                    }
                    @if (isNextUpcoming)
                    {
                        <span class="status-badge status-badge--next">@Ui["Group.EventNext"]</span>
                    }
                    <i class="fas fa-chevron-right gde-chevron" aria-hidden="true"></i>
                </span>
            </a>
        }
    </div>
}

@code {
    [Parameter] public Group?                    Group            { get; set; }
    [Parameter] public List<Event>               DisplayedEvents  { get; set; } = new();
    [Parameter] public List<Event>               UpcomingEvents   { get; set; } = new();
    [Parameter] public bool                      ShowPastEvents   { get; set; }
    [Parameter] public Dictionary<int, int>      EventNumbers     { get; set; } = new();
    [Parameter] public bool                      IsAdmin          { get; set; }
    [Parameter] public string                    NewEventHref     { get; set; } = string.Empty;

    private string RelativeText(Event ev)
    {
        var rel = EventDateText.Relative(ev.StartsAt.ToLocalTime(), DateTime.Now);
        return rel.Kind switch
        {
            EventRelativeKind.Today    => Ui["Event.RelativeToday"],
            EventRelativeKind.Tomorrow => Ui["Event.RelativeTomorrow"],
            EventRelativeKind.InDays   => Ui.Get("Event.RelativeInDays", rel.Days),
            _                          => Ui.Get("Event.RelativeDaysAgo", rel.Days),
        };
    }

    private string? TipMeta(Event ev)
    {
        var venue = ev.Venue?.Name;
        if (string.IsNullOrWhiteSpace(venue)) venue = ev.Location;
        var weekly = ev.RachaScheduleId.HasValue;
        if (string.IsNullOrWhiteSpace(venue))
        {
            return weekly ? Ui["Group.WeeklyTitle"] : null;
        }
        return weekly ? $"{venue} · {Ui["Group.WeeklyTitle"]}" : venue;
    }
}
