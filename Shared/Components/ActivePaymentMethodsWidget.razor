@inject UiTextService T

@* C43-A C1: o V1 so tem Pix manual — o widget mostra so ele, sem consultar
   GatewayService a cada navegacao. Quando o V2 (Pix automatico) entrar,
   volta a ser dinamico. *@

<section class="oldsite-widget widget-payment-methods">
    <h3>@T["Widget.PaymentMethods.Title"]</h3>

    <div class="oldsite-payment-methods">
        <div class="oldsite-payment-chip" title="Pix">
            <img src="/images/payment-methods/pix.svg" alt="" aria-hidden="true" />
            <span>Pix</span>
        </div>
    </div>
    <p class="oldsite-widget-note">@T["Widget.PaymentMethods.PixNote"]</p>
</section>
