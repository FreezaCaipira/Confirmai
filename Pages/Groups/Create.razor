@page "/grupos/criar"

@attribute [Authorize]

@using System.Security.Claims
@using Confirmai.Data
@using Confirmai.Enums
@using Confirmai.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using System.IO
@using System.Text.Json
@using Microsoft.EntityFrameworkCore


<PageTitle>Criar Grupo — Confirmai</PageTitle>

<div class="create-event-page">
    <div class="create-event-card">
        <div class="create-back-row">
            <a href="/grupos" class="listing-back-btn">
                <i class="fas fa-arrow-left"></i> Voltar
            </a>
        </div>
        <h1 class="create-event-title">
            <i class="fas fa-users"></i> Novo Grupo
        </h1>

        <EditForm Model="form" OnValidSubmit="Save">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-summary" />

            <div class="create-group-info-box">
                <i class="fas fa-info-circle"></i>
                <span>Crie um grupo e convide jogadores para participarem das partidas!</span>
            </div>

            <fieldset class="form-section form-section--narrow">
                <legend>Identidade do Grupo</legend>

                <div class="form-group">
                    <label>Esporte <span class="required">*</span></label>
                    <InputSelect class="input" @bind-Value="form.Sport">
                        <option value="@Sport.Futsal">Futsal / Futebol</option>
                        <option value="@Sport.Poker">Poker</option>
                    </InputSelect>
                </div>

                <div class="form-group">
                    <label>Nome do grupo <span class="required">*</span></label>
                    <InputText class="input" @bind-Value="form.Name"
                               placeholder='@(form.Sport == Sport.Poker ? "Ex: \"Sierra Poker Club\"" : "Ex: \"Rachão de Terça\"")'
                               autocomplete="off" />
                    <ValidationMessage For="@(() => form.Name)" class="validation-message" />
                </div>

                <div class="form-group">
                    <label>Logo/Imagem do grupo</label>
                    <div class="upload-section">
                        <div class="upload-preview">
                            @if (!string.IsNullOrWhiteSpace(logoPreview))
                            {
                                <img src="@logoPreview" alt="Preview" class="upload-preview-img" />
                            }
                            else
                            {
                                <div class="upload-placeholder">
                                    <i class="fas fa-image"></i>
                                    <span>Nenhuma imagem selecionada</span>
                                </div>
                            }
                        </div>
                        <div class="upload-controls">
                            <label class="upload-btn" for="logo-input">
                                <i class="fas fa-upload"></i> Selecionar imagem
                            </label>
                            <InputFile id="logo-input" OnChange="OnLogoSelected" accept=".jpg,.jpeg,.png,.webp" class="input-file--hidden" style="display:none;" />
                            @if (!string.IsNullOrWhiteSpace(logoFeedback))
                            {
                                <p class="@(logoError ? "validation-message" : "upload-success")">@logoFeedback</p>
                            }
                            <p class="upload-hint">PNG, JPG ou WebP • Máximo 5 MB</p>
                        </div>
                    </div>
                </div>
            </fieldset>

            <fieldset class="form-section form-section--narrow">
                <legend>Localização</legend>

                <div class="form-row-2">
                    <div class="form-group">
                        <label>UF <span class="required">*</span></label>
                        <InputSelect class="input" @bind-Value="form.StateCode" @bind-Value:after="OnStateChanged">
                            <option value="">— Selecione —</option>
                            <option value="EX">EX — Estrangeiro</option>
                            <option disabled>──────────────────</option>
                            @foreach (var uf in BrazilianStates)
                            {
                                <option value="@uf">@uf</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => form.StateCode)" class="validation-message" />
                    </div>
                    <div class="form-group">
                        <label>Cidade <span class="required">*</span></label>
                        @if (form.StateCode == "EX" || string.IsNullOrEmpty(form.StateCode) || !citiesByState.ContainsKey(form.StateCode))
                        {
                            <InputText class="input" @bind-Value="form.City" placeholder="Selecione a UF" disabled="@(string.IsNullOrEmpty(form.StateCode))" />
                        }
                        else
                        {
                            <InputSelect class="input" @bind-Value="form.City">
                                <option value="">— Selecione —</option>
                                @foreach (var city in citiesByState[form.StateCode])
                                {
                                    <option value="@city">@city</option>
                                }
                            </InputSelect>
                        }
                        <ValidationMessage For="@(() => form.City)" class="validation-message" />
                    </div>
                </div>
            </fieldset>


            @if (!string.IsNullOrWhiteSpace(saveError))
            {
                <p class="validation-message">@saveError</p>
            }

            <div class="form-actions">
                <button class="cancel-btn" type="button"
                        @onclick='() => NavigationManager.NavigateTo("/grupos")'>
                    Cancelar
                </button>
                <button class="save-btn" type="submit" disabled="@isSaving">
                    @(isSaving ? "Criando…" : "Criar Grupo")
                </button>
            </div>
        </EditForm>
    </div>
</div>
