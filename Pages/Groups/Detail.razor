@page "/grupo/{Id:int}"

@attribute [AllowAnonymous]

@using System.Security.Claims
@using Confirmai.Data
@using Confirmai.Enums
@using Confirmai.Models
@using Confirmai.Services
@using Confirmai.Shared.Components.Groups
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop

@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider    AuthStateProvider
@inject NavigationManager              NavigationManager
@inject IConfiguration                 Config
@inject IJSRuntime                     JS
@inject UiTextService                  Ui

<PageTitle>@(group?.Name ?? "Grupo") · Confirmai</PageTitle>

@if (isLoading)
{
    <div class="detail-loading">
        <div class="detail-skeleton">
            <div class="skeleton-header">
                <div class="skeleton-line skeleton-line--sm"></div>
                <div class="skeleton-line skeleton-line--lg"></div>
                <div class="skeleton-line skeleton-line--md"></div>
            </div>
            <div class="skeleton-chips">
                <div class="skeleton-chip"></div>
                <div class="skeleton-chip"></div>
                <div class="skeleton-chip"></div>
            </div>
            <div class="skeleton-section">
                <div class="skeleton-section-title"></div>
                <div class="skeleton-list">
                    <div class="skeleton-list-item">
                        <div class="skeleton-list-item-avatar"></div>
                        <div class="skeleton-list-item-content">
                            <div class="skeleton-line skeleton-line--md skeleton-w-200"></div>
                            <div class="skeleton-line skeleton-line--sm skeleton-w-150"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else if (group is null)
{
    <div class="detail-not-found">
        <h2>Grupo não encontrado.</h2>
        <a href="/">← Voltar</a>
    </div>
}
else
{
    var isAdmin  = currentUserId is not null &&
                   group.Members.Any(m => m.UserId == currentUserId && m.Role == GroupMemberRole.Admin);
    var isMember  = currentUserId is not null &&
                   group.Members.Any(m => m.UserId == currentUserId);
    var baseUrl   = (Config["App:BaseUrl"]?.TrimEnd('/'))  ?? NavigationManager.BaseUri.TrimEnd('/');
    var newEventHref = group.Sport == Sport.Futsal
        ? $"/futsal/create?groupId={group.Id}"
        : $"/poker/create?groupId={group.Id}";
    var orderedMembers = group.Members
        .OrderBy(m => m.Role == GroupMemberRole.Admin ? 0 : 1)
        .ThenBy(m => m.CreatedAt)
        .ToList();
    var hasHiddenMembers = orderedMembers.Count > MembersPreviewLimit;
    var visibleMembers = showAllMembers
        ? orderedMembers
        : orderedMembers.Take(MembersPreviewLimit);

    <div class="detail-page">
        <div class="detail-card">

            @* ── Cabeçalho ─────────────────────────────────────────── *@
            <header class="detail-header">
                <div class="detail-header-top">
                    <span class="detail-sport-badge">
                        @(group.Sport == Sport.Futsal ? "⚽ Futsal" : "🃏 Poker")
                    </span>
                    <a href="/grupos" class="detail-back-link">
                        <i class="fas fa-arrow-left"></i> Início
                    </a>
                </div>
                <h1 class="detail-title">@group.Name</h1>
                @if (!string.IsNullOrWhiteSpace(group.City))
                {
                    <p class="detail-location">
                        <i class="fas fa-map-marker-alt"></i>
                        @group.City/@group.StateCode
                    </p>
                }
                @if (!group.IsActive)
                {
                    <div class="cancelled-banner"><i class="fas fa-ban"></i> Grupo inativo.</div>
                }
            </header>

            @* ── Convite (somente admin) ────────────────────────────── *@
            @if (isAdmin)
            {
                <div class="invite-block">
                    @{ var inviteUrl = $"{baseUrl}/convite/{group.InviteCode}"; }
                    <div class="invite-row">
                        <span class="invite-label"><i class="fas fa-link"></i> Link de convite:</span>
                        <code class="invite-code-display" id="invite-url-text">@inviteUrl</code>
                        <button class="invite-copy-btn" type="button"
                                @onclick="() => CopyInviteLink(inviteUrl)">
                            <i class="fas fa-copy"></i> @(copiedInvite ? "Copiado!" : "Copiar")
                        </button>
                    </div>
                    <hr class="invite-row-divider" />
                    <div class="invite-row">
                        <span class="invite-label"><i class="fas fa-key"></i> Código:</span>
                        <code class="invite-code-display invite-code-only">@group.InviteCode</code>
                        <button class="invite-copy-btn" type="button"
                                @onclick="() => CopyCode(group.InviteCode!)">
                            <i class="fas fa-copy"></i> @(copiedCode ? "Copiado!" : "Copiar")
                        </button>
                    </div>
                    <hr class="invite-row-divider" />
                    <div class="invite-block-actions">
                        <button class="detail-admin-btn detail-admin-btn--invite invite-block-btn" type="button"
                                @onclick="() => ShareInviteOnWhatsApp(inviteUrl)">
                            <i class="fas fa-link"></i> Convidar
                        </button>
                        <a class="detail-admin-btn invite-block-btn invite-block-btn--settings" href="/grupo/@group.Id/configuracoes">
                            <i class="fas fa-cog"></i> Configurações
                        </a>
                    </div>
                </div>
            }

            <hr class="detail-divider">

            @* ── Membros ────────────────────────────────────────────── *@
            <section class="detail-section">
                <div class="detail-section-header">
                    <h2 class="detail-section-title">
                        <i class="fas fa-users"></i> Membros (@group.Members.Count)
                    </h2>
                    <div class="detail-section-actions">
                        @if (isMember && group.EnablePostMatchRanking)
                        {
                            <a class="detail-admin-btn detail-admin-btn--ranking" href="/grupo/@group.Id/ranking">
                                <i class="fas fa-trophy"></i> Ranking
                            </a>
                        }
                        @if (isAdmin)
                        {
                            <a class="payment-btn" href="/grupo/@group.Id/pagamentos">
                                <i class="fas fa-money-bill-wave"></i> Pagamentos
                            </a>
                        }
                    </div>
                </div>
                <GroupDetailMembers
                    Members="@group.Members"
                    CurrentUserId="@currentUserId"
                    ShowAllMembers="@showAllMembers"
                    OnToggleMembersView="@ToggleMembersView" />
            </section>

            @* ── Métricas (somente admin) ───────────────────────────── *@
            @if (isAdmin)
            {
                <hr class="detail-divider">
                <section class="detail-section">
                    <div class="detail-section-header">
                        <h2 class="detail-section-title">
                            <i class="fas fa-chart-line"></i> Métricas
                        </h2>
                    </div>
                    <GroupMetrics GroupId="@group.Id" />
                </section>
            }

            @* ── Partidas ───────────────────────────────────────────── *@
            <section class="detail-section">
                <h2 class="detail-section-title detail-events-title detail-events-title--no-mb">
                    <i class="fas fa-calendar-alt"></i>
                    <span>Partidas</span>
                    <span class="detail-events-year">@eventsYear</span>
                </h2>
                <div class="detail-events-tabs">
                    <div class="detail-events-tabs-left">
                        <button class="detail-events-tab @(!showPastEvents ? "active" : string.Empty)"
                                type="button"
                                @onclick="() => showPastEvents = false">
                            <i class="fas fa-bolt"></i> Próximas (@upcomingEvents.Count)
                        </button>
                        <button class="detail-events-tab @(showPastEvents ? "active" : string.Empty)"
                                type="button"
                                @onclick="() => showPastEvents = true">
                            <i class="fas fa-history"></i> Realizadas (@pastEvents.Count)
                        </button>
                    </div>
                    <div class="detail-events-tabs-right">
                        @if (isAdmin)
                        {
                            <a href="@newEventHref" class="groups-create-btn detail-events-create-btn">
                                <i class="fas fa-plus"></i> Nova partida
                            </a>
                        }
                    </div>
                </div>
                <GroupDetailEvents
                    Group="@group"
                    DisplayedEvents="@displayedEvents"
                    UpcomingEvents="@upcomingEvents"
                    ShowPastEvents="@showPastEvents"
                    EventNumbers="@eventNumbers" />
            </section>

            @* ── Solicitações de entrada (admin) ─────────────────────── *@
            @if (isAdmin && pendingRequests.Count > 0)
            {
                <hr class="detail-divider">
                <GroupDetailPendingRequests
                    PendingCount="@pendingRequests.Count"
                    SelectedCount="@selectedRequestIds.Count"
                    IsBulkProcessing="@isBulkProcessing"
                    @bind-RequestSortOrder="requestSortOrder"
                    SortedPendingRequests="@sortedPendingRequests"
                    SelectedRequestIds="@selectedRequestIds"
                    OnApprove="ApproveRequest"
                    OnReject="RejectRequest"
                    OnApproveSelected="ApproveSelected"
                    OnRejectSelected="RejectSelected"
                    OnClearSelection="ClearSelection"
                    OnToggleSelection="((int id, bool sel) args) => ToggleRequestSelection(args.id, args.sel)" />
            }

            @* ── Aviso: nenhum admin tem Pix (apenas para admins) ─────── *@
            @if (isAdmin && group is not null && !group.Members.Any(m => m.Role == GroupMemberRole.Admin && !string.IsNullOrWhiteSpace(m.User?.PixKey)))
            {
                <hr class="detail-divider">
                <div class="detail-pix-notice">
                    <span class="detail-pix-notice-icon"><i class="fas fa-exclamation-triangle"></i></span>
                    <div class="detail-pix-notice-body">
                        <strong>Pix do organizador não configurado</strong>
                        <p>Nenhum administrador do grupo possui chave Pix cadastrada. Os participantes não terão opção de pagamento manual por Pix.</p>
                        <a href="/grupo/@group.Id/configuracoes" class="detail-pix-notice-link">Configurar agora →</a>
                    </div>
                </div>
            }

            @* ── Não membro: solicitar entrada ────────────────────────── *@
            @if (currentUserId is not null && !isMember)
            {
                <hr class="detail-divider">
                <div class="join-request-section">
                    @if (userJoinRequest?.Status == JoinRequestStatus.Pending)
                    {
                        <p class="join-request-pending">
                            <i class="fas fa-hourglass-half"></i>
                            Solicitação enviada — aguardando aprovação do administrador.
                        </p>
                    }
                    else if (userJoinRequest?.Status == JoinRequestStatus.Rejected)
                    {
                        <p class="join-request-pending join-request-pending--rejected">
                            <i class="fas fa-times-circle"></i>
                            Sua solicitação foi recusada.
                        </p>
                    }
                    else
                    {
                        <p class="join-request-info">
                            <i class="fas fa-info-circle"></i>
                            Você não é membro deste grupo. Solicite entrada ou peça o código de convite ao organizador.
                        </p>
                        <button class="confirm-btn" type="button" @onclick="RequestToJoin"
                                disabled="@requestingJoin">
                            <i class="fas fa-user-plus"></i>
                            @(requestingJoin ? "Enviando…" : "Solicitar entrada")
                        </button>
                    }
                </div>
            }

        </div>
    </div>
}





