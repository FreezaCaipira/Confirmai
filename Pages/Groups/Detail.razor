@page "/grupo/{Id:int}"

@attribute [AllowAnonymous]

@using System.Security.Claims
@using Confirmai.Enums
@using Confirmai.Models
@using Confirmai.Services
@using Confirmai.Shared.Components.Groups
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop

@inject AuthenticationStateProvider    AuthStateProvider
@inject NavigationManager              NavigationManager
@inject IConfiguration                 Config
@inject IJSRuntime                     JS
@inject Confirmai.Services.Core.UiTextService Ui

<PageTitle>@(group?.Name ?? @Ui["Group.PageTitle"]) · Confirmai</PageTitle>

@if (isLoading)
{
    <div class="detail-loading">
        <div class="detail-skeleton">
            <div class="skeleton-header">
                <div class="skeleton-line skeleton-line--sm"></div>
                <div class="skeleton-line skeleton-line--lg"></div>
                <div class="skeleton-line skeleton-line--md"></div>
            </div>
            <div class="skeleton-chips">
                <div class="skeleton-chip"></div>
                <div class="skeleton-chip"></div>
                <div class="skeleton-chip"></div>
            </div>
            <div class="skeleton-section">
                <div class="skeleton-section-title"></div>
                <div class="skeleton-list">
                    <div class="skeleton-list-item">
                        <div class="skeleton-list-item-avatar"></div>
                        <div class="skeleton-list-item-content">
                            <div class="skeleton-line skeleton-line--md skeleton-w-200"></div>
                            <div class="skeleton-line skeleton-line--sm skeleton-w-150"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else if (group is null)
{
    <div class="detail-not-found">
        <h2>@Ui["Group.NotFound"]</h2>
        <a href="/" class="btn btn-ghost"><i class="fas fa-arrow-left"></i> @Ui["Common.Back"]</a>
    </div>
}
else
{
    var isAdmin  = currentUserId is not null &&
                   group.Members.Any(m => m.UserId == currentUserId && m.Role == GroupMemberRole.Admin);
    var isMember  = currentUserId is not null &&
                   group.Members.Any(m => m.UserId == currentUserId);
    var baseUrl   = (Config["App:BaseUrl"]?.TrimEnd('/'))  ?? NavigationManager.BaseUri.TrimEnd('/');
    var inviteUrl = $"{baseUrl}/convite/{group.InviteCode}";

    <div class="detail-page">
        <div class="hub-stack">

            @* ── Cabeçalho do grupo (compartilhado, com sub-nav) ──────── *@
            <GroupHeader Group="@group" IsAdmin="@isAdmin" />

            @if (!group.IsActive)
            {
                <div class="cancelled-banner"><i class="fas fa-ban"></i> @Ui["Group.Inactive"]</div>
            }

            @if (isMember)
            {
                @* ── Ações do grupo ──────────────────────────────────── *@
                <section class="panel hub-actions-panel" aria-label="@Ui["Group.ActionsLabel"]">
                    <div class="hub-actions">
                        <a class="hub-action" href="/grupo/@group.Id/partidas">
                            <span class="hub-action-icon"><i class="fas fa-calendar-alt"></i></span>
                            <span class="hub-action-text">
                                <span class="hub-action-label">@Ui["Group.PartidasLink"]</span>
                                <span class="hub-action-sub">@upcomingEventsCount @Ui["Group.Upcoming"]</span>
                            </span>
                        </a>
                        <a class="hub-action" href="/grupo/@group.Id/pagamentos">
                            <span class="hub-action-icon"><i class="fas fa-money-bill-wave"></i></span>
                            <span class="hub-action-text">
                                <span class="hub-action-label">@Ui["Group.PaymentsLink"]</span>
                                @if (myPendingPayments > 0)
                                {
                                    <span class="hub-action-sub hub-action-sub--warn">
                                        @myPendingPayments @(myPendingPayments == 1 ? Ui["Group.PendingSingular"] : Ui["Group.PendingPlural"])
                                    </span>
                                }
                                else
                                {
                                    <span class="hub-action-sub">@Ui["Group.PaymentsUpToDate"]</span>
                                }
                            </span>
                        </a>
                        @if (group.EnablePostMatchRanking)
                        {
                            <a class="hub-action" href="/grupo/@group.Id/ranking">
                                <span class="hub-action-icon"><i class="fas fa-trophy"></i></span>
                                <span class="hub-action-text">
                                    <span class="hub-action-label">@Ui["Group.RankingLink"]</span>
                                    <span class="hub-action-sub">@Ui["Group.RankingSub"]</span>
                                </span>
                            </a>
                        }
                        @if (isAdmin)
                        {
                            <a class="hub-action" href="/grupo/@group.Id/configuracoes">
                                <span class="hub-action-icon"><i class="fas fa-cog"></i></span>
                                <span class="hub-action-text">
                                    <span class="hub-action-label">@Ui["Group.Settings"]</span>
                                    <span class="hub-action-sub">@Ui["Group.SettingsSub"]</span>
                                </span>
                            </a>
                            <button class="hub-action" type="button"
                                    @onclick="() => ShareInviteOnWhatsApp(inviteUrl)">
                                <span class="hub-action-icon"><i class="fab fa-whatsapp"></i></span>
                                <span class="hub-action-text">
                                    <span class="hub-action-label">@Ui["Group.Invite"]</span>
                                    <span class="hub-action-sub">@Ui["Group.InviteSub"]</span>
                                </span>
                            </button>
                        }
                    </div>
                </section>

                @* ── Próxima partida ───────────────────────────────── *@
                <section class="panel">
                    <div class="panel-head">
                        <h2 class="panel-title">
                            <i class="fas fa-calendar-day"></i> @Ui["Group.NextMatch"]
                        </h2>
                    </div>
                    @if (nextEvent is not null)
                    {
                        var myConfirmation = nextEvent.Confirmations
                            .FirstOrDefault(c => c.UserId == currentUserId);
                        var eventHref = nextEvent.Sport == Sport.Futsal
                            ? $"/futsal/{nextEvent.Id}"
                            : $"/poker/{nextEvent.Id}";
                        var owes = myConfirmation is not null && !myConfirmation.HasPaid
                            && myConfirmation.PaymentStatus == EventConfirmationPaymentStatus.Pending
                            && nextEvent.Price.HasValue && nextEvent.Price.Value > 0
                            && myConfirmation.Position != FutsalPosition.Goalkeeper;
                        var proofSent = owes && myConfirmation!.PixProofUploadedAt is not null;
                        <div class="event-row">
                            <div class="event-row-when">
                                <span class="event-row-day">@Ui.FormatDateTime(nextEvent.StartsAt.ToLocalTime(), "DateTimeFullShort")</span>
                            </div>
                            <div class="event-row-body">
                                <span class="event-row-title">@group.Name</span>
                                <span class="event-row-meta">
                                    @if (!string.IsNullOrWhiteSpace(nextEvent.Location))
                                    {
                                        <span>📍 @nextEvent.Location</span>
                                    }
                                    <span>👥 @nextEvent.Confirmations.Count@(nextEvent.MaxPlayers > 0 ? $"/{nextEvent.MaxPlayers}" : string.Empty) @Ui["Index.ConfirmedCount"]</span>
                                </span>
                            </div>
                            <div class="event-row-side">
                                @if (proofSent)
                                {
                                    <span class="status-badge status-badge--pending">
                                        <i class="fas fa-clock"></i> @Ui["Index.ProofSent"]
                                    </span>
                                }
                                else if (owes)
                                {
                                    <a href="/pagamento/evento/@myConfirmation!.Id" class="btn btn-primary btn-sm">
                                        <i class="fas fa-qrcode"></i> @Ui["Index.Pay"]
                                    </a>
                                }
                                else if (myConfirmation is not null)
                                {
                                    <span class="status-badge status-badge--confirmed">
                                        <i class="fas fa-check"></i> @Ui["Index.Confirmed"]
                                    </span>
                                }
                                else
                                {
                                    <a href="@eventHref" class="btn btn-primary btn-sm">
                                        <i class="fas fa-check"></i> @Ui["Group.ConfirmPresence"]
                                    </a>
                                }
                                <a href="@eventHref" class="btn btn-ghost btn-sm">
                                    <i class="fas fa-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="hub-next-empty">
                            @if (isAdmin)
                            {
                                <p class="hub-next-empty-text">@Ui["Group.NoMatchScheduledEmpty"]</p>
                                <a href="@(group.Sport == Sport.Futsal ? $"/futsal/create?groupId={group.Id}" : $"/poker/create?groupId={group.Id}")" class="btn btn-primary">
                                    <i class="fas fa-plus"></i> @Ui["Groups.NovaPartida"]
                                </a>
                            }
                            else
                            {
                                <p class="hub-next-empty-text">@Ui["Group.NoMatchOrganizer"]</p>
                            }
                        </div>
                    }
                </section>

                @* ── Aviso: nenhum admin tem Pix (apenas admin, apenas Pix direto) ── *@
                @if (isAdmin && !group.EnablePaymentGateways && !group.Members.Any(m => m.Role == GroupMemberRole.Admin && !string.IsNullOrWhiteSpace(m.User?.PixKey)))
                {
                    <div class="detail-pix-notice">
                        <span class="detail-pix-notice-icon"><i class="fas fa-exclamation-triangle"></i></span>
                        <div class="detail-pix-notice-body">
                            <strong>@Ui["Group.PixNotConfigured"]</strong>
                            <p>@Ui["Group.PixNotConfiguredDesc"]</p>
                            <a href="/grupo/@group.Id/configuracoes" class="detail-pix-notice-link">@Ui["Group.ConfigureNow"]</a>
                        </div>
                    </div>
                }

                @* ── Métricas (somente admin) ────────────────────────── *@
                @if (isAdmin)
                {
                    <section class="panel">
                        <div class="panel-head">
                            <h2 class="panel-title">
                                <i class="fas fa-chart-line"></i> @Ui["Group.Metrics"]
                            </h2>
                        </div>
                        <GroupMetrics GroupId="@group.Id" />
                    </section>
                }

                @* ── Membros + pedidos de entrada ────────────────────── *@
                <section class="panel">
                    <div class="panel-head">
                        <h2 class="panel-title">
                            <i class="fas fa-users"></i> @Ui["Group.Members"] (@group.Members.Count)
                        </h2>
                    </div>

                    @if (isAdmin && pendingRequests.Count > 0)
                    {
                        <div class="hub-requests">
                            <div class="hub-requests-head">
                                <h3 class="hub-requests-title">
                                    @Ui["Group.PendingRequestsLabel"] (@pendingRequests.Count)
                                </h3>
                                @if (pendingRequests.Count >= 2)
                                {
                                    <button class="btn btn-primary btn-sm" type="button"
                                            @onclick="ApproveAllRequests" disabled="@isBulkProcessing">
                                        <i class="fas fa-check-double"></i> @Ui["Group.ApproveAll"]
                                    </button>
                                }
                            </div>
                            <ul class="hub-request-list">
                                @foreach (var req in pendingRequests.OrderByDescending(r => r.RequestedAt))
                                {
                                    <li class="hub-request-item">
                                        <div class="hub-request-info">
                                            <span class="hub-request-name">@(req.User?.FullName ?? req.User?.UserName ?? Ui["Group.PendingRequestUserFallback"])</span>
                                            <span class="hub-request-email">@req.User?.Email</span>
                                        </div>
                                        <div class="hub-request-actions">
                                            <button class="btn btn-secondary btn-sm" type="button"
                                                    @onclick="() => ApproveRequest(req.Id)"
                                                    title="@Ui["Group.ApproveRequest"]">
                                                <i class="fas fa-check"></i> @Ui["Group.Approve"]
                                            </button>
                                            <button class="btn btn-ghost btn-sm" type="button"
                                                    @onclick="() => RejectRequest(req.Id)"
                                                    title="@Ui["Group.RejectRequest"]">
                                                <i class="fas fa-times"></i> @Ui["Group.Reject"]
                                            </button>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    <GroupDetailMembers
                        Members="@group.Members"
                        CurrentUserId="@currentUserId"
                        ShowAllMembers="@showAllMembers"
                        OnToggleMembersView="@ToggleMembersView" />
                </section>
            }
            else
            {
                @* ── Não-membro: um painel só ────────────────────────── *@
                <section class="panel empty-state">
                    @if (currentUserId is null)
                    {
                        <i class="fas fa-lock empty-state-icon"></i>
                        <p class="join-request-info">@Ui["Group.NotMemberInfo"]</p>
                        <a class="btn btn-primary" href="/Identity/Account/Login?ReturnUrl=@Uri.EscapeDataString(NavigationManager.Uri)">
                            <i class="fas fa-sign-in-alt"></i> @Ui["Group.LoginToJoin"]
                        </a>
                    }
                    else if (userJoinRequest?.Status == JoinRequestStatus.Pending)
                    {
                        <i class="fas fa-hourglass-half empty-state-icon"></i>
                        <p class="join-request-pending">@Ui["Group.JoinRequestSent"]</p>
                        <button class="btn btn-ghost" type="button" @onclick="CancelJoinRequest" disabled="@cancellingJoin">
                            <i class="fas fa-times"></i>
                            @(cancellingJoin ? @Ui["Group.CancellingJoin"] : @Ui["Group.CancelJoinRequest"])
                        </button>
                    }
                    else if (userJoinRequest?.Status == JoinRequestStatus.Rejected)
                    {
                        <i class="fas fa-times-circle empty-state-icon"></i>
                        <p class="join-request-pending join-request-pending--rejected">@Ui["Group.JoinRequestRejected"]</p>
                    }
                    else
                    {
                        <i class="fas fa-user-plus empty-state-icon"></i>
                        <p class="join-request-info">@Ui["Group.NotMemberInfo"]</p>
                        <button class="btn btn-primary" type="button" @onclick="RequestToJoin"
                                disabled="@requestingJoin">
                            <i class="fas fa-user-plus"></i>
                            @(requestingJoin ? @Ui["Group.SendingJoin"] : @Ui["Group.RequestJoin"])
                        </button>
                    }
                </section>
            }

        </div>
    </div>
}





