@using Confirmai.Data
@using Confirmai.Services
@using Confirmai.Services.Core
@inject UiTextService Ui

<section class="detail-section features-section">
    <h2 class="detail-section-title">
        <i class="fas fa-credit-card"></i> @Ui["Group.PaymentsSection"]
    </h2>
    <p class="features-section-sub">@Ui["Group.PaymentsSectionSub"]</p>

    <div class="features-list">
        <div class="feature-card @(Group!.EnablePaymentGateways ? "feature-card--on" : "")">
            <div class="feature-card-info">
                <span class="feature-card-icon"><i class="fas fa-exchange-alt"></i></span>
                <div class="feature-card-text">
                    <strong class="feature-card-title">@Ui["Group.GatewayTitle"]</strong>
                    <p class="feature-card-desc">
                        @Ui["Group.GatewayDesc"]
                    </p>
                    @if (AvailableGatewayOptions.Count == 0)
                    {
                        <p class="feat-gateway-note">
                            @Ui["Group.NoGateway"]
                        </p>
                    }
                    else
                    {
                        <p class="feat-gateway-note">
                            @Ui.Get("Group.AvailableNow", string.Join(", ", AvailableGatewayOptions.Select(g => g.DisplayName)))
                        </p>
                    }
                </div>
            </div>
            <label class="feature-toggle" title="@(Group!.EnablePaymentGateways ? @Ui["Group.Deactivate"] : @Ui["Group.Activate"])">
                <input type="checkbox"
                       checked="@Group!.EnablePaymentGateways"
                       disabled="@IsSaving"
                       @onchange="() => HandleTogglePaymentGateways()" />
                <span class="feature-toggle-track"></span>
            </label>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(SaveMessage))
    {
        <p class="features-save-msg @(SaveError ? "features-save-msg--error" : "")">
            <i class="fas @(SaveError ? "fa-times-circle" : "fa-check-circle")"></i>
            @SaveMessage
        </p>
    }
</section>

<section class="detail-section features-section">
    <h2 class="detail-section-title">
        <i class="fas fa-sliders-h"></i> @Ui["Group.AdditionalFeatures"]
    </h2>
    <p class="features-section-sub">@Ui["Group.AdditionalFeaturesSub"]</p>

    <div class="features-list">
        <div class="feature-card @(Group!.EnablePostMatchRanking ? "feature-card--on" : "") @(Group!.EnablePaymentGateways ? "" : "feature-card--disabled")">
            <div class="feature-card-info">
                <span class="feature-card-icon"><i class="fas fa-trophy"></i></span>
                <div class="feature-card-text">
                    <strong class="feature-card-title">@Ui["Group.RankingPostMatch"]</strong>
                    <p class="feature-card-desc">
                        @Ui["Group.RankingPostMatchDesc"]
                    </p>
                    @if (!Group!.EnablePaymentGateways)
                    {
                        <p class="feat-gateway-note">
                            @Ui["Group.RequiresGateways"]
                        </p>
                    }
                </div>
            </div>
            <label class="feature-toggle" title="@(Group!.EnablePostMatchRanking ? @Ui["Group.Deactivate"] : @Ui["Group.Activate"])">
                <input type="checkbox"
                       checked="@Group!.EnablePostMatchRanking"
                       disabled="@(IsSaving || !Group!.EnablePaymentGateways)"
                       @onchange="() => HandleTogglePostMatchRanking()" />
                <span class="feature-toggle-track"></span>
            </label>
        </div>

        <div class="feature-card @(Group!.EnableBestPlayerVoting ? "feature-card--on" : "") @(Group!.EnablePaymentGateways ? "" : "feature-card--disabled")">
            <div class="feature-card-info">
                <span class="feature-card-icon"><i class="fas fa-medal"></i></span>
                <div class="feature-card-text">
                    <strong class="feature-card-title">@Ui["Group.BestPlayerVoting"]</strong>
                    <p class="feature-card-desc">
                        @Ui["Group.BestPlayerVotingDesc"]
                    </p>
                    @if (!Group!.EnablePaymentGateways)
                    {
                        <p class="feat-gateway-note">
                            @Ui["Group.RequiresGateways"]
                        </p>
                    }
                </div>
            </div>
            <label class="feature-toggle" title="@(Group!.EnableBestPlayerVoting ? @Ui["Group.Deactivate"] : @Ui["Group.Activate"])">
                <input type="checkbox"
                       checked="@Group!.EnableBestPlayerVoting"
                       disabled="@(IsSaving || !Group!.EnablePaymentGateways)"
                       @onchange="() => HandleToggleBestPlayerVoting()" />
                <span class="feature-toggle-track"></span>
            </label>
        </div>
    </div>
</section>
