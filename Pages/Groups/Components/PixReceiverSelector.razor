@using Confirmai.Models
@using Confirmai.Services.Core
@inject UiTextService Ui

<section class="settings-section feat--payments">
    <div class="settings-section-head">
        <span class="feat-icon"><i class="fas fa-qrcode"></i></span>
        <div>
            <h2 class="settings-section-title">@Ui["Payment.PixOrganizer"]</h2>
            <p class="settings-section-sub">
                @Ui["Payment.SelectReceiver"]
                @Ui["Payment.SelectReceiverSub"]
            </p>
        </div>
    </div>

    @if (PixAdmins.Count == 0)
    {
        <div class="feat-pix-warning">
            <i class="fas fa-exclamation-triangle"></i>
            @Ui["Payment.NoPixAdmin"]
            <a href="/profile/@CurrentUserId?intent=pix" class="feat-pix-profile-link">@Ui["Payment.ConfigurePix"]</a>
        </div>
    }
    else
    {
        <div class="feat-pix-form">
            <label class="feat-pix-label" for="pix-receiver-select">@Ui["Payment.AdminReceives"]</label>
            <select id="pix-receiver-select"
                    class="feat-pix-select"
                    @bind="localSelectedId"
                    disabled="@IsSaving">
                <option value="">@Ui["Payment.AutoReceiver"]</option>
                @foreach (var a in PixAdmins)
                {
                    <option value="@a.UserId">@(a.User?.FullName ?? a.User?.UserName) — @a.User?.PixKey</option>
                }
            </select>
            <button class="btn btn-primary btn-sm" type="button"
                    disabled="@IsSaving"
                    @onclick="HandleSavePixReceiver">
                <i class="fas fa-save"></i> @(IsSaving ? Ui["Payment.Saving"] : Ui["Payment.Save"])
            </button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <p class="features-save-msg @(IsError ? "features-save-msg--error" : "")">
            <i class="fas @(IsError ? "fa-times-circle" : "fa-check-circle")"></i>
            @Message
        </p>
    }
</section>
