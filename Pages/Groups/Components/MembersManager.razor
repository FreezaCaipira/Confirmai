@using Confirmai.Models
@using Confirmai.Enums
@using Confirmai.Services.Core
@inject UiTextService Ui

<section class="detail-section features-section">
    <h2 class="detail-section-title">
        <i class="fas fa-user-shield"></i> @Ui["Group.MembersPermissions"]
    </h2>
    <p class="features-section-sub">@Ui["Group.MembersPermissionsSub"]</p>
    @if (!CanManageAdminRoles)
    {
        <p class="feat-role-note">
            <i class="fas fa-lock"></i>
            @Ui["Group.OnlyCreatorCanManage"]
        </p>
    }

    <ul class="feat-members-list">
        @foreach (var m in Members.OrderBy(m => m.Role == GroupMemberRole.Admin ? 0 : 1).ThenBy(m => m.User?.FullName))
        {
            var isSelf   = m.UserId == CurrentUserId;
            var isAdminM = m.Role == GroupMemberRole.Admin;
            var onlyAdmin = isAdminM && AdminCount == 1;
            var isConfirmingPromote = ConfirmPromoteMemberId == m.Id;
            <li class="feat-member-item">
                <div class="feat-member-info">
                    <span class="feat-member-name">@(m.User?.FullName ?? m.User?.UserName ?? @Ui["Group.Member"])</span>
                    @if (isAdminM) { <span class="player-tag player-tag--admin">@Ui["Group.Admin"]</span> }
                    @if (m.UserId == CreatedByUserId) { <span class="player-tag">@Ui["Group.Creator"]</span> }
                    @if (isSelf)   { <span class="player-tag player-tag--me">@Ui["Group.You"]</span> }
                </div>
                @if (!isSelf && CanManageAdminRoles)
                {
                    @if (isAdminM)
                    {
                        <button class="feat-role-btn feat-role-btn--demote"
                                type="button"
                                disabled="@(IsSavingRole || onlyAdmin)"
                                title="@(onlyAdmin ? @Ui["Group.MustHaveOneAdmin"] : @Ui["Group.RemoveAdminTitle"])"
                                @onclick="() => HandleSetMemberRole(m.Id, GroupMemberRole.Member)">
                            <i class="fas fa-user-minus"></i> @Ui["Group.RemoveAdmin"]
                        </button>
                    }
                    else
                    {
                        @if (isConfirmingPromote)
                        {
                            <div class="feat-role-confirm">
                                <span class="feat-role-confirm-text">@Ui["Group.MakeAdminConfirm"]</span>
                                <button class="feat-role-btn feat-role-btn--confirm-yes"
                                        type="button"
                                        disabled="@IsSavingRole"
                                        @onclick="() => HandleSetMemberRole(m.Id, GroupMemberRole.Admin)">
                                    <i class="fas fa-check"></i>
                                </button>
                                <button class="feat-role-btn feat-role-btn--confirm-no"
                                        type="button"
                                        disabled="@IsSavingRole"
                                        @onclick="() => HandleCancelPromote()">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        }
                        else
                        {
                            <button class="feat-role-btn feat-role-btn--promote"
                                    type="button"
                                    disabled="@IsSavingRole"
                                    title="@Ui["Group.PromoteToAdmin"]"
                                    @onclick="() => HandleInitiatePromote(m.Id)">
                                <i class="fas fa-user-shield"></i> @Ui["Group.MakeAdmin"]
                            </button>
                        }
                    }
                }
            </li>
        }
    </ul>

    @if (!string.IsNullOrWhiteSpace(RoleMessage))
    {
        <p class="features-save-msg @(RoleError ? "features-save-msg--error" : "")">
            <i class="fas @(RoleError ? "fa-times-circle" : "fa-check-circle")"></i>
            @RoleMessage
        </p>
    }
</section>
