@using Confirmai.Models
@using Confirmai.Enums

<section class="detail-section features-section">
    <h2 class="detail-section-title">
        <i class="fas fa-qrcode"></i> Chave PIX de Repasse (Taxa de Serviço)
    </h2>
    <p class="features-section-sub">
        Configure a chave PIX do organizador para receber o valor das partidas (após dedução da taxa de serviço).
        Esta chave será usada para envio automático via API quando pagamentos são confirmados.
    </p>

    @if (ExistingAccount != null)
    {
        <div class="feat-payout-existing">
            <div class="feat-payout-info">
                <div class="feat-payout-label">Chave cadastrada:</div>
                <div class="feat-payout-value">@ExistingAccount.PixKeyValue (@GetPixKeyTypeLabel(ExistingAccount.PixKeyType))</div>
                <div class="feat-payout-beneficiary">Beneficiário: @ExistingAccount.BeneficiaryName</div>
            </div>
            @if (!IsEditing)
            {
                <button class="feat-payout-edit-btn" type="button"
                        disabled="@IsSaving"
                        @onclick="HandleEdit">
                    <i class="fas fa-edit"></i> Editar
                </button>
            }
        </div>
    }

    @if (IsEditing || ExistingAccount == null)
    {
        <div class="feat-payout-form">
            <div class="feat-payout-field">
                <label class="feat-payout-label" for="pix-key-type">Tipo de chave:</label>
                <select id="pix-key-type"
                        class="feat-payout-select"
                        @bind="FormData.PixKeyType"
                        disabled="@IsSaving">
                    <option value="@PixKeyType.Cpf">CPF</option>
                    <option value="@PixKeyType.Cnpj">CNPJ</option>
                    <option value="@PixKeyType.Email">E-mail</option>
                    <option value="@PixKeyType.Phone">Telefone</option>
                    <option value="@PixKeyType.Random">Chave Aleatória</option>
                </select>
            </div>

            <div class="feat-payout-field">
                <label class="feat-payout-label" for="pix-key-value">Chave PIX:</label>
                <input id="pix-key-value"
                       class="feat-payout-input"
                       @bind="FormData.PixKeyValue"
                       placeholder="Digite a chave PIX"
                       disabled="@IsSaving" />
            </div>

            <div class="feat-payout-field">
                <label class="feat-payout-label" for="beneficiary-name">Nome do beneficiário:</label>
                <input id="beneficiary-name"
                       class="feat-payout-input"
                       @bind="FormData.BeneficiaryName"
                       placeholder="Nome completo ou razão social"
                       disabled="@IsSaving" />
            </div>

            <div class="feat-payout-field">
                <label class="feat-payout-label" for="beneficiary-cpf">CPF do beneficiário:</label>
                <input id="beneficiary-cpf"
                       class="feat-payout-input"
                       @bind="FormData.BeneficiaryCpf"
                       placeholder="000.000.000-00"
                       disabled="@IsSaving" />
            </div>

            <div class="feat-payout-field">
                <label class="feat-payout-label" for="bank-account-number">Número da conta bancária:</label>
                <input id="bank-account-number"
                       class="feat-payout-input"
                       @bind="FormData.BankAccountNumber"
                       placeholder="Número da conta (sem dígito)"
                       disabled="@IsSaving" />
            </div>

            <div class="feat-payout-actions">
                <button class="feat-payout-test-btn" type="button"
                        disabled="@IsSaving"
                        @onclick="FillTestData">
                    <i class="fas fa-flask"></i> Dados de teste
                </button>
                @if (ExistingAccount != null)
                {
                    <button class="feat-payout-cancel-btn" type="button"
                            disabled="@IsSaving"
                            @onclick="HandleCancel">
                        <i class="fas fa-times"></i> Cancelar
                    </button>
                }
                <button class="feat-payout-save-btn" type="button"
                        disabled="@IsSaving"
                        @onclick="HandleSave">
                    <i class="fas fa-save"></i> @(IsSaving ? "Salvando…" : "Salvar")
                </button>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <p class="features-save-msg @(IsError ? "features-save-msg--error" : "")">
            <i class="fas @(IsError ? "fa-times-circle" : "fa-check-circle")"></i>
            @Message
        </p>
    }
</section>
