@using Confirmai.Models
@using Confirmai.Enums
@using Confirmai.Services.Core
@inject UiTextService Ui

<section class="settings-section feat--payments">
    <div class="settings-section-head">
        <span class="feat-icon"><i class="fas fa-qrcode"></i></span>
        <div>
            <h2 class="settings-section-title">@Ui["Group.PayoutTitle"]</h2>
            <p class="settings-section-sub">@Ui["Group.PayoutSub"]</p>
        </div>
    </div>

    @if (ExistingAccount != null)
    {
        <div class="feat-payout-existing">
            <div class="feat-payout-info">
                <div class="feat-payout-label">@Ui["Group.PayoutRegistered"]</div>
                <div class="feat-payout-value">@ExistingAccount.PixKeyValue (@GetPixKeyTypeLabel(ExistingAccount.PixKeyType))</div>
                <div class="feat-payout-beneficiary">@Ui.Get("Group.PayoutBeneficiary", ExistingAccount.BeneficiaryName)</div>
            </div>
            @if (!IsEditing)
            {
                <button class="btn btn-secondary btn-sm" type="button"
                        disabled="@IsSaving"
                        @onclick="HandleEdit">
                    <i class="fas fa-edit"></i> @Ui["Common.Edit"]
                </button>
            }
        </div>
    }

    @if (IsEditing || ExistingAccount == null)
    {
        <div class="feat-payout-form">
            <div class="feat-payout-field">
                <label class="feat-payout-label" for="pix-key-type">@Ui["Group.PixKeyType"]</label>
                <select id="pix-key-type"
                        class="feat-payout-select"
                        @bind="FormData.PixKeyType"
                        disabled="@IsSaving">
                    <option value="@PixKeyType.Cpf">CPF</option>
                    <option value="@PixKeyType.Cnpj">CNPJ</option>
                    <option value="@PixKeyType.Email">E-mail</option>
                    <option value="@PixKeyType.Phone">@Ui["Common.Phone"]</option>
                    <option value="@PixKeyType.Random">@Ui["Group.PixKeyRandom"]</option>
                </select>
            </div>

            <div class="feat-payout-field">
                <label class="feat-payout-label" for="pix-key-value">@Ui["Group.PixKey"]</label>
                <input id="pix-key-value"
                       class="feat-payout-input"
                       @bind="FormData.PixKeyValue"
                       placeholder="@Ui["Group.PixKeyPlaceholder"]"
                       disabled="@IsSaving" />
            </div>

            <div class="feat-payout-field">
                <label class="feat-payout-label" for="beneficiary-name">@Ui["Group.BeneficiaryName"]</label>
                <input id="beneficiary-name"
                       class="feat-payout-input"
                       @bind="FormData.BeneficiaryName"
                       placeholder="@Ui["Group.BeneficiaryNamePlaceholder"]"
                       disabled="@IsSaving" />
            </div>

            <div class="feat-payout-field">
                <label class="feat-payout-label" for="beneficiary-cpf">@Ui["Group.BeneficiaryCpf"]</label>
                <input id="beneficiary-cpf"
                       class="feat-payout-input"
                       @bind="FormData.BeneficiaryCpf"
                       placeholder="000.000.000-00"
                       disabled="@IsSaving" />
            </div>

            <div class="feat-payout-field">
                <label class="feat-payout-label" for="bank-account-number">@Ui["Group.BankAccountNumber"]</label>
                <input id="bank-account-number"
                       class="feat-payout-input"
                       @bind="FormData.BankAccountNumber"
                       placeholder="@Ui["Group.BankAccountPlaceholder"]"
                       disabled="@IsSaving" />
            </div>

            <div class="feat-payout-actions">
                <button class="btn btn-ghost btn-sm" type="button"
                        disabled="@IsSaving"
                        @onclick="FillTestData">
                    <i class="fas fa-flask"></i> @Ui["Group.TestData"]
                </button>
                @if (ExistingAccount != null)
                {
                    <button class="btn btn-secondary btn-sm" type="button"
                            disabled="@IsSaving"
                            @onclick="HandleCancel">
                        <i class="fas fa-times"></i> @Ui["Common.Cancel"]
                    </button>
                }
                <button class="btn btn-primary btn-sm" type="button"
                        disabled="@IsSaving"
                        @onclick="HandleSave">
                    <i class="fas fa-save"></i> @(IsSaving ? @Ui["Group.PayoutSaving"] : @Ui["Common.Save"])
                </button>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <p class="features-save-msg @(IsError ? "features-save-msg--error" : "")">
            <i class="fas @(IsError ? "fa-times-circle" : "fa-check-circle")"></i>
            @Message
        </p>
    }
</section>
