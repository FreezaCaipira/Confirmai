<div class="detail-pix-notice">
    <span class="detail-pix-notice-icon"><i class="fas fa-exclamation-triangle"></i></span>
    <div class="detail-pix-notice-body">
        <strong>Pix do organizador não configurado</strong>
        <p>Nenhum administrador do grupo possui chave Pix cadastrada. Os participantes não terão opção de pagamento manual por Pix.</p>
        <a href="@SettingsHref" class="detail-pix-notice-link">Configurar agora →</a>
    </div>
</div>

@code {
    [Parameter] public string SettingsHref { get; set; } = string.Empty;
}
