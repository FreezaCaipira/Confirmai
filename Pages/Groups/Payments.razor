@page "/grupo/{Id:int}/pagamentos"

@attribute [Authorize]

@using System.Security.Claims
@using Confirmai.Data
@using Confirmai.Enums
@using Confirmai.Models
@using Confirmai.Services
@using Confirmai.Services.Admin
@using Confirmai.Services.Payment
@using Confirmai.Shared.Components.Groups
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop

@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider    AuthStateProvider
@inject NavigationManager              NavigationManager
@inject IJSRuntime                     JS
@inject EventNotificationService       NotificationService
@inject LogService                     LogService
@inject UiTextService                  Ui

<PageTitle>@Ui.Get("Group.PaymentsPageTitle", group?.Name ?? @Ui["Group.PageTitle"]) · Confirmai</PageTitle>

@if (isLoading)
{
    <div class="detail-loading">
        <div class="detail-skeleton">
            <div class="skeleton-header">
                <div class="skeleton-line skeleton-line--sm"></div>
                <div class="skeleton-line skeleton-line--lg"></div>
                <div class="skeleton-line skeleton-line--md"></div>
            </div>
            <div class="skeleton-section">
                <div class="skeleton-section-title"></div>
                <div class="skeleton-list">
                    <div class="skeleton-list-item">
                        <div class="skeleton-list-item-avatar"></div>
                        <div class="skeleton-list-item-content">
                            <div class="skeleton-line skeleton-line--md"></div>
                            <div class="skeleton-line skeleton-line--sm"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else if (group is null || !isAdmin)
{
    <div class="detail-not-found">
        <i class="fas fa-lock detail-not-found-icon"></i>
        <h2>@Ui["Group.NotAuthorized"]</h2>
        <a href="/grupo/@Id">← @Ui["Common.Back"]</a>
    </div>
}
else
{
    <div class="detail-page">
        <div class="detail-card">

            <header class="detail-header">
                <div class="detail-header-top">
                    <a href="/grupo/@Id" class="detail-back-link">
                        <i class="fas fa-arrow-left"></i> @Ui["Common.Back"]
                    </a>
                    <a href="/grupos" class="btn-view-groups">
                        <i class="fas fa-layer-group"></i> @Ui["Groups.Title"]
                    </a>
                </div>
                <div class="detail-header-badge">
                    <span class="detail-sport-badge">
                        @(group.Sport == Sport.Futsal ? @Ui["Group.SportFutsal"] : @Ui["Group.SportPoker"])
                    </span>
                </div>
                <h1 class="detail-title payments-title"><i class="fas fa-money-bill-wave"></i> @Ui["Group.PaymentsTitle"]</h1>
            </header>

            @* ── Tabs ──────────────────────────────────────────────── *@
            <div class="payments-tabs">
                <button class="payments-tab @(paymentTab == "delinquent" ? "payments-tab--active payments-tab--delinquent" : "")"
                        type="button"
                        @onclick="@(() => HandleTabChange("delinquent"))">
                    <i class="fas fa-exclamation-triangle"></i> @Ui["Group.PaymentsPending"]
                    @if (delinquencyList?.Count > 0)
                    {
                        <span class="payments-tab-count payments-tab-count--delinquent">@delinquencyList.Count</span>
                    }
                </button>
                <button class="payments-tab @(paymentTab == "history" ? "payments-tab--active payments-tab--history" : "")"
                        type="button"
                        @onclick="@(() => HandleTabChange("history"))">
                    <i class="fas fa-history"></i> @Ui["Group.PaymentsHistory"]
                    @if (paymentHistory?.Count > 0)
                    {
                        <span class="payments-tab-count payments-tab-count--history">@paymentHistory.Count</span>
                    }
                </button>
                @if (ShouldShowPlatformFeeTab)
                {
                    <button class="payments-tab @(paymentTab == "platformfee" ? "payments-tab--active payments-tab--platformfee" : "")"
                            type="button"
                            @onclick="@(() => HandleTabChange("platformfee"))">
                        <i class="fas fa-percentage"></i> @Ui["Group.PlatformFeeTab"]
                        @if (feeOverview is not null && feeOverview.Due > 0)
                        {
                            <span class="payments-tab-count payments-tab-count--delinquent">@feeOverview.Due.ToString("F2")</span>
                        }
                    </button>
                }
                <button class="payments-refresh-btn" type="button" @onclick="RefreshPayments" title="@Ui["Group.PaymentsRefresh"]">
                    <i class="fas @(isLoadingPayments ? "fa-spinner fa-spin" : "fa-sync-alt")"></i>
                </button>
            </div>

            @if (isLoadingPayments)
            {
                <div class="payments-loading"><i class="fas fa-spinner fa-spin"></i> @Ui["Group.PaymentsLoading"]</div>
            }
            else if (paymentTab == "history")
            {
                <div class="payments-history-filters">
                    <select @bind="historyFilterUserId">
                        <option value="">@Ui["Group.AllParticipants"]</option>
                        @foreach (var userName in paymentHistory?.Select(h => h.UserName).Distinct().OrderBy(n => n) ?? Enumerable.Empty<string>())
                        {
                            <option value="@userName">@userName</option>
                        }
                    </select>
                </div>
                @if (filteredHistory?.Count == 0)
                {
                    <div class="payments-empty">
                        <i class="fas fa-history"></i>
                        <span>@Ui["Group.NoManualPayments"]</span>
                    </div>
                }
                else
                {
                    <ul class="payments-user-list">
                        @foreach (var group in groupedHistory ?? new())
                        {
                            string userName = group.UserName;
                            bool isSelected = selectedPaymentUserId == userName;
                            <li class="payments-user-item payments-user-item--history @(isSelected ? "payments-user-item--selected" : "")"
                                @onclick="() => SelectPaymentUser(userName)">
                                <span class="payments-user-name">@group.UserName</span>
                                <div class="payments-user-meta">
                                    <span class="payments-badge payments-badge--games">@group.Entries.Count @Ui["Group.Payment" + (group.Entries.Count != 1 ? "Plural" : "Singular")]</span>
                                    <span class="payments-badge payments-badge--amount payments-badge--amount--history">R$ @group.TotalAmount.ToString("F2")</span>
                                </div>
                                <i class="fas fa-chevron-@(isSelected ? "up" : "down") payments-chevron"></i>
                            </li>

                            @if (isSelected)
                            {
                                <li class="payments-detail-panel payments-detail-panel--history">
                                    <ul class="payments-detail-list">
                                        @foreach (var entry in group.Entries)
                                        {
                                            <li class="payments-detail-item">
                                                <span class="payments-detail-date">@Ui.FormatDateTime(entry.EventDate.ToLocalTime(), "DateDefault")</span>
                                                <span class="payments-detail-price">R$ @entry.EventPrice.ToString("F2")</span>
                                                <span class="payments-detail-admin">@entry.AdminName</span>
                                                <div class="payments-detail-actions">
                                                    <button class="payments-view-proof-btn" type="button"
                                                            disabled="@(entry.HasProof && entry.ConfirmationId.HasValue ? null : true)"
                                                            @onclick="@(e => entry.HasProof && entry.ConfirmationId.HasValue ? HandleViewProof(entry.ConfirmationId.Value) : System.Threading.Tasks.Task.CompletedTask)"
                                                            title="@Ui["Group.ViewProof"]">
                                                        <i class="fas fa-camera"></i>
                                                    </button>
                                                    <a class="payments-entry-link" href="@entry.EventHref" title="@Ui["Group.ViewMatch"]">
                                                        <i class="fas fa-external-link-alt"></i>
                                                    </a>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                </li>
                            }
                        }
                    </ul>
                }
            }
            else if (delinquencyList?.Count == 0)
            {
                <div class="payments-empty">
                    <i class="fas fa-check-circle"></i>
                    <span>@Ui["Group.NoDelinquent"]</span>
                </div>
            }
            else
            {
                <ul class="payments-user-list">
                    @foreach (var d in delinquencyList ?? new())
                    {
                        string userId = d.UserId;
                        bool isSelected = selectedPaymentUserId == userId;
                        <li class="payments-user-item @(isSelected ? "payments-user-item--selected" : "")"
                            @onclick="() => SelectPaymentUser(userId)">
                            <span class="payments-user-name">@d.UserName</span>
                            <div class="payments-user-meta">
                                <span class="payments-badge payments-badge--games">@d.Entries.Count @Ui["Group.Game" + (d.Entries.Count != 1 ? "Plural" : "Singular")]</span>
                                <span class="payments-badge payments-badge--amount">R$ @d.TotalAmount.ToString("F2")</span>
                            </div>
                            <div class="payments-notify-actions" @onclick:stopPropagation="true">
                                @if (notifiedUserIds?.Contains(userId) == true)
                                {
                                    <span class="payments-notified-badge"><i class="fas fa-check"></i> @Ui["Group.Notified"]</span>
                                }
                                else if (notifyingUserId == userId)
                                {
                                    <span class="payments-notifying"><i class="fas fa-spinner fa-spin"></i></span>
                                }
                                else
                                {
                                    <button class="payments-notify-btn payments-notify-btn--email" type="button"
                                            title="@Ui["Group.NotifyEmail"]"
                                            @onclick="() => HandleNotifyDelinquencyAsync(d)">
                                        <i class="fas fa-envelope"></i>
                                    </button>
                                    <button class="payments-notify-btn payments-notify-btn--whatsapp" type="button"
                                            title="@Ui["Group.NotifyWhatsApp"]"
                                            @onclick="() => OpenWhatsAppDelinquency(d)">
                                        <i class="fab fa-whatsapp"></i>
                                    </button>
                                }
                            </div>
                            <i class="fas fa-chevron-@(isSelected ? "up" : "down") payments-chevron"></i>
                        </li>

                        @if (isSelected)
                        {
                            <li class="payments-detail-panel">
                                <div class="payments-detail-summary">
                                    <span class="payments-summary-label">@Ui["Group.PendingMatches"]</span>
                                    <span class="payments-summary-total">R$ @d.TotalAmount.ToString("F2")</span>
                                </div>
                                <ul class="payments-detail-list">
                                    @foreach (var entry in d.Entries)
                                    {
                                        <li class="payments-detail-item">
                                            <span class="payments-detail-date">@Ui.FormatDateTime(entry.EventDate.ToLocalTime(), "DateDefault")</span>
                                            <span class="payments-detail-price">R$ @entry.EventPrice.ToString("F2")</span>
                                            <div class="payments-detail-actions">
                                                <button class="payments-view-proof-btn" type="button"
                                                        disabled="@(entry.HasProof ? null : true)"
                                                        @onclick="@(e => entry.HasProof ? HandleViewProof(entry.ConfirmationId) : System.Threading.Tasks.Task.CompletedTask)"
                                                        title="@Ui["Group.ViewProof"]">
                                                    <i class="fas fa-camera"></i>
                                                </button>
                                                <a class="payments-entry-link" href="@entry.EventHref" title="@Ui["Group.ViewMatch"]">
                                                    <i class="fas fa-external-link-alt"></i>
                                                </a>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </li>
                        }
                    }
                </ul>
            }
            else if (paymentTab == "platformfee")
            {
                @if (isLoadingFee)
                {
                    <div class="payments-loading"><i class="fas fa-spinner fa-spin"></i> @Ui["Group.PaymentsLoading"]</div>
                }
                else if (feeOverview is null)
                {
                    <div class="payments-empty">
                        <i class="fas fa-exclamation-circle"></i>
                        <span>@Ui["Group.PlatformFeeMatchesEmpty"]</span>
                    </div>
                }
                else
                {
                    <section class="platform-fee-section">
                        <h2 class="platform-fee-section-title">@Ui["Group.PlatformFeeSummary"]</h2>
                        <div class="platform-fee-summary-grid">
                            <div class="platform-fee-summary-card platform-fee-summary-card--highlight">
                                <span class="platform-fee-summary-label">@Ui["Group.PlatformFeeToSettle"]</span>
                                <span class="platform-fee-summary-value">R$ @feeOverview.Due.ToString("F2")</span>
                            </div>
                            <div class="platform-fee-summary-card">
                                <span class="platform-fee-summary-label">@Ui["Group.PlatformFeeAccrued"]</span>
                                <span class="platform-fee-summary-value">R$ @feeOverview.Accrued.ToString("F2")</span>
                            </div>
                            <div class="platform-fee-summary-card platform-fee-summary-card--warning">
                                <span class="platform-fee-summary-label">@Ui["Group.PlatformFeeInAnalysis"]</span>
                                <span class="platform-fee-summary-value">R$ @feeOverview.InAnalysis.ToString("F2")</span>
                            </div>
                            <div class="platform-fee-summary-card platform-fee-summary-card--success">
                                <span class="platform-fee-summary-label">@Ui["Group.PlatformFeeSettled"]</span>
                                <span class="platform-fee-summary-value">R$ @feeOverview.Settled.ToString("F2")</span>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(feeOverview.PlatformPixKey))
                        {
                            <div class="platform-fee-pix-card">
                                <h3 class="platform-fee-pix-title">@Ui["Group.PlatformFeePlatformPix"]</h3>
                                <p class="platform-fee-pix-hint">@Ui["Group.PlatformFeePlatformPixHint"]</p>
                                <div class="platform-fee-pix-qr">
                                    <QRCode Value="@PlatformFeePixPayload" />
                                </div>
                                <div class="platform-fee-pix-key">
                                    <code class="platform-fee-pix-code">@feeOverview.PlatformPixKey</code>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="payments-empty">
                                <i class="fas fa-exclamation-circle"></i>
                                <span>@Ui["Group.PlatformFeeNoPixConfigured"]</span>
                            </div>
                        }

                        <h3 class="platform-fee-section-title">@Ui["Group.PlatformFeeMatches"]</h3>
                        @if (feeOverview.Matches.Count == 0)
                        {
                            <div class="payments-empty">
                                <i class="fas fa-check-circle"></i>
                                <span>@Ui["Group.PlatformFeeMatchesEmpty"]</span>
                            </div>
                        }
                        else
                        {
                            <table class="platform-fee-table">
                                <thead>
                                    <tr>
                                        <th>@Ui["Group.PlatformFeeMatchDate"]</th>
                                        <th>@Ui["Group.PlatformFeeMatchName"]</th>
                                        <th>@Ui["Group.PlatformFeeMatchPlayers"]</th>
                                        <th>@Ui["Group.PlatformFeeMatchFee"]</th>
                                        <th>@Ui["Group.PlatformFeeMatchStatus"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var m in feeOverview.Matches)
                                    {
                                        <tr>
                                            <td>@Ui.FormatDateTime(m.StartsAt.ToLocalTime(), "DateDefault")</td>
                                            <td>@(string.IsNullOrWhiteSpace(m.Location) ? Ui["Group.PlatformFeeMatchName"] : m.Location)</td>
                                            <td>@m.PaidPlayers</td>
                                            <td>R$ @m.FeeAmount.ToString("F2")</td>
                                            <td>
                                                <span class="platform-fee-status platform-fee-status--@(m.Status == PlatformFeeMatchStatus.Pago ? "paid" : "pending")">
                                                    @(m.Status == PlatformFeeMatchStatus.Pago ? Ui["Group.PlatformFeeStatusPaid"] : Ui["Group.PlatformFeeStatusPending"])
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }

                        @if (!string.IsNullOrWhiteSpace(feeOverview.PlatformPixKey) && feeOverview.Due > 0)
                        {
                            <div class="platform-fee-submit-card">
                                <h3 class="platform-fee-section-title">@Ui["Group.PlatformFeeSubmit"]</h3>
                                @if (!string.IsNullOrWhiteSpace(settlementSuccess))
                                {
                                    <p class="platform-fee-success"><i class="fas fa-check-circle"></i> @settlementSuccess</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(settlementError))
                                {
                                    <p class="platform-fee-error"><i class="fas fa-exclamation-circle"></i> @settlementError</p>
                                }
                                <label class="platform-fee-label">@Ui["Group.PlatformFeeSubmitAmount"]</label>
                                <input type="number" class="platform-fee-input" step="0.01" min="0.01" @bind="settlementAmount" />
                                <label class="platform-fee-label">@Ui["Group.PlatformFeeSubmitProof"]</label>
                                <InputFile OnChange="SubmitSettlementAsync" accept="image/jpeg,image/png,image/webp" />
                                @if (isSubmittingSettlement)
                                {
                                    <p class="payments-loading"><i class="fas fa-spinner fa-spin"></i> @Ui["Group.PlatformFeeSubmitting"]</p>
                                }
                            </div>
                        }

                        <h3 class="platform-fee-section-title">@Ui["Group.PlatformFeeHistory"]</h3>
                        @if (feeOverview.Settlements.Count == 0)
                        {
                            <div class="payments-empty">
                                <i class="fas fa-history"></i>
                                <span>@Ui["Group.PlatformFeeHistoryEmpty"]</span>
                            </div>
                        }
                        else
                        {
                            <table class="platform-fee-table">
                                <thead>
                                    <tr>
                                        <th>@Ui["Group.PlatformFeeHistoryDate"]</th>
                                        <th>@Ui["Group.PlatformFeeHistoryAmount"]</th>
                                        <th>@Ui["Group.PlatformFeeHistoryStatus"]</th>
                                        <th>@Ui["Group.PlatformFeeHistoryReviewedAt"]</th>
                                        <th>@Ui["Group.PlatformFeeHistoryNote"]</th>
                                        <th>@Ui["Group.PlatformFeeHistoryProof"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in feeOverview.Settlements)
                                    {
                                        <tr>
                                            <td>@Ui.FormatDateTime(s.SubmittedAt.ToLocalTime(), "DateDefault")</td>
                                            <td>R$ @s.Amount.ToString("F2")</td>
                                            <td>
                                                <span class="platform-fee-status platform-fee-status--@(s.Status == PlatformFeeSettlementStatus.Pago ? "paid" : s.Status == PlatformFeeSettlementStatus.Rejeitado ? "rejected" : "pending")">
                                                    @(s.Status == PlatformFeeSettlementStatus.Pago ? Ui["Group.PlatformFeeStatusPaid"] : s.Status == PlatformFeeSettlementStatus.Rejeitado ? Ui["Group.PlatformFeeHistoryNote"] : Ui["Group.PlatformFeeStatusPending"])
                                                </span>
                                            </td>
                                            <td>@(s.ReviewedAt.HasValue ? Ui.FormatDateTime(s.ReviewedAt.Value.ToLocalTime(), "DateDefault") : "—")</td>
                                            <td>@(string.IsNullOrWhiteSpace(s.ReviewNote) ? "—" : s.ReviewNote)</td>
                                            <td>
                                                @if (s.HasProof)
                                                {
                                                    <button class="payments-view-proof-btn" type="button"
                                                            @onclick="() => ViewSettlementProof(s.Id)"
                                                            title="@Ui["Group.PlatformFeeHistoryProof"]">
                                                        <i class="fas fa-camera"></i>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </section>
                }
            }

        </div>
    </div>

    @if (viewingProofConfirmationId.HasValue)
    {
        <div class="payment-proof-viewer" @onclick="() => viewingProofConfirmationId = null">
            <div class="payment-proof-viewer-content" @onclick:stopPropagation="true">
                <button class="payment-proof-viewer-close" type="button" @onclick="() => viewingProofConfirmationId = null">
                    <i class="fas fa-times"></i>
                </button>
                <img src="/api/pix-proof/@viewingProofConfirmationId"
                     class="payment-proof-img"
                     alt="@Ui["Group.ProofAlt"]" />
            </div>
        </div>
    }

    @if (viewingSettlementProofId.HasValue)
    {
        <div class="payment-proof-viewer" @onclick="() => viewingSettlementProofId = null">
            <div class="payment-proof-viewer-content" @onclick:stopPropagation="true">
                <button class="payment-proof-viewer-close" type="button" @onclick="() => viewingSettlementProofId = null">
                    <i class="fas fa-times"></i>
                </button>
                <img src="/api/fee-settlement-proof/@viewingSettlementProofId"
                     class="payment-proof-img"
                     alt="@Ui["Group.PlatformFeeProofAlt"]" />
            </div>
        </div>
    }
}

