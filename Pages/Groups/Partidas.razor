@page "/grupo/{Id:int}/partidas"

@attribute [AllowAnonymous]

@using System.Security.Claims
@using Confirmai.Data
@using Confirmai.Enums
@using Confirmai.Models
@using Confirmai.Services
@using Confirmai.Shared.Components.Groups
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore

@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider    AuthStateProvider
@inject NavigationManager              NavigationManager
@inject IConfiguration                 Config
@inject UiTextService                  Ui

<PageTitle>@Ui.Get("Group.PartidasPageTitle", group?.Name ?? @Ui["Group.PageTitle"]) · Confirmai</PageTitle>

@if (isLoading)
{
    <div class="detail-loading">
        <div class="detail-skeleton">
            <div class="skeleton-header">
                <div class="skeleton-line skeleton-line--sm"></div>
                <div class="skeleton-line skeleton-line--lg"></div>
                <div class="skeleton-line skeleton-line--md"></div>
            </div>
            <div class="skeleton-section">
                <div class="skeleton-section-title"></div>
                <div class="skeleton-list">
                    <div class="skeleton-list-item">
                        <div class="skeleton-list-item-avatar"></div>
                        <div class="skeleton-list-item-content">
                            <div class="skeleton-line skeleton-line--md"></div>
                            <div class="skeleton-line skeleton-line--sm"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else if (group is null)
{
    <div class="detail-not-found">
        <h2>@Ui["Groups.NotFound"]</h2>
        <a href="/">← @Ui["Common.Back"]</a>
    </div>
}
else
{
    var isAdmin  = currentUserId is not null &&
                   group.Members.Any(m => m.UserId == currentUserId && m.Role == GroupMemberRole.Admin);
    var newEventHref = group.Sport == Sport.Futsal
        ? $"/futsal/create?groupId={group.Id}"
        : $"/poker/create?groupId={group.Id}";

    <div class="detail-page">
        <div class="detail-card">

            <header class="detail-header">
                <div class="detail-header-top">
                    <a href="/grupo/@group.Id" class="detail-back-link">
                        <i class="fas fa-arrow-left"></i> @Ui["Common.Back"]
                    </a>
                    <a href="/grupos" class="btn-view-groups">
                        <i class="fas fa-layer-group"></i> @Ui["Groups.Title"]
                    </a>
                </div>
                <div class="detail-header-title-row">
                    <span class="detail-header-subtitle">
                        @(group.Sport == Sport.Futsal ? @Ui["Group.SportFutsal"] : @Ui["Group.SportPoker"]) — @Ui["Groups.Partidas"] <span class="detail-events-year">@eventsYear</span>
                    </span>
                </div>
                <h1 class="detail-title">@group.Name</h1>
            </header>

            <section class="detail-section">
                @if (displayedEvents.Any(e => e.RachaScheduleId.HasValue))
                {
                    <div class="events-recurring-notice">
                        <i class="fas fa-sync-alt"></i>
                        <span>@Ui["Group.RecurringNotice"]</span>
                    </div>
                }
                <div class="detail-events-tabs">
                    <div class="detail-events-tabs-left">
                        <button class="detail-events-tab @(!showPastEvents ? "active" : string.Empty)"
                                type="button"
                                @onclick="() => { showPastEvents = false; showAllUpcoming = false; }">
                            <i class="fas fa-bolt"></i> @Ui["Groups.Proximas"] (@upcomingEvents.Count)
                        </button>
                        <button class="detail-events-tab @(showPastEvents ? "active" : string.Empty)"
                                type="button"
                                @onclick="() => showPastEvents = true">
                            <i class="fas fa-history"></i> @Ui["Groups.Realizadas"] (@pastEvents.Count)
                        </button>
                    </div>
                    <div class="detail-events-tabs-right">
                        @if (isAdmin)
                        {
                            @if (group.Sport == Sport.Futsal)
                            {
                                <a href="/futsal/schedule?groupId=@group.Id" class="groups-create-btn groups-create-btn--semanais detail-events-create-btn">
                                    <i class="fas fa-sync-alt"></i> @Ui["Groups.Semanais"]
                                </a>
                            }
                            <a href="@newEventHref" class="groups-create-btn detail-events-create-btn">
                                <i class="fas fa-plus"></i> @Ui["Groups.NovaPartida"]
                            </a>
                        }
                    </div>
                </div>
                <GroupDetailEvents
                    Group="@group"
                    DisplayedEvents="@displayedEvents"
                    UpcomingEvents="@upcomingEvents"
                    ShowPastEvents="@showPastEvents"
                    EventNumbers="@eventNumbers"
                    IsAdmin="@isAdmin"
                    NewEventHref="@newEventHref" />
                @if (hasMoreUpcoming || (!showPastEvents && showAllUpcoming && upcomingEvents.Count > UpcomingPreviewCount))
                {
                    <div class="events-expand-row">
                        <button class="events-expand-btn" type="button" @onclick="ToggleUpcomingExpansion">
                            @if (showAllUpcoming)
                            {
                                <i class="fas fa-chevron-up"></i> @Ui["Groups.VerMenos"]
                            }
                            else
                            {
                                <i class="fas fa-chevron-down"></i>
                                <span>@Ui["Groups.VerMais"] (@(upcomingEvents.Count - UpcomingPreviewCount))</span>
                            }
                        </button>
                    </div>
                }
            </section>

        </div>
    </div>
}
