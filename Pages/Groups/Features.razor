@page "/grupo/{Id:int}/configuracoes"

@attribute [Authorize]

@using System.Security.Claims
@using Confirmai.Data
@using Confirmai.Enums
@using Confirmai.Models
@using Confirmai.Services
@using Confirmai.Pages.Groups.Components
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore

@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider    AuthStateProvider
@inject NavigationManager              NavigationManager
@inject LogService                     LogService
@inject EventPaymentGatewayFactory     EventGatewayFactory

<PageTitle>Configurações — @(group?.Name ?? "Grupo") · Confirmai</PageTitle>

@if (isLoading)
{
    <div class="detail-loading">
        <div class="detail-skeleton">
            <div class="skeleton-header">
                <div class="skeleton-line skeleton-line--sm"></div>
                <div class="skeleton-line skeleton-line--lg"></div>
                <div class="skeleton-line skeleton-line--md"></div>
            </div>
            <div class="skeleton-section">
                <div class="skeleton-section-title"></div>
                <div class="skeleton-list">
                    <div class="skeleton-list-item">
                        <div class="skeleton-list-item-avatar"></div>
                        <div class="skeleton-list-item-content">
                            <div class="skeleton-line skeleton-line--md"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else if (group is null || !isAdmin)
{
    <div class="detail-not-found">
        <i class="fas fa-lock detail-not-found-icon"></i>
        <h2>Acesso não autorizado.</h2>
        <a href="/">← Voltar</a>
    </div>
}
else
{
    var adminMembers   = members.Where(m => m.Role == GroupMemberRole.Admin).ToList();
    var pixAdmins      = adminMembers.Where(m => !string.IsNullOrWhiteSpace(m.User?.PixKey)).ToList();
    var canManageAdminRoles = isCreator;

    <div class="detail-page">
        <div class="detail-card">

            <header class="detail-header">
                <div class="detail-header-top">
                    <a href="/grupo/@group.Id" class="detail-back-link">
                        <i class="fas fa-arrow-left"></i> Voltar
                    </a>
                </div>
                <div class="detail-header-content">
                    <span class="detail-sport-badge">
                        @(group.Sport == Sport.Futsal ? "⚽ Futsal" : "🃏 Poker")
                    </span>
                    <h1 class="detail-title">Configurações do grupo</h1>
                </div>
            </header>

            @* ── Pagamentos & Funcionalidades ─────────────────────────── *@
            <FeaturesToggles
                Group="@group"
                IsSaving="@isSaving"
                SaveMessage="@saveMessage"
                SaveError="@saveError"
                AvailableGatewayOptions="@availableGatewayOptions"
                OnTogglePostMatchRanking="@TogglePostMatchRankingCallback"
                OnToggleBestPlayerVoting="@ToggleBestPlayerVotingCallback"
                OnTogglePaymentGateways="@TogglePaymentGatewaysCallback" />

            <hr class="detail-divider">

            @* ── Configuração de Pagamento (condicional) ──────────────── *@
            @if (group.EnablePaymentGateways)
            {
                <PayoutAccountEditor
                    ExistingAccount="@payoutAccount"
                    IsSaving="@isSavingPayout"
                    Message="@payoutMessage"
                    IsError="@payoutError"
                    OnSave="@SavePayoutAccountCallback" />
            }
            else
            {
                <PixReceiverSelector
                    PixAdmins="@pixAdmins"
                    SelectedPixReceiverId="@selectedPixReceiverId"
                    IsSaving="@isSavingPix"
                    Message="@pixMessage"
                    IsError="@pixError"
                    OnSavePixReceiver="@SavePixReceiverCallback" />
            }

            <hr class="detail-divider">

            @* ── Membros & Permissões ───────────────────────────────── *@
            <MembersManager
                Members="@members"
                CurrentUserId="@currentUserId"
                CreatedByUserId="@(group?.CreatedByUserId ?? "")"
                CanManageAdminRoles="@canManageAdminRoles"
                AdminCount="@(members.Count(m => m.Role == GroupMemberRole.Admin))"
                IsSavingRole="@isSavingRole"
                RoleMessage="@roleMessage"
                RoleError="@roleError"
                ConfirmPromoteMemberId="@confirmPromoteMemberId"
                OnSetMemberRole="@SetMemberRoleCallback"
                OnInitiatePromote="@InitiatePromoteCallback"
                OnCancelPromote="@CancelPromoteCallback" />

        </div>
    </div>
}

