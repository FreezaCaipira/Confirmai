@page "/grupos"

@attribute [Authorize]

@using System.Security.Claims
@using Confirmai.Data
@using Confirmai.Enums
@using Confirmai.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore

@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider    AuthStateProvider
@inject NavigationManager              NavigationManager

<PageTitle>Grupos — Confirmai</PageTitle>

<div class="groups-page">

    @if (isLoading)
    {
        <div class="detail-loading">Carregando…</div>
    }
    else
    {
        <section class="groups-block">
            <div class="groups-block-header">
                <h2 class="groups-title"><i class="fas fa-sign-in-alt"></i> Entrar em um grupo</h2>
                <p class="groups-block-sub">Use um código de convite ou crie um novo grupo para começar.</p>
            </div>

            <div class="groups-entry-stack">
                <div class="join-code-section">
                    <p class="join-code-label"><i class="fas fa-key"></i> Entrar com código de convite</p>
                    <div class="join-code-row">
                        <input class="input join-code-input" type="text" maxlength="8"
                               placeholder="Ex: ABCD1234"
                               @bind="joinCode" @bind:event="oninput" />
                        <button class="confirm-btn" type="button" @onclick="JoinWithCode"
                                disabled="@(joinCode.Trim().Length == 0)">
                            Entrar
                        </button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(joinCodeError))
                    {
                        <p class="validation-message">@joinCodeError</p>
                    }
                </div>

                <div class="groups-entry-divider"><span>ou</span></div>

                <a href="/grupos/criar" class="groups-create-btn">
                    <i class="fas fa-plus"></i> Criar novo grupo
                </a>
            </div>
        </section>

        <section class="groups-block">
            <div class="groups-block-header">
                <h2 class="groups-title"><i class="fas fa-layer-group"></i> Meus grupos</h2>
            </div>

            @if (groups.Count == 0)
            {
                <div class="groups-empty">
                    <i class="fas fa-users-slash groups-empty-icon"></i>
                    <p>Você ainda não faz parte de nenhum grupo.</p>
                    <p class="groups-empty-sub">Assim que entrar em um grupo, ele aparecerá aqui.</p>
                </div>
            }
            else
            {
                <div class="groups-grid">
                    @foreach (var g in groups)
                    {
                        var isAdmin = g.Members.Any(m => m.UserId == currentUserId && m.Role == GroupMemberRole.Admin);
                        var nextEvent = g.Events
                            .Where(e => e.IsActive && e.StartsAt > DateTime.UtcNow)
                            .OrderBy(e => e.StartsAt)
                            .FirstOrDefault();
                        <a class="group-card" href="/grupo/@g.Id">
                            <div class="group-card-top">
                                <span class="group-card-sport">
                                    @(g.Sport == Sport.Futsal ? "⚽ Futsal" : "🃏 Poker")
                                </span>
                                <div class="group-card-badges">
                                    @if (isAdmin)
                                    {
                                        <span class="player-tag player-tag--admin">admin</span>
                                    }
                                    @if (!g.IsActive)
                                    {
                                        <span class="player-tag">inativo</span>
                                    }
                                </div>
                            </div>
                            <h2 class="group-card-name">@g.Name</h2>
                            @if (!string.IsNullOrWhiteSpace(g.City))
                            {
                                <p class="group-card-location">
                                    <i class="fas fa-map-marker-alt"></i> @g.City/@g.StateCode
                                </p>
                            }
                            <div class="group-card-meta">
                                <span><i class="fas fa-users"></i> @g.Members.Count membro@(g.Members.Count != 1 ? "s" : "")</span>
                                @if (nextEvent is not null)
                                {
                                    <span><i class="fas fa-calendar-alt"></i> @nextEvent.StartsAt.ToLocalTime().ToString("dd/MM HH:mm")</span>
                                }
                                else
                                {
                                    <span class="group-card-no-event"><i class="fas fa-calendar-times"></i> Sem partida agendada</span>
                                }
                            </div>
                        </a>
                    }
                </div>
            }
        </section>
    }
</div>

@code {
    private string?      currentUserId = null;
    private List<Group>  groups        = new();
    private bool         isLoading     = true;

    private string       joinCode      = string.Empty;
    private string       joinCodeError = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
        await LoadGroups();
    }

    private async Task LoadGroups()
    {
        if (currentUserId is null) return;
        isLoading = true;
        await using var db = await DbFactory.CreateDbContextAsync();

        groups = await db.Groups
            .Where(g => g.Members.Any(m => m.UserId == currentUserId))
            .Include(g => g.Members)
            .Include(g => g.Events.Where(e => e.IsActive && e.StartsAt > DateTime.UtcNow))
            .OrderByDescending(g => g.Members.Any(m => m.UserId == currentUserId && m.Role == GroupMemberRole.Admin))
            .ThenBy(g => g.Name)
            .AsSplitQuery()
            .ToListAsync();

        isLoading = false;
    }

    private void JoinWithCode()
    {
        var code = joinCode.Trim().ToUpperInvariant();
        if (string.IsNullOrWhiteSpace(code))
        {
            joinCodeError = "Digite o código de convite.";
            return;
        }
        NavigationManager.NavigateTo($"/convite/{code}");
    }
}
