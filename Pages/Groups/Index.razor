@page "/"
@page "/grupos"

@attribute [Authorize]

@using System.Security.Claims
@using Confirmai.Data
@using Confirmai.Enums
@using Confirmai.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore

@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider    AuthStateProvider
@inject NavigationManager              NavigationManager

<PageTitle>Grupos — Confirmai</PageTitle>

<div class="groups-page">

    @if (isLoading)
    {
        <div class="detail-loading">Carregando…</div>
    }
    else if (groups.Count == 0)
    {
        <section class="groups-block">
            <div class="groups-block-header">
                <h2 class="groups-title"><i class="fas fa-sign-in-alt"></i> Entrar em um grupo</h2>
                <p class="groups-block-sub">Use um código de convite ou crie um novo grupo para começar.</p>
            </div>

            <div class="groups-entry-stack">
                <div class="join-code-section">
                    <p class="join-code-label"><i class="fas fa-key"></i> Entrar com código de convite</p>
                    <div class="join-code-row">
                        <input class="input join-code-input" type="text" maxlength="8"
                               placeholder="Ex: ABCD1234"
                               @bind="joinCode" @bind:event="oninput" />
                        <button class="confirm-btn" type="button" @onclick="JoinWithCode"
                                disabled="@(joinCode.Trim().Length == 0)">
                            Entrar
                        </button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(joinCodeError))
                    {
                        <p class="validation-message">@joinCodeError</p>
                    }
                </div>

                <div class="groups-entry-divider"><span>ou</span></div>

                <a href="/grupos/criar" class="groups-create-btn">
                    <i class="fas fa-plus"></i> Criar novo grupo
                </a>
            </div>
        </section>
    }
    else
    {
        <section class="groups-block">
            <div class="groups-block-header">
                <h2 class="groups-title"><i class="fas fa-layer-group"></i> Meus grupos</h2>
            </div>

            <div class="groups-grid">
                @foreach (var g in groups)
                {
                    var isAdmin = IsCurrentUserAdmin(g);
                    var pendingCount = GetPendingRequestsCount(g.Id);
                    var hasPending = isAdmin && pendingCount > 0;
                    var needsPix = GroupNeedsPixSetup(g);
                    var nextEvent = g.Events
                        .Where(e => e.IsActive && e.StartsAt > DateTime.UtcNow)
                        .OrderBy(e => e.StartsAt)
                        .FirstOrDefault();
                    <a class="group-card @(hasPending || needsPix ? "group-card--action-required" : "")" href="/grupo/@g.Id">
                        <div class="group-card-top">
                            <span class="group-card-sport">
                                @(g.Sport == Sport.Futsal ? "⚽ Futsal" : "🃏 Poker")
                            </span>
                            <div class="group-card-badges">
                                @if (isAdmin)
                                {
                                    <span class="player-tag player-tag--admin">admin</span>
                                    @if (hasPending)
                                    {
                                        <span class="player-tag player-tag--pending-requests">@pendingCount pendente@(pendingCount == 1 ? string.Empty : "s")</span>
                                    }
                                    @if (needsPix)
                                    {
                                        <span class="player-tag player-tag--pix-missing" title="Nenhum admin tem chave Pix cadastrada">⚠ Pix pendente</span>
                                    }
                                }
                                @if (!g.IsActive)
                                {
                                    <span class="player-tag">inativo</span>
                                }
                            </div>
                        </div>
                        <h2 class="group-card-name">@g.Name</h2>
                        @if (!string.IsNullOrWhiteSpace(g.City))
                        {
                            <p class="group-card-location">
                                <i class="fas fa-map-marker-alt"></i> @g.City/@g.StateCode
                            </p>
                        }
                        <div class="group-card-meta">
                            <span><i class="fas fa-users"></i> @g.Members.Count membro@(g.Members.Count != 1 ? "s" : "")</span>
                            @if (nextEvent is not null)
                            {
                                <span><i class="fas fa-calendar-alt"></i> @nextEvent.StartsAt.ToLocalTime().ToString("dd/MM HH:mm")</span>
                            }
                            else
                            {
                                <span class="group-card-no-event"><i class="fas fa-calendar-times"></i> Sem partida agendada</span>
                            }
                        </div>
                    </a>
                }
            </div>
        </section>

        <hr class="detail-divider" style="max-width:860px;margin:0 auto 1.25rem;" />

        <section class="groups-block groups-block--secondary">
            <div class="groups-block-header">
                <h2 class="groups-title groups-title--sm"><i class="fas fa-sign-in-alt"></i> Entrar em outro grupo</h2>
            </div>

            <div class="groups-entry-stack">
                <div class="join-code-section">
                    <p class="join-code-label"><i class="fas fa-key"></i> Entrar com código de convite</p>
                    <div class="join-code-row">
                        <input class="input join-code-input" type="text" maxlength="8"
                               placeholder="Ex: ABCD1234"
                               @bind="joinCode" @bind:event="oninput" />
                        <button class="confirm-btn" type="button" @onclick="JoinWithCode"
                                disabled="@(joinCode.Trim().Length == 0)">
                            Entrar
                        </button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(joinCodeError))
                    {
                        <p class="validation-message">@joinCodeError</p>
                    }
                </div>

                <div class="groups-entry-divider"><span>ou</span></div>

                <a href="/grupos/criar" class="groups-create-btn">
                    <i class="fas fa-plus"></i> Criar novo grupo
                </a>
            </div>
        </section>
    }
</div>

@code {
    private string?      currentUserId = null;
    private List<Group>  groups        = new();
    private bool         isLoading     = true;
    private Dictionary<int, int> pendingJoinRequestsByGroup = new();

    private string       joinCode      = string.Empty;
    private string       joinCodeError = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
        await LoadGroups();
    }

    private async Task LoadGroups()
    {
        if (currentUserId is null) return;
        isLoading = true;
        await using var db = await DbFactory.CreateDbContextAsync();

        groups = await db.Groups
            .Where(g => g.Members.Any(m => m.UserId == currentUserId))
            .Include(g => g.Members)
                .ThenInclude(m => m.User)
            .Include(g => g.Events.Where(e => e.IsActive && e.StartsAt > DateTime.UtcNow))
            .OrderByDescending(g => g.Members.Any(m => m.UserId == currentUserId && m.Role == GroupMemberRole.Admin))
            .ThenBy(g => g.Name)
            .AsSplitQuery()
            .ToListAsync();

        var adminGroupIds = groups
            .Where(IsCurrentUserAdmin)
            .Select(g => g.Id)
            .ToList();

        pendingJoinRequestsByGroup = adminGroupIds.Count == 0
            ? new Dictionary<int, int>()
            : await db.GroupJoinRequests
                .Where(r => adminGroupIds.Contains(r.GroupId) && r.Status == JoinRequestStatus.Pending)
                .GroupBy(r => r.GroupId)
                .Select(g => new { GroupId = g.Key, Count = g.Count() })
                .ToDictionaryAsync(x => x.GroupId, x => x.Count);

        groups = groups
            .OrderByDescending(g => GetPendingRequestsCount(g.Id) > 0)
            .ThenByDescending(IsCurrentUserAdmin)
            .ThenBy(g => g.Name)
            .ToList();

        isLoading = false;
    }

    private bool IsCurrentUserAdmin(Group group)
        => currentUserId is not null && group.Members.Any(m => m.UserId == currentUserId && m.Role == GroupMemberRole.Admin);

    private int GetPendingRequestsCount(int groupId)
        => pendingJoinRequestsByGroup.TryGetValue(groupId, out var pendingCount) ? pendingCount : 0;

    private bool GroupNeedsPixSetup(Group group)
        => IsCurrentUserAdmin(group)
        && !group.Members.Any(m => m.Role == GroupMemberRole.Admin && !string.IsNullOrWhiteSpace(m.User?.PixKey));

    private void JoinWithCode()
    {
        var code = joinCode.Trim().ToUpperInvariant();
        if (string.IsNullOrWhiteSpace(code))
        {
            joinCodeError = "Digite o código de convite.";
            return;
        }
        NavigationManager.NavigateTo($"/convite/{code}");
    }
}
