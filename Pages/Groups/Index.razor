@page "/grupos"

@attribute [Authorize]

@using System.Security.Claims
@using Confirmai.Data
@using Confirmai.Enums
@using Confirmai.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using Confirmai.Shared.Components.Groups
@using Confirmai.Services.Core
@inject UiTextService Ui


<PageTitle>@Ui["Groups.Title"] — Confirmai</PageTitle>

<div class="detail-page">
    <div class="hub-stack">

    @if (isLoading)
    {
        <div class="detail-loading">
            <div class="detail-skeleton">
                <div class="skeleton-section">
                    <div class="skeleton-list">
                        <div class="skeleton-list-item">
                            <div class="skeleton-list-item-avatar"></div>
                            <div class="skeleton-list-item-content">
                                <div class="skeleton-line skeleton-line--md skeleton-w-200"></div>
                                <div class="skeleton-line skeleton-line--sm skeleton-w-150"></div>
                            </div>
                        </div>
                        <div class="skeleton-list-item">
                            <div class="skeleton-list-item-avatar"></div>
                            <div class="skeleton-list-item-content">
                                <div class="skeleton-line skeleton-line--md skeleton-w-200"></div>
                                <div class="skeleton-line skeleton-line--sm skeleton-w-150"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (groups.Count == 0 && myPendingRequests.Count == 0)
    {
        <section class="panel">
            <NoGroupsHint />
            <GroupEntryPanel />
        </section>
    }
    else
    {
        @if (groups.Count > 0)
        {
            <section class="panel">
                <div class="panel-head">
                    <h2 class="panel-title">
                        <i class="fas fa-layer-group"></i> @Ui["Groups.MyGroups"]
                    </h2>
                    <span class="panel-count">@groups.Count</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(leaveError))
                {
                    <p class="group-leave-error" role="alert">@leaveError</p>
                }

                <ul class="group-rows">
                    @foreach (var g in groups)
                    {
                        var isAdmin = IsCurrentUserAdmin(g);
                        var pendingCount = GetPendingRequestsCount(g.Id);
                        var needsPix = GroupNeedsPixSetup(g);
                        <li class="group-row" data-test-is-admin="@isAdmin.ToString()" data-test-pending-count="@pendingCount">
                            <span class="group-row-icon">
                                <i class="fas @(g.Sport == Sport.Futsal ? "fa-futbol" : "fa-cards")"></i>
                            </span>
                            <span class="group-row-body">
                                <span class="group-row-name">@g.Name</span>
                                <span class="group-row-meta">
                                    @if (!string.IsNullOrWhiteSpace(g.City))
                                    {
                                        <span><i class="fas fa-map-marker-alt"></i> @g.City@(!string.IsNullOrWhiteSpace(g.StateCode) ? $"/{g.StateCode}" : "")</span>
                                    }
                                    <span><i class="fas fa-users"></i> @g.Members.Count @Ui["Group.Member" + (g.Members.Count != 1 ? "s" : "")]</span>
                                </span>
                            </span>
                            <span class="group-row-badges">
                                @if (isAdmin)
                                {
                                    <span class="status-badge status-badge--accent">@Ui["Group.Admin"]</span>
                                }
                                @if (isAdmin && pendingCount > 0)
                                {
                                    <span class="status-badge status-badge--accent">
                                        @pendingCount @Ui["Group.Pending" + (pendingCount == 1 ? "Singular" : "Plural")]
                                    </span>
                                }
                                @if (needsPix)
                                {
                                    <span class="status-badge status-badge--pending" title="@Ui["Group.PixPendingTitle"]">@Ui["Group.PixPending"]</span>
                                }
                                @if (!g.IsActive)
                                {
                                    <span class="status-badge">@Ui["Group.InactiveTag"]</span>
                                }
                            </span>
                            <span class="group-row-actions">
                                <a href="/grupo/@g.Id" class="btn btn-secondary btn-sm">@Ui["Groups.Open"]</a>
                                <span class="group-menu">
                                    <button class="btn btn-ghost btn-sm" type="button"
                                            aria-label="@Ui["Group.MemberActions"]"
                                            @onclick="() => ToggleMenu(g.Id)" @onclick:stopPropagation="true">
                                        <i class="fas fa-ellipsis-h"></i>
                                    </button>
                                    @if (openMenuGroupId == g.Id)
                                    {
                                        <span class="group-menu-pop">
                                            @if (isAdmin && !string.IsNullOrWhiteSpace(g.InviteCode))
                                            {
                                                <button class="group-menu-item" type="button"
                                                        @onclick="() => CopyInvite(g)">
                                                    <i class="fas fa-copy"></i>
                                                    @(copiedGroupId == g.Id ? Ui["Group.Copied"] : Ui["Group.CopyInvite"])
                                                </button>
                                            }
                                            @if (confirmLeaveGroupId == g.Id)
                                            {
                                                <button class="group-menu-item group-menu-item--danger" type="button"
                                                        disabled="@isLeaving"
                                                        @onclick="() => LeaveGroup(g)">
                                                    <i class="fas fa-sign-out-alt"></i> @Ui["Group.LeaveGroupConfirm"]
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="group-menu-item group-menu-item--danger" type="button"
                                                        @onclick="() => confirmLeaveGroupId = g.Id">
                                                    <i class="fas fa-sign-out-alt"></i> @Ui["Group.LeaveGroup"]
                                                </button>
                                            }
                                        </span>
                                    }
                                </span>
                            </span>
                        </li>
                    }
                </ul>
            </section>
        }

        @if (myPendingRequests.Count > 0)
        {
            <section class="panel">
                <div class="panel-head">
                    <h2 class="panel-title">
                        <i class="fas fa-hourglass-half"></i> @Ui["Groups.PendingRequests"]
                    </h2>
                    <span class="panel-count">@myPendingRequests.Count</span>
                </div>
                <ul class="group-rows">
                    @foreach (var req in myPendingRequests)
                    {
                        <li class="group-row">
                            <span class="group-row-icon">
                                <i class="fas @(req.Group?.Sport == Sport.Poker ? "fa-cards" : "fa-futbol")"></i>
                            </span>
                            <span class="group-row-body">
                                <span class="group-row-name">@(req.Group?.Name ?? $"#{req.GroupId}")</span>
                                <span class="group-row-meta">
                                    <span>@Ui.FormatDateTime(req.RequestedAt.ToLocalTime(), "DateDefault")</span>
                                </span>
                            </span>
                            <span class="group-row-badges">
                                <span class="status-badge status-badge--accent">@Ui["Group.AwaitingApproval"]</span>
                            </span>
                            <span class="group-row-actions">
                                <button class="btn btn-ghost btn-sm" type="button"
                                        disabled="@cancellingRequestId.HasValue"
                                        @onclick="() => CancelMyRequest(req.Id)">
                                    <i class="fas fa-times"></i> @Ui["Group.CancelRequest"]
                                </button>
                            </span>
                        </li>
                    }
                </ul>
            </section>
        }

        <section class="panel">
            <div class="panel-head">
                <h2 class="panel-title">
                    <i class="fas fa-sign-in-alt"></i> @Ui["Groups.JoinOther"]
                </h2>
            </div>
            <GroupEntryPanel Compact="true" />
        </section>
    }

    </div>
</div>
