@page "/convite/{Code}"

@attribute [AllowAnonymous]

@using System.Security.Claims
@using Confirmai.Data
@using Confirmai.Enums
@using Confirmai.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Confirmai.Services.Core
@inject UiTextService Ui


<PageTitle>@(group?.Name ?? @Ui["Group.InvitePageTitle"]) · Confirmai</PageTitle>

@if (isLoading)
{
    <div class="detail-loading">
        <div class="detail-skeleton">
            <div class="skeleton-header">
                <div class="skeleton-line skeleton-line--sm"></div>
                <div class="skeleton-line skeleton-line--lg"></div>
                <div class="skeleton-line skeleton-line--md"></div>
            </div>
            <div class="skeleton-chips">
                <div class="skeleton-chip"></div>
                <div class="skeleton-chip"></div>
            </div>
        </div>
    </div>
}
else if (group is null)
{
    <div class="detail-not-found">
        <h2>@Ui["Group.InvalidInvite"]</h2>
        <a href="/">@Ui["Group.BackToStart"]</a>
    </div>
}
else
{
    <div class="detail-page">
        <div class="detail-card">

            <header class="detail-header">
                <div class="detail-header-top">
                    <span class="detail-sport-badge">
                        @(group.Sport == Sport.Futsal ? @Ui["Group.SportFutsal"] : @Ui["Group.SportPoker"])
                    </span>
                    <a class="detail-back-link" href="/">
                        <i class="fas fa-arrow-left"></i> @Ui["Group.Home"]
                    </a>
                </div>
                <h1 class="detail-title">@group.Name</h1>
                @if (!string.IsNullOrWhiteSpace(group.City))
                {
                    <p class="detail-location">
                        <i class="fas fa-map-marker-alt"></i>
                        @group.City/@group.StateCode
                    </p>
                }
            </header>

            @* ── Membros ────────────────────────────────────────── *@
            @if (group.Members.Count > 0)
            {
                <section class="detail-section detail-section--spaced">
                    <h2 class="detail-section-title">
                        <i class="fas fa-users"></i> @Ui["Group.Members"] (@group.Members.Count)
                    </h2>
                    <ul class="players-list">
                        @foreach (var m in group.Members
                            .OrderBy(m => m.Role == GroupMemberRole.Admin ? 0 : 1)
                            .ThenBy(m => m.CreatedAt))
                        {
                            <li class="player-item">
                                <span class="player-name">@(m.User?.FullName ?? m.User?.UserName ?? @Ui["Group.Member"])</span>
                                @if (m.Role == GroupMemberRole.Admin)
                                {
                                    <span class="player-tag player-tag--admin">@Ui["Group.Admin"]</span>
                                }
                            </li>
                        }
                    </ul>
                </section>
            }

            @* ── Partidas ───────────────────────────────────────── *@
            @if (recentEvents.Count > 0)
            {
                <section class="detail-section detail-section--spaced">
                    <h2 class="detail-section-title">
                        <i class="fas fa-calendar-alt"></i> @Ui["Group.PartidasLink"] (@recentEvents.Count)
                    </h2>
                    <table class="events-table">
                        <thead>
                            <tr>
                                <th class="web-only">@Ui["Group.DateTimeHeader"]</th>
                                <th class="web-only">@Ui["Group.PlayersHeader"]</th>
                                <th class="web-only">@Ui["Group.StatusHeader"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ev in recentEvents)
                            {
                                var href   = group.Sport == Sport.Futsal ? $"/futsal/{ev.Id}" : $"/poker/{ev.Id}";
                                var date   = ev.StartsAt.ToString("dd/MM/yyyy");
                                var time   = ev.StartsAt.ToString("HH:mm");
                                var isFull = ev.Confirmations.Count >= ev.MaxPlayers;
                                <tr class="events-table-row" @onclick="() => NavigationManager.NavigateTo(href)">
                                    <td class="web-only">
                                        <span class="et-date">@date</span>
                                        <span class="et-time">@time</span>
                                    </td>
                                    <td class="web-only">
                                        <span class="et-players @(isFull ? "et-players--full" : "")">@ev.Confirmations.Count / @ev.MaxPlayers</span>
                                    </td>
                                    <td class="web-only">
                                        @if (!ev.IsActive)
                                        {
                                            <span class="player-tag player-tag--cancel">@Ui["Group.Cancelled"]</span>
                                        }
                                        else if (isFull)
                                        {
                                            <span class="player-tag player-tag--full">@Ui["Group.Full"]</span>
                                        }
                                        else
                                        {
                                            <span class="player-tag player-tag--open">@Ui["Group.Open"]</span>
                                        }
                                    </td>
                                    <td class="mobile-only">
                                        <div class="et-cell">
                                            <div class="et-cell-header">
                                                <div class="et-cell-right">
                                                    <span class="et-date">@date</span>
                                                    <span class="et-time">@time</span>
                                                </div>
                                            </div>
                                            <div class="et-cell-meta">
                                                <span class="et-players-mobile @(isFull ? "et-players--full" : "")">
                                                    <i class="fas fa-users"></i> @ev.Confirmations.Count / @ev.MaxPlayers
                                                </span>
                                                @if (!ev.IsActive)
                                                {
                                                    <span class="player-tag player-tag--cancel">@Ui["Group.Cancelled"]</span>
                                                }
                                                else if (isFull)
                                                {
                                                    <span class="player-tag player-tag--full">@Ui["Group.Full"]</span>
                                                }
                                                else
                                                {
                                                    <span class="player-tag player-tag--open">@Ui["Group.Open"]</span>
                                                }
                                            </div>
                                        </div>
                                        <i class="fas fa-chevron-right et-chevron-icon"></i>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </section>
            }

            <div class="detail-action">
                @if (currentUserId is null)
                {
                    <a href="/Identity/Account/Login?ReturnUrl=@Uri.EscapeDataString(NavigationManager.Uri)"
                       class="confirm-btn">
                        <i class="fas fa-sign-in-alt"></i> @Ui["Group.EnterToJoin"]
                    </a>
                }
                else if (alreadyMember)
                {
                    <div class="confirmed-inline-banner">
                        <i class="fas fa-check-circle"></i>
                        <span>@Ui["Group.AlreadyMember"]</span>
                    </div>
                    <a href="/grupo/@group.Id" class="confirm-btn confirm-btn--mt">
                        @Ui["Group.ViewGroup"]
                    </a>
                }
                else if (joined)
                {
                    <div class="confirmed-inline-banner">
                        <i class="fas fa-check-circle"></i>
                        <span>@Ui.Get("Group.JoinedGroup", group.Name)</span>
                    </div>
                    <a href="/grupo/@group.Id" class="confirm-btn confirm-btn--mt">
                        @Ui["Group.ViewGroup"]
                    </a>
                }
                else
                {
                    @if (!string.IsNullOrWhiteSpace(actionError))
                    {
                        <p class="detail-error">@actionError</p>
                    }
                    <button class="confirm-btn" type="button" @onclick="JoinGroup">
                        <i class="fas fa-user-plus"></i> @Ui["Group.JoinGroupBtn"]
                    </button>
                }
            </div>

        </div>
    </div>
}
