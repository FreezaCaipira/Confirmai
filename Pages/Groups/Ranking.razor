@page "/grupo/{Id:int}/ranking"

@attribute [Authorize]

@using System.Security.Claims
@using Confirmai.Data
@using Confirmai.Enums
@using Confirmai.Models
@using Confirmai.Shared.Components.Groups
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore


<PageTitle>Ranking — @(group?.Name ?? "Grupo") · Confirmai</PageTitle>

@if (isLoading)
{
    <div class="detail-loading">
        <div class="detail-skeleton">
            <div class="skeleton-header">
                <div class="skeleton-line skeleton-line--sm"></div>
                <div class="skeleton-line skeleton-line--lg"></div>
                <div class="skeleton-line skeleton-line--md"></div>
            </div>
            <div class="skeleton-section">
                <div class="skeleton-section-title"></div>
                <div class="skeleton-list">
                    <div class="skeleton-list-item">
                        <div class="skeleton-list-item-avatar"></div>
                        <div class="skeleton-list-item-content">
                            <div class="skeleton-line skeleton-line--md"></div>
                            <div class="skeleton-line skeleton-line--sm"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else if (group is null || !isMember)
{
    <div class="detail-not-found">
        <i class="fas fa-lock detail-not-found-icon"></i>
        <h2>Acesso não autorizado.</h2>
        <a href="/">← Voltar</a>
    </div>
}
else if (!group.EnablePostMatchRanking)
{
    <div class="detail-not-found">
        <i class="fas fa-toggle-off detail-not-found-icon"></i>
        <h2>Funcionalidade não habilitada.</h2>
        <a href="/grupo/@group.Id">← Voltar ao grupo</a>
    </div>
}
else
{
    <div class="detail-page">
        <div class="detail-card">

            <header class="detail-header">
                <div class="detail-header-top">
                    <a href="/grupo/@group.Id" class="detail-back-link">
                        <i class="fas fa-arrow-left"></i> Voltar
                    </a>
                    <a href="/grupos" class="detail-back-link detail-back-link--groups">
                        <i class="fas fa-layer-group"></i> Grupos
                    </a>
                </div>
                <div class="detail-header-badge">
                    <span class="detail-sport-badge">
                        @(group.Sport == Sport.Futsal ? "⚽ Futsal" : "🃏 Poker")
                    </span>
                </div>
                <h1 class="detail-title ranking-title"><i class="fas fa-trophy"></i> Ranking</h1>
            </header>

            @* ── Filtro ────────────────────────────────────────────────── *@
            <RankingViewSelector
                ViewMode="@viewMode.ToString()"
                CurrentYear="@currentYear"
                OnViewModeChanged="@HandleViewModeChanged" />

            @* ── Tabela ────────────────────────────────────────────────── *@
            <RankingTable
                RankingRows="@rankingRowsTable"
                CurrentUserId="@currentUserId" />

            <p class="ranking-footnote">
                <i class="fas fa-info-circle"></i>
                Contabiliza apenas partidas com data já encerrada.
            </p>

        </div>
    </div>
}
