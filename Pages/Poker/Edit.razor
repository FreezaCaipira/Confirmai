@page "/poker/{Id:int}/edit"

@attribute [Authorize]

@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Confirmai.Data
@using Confirmai.Enums
@using Confirmai.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore

@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject Confirmai.Services.Events.EventNotificationService NotificationService
@inject Confirmai.Services.Events.EventCollisionService EventCollisionService

<PageTitle>Editar Evento Â· Poker Â· Confirmai</PageTitle>

<div class="create-event-page">
    <div class="create-event-card">

        @if (isLoading)
        {
            <div class="loading-spinner">Carregando...</div>
        }
        else if (notFound)
        {
            <div class="detail-not-found">
                <h2>Evento nÃ£o encontrado.</h2>
                <a href="/poker">â† Voltar</a>
            </div>
        }
        else if (accessDenied)
        {
            <div class="detail-not-found">
                <h2>Acesso negado.</h2>
                <p>Apenas o organizador pode editar este evento.</p>
                <a href="/poker/@Id">â† Voltar</a>
            </div>
        }
        else
        {
            <h1 class="create-event-title">
                @(eventType switch
                {
                    PokerEventType.Tournament => "ðŸ† Editar Torneio",
                    PokerEventType.CashGame   => "ðŸ’° Editar Cash Game",
                    PokerEventType.HomeGame   => "ðŸ  Editar Home Game",
                    _                         => "Editar Evento"
                })
            </h1>

            <EditForm Model="form" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <ValidationSummary class="validation-summary" />

                @* â”€â”€ Identidade â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
                <fieldset class="form-section">
                    <legend>Identidade</legend>

                    <div class="form-group">
                        <label>Nome do evento <span class="required">*</span></label>
                        <InputText class="input" @bind-Value="form.Name" />
                        <ValidationMessage For="@(() => form.Name)" class="validation-message" />
                    </div>

                    <div class="form-group">
                        <label>@(eventType == PokerEventType.HomeGame ? "Sua casa / local" : "Casa de Poker") <span class="required">*</span></label>
                        <InputText class="input" @bind-Value="form.PokerHouseName" />
                        <ValidationMessage For="@(() => form.PokerHouseName)" class="validation-message" />
                    </div>

                    @if (eventType != PokerEventType.HomeGame)
                    {
                        <div class="form-group">
                            <label>EndereÃ§o</label>
                            <InputText class="input" @bind-Value="form.Address"
                                       placeholder="Rua, nÃºmero, bairro â€” Cidade/UF" />
                        </div>
                    }

                    <div class="form-row-2">
                        <div class="form-group">
                            <label>Cidade <span class="required">*</span></label>
                            <InputText class="input" @bind-Value="form.City" />
                            <ValidationMessage For="@(() => form.City)" class="validation-message" />
                        </div>
                        <div class="form-group">
                            <label>UF <span class="required">*</span></label>
                            <InputText class="input" @bind-Value="form.StateCode" maxlength="2" />
                            <ValidationMessage For="@(() => form.StateCode)" class="validation-message" />
                        </div>
                    </div>
                </fieldset>

                @* â”€â”€ Data e hora â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
                <fieldset class="form-section">
                    <legend>Data &amp; HorÃ¡rio</legend>

                    <div class="form-row-2">
                        <div class="form-group">
                            <label>Data <span class="required">*</span></label>
                            <InputDate class="input" @bind-Value="form.Date" />
                            <ValidationMessage For="@(() => form.Date)" class="validation-message" />
                        </div>
                        <div class="form-group">
                            <label>Hora de inÃ­cio <span class="required">*</span></label>
                            <input type="time" class="input"
                                   value="@form.Time.ToString("HH:mm")"
                                   @onchange="OnTimeChange" />
                        </div>
                    </div>

                    @if (eventType == PokerEventType.Tournament)
                    {
                        <div class="form-row-2">
                            <div class="form-group">
                                <label>Late Registration â€” data</label>
                                <InputDate class="input" @bind-Value="form.LateRegDate" />
                            </div>
                            <div class="form-group">
                                <label>Late Registration â€” hora</label>
                                <input type="time" class="input"
                                       value="@(form.LateRegTime?.ToString(@"HH\:mm") ?? "")"
                                       @onchange="e => { if (TimeOnly.TryParse(e.Value?.ToString(), out var t)) form.LateRegTime = t; else form.LateRegTime = null; }" />
                                <small class="form-hint">Deixe em branco para remover.</small>
                            </div>
                        </div>
                    }
                </fieldset>

                @* â”€â”€ Modalidade â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
                @if (eventType != PokerEventType.HomeGame)
                {
                    <fieldset class="form-section">
                        <legend>Modalidade</legend>

                        <div class="modality-grid">
                            @foreach (var m in AvailableModalities(eventType))
                            {
                                <label class="modality-chip @(form.Modality == m ? "modality-chip--on" : "")">
                                    <input type="radio" name="modality" value="@m"
                                           checked="@(form.Modality == m)"
                                           @onchange="() => form.Modality = m" />
                                    @ModalityLabel(m)
                                </label>
                            }
                        </div>
                    </fieldset>
                }

                @* â”€â”€ Torneio: estrutura e preÃ§os â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
                @if (eventType == PokerEventType.Tournament)
                {
                    <fieldset class="form-section">
                        <legend>Estrutura do Torneio</legend>

                        <div class="form-row-2">
                            <div class="form-group">
                                <label>Fichas iniciais <span class="required">*</span></label>
                                <InputNumber class="input" @bind-Value="form.StartingStack" min="1000" step="500" />
                                <ValidationMessage For="@(() => form.StartingStack)" class="validation-message" />
                            </div>
                            <div class="form-group">
                                <label>Blind inicial (em BBs) <span class="required">*</span></label>
                                <InputNumber class="input" @bind-Value="form.InitialBlindBB" min="1" />
                                <ValidationMessage For="@(() => form.InitialBlindBB)" class="validation-message" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label>NÂº mÃ¡ximo de jogadores</label>
                            <InputNumber class="input" @bind-Value="form.MaxPlayers" min="0" />
                            <small class="form-hint">Use 0 para ilimitado.</small>
                        </div>
                    </fieldset>

                    <fieldset class="form-section">
                        <legend>PreÃ§os</legend>

                        <div class="form-row-2">
                            <div class="form-group">
                                <label>Buy-in (R$) <span class="required">*</span></label>
                                <div class="input-prefix-wrap">
                                    <span class="input-prefix">R$</span>
                                    <InputNumber class="input" @bind-Value="form.BuyInAmount" min="0" step="5" />
                                </div>
                                <ValidationMessage For="@(() => form.BuyInAmount)" class="validation-message" />
                            </div>
                            <div class="form-group">
                                <label>GTD â€” PremiaÃ§Ã£o garantida (R$)</label>
                                <div class="input-prefix-wrap">
                                    <span class="input-prefix">R$</span>
                                    <InputNumber class="input" @bind-Value="form.GTD" min="0" step="100" />
                                </div>
                            </div>
                        </div>

                        <div class="form-row-2">
                            <div class="form-group">
                                <label>Rebuy (R$)</label>
                                <div class="input-prefix-wrap">
                                    <span class="input-prefix">R$</span>
                                    <InputNumber class="input" @bind-Value="form.RebuyAmount" min="0" step="5" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label>Rebuy duplo (R$)</label>
                                <div class="input-prefix-wrap">
                                    <span class="input-prefix">R$</span>
                                    <InputNumber class="input" @bind-Value="form.RebuyDoubleAmount" min="0" step="5" />
                                </div>
                            </div>
                        </div>

                        <div class="form-row-2">
                            <div class="form-group">
                                <label>Add-on (R$)</label>
                                <div class="input-prefix-wrap">
                                    <span class="input-prefix">R$</span>
                                    <InputNumber class="input" @bind-Value="form.AddonAmount" min="0" step="5" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label>Add-on duplo (R$)</label>
                                <div class="input-prefix-wrap">
                                    <span class="input-prefix">R$</span>
                                    <InputNumber class="input" @bind-Value="form.AddonDoubleAmount" min="0" step="5" />
                                </div>
                            </div>
                        </div>
                    </fieldset>
                }

                @* â”€â”€ Cash Game â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
                @if (eventType == PokerEventType.CashGame)
                {
                    <fieldset class="form-section">
                        <legend>Stacks</legend>

                        <div class="form-row-2">
                            <div class="form-group">
                                <label>Stack mÃ­nimo (R$) <span class="required">*</span></label>
                                <div class="input-prefix-wrap">
                                    <span class="input-prefix">R$</span>
                                    <InputNumber class="input" @bind-Value="form.CashMinBuyIn" min="0" step="50" />
                                </div>
                                <ValidationMessage For="@(() => form.CashMinBuyIn)" class="validation-message" />
                            </div>
                            <div class="form-group">
                                <label>Stack mÃ¡ximo (R$) <span class="required">*</span></label>
                                <div class="input-prefix-wrap">
                                    <span class="input-prefix">R$</span>
                                    <InputNumber class="input" @bind-Value="form.CashMaxBuyIn" min="0" step="50" />
                                </div>
                                <ValidationMessage For="@(() => form.CashMaxBuyIn)" class="validation-message" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label>O que estÃ¡ incluso para os jogadores?</label>
                            <InputText class="input" @bind-Value="form.CashIncludes"
                                       placeholder='Ex: "janta, cerveja e refri", "snacks e Ã¡gua"' maxlength="300" />
                        </div>
                    </fieldset>
                }

                @* â”€â”€ Home Game: cÃ³digo atual (somente leitura) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
                @if (eventType == PokerEventType.HomeGame && !string.IsNullOrWhiteSpace(currentHomeGameCode))
                {
                    <fieldset class="form-section">
                        <legend>CÃ³digo de Acesso</legend>
                        <div class="homegame-notice">
                            <i class="fas fa-key"></i>
                            <div>
                                <strong>CÃ³digo atual: @currentHomeGameCode</strong>
                                <p>O cÃ³digo nÃ£o pode ser alterado â€” jÃ¡ foi compartilhado com os convidados.</p>
                            </div>
                        </div>
                    </fieldset>
                }

                @if (!string.IsNullOrWhiteSpace(saveError))
                {
                    <p class="validation-message validation-message--mt">
                        @saveError
                        @if (!string.IsNullOrWhiteSpace(collisionHref))
                        {
                            <a href="@collisionHref" class="collision-link">@Confirmai.Services.Events.EventCollisionService.OpenExistingEventLinkText</a>
                        }
                    </p>
                }

                <div class="form-actions">
                    <button class="cancel-btn" type="button"
                            @onclick='() => NavigationManager.NavigateTo($"/poker/{Id}")'>
                        Cancelar
                    </button>
                    <button class="save-btn save-btn--poker" type="submit" disabled="@isSaving">
                        @(isSaving ? "Salvandoâ€¦" : "Salvar alteraÃ§Ãµes")
                    </button>
                </div>

            </EditForm>
        }
    </div>
</div>

