@page "/orders"

@attribute [Authorize]

@using Confirmai.Models
@using Confirmai.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Confirmai.Shared.Helpers
@using Confirmai.Data

@inject IDbContextFactory<AppDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager NavigationManager
@inject BitcoinQuoteService BitcoinQuoteService
@inject CurrencyPreferenceService CurrencyPreferenceService
@inject UiTextService T

<div class="entity-shell parchment-a my-orders-shell">

    <section class="entity-shell-grid" aria-label="@T["MyOrders.Aria"]">
        <article class="entity-shell-card entity-shell-main">
            <h1 class="page-section-title">@T["Nav.MyOrders"]</h1>
            <div class="filter-bar admin-filter-card my-orders-filter-card">
                <input type="number" placeholder="@T["MyOrders.Filter.Id"]" @bind="filterId" min="0" />
                <input type="text" placeholder="@T["AdminOrders.Filter.Product"]" @bind="filterProduct" @bind:event="oninput" />
                <input type="number" placeholder="@T["AdminOrders.Filter.Min"]" @bind="filterMinAmount" min="0" />
                <input type="number" placeholder="@T["AdminOrders.Filter.Max"]" @bind="filterMaxAmount" min="0" />
                <select @bind="filterStatus">
                    <option value="">@T["AdminOrders.Filter.AllStatuses"]</option>
                    <option value="Pendente">Aguardando pagamento</option>
                    <option value="Pago">Pago</option>
                    <option value="AguardandoEntrega">Aguardando entrega</option>
                    <option value="AguardandoEntregaInGame">Aguardando entrega in-game</option>
                    <option value="AguardandoRevisaoAdm">Aguardando revisão ADM</option>
                    <option value="Finalizado">Finalizado</option>
                    <option value="Disputa">Em disputa</option>
                    <option value="Cancelado">Cancelado</option>
                </select>
                <input type="date" @bind="filterDate" />
                <button @onclick="ApplyFilters">@T["Common.Filter"]</button>
                <button @onclick="ClearFilters">@T["Common.Clear"]</button>
            </div>

            <AdminDataState IsLoading="@isLoading" IsEmpty="@(!pagedOrders.Any())" LoadingText="@T["Common.Loading"]" EmptyText="@T["MyOrders.Empty"]" EmptyIcon="fas fa-clipboard-list">
                <div class="my-orders-table-wrap">
                <table class="product-table my-orders-table">
        <thead>
            <tr>
                <th>@T["AdminOrders.Product"]</th>
                <th>@T["Common.Value"]</th>
                <th>@T["Common.Status"]</th>
                <th>@T["Common.Date"]</th>
                <th>@T["MyOrders.Counterparty"]</th>
                <th>@T["Common.Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in pagedOrders)
            {
                var otherParty = t.BuyerId == userId 
                    ? t.Seller?.UserName ?? t.SellerId ?? "(deletado)"
                    : t.Buyer?.UserName ?? t.BuyerId ?? "(deletado)";
                var otherPartyId = t.BuyerId == userId
                    ? t.SellerId
                    : t.BuyerId;
                <tr>
                    <td>
                        @if (t.Product != null)
                        {
                            @t.Product.Name
                        }
                        else
                        {
                            <span class="text-warning">@string.Format(T["MyOrders.ProductNotFound"], t.ProductId)</span>
                        }
                    </td>
                    <td>@FormatOrderAmount(t.Amount, t.Payment?.Currency)</td>
                    <td>
                        <span class="order-status-badge @OrderStatusHelper.GetStatusCssClass(t.Status)">
                            @OrderStatusHelper.GetStatusText(t.Status, T)
                        </span>
                    </td>
                    <td>@t.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(otherPartyId))
                        {
                            <a class="evidence-link" href="@($"/profile/{otherPartyId}")">@otherParty</a>
                        }
                        else
                        {
                            @otherParty
                        }
                    </td>
                    <td>
                        <button class="details-btn action-btn icon-only" @onclick="() => GoToDetails(t.Id)" title="@T["Common.Details"]" aria-label="@T["Common.Details"]">
                            <i class="fas fa-eye"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
                </table>
                </div>

                <div class="pagination my-orders-pagination">
                    <button type="button" @onclick="@(() => PrevPage())" disabled="@(!CanGoToPreviousPage)">@T["Common.Previous"]</button>
                    <span class="pagination-info">@T["Common.Page"] @currentPage @T["Common.Of"] @totalPages</span>
                    <button type="button" @onclick="@(() => NextPage())" disabled="@(!CanGoToNextPage)">@T["Common.Next"]</button>
                </div>
            </AdminDataState>
        </article>
    </section>
</div>

@code {
    private bool isLoading = true;
    private List<OrderModel> pagedOrders = new();
    private int totalCount;
    private string? userId;
    private int? filterId;
    private string filterProduct = "";
    private decimal? filterMinAmount;
    private decimal? filterMaxAmount;
    private decimal? btcUsdRate;
    private decimal? btcBrlRate;
    private string filterStatus = "";
    private DateTime? filterDate;

    private int pageSize = 10;
    private int currentPage = 1;
    private int totalPages => Math.Max(1, (int)Math.Ceiling((double)totalCount / pageSize));

    private bool CanGoToNextPage => currentPage < totalPages;
    private bool CanGoToPreviousPage => currentPage > 1;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        var quote = await BitcoinQuoteService.GetQuoteAsync();
        btcUsdRate = quote?.btc_usd;
        btcBrlRate = quote?.btc_brl;

        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        userId = UserManager.GetUserId(user);

        await LoadPageAsync();
        isLoading = false;
    }

    private async Task LoadPageAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        IQueryable<OrderModel> query = db.Orders
            .Include(o => o.Product)
            .Include(o => o.Payment)
            .Include(o => o.Buyer)
            .Include(o => o.Seller)
            .AsNoTracking()
            .Where(t => t.BuyerId == userId || t.SellerId == userId);

        if (filterId.HasValue)
            query = query.Where(t => t.Id == filterId.Value);

        if (!string.IsNullOrWhiteSpace(filterProduct))
            query = query.Where(t => t.Product != null && t.Product.Name.ToLower().Contains(filterProduct.ToLower()));

        if (filterMinAmount.HasValue)
            query = query.Where(t => t.Amount >= filterMinAmount.Value);

        if (filterMaxAmount.HasValue)
            query = query.Where(t => t.Amount <= filterMaxAmount.Value);

        if (!string.IsNullOrWhiteSpace(filterStatus) && Enum.TryParse<PaymentStatus>(filterStatus, out var parsedStatus))
            query = query.Where(t => t.Status == parsedStatus);

        if (filterDate.HasValue)
            query = query.Where(t => t.CreatedAt.Date == filterDate.Value.Date);

        totalCount = await query.CountAsync();

        if (currentPage > totalPages)
            currentPage = totalPages;

        pagedOrders = await query
            .OrderByDescending(t => t.CreatedAt)
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToListAsync();
    }

    private void GoToDetails(int id)
    {
        NavigationManager.NavigateTo($"/orders/{id}");
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;
        await LoadPageAsync();
    }

    private async Task ClearFilters()
    {
        filterId = null;
        filterProduct = "";
        filterMinAmount = null;
        filterMaxAmount = null;
        filterStatus = "";
        filterDate = null;
        currentPage = 1;
        await LoadPageAsync();
    }

    private async Task NextPage()
    {
        if (CanGoToNextPage)
        {
            currentPage++;
            await LoadPageAsync();
        }
    }

    private async Task PrevPage()
    {
        if (CanGoToPreviousPage)
        {
            currentPage--;
            await LoadPageAsync();
        }
    }

    private MarkupString FormatBtcWithUsd(decimal amount)
    {
        return BtcUsdFormatter.FormatMarkup(amount, btcUsdRate, btcBrlRate, CurrencyPreferenceService.SelectedFiatCurrency);
    }

    private string FormatOrderAmount(decimal amount, string? currency)
    {
        return currency switch
        {
            "BRL" => $"R$ {amount:N2}",
            "USD" => $"$ {amount:N2}",
            _ => BtcUsdFormatter.Format(amount, btcUsdRate, btcBrlRate, CurrencyPreferenceService.SelectedFiatCurrency)
        };
    }
}

