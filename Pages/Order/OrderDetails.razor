@page "/orders/{Id:int}"

@attribute [Authorize]

@using Confirmai.Models
@using Confirmai.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Confirmai.Shared.Helpers

@inject AppDbContext Db
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthProvider
@inject UserManager<ApplicationUser> UserManager
@inject IJSRuntime JS
@inject BitcoinQuoteService BitcoinQuoteService
@inject CurrencyPreferenceService CurrencyPreferenceService
@inject OrderAccessService OrderAccessService
@inject OperationFeeCalculatorService OperationFeeCalculatorService
@inject AdminOrderReleaseService AdminOrderReleaseService
@inject AdminSettingsService AdminSettingsService
@inject LogService Log
@inject UiTextService T

<nav class="breadcrumb-nav">
    <a href="/dashboard">@T["Breadcrumb.Dashboard"]</a>
    <span class="breadcrumb-sep"><i class="fas fa-chevron-right"></i></span>
    <a href="/orders">@T["Breadcrumb.Orders"]</a>
    <span class="breadcrumb-sep"><i class="fas fa-chevron-right"></i></span>
    <span class="breadcrumb-current">@T["Common.Details"]</span>
</nav>

<div class="entity-shell parchment-b intermediation-shell">

    <section class="entity-shell-grid" aria-label="@T["OrderDetails.Aria"]">
        <article class="entity-shell-card entity-shell-main">
@if (isLoading)
{
    <div class="loading-spinner">@T["Common.Loading"]</div>
}
else if (order == null)
{
    <div class="alert alert-warning">@T["OrderDetails.NotFoundOrDenied"]</div>
}
else
{
    <div class="intermediation-grid">
        <div class="intermediation-item-card">
            <img class="product-img" src="@order.Product?.ImagePath" alt="@order.Product?.Name" />
            <div class="product-info">
                <div class="product-name">@order.Product?.Name</div>
                <div class="product-price">@FormatAmount(order.Amount, order.Payment?.Currency)</div>
                <div class="product-desc">@order.Product?.ShortDescription</div>
            </div>
        </div>
        <div class="intermediation-meta-card">
            <div class="intermediation-meta-rows">
            <div class="intermediation-row">
                <span class="intermediation-label">@(T["OrderDetails.OrderId"] == "OrderDetails.OrderId" ? "ID do pedido" : T["OrderDetails.OrderId"])</span>
                <span class="intermediation-value order-id-value">@order.Id</span>
            </div>
            <div class="intermediation-row">
                <span class="intermediation-label">@T["AdminOrders.Buyer"]</span>
                <span class="intermediation-value">
                    @if (order.BuyerId != null)
                    {
                        <a class="evidence-link" href="@($"/profile/{order.BuyerId}")">@order.Buyer?.UserName</a>
                    }
                    else
                    {
                        <span>(deletado)</span>
                    }
                </span>
            </div>
            <div class="intermediation-row">
                <span class="intermediation-label">@T["AdminOrders.Seller"]</span>
                <span class="intermediation-value">
                    @if (order.SellerId != null)
                    {
                        <a class="evidence-link" href="@($"/profile/{order.SellerId}")">@order.Seller?.UserName</a>
                    }
                    else
                    {
                        <span>(deletado)</span>
                    }
                </span>
            </div>
            <div class="intermediation-row">
                <span class="intermediation-label">@T["Common.Date"]</span>
                <span class="intermediation-value">@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            @if (order.Payment != null)
            {
                <div class="intermediation-row">
                    <span class="intermediation-label">@T["Common.Gateway"]</span>
                    <span class="intermediation-value">@(string.IsNullOrWhiteSpace(order.Payment.PaymentMethod) ? "-" : order.Payment.PaymentMethod)</span>
                </div>
                <div class="intermediation-row intermediation-payment-id-row">
                    <span class="intermediation-label">@(T["OrderDetails.PaymentId"] == "OrderDetails.PaymentId" ? "ID do pagamento" : T["OrderDetails.PaymentId"])</span>
                    <span class="intermediation-value payment-address-flex">
                        <span class="payment-address">@order.Payment.PaymentId</span>
                        <button class="clipboard-btn" @onclick="() => CopyToClipboard(order.Payment.PaymentId)">
                            <i class="fas fa-clipboard"></i>
                        </button>
                    </span>
                </div>
                @if (order.Status == PaymentStatus.AguardandoRevisaoAdm)
                {
                    <div class="order-status-notice notice-awaiting-review">
                        <i class="fas fa-hourglass-half"></i>
                        <span>As evidências foram enviadas e o pedido está aguardando revisão administrativa. Os fundos serão liberados para o vendedor após a confirmação.</span>
                    </div>
                }
                @if (order.Status == PaymentStatus.Disputa)
                {
                    <div class="order-status-notice notice-disputa">
                        <i class="fas fa-exclamation-circle"></i>
                        <span>Esta transacao esta em disputa. O time administrativo ira analisar as evidencias e tomar uma decisao.</span>
                    </div>
                }
                <div class="intermediation-actions">
                    <a class="intermediation-btn intermediation-btn-success action-view-payment" href="@($"/payments/view/{order.Payment?.Id}")" title="@T["OrderDetails.ViewPayment"]">
                        <span class="payment-link-text">@T["OrderDetails.ViewPayment"]</span>
                    </a>

                    @if (isBuyer)
                    {
                        <button class="intermediation-btn intermediation-btn-success action-view-proof" @onclick="() => showSellerEvidenceViewerModal = true">
                            Ver evidencia de envio
                        </button>
                    }

                    @if (isAdmin && order.IsDelivered && !order.FundsReleased)
                    {
                        <button class="intermediation-btn intermediation-btn-success" @onclick="() => showReleaseModal = true">
                            @T["OrderDetails.ReleaseFunds"]
                        </button>
                    }

                    @if (isSeller)
                    {
                        <button class="intermediation-btn intermediation-btn-success action-view-proof" @onclick="() => showBuyerEvidenceViewerModal = true">
                            Ver evidencia de recebimento
                        </button>
                    }

                    @if (isSeller && order.IsPaid && !order.FundsReleased)
                    {
                        <button class="intermediation-btn intermediation-btn-info action-send-proof" @onclick="()=>showSellerEvidenceModal=true">
                            <i class="fas fa-upload"></i> Enviar evidencia de envio
                        </button>
                    }

                    @if (isBuyer && !order.FundsReleased && !order.UseSiteIntermediary && !order.IsDelivered)
                    {
                        <button class="intermediation-btn intermediation-btn-success action-confirm-direct" @onclick="()=>showDirectConfirmModal=true">
                            <i class="fas fa-check"></i> Confirmar recebimento
                        </button>
                    }
                    @if (isBuyer && !order.FundsReleased)
                    {
                        <button class="intermediation-btn intermediation-btn-info action-send-proof" @onclick="()=>showConfirmModal=true">
                            <i class="fas fa-upload"></i> @T["OrderDetails.SendReceiveEvidence"]
                        </button>
                    }

                    <button class="intermediation-btn intermediation-btn-warning action-back" @onclick='GoBack'>@T["Common.Back"]</button>
                </div>
            }
            else
            {
                <div class="intermediation-row">
                    <span class="intermediation-label">@T["Common.Gateway"]</span>
                    <span class="text-danger">@T["OrderDetails.NotFound"]</span>
                </div>
                <div class="intermediation-actions">
                    <button class="intermediation-btn intermediation-btn-warning" @onclick='GoBack'>@T["Common.Back"]</button>
                </div>
            }

            @if (order.IsDelivered && order.FundsReleased)
            {
                <div class="intermediation-success-message">
                    <i class="fas fa-check-circle"></i>
                    @T["OrderDetails.DeliveredReleased"]
                </div>
            }
            </div>
        </div>
    </div>

    @if (showConfirmModal)
    {
        <div class="modal-overlay" @onclick="CloseAllModals">
            <div class="confirm-delivery-modal modal-card" role="dialog" aria-modal="true" aria-labelledby="confirm-delivery-title" tabindex="0" @onkeydown="HandleModalKeydown" @onkeydown:stopPropagation="true" @onclick:stopPropagation="true">
                <h4 class="modal-title modal-title-with-icon" id="confirm-delivery-title"><i class="fas fa-check-circle modal-title-icon"></i>@T["OrderDetails.ConfirmReceiveTitle"]</h4>
                <div class="modal-content">
                    @if (!string.IsNullOrEmpty(confirmError))
                    {
                        <div class="modal-error">@confirmError</div>
                    }
                    @if (!string.IsNullOrEmpty(order.BuyerEvidencePath))
                    {
                        <div>
                            <a class="evidence-link" href="@order.BuyerEvidencePath" target="_blank">
                                <i class="fas fa-file-image"></i> @T["OrderDetails.ViewCurrentEvidence"]
                            </a>
                        </div>
                    }
                    <label>@T["OrderDetails.EvidenceFileLabel"]</label>
                    <InputFile OnChange="OnFileSelected" accept=".jpg,.jpeg,.png,.gif,.webp" />
                    <label>@T["OrderDetails.CommentLabel"]</label>
                    <textarea class="modal-textarea" @bind="confirmComment">@order.BuyerEvidenceComment</textarea>
                </div>
                <div class="modal-actions">
                    <button class="success-btn" @onclick="ConfirmDelivery">@T["Common.Save"]</button>
                    <button class="back-btn" @onclick="()=>showConfirmModal=false">@T["Common.Cancel"]</button>
                </div>
            </div>
        </div>
    }

    @if (showSellerEvidenceModal)
    {
        <div class="modal-overlay" @onclick="CloseAllModals">
            <div class="seller-evidence-modal modal-card" role="dialog" aria-modal="true" aria-labelledby="seller-evidence-title" tabindex="0" @onkeydown="HandleModalKeydown" @onkeydown:stopPropagation="true" @onclick:stopPropagation="true">
                <h4 class="modal-title modal-title-with-icon" id="seller-evidence-title"><i class="fas fa-truck modal-title-icon"></i>@T["OrderDetails.ShippingEvidence"]</h4>
                <div class="modal-content">
                    @if (!string.IsNullOrEmpty(sellerEvidenceError))
                    {
                        <div class="modal-error">@sellerEvidenceError</div>
                    }
                    @if (!string.IsNullOrEmpty(order.SellerEvidencePath))
                    {
                        <div>
                            <a class="evidence-link" href="@order.SellerEvidencePath" target="_blank">
                                <i class="fas fa-file-image"></i> @T["OrderDetails.ViewCurrentEvidence"]
                            </a>
                        </div>
                    }
                    <label>@T["OrderDetails.EvidenceFileLabel"]</label>
                    <InputFile OnChange="OnSellerFileSelected" accept=".jpg,.jpeg,.png,.gif,.webp" />
                    <label>@T["OrderDetails.CommentLabel"]</label>
                    <textarea class="modal-textarea" @bind="sellerEvidenceComment">@order.SellerEvidenceComment</textarea>
                </div>
                <div class="modal-actions">
                    <button class="success-btn" @onclick="ConfirmSellerEvidence">@T["Common.Save"]</button>
                    <button class="back-btn" @onclick="()=>showSellerEvidenceModal=false">@T["Common.Cancel"]</button>
                </div>
            </div>
        </div>
    }

    @if (showSellerEvidenceViewerModal)
    {
        <div class="modal-overlay" @onclick="CloseAllModals">
            <div class="seller-evidence-view-modal modal-card" role="dialog" aria-modal="true" aria-labelledby="seller-evidence-view-title" tabindex="0" @onkeydown="HandleModalKeydown" @onkeydown:stopPropagation="true" @onclick:stopPropagation="true">
                <h4 class="modal-title modal-title-with-icon" id="seller-evidence-view-title"><i class="fas fa-truck modal-title-icon"></i>Ver evidencia de envio</h4>
                <div class="modal-content">
                    @if (!string.IsNullOrEmpty(order.SellerEvidencePath))
                    {
                        <div>
                            <a class="evidence-link" href="@order.SellerEvidencePath" target="_blank">
                                <i class="fas fa-file-image"></i> @T["OrderDetails.ViewCurrentEvidence"]
                            </a>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(order.SellerEvidenceComment))
                        {
                            <div>@T["OrderDetails.CommentLabel"] @order.SellerEvidenceComment</div>
                        }
                    }
                    else
                    {
                        <div class="text-muted">O vendedor ainda nao postou evidencia de envio.</div>
                    }
                </div>
                <div class="modal-actions">
                    <button class="back-btn" @onclick="() => showSellerEvidenceViewerModal = false">@T["Common.Cancel"]</button>
                </div>
            </div>
        </div>
    }

    @if (showBuyerEvidenceViewerModal)
    {
        <div class="modal-overlay" @onclick="CloseAllModals">
            <div class="buyer-evidence-view-modal modal-card" role="dialog" aria-modal="true" aria-labelledby="buyer-evidence-view-title" tabindex="0" @onkeydown="HandleModalKeydown" @onkeydown:stopPropagation="true" @onclick:stopPropagation="true">
                <h4 class="modal-title modal-title-with-icon" id="buyer-evidence-view-title"><i class="fas fa-check-circle modal-title-icon"></i>Ver evidencia de recebimento</h4>
                <div class="modal-content">
                    @if (!string.IsNullOrEmpty(order.BuyerEvidencePath))
                    {
                        <div>
                            <a class="evidence-link" href="@order.BuyerEvidencePath" target="_blank">
                                <i class="fas fa-file-image"></i> @T["OrderDetails.ViewCurrentEvidence"]
                            </a>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(order.BuyerEvidenceComment))
                        {
                            <div>@T["OrderDetails.CommentLabel"] @order.BuyerEvidenceComment</div>
                        }
                    }
                    else
                    {
                        <div class="text-muted">O comprador ainda nao postou evidencia de recebimento.</div>
                    }
                </div>
                <div class="modal-actions">
                    <button class="back-btn" @onclick="() => showBuyerEvidenceViewerModal = false">@T["Common.Cancel"]</button>
                </div>
            </div>
        </div>
    }

    @if (showDirectConfirmModal)
    {
        <div class="modal-overlay" @onclick="CloseAllModals">
            <div class="confirm-delivery-modal modal-card" role="dialog" aria-modal="true" aria-labelledby="direct-confirm-title" tabindex="0" @onkeydown="HandleModalKeydown" @onkeydown:stopPropagation="true" @onclick:stopPropagation="true">
                <h4 class="modal-title modal-title-with-icon" id="direct-confirm-title"><i class="fas fa-check-circle modal-title-icon"></i>Confirmar recebimento</h4>
                <div class="modal-content">
                    <p>Confirme que você recebeu o item conforme combinado. Esta ação encerrará o pedido.</p>
                    <p class="direct-confirm-warning">⚠️ Esta transação foi realizada sem intermédio do site. Ao confirmar, o pedido será finalizado imediatamente.</p>
                </div>
                <div class="modal-actions">
                    <button class="success-btn" @onclick="ConfirmDirectDelivery">Confirmar</button>
                    <button class="back-btn" @onclick="()=>showDirectConfirmModal=false">@T["Common.Cancel"]</button>
                </div>
            </div>
        </div>
    }

    @if (showReleaseModal)
    {
        <div class="modal-overlay" @onclick="CloseAllModals">
            <div class="release-funds-modal modal-card release-modal-card" role="dialog" aria-modal="true" aria-labelledby="release-funds-title" tabindex="0" @onkeydown="HandleModalKeydown" @onkeydown:stopPropagation="true" @onclick:stopPropagation="true">
                <h4 class="modal-title modal-title-with-icon" id="release-funds-title"><i class="fas fa-exclamation-triangle modal-title-icon"></i>@T["AdminOrdersReview.Modal.Title"]</h4>
                <div class="modal-content release-modal-content">
                    <p class="release-modal-question">@T["AdminOrdersReview.Modal.Question"]</p>

                    <div class="release-modal-layout">
                        <div class="payment-details-card release-summary-card">
                            <div class="details-row"><span class="label">@T["AdminOrders.Product"]:</span><span>@order.Product?.Name</span></div>
                            <div class="details-row"><span class="label">@T["AdminOrdersReview.Quantity"]:</span><span>1</span></div>
                            <div class="details-row"><span class="label">@T["AdminOrders.Buyer"]:</span><span>@if (order.BuyerId != null) {<a class="evidence-link" href="@($"/profile/{order.BuyerId}")">@order.Buyer?.UserName</a>} else {<span>(deletado)</span>}</span></div>
                            <div class="details-row"><span class="label">@T["AdminOrders.Seller"]:</span><span>@if (order.SellerId != null) {<a class="evidence-link" href="@($"/profile/{order.SellerId}")">@order.Seller?.UserName</a>} else {<span>(deletado)</span>}</span></div>
                            <div class="details-row"><span class="label">@T["AdminOrdersReview.GrossAmount"]:</span><span>@FormatAmount(order.Amount, order.Payment?.Currency)</span></div>
                            <div class="details-row"><span class="label">@T["AdminOrdersReview.OperationFee"]:</span><span>@(releaseBreakdown?.Percent.ToString("0.##") ?? "0")%</span></div>
                            <div class="details-row"><span class="label">@T["AdminOrdersReview.FeeAmount"]:</span><span>@FormatAmount(releaseBreakdown?.FeeAmount ?? 0m, order.Payment?.Currency)</span></div>
                            <div class="details-row"><span class="label">@T["AdminOrdersReview.NetAmount"]:</span><span><b>@FormatAmount(releaseBreakdown?.NetAmount ?? 0m, order.Payment?.Currency)</b></span></div>
                        </div>

                        <div class="release-modal-side">
                            @if (!string.IsNullOrWhiteSpace(order.Product?.ImagePath))
                            {
                                <div class="release-product-preview-wrapper">
                                    <img src="@order.Product.ImagePath" alt="@order.Product.Name" class="release-product-preview-img" />
                                </div>
                            }
                        </div>
                    </div>

                    <div class="evidence-section release-evidence-row">
                        <div class="evidence-card">
                            <div class="evidence-card-title"><i class="fas fa-user"></i><b>@T["AdminOrders.Buyer"]</b></div>
                            @if (!string.IsNullOrEmpty(order.BuyerEvidencePath))
                            {
                                <div>@T["AdminOrdersReview.Comment"] @order.BuyerEvidenceComment</div>
                                <a href="@order.BuyerEvidencePath" target="_blank">
                                    <i class="fas fa-file-image"></i> @T["AdminOrdersReview.ViewEvidence"]
                                </a>
                            }
                            else
                            {
                                <div class="text-muted">@T["AdminOrdersReview.NoEvidence"]</div>
                            }
                        </div>
                        <div class="evidence-card">
                            <div class="evidence-card-title"><i class="fas fa-truck"></i><b>@T["AdminOrders.Seller"]</b></div>
                            @if (!string.IsNullOrEmpty(order.SellerEvidencePath))
                            {
                                <div>@T["AdminOrdersReview.Comment"] @order.SellerEvidenceComment</div>
                                <a href="@order.SellerEvidencePath" target="_blank">
                                    <i class="fas fa-file-image"></i> @T["AdminOrdersReview.ViewEvidence"]
                                </a>
                            }
                            else
                            {
                                <div class="text-muted">@T["AdminOrdersReview.NoEvidence"]</div>
                            }
                        </div>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(releaseError))
                {
                    <div class="modal-error">@releaseError</div>
                }
                <div class="modal-actions">
                    <button class="success-btn" @onclick="ConfirmReleaseFunds" disabled="@(order.BuyerId == null || order.SellerId == null)">@T["AdminOrdersReview.Modal.Confirm"]</button>
                    <button class="back-btn" @onclick="() => showReleaseModal = false">@T["Common.Cancel"]</button>
                </div>
            </div>
        </div>
    }

    <div class="intermediation-status-container">
        @{
            var isTerminal = order.Status is PaymentStatus.Cancelado or PaymentStatus.Falha or PaymentStatus.Reembolsado or PaymentStatus.Disputa;
            var stepperSteps = new[]
            {
                (Label: "Pagamento", Icon: "fa-file-invoice", Statuses: new[] { PaymentStatus.AguardandoPagamento, PaymentStatus.Pendente }),
                (Label: "Confirmado", Icon: "fa-check-circle", Statuses: new[] { PaymentStatus.Pago }),
                (Label: "Entrega", Icon: "fa-box", Statuses: new[] { PaymentStatus.AguardandoEntrega, PaymentStatus.AguardandoEntregaInGame, PaymentStatus.AguardandoRevisaoAdm }),
                (Label: "Entregue", Icon: "fa-hand-holding-heart", Statuses: new[] { PaymentStatus.Entregue }),
                (Label: "Finalizado", Icon: "fa-trophy", Statuses: new[] { PaymentStatus.Finalizado }),
            };
            // Determina o índice do passo ativo (normal flow)
            int activeStep = -1;
            for (int si = 0; si < stepperSteps.Length; si++)
            {
                if (stepperSteps[si].Statuses.Contains(order.Status)) { activeStep = si; break; }
            }
            // Para estados terminais negativos, marca como falha visual
        }
        @if (isTerminal)
        {
            <div class="order-stepper order-stepper--terminal">
                <div class="order-stepper-terminal-icon">
                    @if (order.Status == PaymentStatus.Disputa) { <i class="fas fa-gavel"></i> }
                    else if (order.Status == PaymentStatus.Reembolsado) { <i class="fas fa-undo-alt"></i> }
                    else { <i class="fas fa-times-circle"></i> }
                </div>
                <div class="order-stepper-terminal-text">
                    <strong>@OrderStatusHelper.GetStatusText(order.Status, T)</strong>
                    @if (order.Status == PaymentStatus.Disputa)
                    { <span>Esta transacao esta em disputa. O time administrativo ira analisar as evidencias.</span> }
                    else if (order.Status == PaymentStatus.Reembolsado)
                    { <span>O valor foi reembolsado para o comprador.</span> }
                    else
                    { <span>Este pedido foi encerrado sem conclusao.</span> }
                </div>
            </div>
        }
        else
        {
            <div class="order-stepper">
                @for (int si = 0; si < stepperSteps.Length; si++)
                {
                    var step = stepperSteps[si];
                    var isCompleted = si < activeStep || (si == activeStep && si == stepperSteps.Length - 1);
                    var isActive = si == activeStep && si < stepperSteps.Length - 1;
                    var stepClass = isCompleted ? "order-step--done" : isActive ? "order-step--active" : "order-step--pending";
                    <div class="order-step @stepClass">
                        <div class="order-step-circle">
                            @if (isCompleted && si < stepperSteps.Length - 1) { <i class="fas fa-check"></i> }
                            else { <i class="fas @step.Icon"></i> }
                        </div>
                        <span class="order-step-label">@step.Label</span>
                    </div>
                    @if (si < stepperSteps.Length - 1)
                    {
                        <div class="order-step-connector @(si < activeStep || activeStep == stepperSteps.Length - 1 ? "order-step-connector--done" : "")"></div>
                    }
                }
            </div>
        }
    </div>

    <!-- Chat da transacao -->
    <div class="intermediation-chat-card">
        <h3 class="chat-title">
            <i class="fas fa-comments" aria-hidden="true"></i>
            pedido @order.Id
        </h3>
        <div class="chat-messages">
            @foreach (var msg in chatMessages)
            {
                <div class="chat-message @(msg.UserRole?.ToLower()) @(msg.UserId == currentUserId ? "mine" : "")">
                    <span class="chat-user">@FormatChatAuthor(msg):</span>
                    <span class="chat-text">@msg.Text</span>
                    <span class="chat-date">@msg.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</span>
                </div>
            }
        </div>
        <div class="chat-input-row">
            <input class="chat-input" @bind="newMessage" placeholder="@T["OrderDetails.ChatPlaceholder"]" />
            <button class="success-btn" @onclick="SendMessage">@T["OrderDetails.Send"]</button>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private OrderModel? order;
    private bool isLoading = true;
    private bool isBuyer, isSeller, isAdmin;
    private string? currentUserId;

    private List<OrderMessage> chatMessages = new();
    private string newMessage = "";

    // Modal de confirmaÃ§Ã£o de entrega
    private bool showConfirmModal = false;
    private string? confirmComment;
    private IBrowserFile? confirmFile;
    private string? confirmError;

    // Modal de evidÃªncia de envio pelo vendedor
    private bool showSellerEvidenceModal = false;
    private IBrowserFile? sellerEvidenceFile;
    private string? sellerEvidenceComment;
    private string? sellerEvidenceError;

    // Modais somente de visualizacao de evidencia
    private bool showSellerEvidenceViewerModal = false;
    private bool showBuyerEvidenceViewerModal = false;

    private bool showReleaseModal = false;
    private string? releaseError;
    private bool showDirectConfirmModal = false;
    private bool luaDeliveryEnabled = false;
    private bool wasConfirmModalOpen;
    private bool wasSellerEvidenceModalOpen;
    private bool wasSellerEvidenceViewerModalOpen;
    private bool wasBuyerEvidenceViewerModalOpen;
    private bool wasReleaseModalOpen;
    private decimal? btcUsdRate;
    private decimal? btcBrlRate;
    private OperationFeeBreakdown? releaseBreakdown;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await SyncModalAccessibilityAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        var quote = await BitcoinQuoteService.GetQuoteAsync();
        btcUsdRate = quote?.btc_usd;
        btcBrlRate = quote?.btc_brl;
        luaDeliveryEnabled = await AdminSettingsService.GetLuaDeliveryEnabledAsync();

        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userId = UserManager.GetUserId(user);
        currentUserId = userId;
        isAdmin = user.IsInRole("admin");

        order = await Db.Orders
            .Include(o => o.Product)
            .Include(o => o.Buyer)
            .Include(o => o.Seller)
            .Include(o => o.Payment) 
            .FirstOrDefaultAsync(o => o.Id == Id);

        if (!OrderAccessService.CanAccess(order, userId, isAdmin))
        {
            order = null;
            isLoading = false;
            return;
        }

        if (order is null)
        {
            isLoading = false;
            return;
        }

        releaseBreakdown = await OperationFeeCalculatorService.CalculateBreakdownAsync(order.Amount);

        isBuyer = order.BuyerId == userId;
        isSeller = order.SellerId == userId;

        chatMessages = await Db.OrderMessages
            .Include(m => m.User)
            .Where(m => m.OrderId == order.Id)
            .OrderBy(m => m.CreatedAt)
            .ToListAsync();

        // Preencher campos de ediÃ§Ã£o de evidÃªncia
        confirmComment = order.BuyerEvidenceComment;
        sellerEvidenceComment = order.SellerEvidenceComment;

        isLoading = false;
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        confirmFile = e.File;
    }

    private MarkupString FormatBtcWithUsd(decimal amount)
    {
        return BtcUsdFormatter.FormatMarkup(amount, btcUsdRate, btcBrlRate, CurrencyPreferenceService.SelectedFiatCurrency);
    }

    private void OnSellerFileSelected(InputFileChangeEventArgs e)
    {
        sellerEvidenceFile = e.File;
    }

    private async Task ConfirmDelivery()
    {
        confirmError = null;
        if (string.IsNullOrWhiteSpace(confirmComment))
        {
            confirmError = T["OrderDetails.ErrorCommentRequired"];
            return;
        }
        if (order != null)
        {
            if (order.BuyerId == null || order.SellerId == null)
            {
                confirmError = "Pedido bloqueado: um dos participantes foi removido.";
                return;
            }
            order.IsDelivered = true;
            order.BuyerEvidenceComment = confirmComment;
            order.BuyerEvidenceAt = DateTime.UtcNow;
            if (confirmFile != null)
            {
                var filePath = await SaveEvidenceFile(confirmFile, $"buyer_{order.Id}");
                order.BuyerEvidencePath = filePath;
            }
            if (!order.UseSiteIntermediary)
            {
                order.Status = PaymentStatus.Finalizado;
                order.FundsReleased = true;
                order.FinishedAt = DateTime.UtcNow;
                order.DeliveredAt = DateTime.UtcNow;
            }
            else
            {
                order.DeliveryPendingApproval = true;
                order.Status = PaymentStatus.AguardandoRevisaoAdm;
            }
            await Db.SaveChangesAsync();
            await Log.AuditAsync(
                AuditEvents.OrderDelivered,
                AuditEntities.Order,
                order.Id.ToString(),
                $"Comprador confirmou recebimento do pedido #{order.Id} (UseSiteIntermediary={order.UseSiteIntermediary}).",
                actorUserId: currentUserId,
                source: "Orders"
            );
            showConfirmModal = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmDirectDelivery()
    {
        if (order == null || !isBuyer || order.IsDelivered || order.UseSiteIntermediary) return;
        if (order.BuyerId == null || order.SellerId == null) return;
        order.IsDelivered = true;
        order.Status = PaymentStatus.Finalizado;
        order.FundsReleased = true;
        order.DeliveredAt = DateTime.UtcNow;
        order.FinishedAt = DateTime.UtcNow;
        await Db.SaveChangesAsync();
        await Log.AuditAsync(
            AuditEvents.OrderDelivered,
            AuditEntities.Order,
            order.Id.ToString(),
            $"Comprador confirmou recebimento direto do pedido #{order.Id} (sem intermedia\u00e7\u00e3o do site).",
            actorUserId: currentUserId,
            source: "Orders"
        );
        showDirectConfirmModal = false;
        StateHasChanged();
    }

    private async Task ConfirmSellerEvidence()
    {
        sellerEvidenceError = null;
        if (string.IsNullOrWhiteSpace(sellerEvidenceComment))
        {
            sellerEvidenceError = T["OrderDetails.ErrorCommentRequired"];
            return;
        }
        if (order != null)
        {
            order.SellerEvidenceComment = sellerEvidenceComment;
            order.SellerEvidenceAt = DateTime.UtcNow;
            // Salvar arquivo se enviado
            if (sellerEvidenceFile != null)
            {
                var filePath = await SaveEvidenceFile(sellerEvidenceFile, $"seller_{order.Id}");
                order.SellerEvidencePath = filePath;
            }
            await Db.SaveChangesAsync();
            showSellerEvidenceModal = false;
            StateHasChanged();
        }
    }

    private static readonly HashSet<string> AllowedEvidenceExtensions = new(StringComparer.OrdinalIgnoreCase)
    {
        ".jpg", ".jpeg", ".png", ".gif", ".webp"
    };

    private static readonly HashSet<string> AllowedContentTypes = new(StringComparer.OrdinalIgnoreCase)
    {
        "image/jpeg", "image/png", "image/gif", "image/webp"
    };

    private async Task<string> SaveEvidenceFile(IBrowserFile file, string prefix)
    {
        var ext = Path.GetExtension(file.Name);
        if (string.IsNullOrEmpty(ext) || !AllowedEvidenceExtensions.Contains(ext))
            throw new InvalidOperationException($"Tipo de arquivo não permitido: {ext}");

        if (!AllowedContentTypes.Contains(file.ContentType))
            throw new InvalidOperationException($"Tipo de conteúdo não permitido: {file.ContentType}");

        var uploads = Path.Combine("wwwroot", "evidences");
        Directory.CreateDirectory(uploads);
        var fileName = $"{prefix}_{DateTime.UtcNow.Ticks}{ext}";
        var filePath = Path.Combine(uploads, fileName);

        using (var stream = File.Create(filePath))
        {
            await file.OpenReadStream(5 * 1024 * 1024).CopyToAsync(stream);
        }
        return $"/evidences/{fileName}";
    }

    private async Task ReleaseFunds()
    {
        if (order == null || !isAdmin) return;

        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var adminUserId = UserManager.GetUserId(authState.User);
        if (string.IsNullOrEmpty(adminUserId) || !authState.User.IsInRole("admin")) return;

        var result = await AdminOrderReleaseService.ReleaseFundsAsync(order.Id, adminUserId);
        if (result.Succeeded)
        {
            releaseError = null;
            order.FundsReleased = true;
            order.Status = PaymentStatus.Finalizado;
            StateHasChanged();
        }
        else if (result.Reason == "ParticipantDeleted")
        {
            releaseError = "Operação bloqueada: um dos participantes do pedido foi removido.";
            StateHasChanged();
        }
    }

    private async Task ConfirmReleaseFunds()
    {
        showReleaseModal = false;
        await ReleaseFunds();
    }

    private void HandleModalKeydown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseAllModals();
        }
    }

    private void CloseAllModals()
    {
        showConfirmModal = false;
        showDirectConfirmModal = false;
        showSellerEvidenceModal = false;
        showSellerEvidenceViewerModal = false;
        showBuyerEvidenceViewerModal = false;
        showReleaseModal = false;
    }

    private async Task SyncModalAccessibilityAsync()
    {
        try
        {
            if (showConfirmModal && !wasConfirmModalOpen)
            {
                await JS.InvokeVoidAsync("ConfirmaiModal.open", "#confirm-delivery-modal");
            }
            else if (showSellerEvidenceModal && !wasSellerEvidenceModalOpen)
            {
                await JS.InvokeVoidAsync("ConfirmaiModal.open", "#seller-evidence-modal");
            }
            else if (showSellerEvidenceViewerModal && !wasSellerEvidenceViewerModalOpen)
            {
                await JS.InvokeVoidAsync("ConfirmaiModal.open", "#seller-evidence-view-modal");
            }
            else if (showBuyerEvidenceViewerModal && !wasBuyerEvidenceViewerModalOpen)
            {
                await JS.InvokeVoidAsync("ConfirmaiModal.open", "#buyer-evidence-view-modal");
            }
            else if (showReleaseModal && !wasReleaseModalOpen)
            {
                await JS.InvokeVoidAsync("ConfirmaiModal.open", "#release-funds-modal");
            }

            if (!showConfirmModal && !showSellerEvidenceModal && !showSellerEvidenceViewerModal && !showBuyerEvidenceViewerModal && !showReleaseModal
                && (wasConfirmModalOpen || wasSellerEvidenceModalOpen || wasSellerEvidenceViewerModalOpen || wasBuyerEvidenceViewerModalOpen || wasReleaseModalOpen))
            {
                await JS.InvokeVoidAsync("ConfirmaiModal.close");
            }
        }
        catch
        {
            // No-op: fallback to native browser focus behavior if JS interop is unavailable.
        }

        wasConfirmModalOpen = showConfirmModal;
        wasSellerEvidenceModalOpen = showSellerEvidenceModal;
        wasSellerEvidenceViewerModalOpen = showSellerEvidenceViewerModal;
        wasBuyerEvidenceViewerModalOpen = showBuyerEvidenceViewerModal;
        wasReleaseModalOpen = showReleaseModal;
    }

    private static string FormatAmount(decimal amount, string? currency)
        => currency switch
        {
            "BRL" => $"R$ {amount:N2}",
            "USD" => $"$ {amount:N2}",
            _ => $"{amount:0.########} BTC"
        };

    private static string FormatBtc(decimal amount)
        => $"{amount:0.########} BTC";

    private async Task SendMessage()
    {
        if (!string.IsNullOrWhiteSpace(newMessage) && order != null)
        {
            var user = await UserManager.GetUserAsync((await AuthProvider.GetAuthenticationStateAsync()).User);
            if (user == null)
                return;

            var role = isAdmin ? "admin" : isBuyer ? "buyer" : isSeller ? "seller" : "other";
            var msg = new OrderMessage
            {
                OrderId = order.Id,
                UserId = user.Id,
                UserRole = role,
                Text = newMessage,
                CreatedAt = DateTime.UtcNow
            };
            Db.OrderMessages.Add(msg);
            await Db.SaveChangesAsync();

            await MirrorOrderMessageToMailboxAsync(user.Id, newMessage.Trim());

            chatMessages.Add(msg);
            newMessage = "";
        }
    }

    private async Task MirrorOrderMessageToMailboxAsync(string senderUserId, string body)
    {
        if (order == null || string.IsNullOrWhiteSpace(senderUserId) || string.IsNullOrWhiteSpace(body))
        {
            return;
        }

        var adminRoleId = await Db.Roles
            .Where(r => r.NormalizedName == "ADMIN")
            .Select(r => r.Id)
            .FirstOrDefaultAsync();

        var adminUserIds = string.IsNullOrWhiteSpace(adminRoleId)
            ? new List<string>()
            : await Db.UserRoles
                .Where(ur => ur.RoleId == adminRoleId)
                .Select(ur => ur.UserId)
                .Distinct()
                .ToListAsync();

        var recipients = new HashSet<string>(StringComparer.Ordinal);
        if (!string.IsNullOrWhiteSpace(order.BuyerId))
            recipients.Add(order.BuyerId);

        if (!string.IsNullOrWhiteSpace(order.SellerId))
        {
            recipients.Add(order.SellerId);
        }

        foreach (var adminId in adminUserIds)
        {
            recipients.Add(adminId);
        }

        recipients.Remove(senderUserId);

        var subject = $"Pedido {order.Id}";
        var now = DateTime.UtcNow;

        foreach (var recipientId in recipients)
        {
            Db.UserMailboxMessages.Add(new UserMailboxMessage
            {
                SenderUserId = senderUserId,
                RecipientUserId = recipientId,
                Subject = subject,
                Body = body,
                IsRead = false,
                CreatedAt = now
            });
        }

        if (recipients.Count > 0)
        {
            await Db.SaveChangesAsync();
        }
    }

    private string FormatChatAuthor(OrderMessage msg)
    {
        var normalized = msg.UserRole?.Trim().ToLowerInvariant();
        return normalized switch
        {
            "admin" => "Admin",
            "buyer" or "comprador" => msg.UserId == null ? "(deletado)" : (string.IsNullOrWhiteSpace(msg.User?.UserName) ? T["AdminOrders.Buyer"] : msg.User!.UserName!),
            "seller" or "vendedor" => msg.UserId == null ? "(deletado)" : (string.IsNullOrWhiteSpace(msg.User?.UserName) ? T["AdminOrders.Seller"] : msg.User!.UserName!),
            _ => T["OrderDetails.Other"]
        };
    }

