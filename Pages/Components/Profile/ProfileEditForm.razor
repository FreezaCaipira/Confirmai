@using Confirmai.Models
@using System.ComponentModel.DataAnnotations

<details class="profile-edit-details">
    <summary class="profile-edit-summary">Editar perfil</summary>
    <div class="profile-edit-form">
        <EditForm Model="EditModel" OnValidSubmit="HandleSaveProfile">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="profile-edit-grid">
                <div class="form-group">
                    <label>Instagram</label>
                    <InputText class="input" @bind-Value="EditModel.InstagramHandle" />
                </div>
                <div class="form-group">
                    <label>Discord</label>
                    <InputText class="input" @bind-Value="EditModel.DiscordHandle" />
                </div>
                <div class="form-group">
                    <label>PIX</label>
                    <InputText class="input" @bind-Value="EditModel.PixKey" />
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(SaveFeedback))
            {
                <p class="profile-feedback" role="status">@SaveFeedback</p>
            }
            <div class="profile-edit-actions">
                <button class="mk-btn mk-btn-primary" type="submit" disabled="@IsSaving">
                    @(IsSaving ? "Salvando..." : "Salvar")
                </button>
            </div>
        </EditForm>
    </div>
</details>
