@using Confirmai.Enums
@using Confirmai.Services.Core
@inject UiTextService T

<section class="panel profile-sport-panel">
    <div class="seg-toggle profile-sport-tabs" role="tablist">
        <button class="seg-item @(ActiveSport == Sport.Futsal ? "seg-item--active" : string.Empty)"
                role="tab" type="button" @onclick='() => HandleSetSport(Sport.Futsal)'>
            @T["Profile.SportFutsal"]
        </button>
        <button class="seg-item @(ActiveSport == Sport.Poker ? "seg-item--active" : string.Empty)"
                role="tab" type="button" @onclick='() => HandleSetSport(Sport.Poker)'>
            @T["Profile.SportPoker"]
        </button>
    </div>

    @if (ActiveSport == Sport.Futsal)
    {
        <div class="profile-sport-stats" role="tabpanel">
            <div class="profile-stat-item">
                <span class="profile-stat-number @(FutsalTotal > 0 ? "profile-stat-number--accent" : string.Empty)">@FutsalTotal</span>
                <span class="profile-stat-label">@T["Profile.StatMatches"]</span>
            </div>
            <div class="profile-stat-item">
                <span class="profile-stat-number">@FutsalOutfieldTotal</span>
                <span class="profile-stat-label">@T["Profile.StatOutfield"]</span>
            </div>
            <div class="profile-stat-item">
                <span class="profile-stat-number">@FutsalGoalkeeperTotal</span>
                <span class="profile-stat-label">@T["Profile.StatGoalkeeper"]</span>
            </div>
        </div>
    }
    else if (ActiveSport == Sport.Poker)
    {
        <div class="profile-sport-stats" role="tabpanel">
            <div class="profile-stat-item">
                <span class="profile-stat-number @(PokerTotal > 0 ? "profile-stat-number--accent" : string.Empty)">@PokerTotal</span>
                <span class="profile-stat-label">@T["Profile.StatSessions"]</span>
            </div>
        </div>
    }
</section>
