@if (!string.IsNullOrWhiteSpace(Feedback))
{
    <p class="profile-feedback" role="status">@Feedback</p>
}

<textarea class="mk-input profile-chat-textarea" rows="3" maxlength="4000"
          placeholder="Digite sua mensagem..." @bind="localMessageBody"></textarea>

<div class="profile-chat-actions">
    <button class="mk-btn mk-btn-primary" type="button"
            @onclick="HandleSendMessage" disabled="@IsSending">
        @(IsSending ? "Enviando..." : "Enviar")
    </button>
    @if (ShowRefreshButton)
    {
        <button class="mk-btn" type="button" @onclick="HandleRefreshChat">Atualizar</button>
    }
</div>
