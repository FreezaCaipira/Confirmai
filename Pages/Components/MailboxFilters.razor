@using Confirmai.Data

<section class="mailbox-filters" aria-label="@T["Mailbox.FiltersAria"]">
    <div class="mailbox-filter-field">
        <label for="mailbox-search">@T["Mailbox.FilterSearch"]</label>
        <input id="mailbox-search" class="mailbox-search mk-input" @bind="SearchTerm" @bind:event="oninput" />
    </div>

    <div class="mailbox-filter-field mailbox-filter-inline">
        <label for="mailbox-page-size">@T["Mailbox.FilterPageSize"]</label>
        <select id="mailbox-page-size" class="mk-input" @bind="PageSize">
            <option value="10">10</option>
            <option value="20">20</option>
            <option value="50">50</option>
        </select>
    </div>

    <div class="mailbox-filter-field mailbox-filter-inline">
        <label class="mailbox-check-label">
            <input type="checkbox" @bind="InboxUnreadOnly" />
            <span>@T["Mailbox.FilterUnreadOnly"]</span>
        </label>
    </div>

    <div class="mailbox-filter-actions">
        <button class="mk-btn mk-btn-primary" type="button" @onclick="HandleApplyFilters">@T["Mailbox.FilterApply"]</button>
        <button class="mk-btn mk-btn-secondary" type="button" @onclick="HandleResetFilters">@T["Mailbox.FilterClear"]</button>
    </div>
</section>
