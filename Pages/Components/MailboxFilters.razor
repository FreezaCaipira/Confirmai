@using Confirmai.Data

<section class="mailbox-filters" aria-label="@T["Mailbox.FiltersAria"]">
    <div class="mailbox-filter-field mailbox-filter-search">
        <label class="mailbox-filter-label" for="mailbox-search"><i class="fas fa-search"></i> @T["Mailbox.FilterSearch"]</label>
        <input id="mailbox-search" class="input" @bind="SearchTerm" @bind:event="oninput" />
    </div>

    <div class="mailbox-filter-field">
        <label class="mailbox-filter-label" for="mailbox-page-size">@T["Mailbox.FilterPageSize"]</label>
        <select id="mailbox-page-size" class="input" @bind="PageSize">
            <option value="10">10</option>
            <option value="20">20</option>
            <option value="50">50</option>
        </select>
    </div>

    <label class="mailbox-check-label">
        <input type="checkbox" @bind="InboxUnreadOnly" />
        <span>@T["Mailbox.FilterUnreadOnly"]</span>
    </label>

    <div class="mailbox-filter-actions">
        <button class="btn btn-secondary btn-sm" type="button" @onclick="HandleApplyFilters">@T["Mailbox.FilterApply"]</button>
        <button class="btn btn-ghost btn-sm" type="button" @onclick="HandleResetFilters">@T["Mailbox.FilterClear"]</button>
    </div>
</section>
