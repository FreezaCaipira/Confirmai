@using Confirmai.Data
@using System.Globalization

<aside class="mailbox-list-pane">
    <div class="seg-toggle mailbox-seg" aria-label="@T["Mailbox.ConversationListAria"]">
        <button class="seg-item @(ShowArchived ? string.Empty : "seg-item--active")" type="button" @onclick="@(() => HandleSwitchFolder(false))">
            @T["Mailbox.TabActive"] <span class="seg-count">@ActiveConversationTotal</span>
        </button>
        <button class="seg-item @(ShowArchived ? "seg-item--active" : string.Empty)" type="button" @onclick="@(() => HandleSwitchFolder(true))">
            @T["Mailbox.TabArchived"] <span class="seg-count">@ArchivedConversationTotal</span>
        </button>
    </div>

    @if (!Conversations.Any())
    {
        <div class="empty-state mailbox-list-empty">
            <i class="fas fa-inbox empty-state-icon"></i>
            <p>@T["Mailbox.NoConversations"]</p>
        </div>
    }
    else
    {
        <div class="mailbox-list">
            @foreach (var contact in Conversations)
            {
                var isSelected = string.Equals(SelectedConversationKey, contact.ConversationKey, StringComparison.Ordinal);
                <div class="mailbox-list-item @(contact.HasUnread ? "mailbox-list-item--unread" : string.Empty) @(isSelected ? "mailbox-list-item--active" : string.Empty)">
                    <button class="mailbox-list-item-main"
                            type="button"
                            @onclick="@(() => HandleSelectConversation(contact.ConversationKey))">
                        <div class="mailbox-list-item-head">
                            <div class="mailbox-list-item-contact">
                                <span class="mailbox-avatar" aria-hidden="true">@BuildAvatarInitials(contact.ConversationTitle)</span>
                                <strong>@contact.ConversationTitle</strong>
                                @if (contact.UnreadCount > 0)
                                {
                                    <span class="mailbox-unread-count">@contact.UnreadCount</span>
                                }
                            </div>
                            <span class="mailbox-list-item-time">@FormatRelativeTime(contact.LastCreatedAt)</span>
                        </div>
                        <div class="mailbox-list-item-snippet">@BuildSnippet(contact.LastBody)</div>
                    </button>

                    <div class="mailbox-list-item-actions">
                        @if (contact.HasUnread)
                        {
                            <button class="btn btn-ghost btn-sm"
                                    type="button"
                                    @onclick="@(() => HandleMarkAsRead(contact.ConversationKey))">
                                @T["Mailbox.MarkAsRead"]
                            </button>
                        }

                        <button class="btn btn-ghost btn-sm"
                                type="button"
                                @onclick="@(() => HandleArchive(contact.ConversationKey))">
                            @(ShowArchived ? T["Mailbox.Unarchive"] : T["Mailbox.Archive"])
                        </button>
                    </div>
                </div>
            }
        </div>

        <div class="mailbox-pagination">
            <button class="btn btn-ghost btn-sm" type="button" disabled="@(CurrentPage <= 1)" @onclick="HandlePreviousPage">@T["Mailbox.PrevPage"]</button>
            <span class="mailbox-pagination-info">@string.Format(T["Mailbox.PageInfo"], CurrentPage, TotalPages(ConversationTotal))</span>
            <button class="btn btn-ghost btn-sm" type="button" disabled="@(CurrentPage >= TotalPages(ConversationTotal))" @onclick="HandleNextPage">@T["Mailbox.NextPage"]</button>
        </div>
    }
</aside>
