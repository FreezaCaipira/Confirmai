@page "/delivery-agents/{Id:int}"

@using Microsoft.EntityFrameworkCore

@inject AppDbContext Db
@inject NavigationManager NavigationManager
@inject UiTextService T

@if (isLoading)
{
    <div class="loading-spinner">@T["DeliveryProfile.Loading"]</div>
}
else if (agent == null)
{
    <div class="alert alert-info">@T["DeliveryProfile.NotFound"]</div>
}
else
{
    <EntityProfileShell
        Kicker="@T["Profile.Kicker"]"
        Title="@agent.Name"
        Subtitle="@T["DeliveryProfile.Subtitle"]">
        <MainContent>
            <h3>@T["Profile.PublicInfo"]</h3>
            <dl>
                <dt>@T["Common.Name"]</dt>
                <dd>@agent.Name</dd>

                <dt>@T["DeliveryProfile.AverageLeadTime"]</dt>
                <dd>@string.Format(T["OrderDetails.BusinessDays"], agent.EstimatedBusinessDays, agent.EstimatedBusinessDays == 1 ? string.Empty : "s")</dd>

                <dt>@T["DeliveryProfile.OperationalStatus"]</dt>
                <dd>
                    @if (agent.IsActive)
                    {
                        <span class="entity-shell-chip ok">@T["AdminDeliveryAgents.Active"]</span>
                    }
                    else
                    {
                        <span class="entity-shell-chip warn">@T["DeliveryProfile.Unavailable"]</span>
                    }
                </dd>
            </dl>
        </MainContent>

        <SideContent>
            <h3>@T["Profile.Privacy"]</h3>
            <p>@T["DeliveryProfile.PrivacyText"]</p>
            <span class="entity-shell-chip ok">@T["DeliveryProfile.NoSensitive"]</span>
        </SideContent>

    </EntityProfileShell>
}

@code {
    [Parameter] public int Id { get; set; }

    private DeliveryAgent? agent;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        agent = await Db.DeliveryAgents
            .AsNoTracking()
            .FirstOrDefaultAsync(d => d.Id == Id);

        isLoading = false;
    }
}
