@page "/venue-manager/venues/edit/{Id:int}"

@attribute [Authorize(Roles = "venue_manager,admin")]

@using Confirmai.Data
@using Confirmai.Enums
@using Confirmai.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using System.Linq
@using System.Security.Claims

@implements IAsyncDisposable

<PageTitle>@(IsNew ? T["VenueEdit.NewTitle"] : T["VenueEdit.EditTitle"]) — Confirmai</PageTitle>

<div class="entity-shell admin-page">

    <section class="entity-shell-grid" aria-label="@(IsNew ? T["VenueEdit.NewTitle"] : T["VenueEdit.EditTitle"])">
        <article class="entity-shell-card entity-shell-main form-card">

            <h1 class="page-section-title">@(IsNew ? T["VenueEdit.NewTitle"] : T["VenueEdit.EditTitle"])</h1>

            @if (isLoading)
            {
                <div class="loading-spinner">@T["VenueEdit.Loading"]</div>
            }
            else if (accessDenied)
            {
                <div class="detail-error">
                    <p>@T["VenueEdit.AccessDenied"]</p>
                    <button class="cancel-btn" type="button"
                            @onclick='() => NavigationManager.NavigateTo("/venue-manager/venues")'>
                        @T["VenueEdit.Back"]
                    </button>
                </div>
            }
            else
            {
                <EditForm Model="model" OnValidSubmit="Save">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="validation-summary" />

                    <div class="form-group">
                        <label>@T["VenueEdit.Name"] <span class="required">*</span></label>
                        <InputText id="venue-name-input" class="input" @bind-Value="model.Name"
                                   placeholder="@T["VenueEdit.NamePlaceholder"]"
                                   autocomplete="off" />
                        @if (hasMapsApiKey)
                        {
                            <small class="form-hint">@T["VenueEdit.MapsHint"]</small>
                        }
                        <ValidationMessage For="@(() => model.Name)" class="validation-message" />
                    </div>

                    <div class="form-row-2">
                        <div class="form-group">
                            <label>@T["VenueEdit.Type"] <span class="required">*</span></label>
                            <InputSelect class="input" @bind-Value="model.Type">
                                @foreach (var t in Enum.GetValues<VenueType>())
                                {
                                    <option value="@t">@VenueTypeLabel(t)</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="form-group">
                            <label>@T["VenueEdit.State"] <span class="required">*</span></label>
                            <InputSelect class="input" @bind-Value="model.StateCode" @bind-Value:after="OnStateChanged">
                                <option value="">@T["VenueEdit.SelectState"]</option>
                                @foreach (var uf in BrazilianStates)
                                {
                                    <option value="@uf">@uf</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => model.StateCode)" class="validation-message" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>@T["VenueEdit.City"] <span class="required">*</span></label>
                        @if (string.IsNullOrEmpty(model.StateCode) || !citiesByState.ContainsKey(model.StateCode))
                        {
                            <InputText class="input" @bind-Value="model.City" placeholder="@T["VenueEdit.SelectState"]" disabled="@(string.IsNullOrEmpty(model.StateCode))" />
                        }
                        else
                        {
                            <InputSelect class="input" @bind-Value="model.City">
                                <option value="">@T["VenueEdit.SelectCity"]</option>
                                @foreach (var city in citiesByState[model.StateCode])
                                {
                                    <option value="@city">@city</option>
                                }
                            </InputSelect>
                        }
                        <ValidationMessage For="@(() => model.City)" class="validation-message" />
                    </div>

                    <div class="form-group">
                        <label>@T["VenueEdit.Address"]</label>
                        <InputText class="input" @bind-Value="model.Address"
                                   placeholder="@(hasMapsApiKey ? T["VenueEdit.AddressAutoPlaceholder"] : T["VenueEdit.AddressPlaceholder"])" />
                        <ValidationMessage For="@(() => model.Address)" class="validation-message" />
                    </div>

                    @if (!IsNew)
                    {
                        <div class="form-group">
                            <label class="switch-label">
                                <InputCheckbox @bind-Value="model.IsActive" />
                                @T["VenueEdit.Active"]
                            </label>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(saveError))
                    {
                        <p class="validation-message">@saveError</p>
                    }

                    <div class="form-actions">
                        <button class="cancel-btn" type="button"
                                @onclick='() => NavigationManager.NavigateTo("/venue-manager/venues")'>
                            @T["VenueEdit.Cancel"]
                        </button>
                        <button class="save-btn" type="submit" disabled="@isSaving">
                            @(isSaving ? T["VenueEdit.Saving"] : T["VenueEdit.Save"])
                        </button>
                    </div>
                </EditForm>
            }
        </article>
    </section>

</div>
