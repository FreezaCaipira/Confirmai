@page "/venue-manager/venues/edit/{Id:int}"

@attribute [Authorize(Roles = "venue_manager,admin")]

@using Confirmai.Data
@using Confirmai.Enums
@using Confirmai.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using System.Linq
@using System.Net.Http.Json
@using System.Security.Claims

@implements IAsyncDisposable

<PageTitle>@(IsNew ? "Nova Quadra" : "Editar Quadra") — Confirmai</PageTitle>

<div class="entity-shell admin-page">

    <section class="entity-shell-grid" aria-label="@(IsNew ? "Nova quadra" : "Editar quadra")">
        <article class="entity-shell-card entity-shell-main form-card">

            <h1 class="page-section-title">@(IsNew ? "Nova Quadra" : "Editar Quadra")</h1>

            @if (isLoading)
            {
                <div class="loading-spinner">Carregando…</div>
            }
            else if (accessDenied)
            {
                <div class="detail-error">
                    <p>Você não tem permissão para editar esta quadra.</p>
                    <button class="cancel-btn" type="button"
                            @onclick='() => NavigationManager.NavigateTo("/venue-manager/venues")'>
                        Voltar
                    </button>
                </div>
            }
            else
            {
                <EditForm Model="model" OnValidSubmit="Save">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="validation-summary" />

                    <div class="form-group">
                        <label>Nome da Quadra <span class="required">*</span></label>
                        <InputText id="venue-name-input" class="input" @bind-Value="model.Name"
                                   placeholder="Ex: Arena do Zé, Society Central…"
                                   autocomplete="off" />
                        <small class="form-hint">Digite o nome para buscar no Google Maps e preencher os campos automaticamente.</small>
                        <ValidationMessage For="@(() => model.Name)" class="validation-message" />
                    </div>

                    <div class="form-row-2">
                        <div class="form-group">
                            <label>Tipo <span class="required">*</span></label>
                            <InputSelect class="input" @bind-Value="model.Type">
                                @foreach (var t in Enum.GetValues<VenueType>())
                                {
                                    <option value="@t">@VenueTypeLabel(t)</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="form-group">
                            <label>UF <span class="required">*</span></label>
                            <InputSelect class="input" @bind-Value="model.StateCode" @bind-Value:after="LoadCitiesAsync">
                                <option value="">Selecione…</option>
                                @foreach (var uf in BrazilianStates)
                                {
                                    <option value="@uf">@uf</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => model.StateCode)" class="validation-message" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Cidade <span class="required">*</span></label>
                        <InputText class="input" @bind-Value="model.City"
                                   list="venue-cities-list" placeholder="São Paulo" autocomplete="off" />
                        <datalist id="venue-cities-list">
                            @foreach (var c in cityOptions)
                            {
                                <option value="@c" />
                            }
                        </datalist>
                        <ValidationMessage For="@(() => model.City)" class="validation-message" />
                    </div>

                    <div class="form-group">
                        <label>Endereço</label>
                        <InputText class="input" @bind-Value="model.Address"
                                   placeholder="Preenchido automaticamente ao selecionar o local" />
                        <ValidationMessage For="@(() => model.Address)" class="validation-message" />
                    </div>

                    @if (!IsNew)
                    {
                        <div class="form-group">
                            <label class="switch-label">
                                <InputCheckbox @bind-Value="model.IsActive" />
                                Ativa
                            </label>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(saveError))
                    {
                        <p class="validation-message">@saveError</p>
                    }

                    <div class="form-actions">
                        <button class="cancel-btn" type="button"
                                @onclick='() => NavigationManager.NavigateTo("/venue-manager/venues")'>
                            Cancelar
                        </button>
                        <button class="save-btn" type="submit" disabled="@isSaving">
                            @(isSaving ? "Salvando…" : "Salvar")
                        </button>
                    </div>
                </EditForm>
            }
        </article>
    </section>

</div>
