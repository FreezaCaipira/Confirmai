@page "/venue-manager/venues"

@attribute [Authorize(Roles = "venue_manager,admin")]

@using Confirmai.Data
@using Confirmai.Enums
@using Confirmai.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims


<PageTitle>Minhas Quadras — Confirmai</PageTitle>

<div class="entity-shell admin-page">

    <section class="entity-shell-grid" aria-label="Gerenciamento de quadras">
        <article class="entity-shell-card entity-shell-main">
            <div class="page-section-header">
                <h1 class="page-section-title">Minhas Quadras</h1>
                <button class="success-btn" type="button"
                        @onclick='() => NavigationManager.NavigateTo("/venue-manager/venues/edit/0")'>
                    <i class="fas fa-plus"></i> Nova Quadra
                </button>
            </div>

            @if (isLoading)
            {
                <p class="listing-state">Carregando…</p>
            }
            else if (!venues.Any())
            {
                <div class="listing-state listing-empty">
                    <p>Você ainda não cadastrou nenhuma quadra.</p>
                    <p class="listing-empty-hint">Use o botão "Nova Quadra" para começar.</p>
                </div>
            }
            else
            {
                <table class="product-table">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Tipo</th>
                            <th>Cidade / UF</th>
                            <th>Status</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in venues)
                        {
                            <tr>
                                <td data-label="Nome">@v.Name</td>
                                <td data-label="Tipo">
                                    <span class="venue-type-badge venue-type-@v.Type.ToString().ToLower()">
                                        @VenueTypeLabel(v.Type)
                                    </span>
                                </td>
                                <td data-label="Cidade / UF">@v.City — @v.StateCode</td>
                                <td data-label="Status">
                                    @if (v.IsActive)
                                    {
                                        <span class="entity-shell-chip ok">Ativa</span>
                                    }
                                    else
                                    {
                                        <span class="entity-shell-chip warn">Inativa</span>
                                    }
                                </td>
                                <td data-label="Ações">
                                    @if (confirmDeleteId == v.Id)
                                    {
                                        <div class="admin-actions-row">
                                            <span class="admin-delete-prompt">Remover?</span>
                                            <button class="danger-btn action-btn icon-only" title="Confirmar remoção"
                                                    @onclick='() => DeleteVenue(v.Id)'>
                                                <i class="fas fa-check"></i>
                                            </button>
                                            <button class="cancel-btn action-btn icon-only" title="Cancelar"
                                                    @onclick='() => confirmDeleteId = null'>
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="admin-actions-row">
                                            <button class="edit-btn action-btn icon-only"
                                                    @onclick='() => NavigationManager.NavigateTo($"/venue-manager/venues/edit/{v.Id}")'
                                                    title="Editar" aria-label="Editar">
                                                <i class="fas fa-pencil-alt"></i>
                                            </button>
                                            <button class="danger-btn action-btn icon-only"
                                                    @onclick='() => { confirmDeleteId = v.Id; deleteError = string.Empty; }'
                                                    title="Remover" aria-label="Remover">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (!string.IsNullOrWhiteSpace(deleteError))
            {
                <p class="validation-message">@deleteError</p>
            }
        </article>
    </section>

</div>
