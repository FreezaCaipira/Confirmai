@page "/venue-manager/venues"

@attribute [Authorize(Roles = "venue_manager,admin")]

@using Confirmai.Data
@using Confirmai.Enums
@using Confirmai.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims


<PageTitle>@T["VenueManager.Title"] — Confirmai</PageTitle>

<div class="entity-shell admin-page">

    <section class="entity-shell-grid" aria-label="@T["VenueManager.Aria"]">
        <article class="entity-shell-card entity-shell-main">
            <div class="page-section-header">
                <h1 class="page-section-title">@T["VenueManager.Title"]</h1>
                <button class="success-btn" type="button"
                        @onclick='() => NavigationManager.NavigateTo("/venue-manager/venues/edit/0")'>
                    <i class="fas fa-plus"></i> @T["VenueManager.AddNew"]
                </button>
            </div>

            @if (isLoading)
            {
                <p class="listing-state">@T["VenueManager.Loading"]</p>
            }
            else if (!venues.Any())
            {
                <div class="listing-state listing-empty">
                    <p>@T["VenueManager.Empty"]</p>
                    <p class="listing-empty-hint">@T["VenueManager.EmptyHint"]</p>
                </div>
            }
            else
            {
                <table class="product-table">
                    <thead>
                        <tr>
                            <th>@T["VenueManager.ColName"]</th>
                            <th>@T["VenueManager.ColType"]</th>
                            <th>@T["VenueManager.ColCity"]</th>
                            <th>@T["VenueManager.ColStatus"]</th>
                            <th>@T["VenueManager.ColActions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in venues)
                        {
                            <tr>
                                <td data-label="@T["VenueManager.ColName"]">@v.Name</td>
                                <td data-label="@T["VenueManager.ColType"]">
                                    <span class="venue-type-badge venue-type-@v.Type.ToString().ToLower()">
                                        @VenueTypeLabel(v.Type)
                                    </span>
                                </td>
                                <td data-label="@T["VenueManager.ColCity"]">@v.City — @v.StateCode</td>
                                <td data-label="@T["VenueManager.ColStatus"]">
                                    @if (v.IsActive)
                                    {
                                        <span class="entity-shell-chip ok">@T["VenueManager.StatusActive"]</span>
                                    }
                                    else
                                    {
                                        <span class="entity-shell-chip warn">@T["VenueManager.StatusInactive"]</span>
                                    }
                                </td>
                                <td data-label="@T["VenueManager.ColActions"]">
                                    @if (confirmDeleteId == v.Id)
                                    {
                                        <div class="admin-actions-row">
                                            <span class="admin-delete-prompt">@T["VenueManager.ConfirmDelete"]</span>
                                            <button class="danger-btn action-btn icon-only" title="@T["Common.Confirm"]"
                                                    @onclick='() => DeleteVenue(v.Id)'>
                                                <i class="fas fa-check"></i>
                                            </button>
                                            <button class="cancel-btn action-btn icon-only" title="@T["Common.Cancel"]"
                                                    @onclick='() => confirmDeleteId = null'>
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="admin-actions-row">
                                            <button class="edit-btn action-btn icon-only"
                                                    @onclick='() => NavigationManager.NavigateTo($"/venue-manager/venues/edit/{v.Id}")'
                                                    title="@T["VenueManager.Edit"]" aria-label="@T["VenueManager.Edit"]">
                                                <i class="fas fa-pencil-alt"></i>
                                            </button>
                                            <button class="danger-btn action-btn icon-only"
                                                    @onclick='() => { confirmDeleteId = v.Id; deleteError = string.Empty; }'
                                                    title="@T["VenueManager.Delete"]" aria-label="@T["VenueManager.Delete"]">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (!string.IsNullOrWhiteSpace(deleteError))
            {
                <p class="validation-message">@deleteError</p>
            }
        </article>
    </section>

</div>
