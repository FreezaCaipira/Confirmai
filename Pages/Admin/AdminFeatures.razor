@page "/admin/features"

@attribute [Authorize(Roles = "admin")]

@using Confirmai.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using System.Security.Claims

@inject AdminSettingsService AdminSettingsService
@inject LogService LogService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@inject UiTextService T

<div class="entity-shell admin-page admin-features-shell">

    <PageTitle>Features — Confirmai</PageTitle>

    <section class="entity-shell-grid" aria-label="@T["AdminFeatures.Aria"]">
        <article class="entity-shell-card entity-shell-main">
            <h1 class="page-section-title">@T["AdminFeatures.Title"]</h1>
            <p class="admin-features-subtitle">@T["AdminFeatures.Subtitle"]</p>

            @if (isLoading)
            {
                <div class="loading-spinner">@T["Common.Loading"]</div>
            }
            else
            {
                <div class="admin-features-list">
                    @foreach (var feature in features)
                    {
                        <div class="admin-feature-card @(feature.Enabled ? "feature-enabled" : "feature-disabled")">
                            <div class="admin-feature-header">
                                <div class="admin-feature-info">
                                    <span class="admin-feature-name">@feature.Name</span>
                                    <span class="admin-feature-badge @(feature.Enabled ? "badge-feature-on" : "badge-feature-off")">
                                        @(feature.Enabled ? T["AdminFeatures.Enabled"] : T["AdminFeatures.Disabled"])
                                    </span>
                                </div>
                                <label class="switch-toggle" title="@(feature.Enabled ? T["AdminFeatures.Disabled"] : T["AdminFeatures.Enabled"])">
                                    <input type="checkbox"
                                           checked="@feature.Enabled"
                                           @onchange="async (e) => await OnToggleFeature(feature, (bool)(e.Value ?? false))" />
                                    <span class="slider"></span>
                                </label>
                            </div>
                            <p class="admin-feature-description">@feature.Description</p>
                            @if (!feature.Enabled)
                            {
                                <p class="admin-feature-fallback"><i class="fas fa-info-circle"></i> @feature.FallbackDescription</p>
                            }
                        </div>
                    }
                </div>
            }
        </article>
    </section>

    <section class="entity-shell-footer" aria-label="Ações">
        <button class="back-btn" @onclick='() => NavigationManager.NavigateTo("/admin")'>@T["AdminFeatures.Back"]</button>
    </section>
</div>

@code {
    [CascadingParameter] public Toast? ToastRef { get; set; }

    private bool isLoading = true;
    private ClaimsPrincipal? currentUser;
    private List<FeatureFlag> features = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUser = authState.User;

        var luaEnabled = await AdminSettingsService.GetLuaDeliveryEnabledForAdminAsync(currentUser);

        features = new List<FeatureFlag>
        {
            new FeatureFlag(
                Key: AdminSettingsService.LuaDeliveryEnabledKey,
                Name: T["AdminFeatures.LuaName"],
                Description: T["AdminFeatures.LuaDescription"],
                FallbackDescription: T["AdminFeatures.LuaFallback"],
                Enabled: luaEnabled
            )
        };

        isLoading = false;
    }

    private async Task OnToggleFeature(FeatureFlag feature, bool newValue)
    {
        var verb = newValue ? T["AdminFeatures.VerbEnable"] : T["AdminFeatures.VerbDisable"];
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            string.Format(T["AdminFeatures.ConfirmToggle"], verb, feature.Name));

        if (!confirmed)
        {
            // Revert visual state without touching the DB
            StateHasChanged();
            return;
        }

        try
        {
            if (feature.Key == AdminSettingsService.LuaDeliveryEnabledKey)
            {
                await AdminSettingsService.SetLuaDeliveryEnabledForAdminAsync(currentUser, newValue);
            }

            var idx = features.IndexOf(feature);
            features[idx] = feature with { Enabled = newValue };

            await LogService.LogAsync(
                string.Format(T["AdminFeatures.LogChanged"], feature.Name, newValue ? T["AdminFeatures.VerbEnable"] : T["AdminFeatures.VerbDisable"]),
                source: "Admin",
                level: newValue ? "Info" : "Warning",
                userId: currentUser?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value);

            var msg = newValue
                ? string.Format(T["AdminFeatures.ToastEnabled"], feature.Name)
                : string.Format(T["AdminFeatures.ToastDisabled"], feature.Name);
            ToastRef?.Show(msg, newValue ? "success" : "warning");
        }
        catch (UnauthorizedAccessException)
        {
            ToastRef?.Show(T["AdminFeatures.AccessDenied"], "error");
        }

        StateHasChanged();
    }

    private record FeatureFlag(string Key, string Name, string Description, string FallbackDescription, bool Enabled);
}
