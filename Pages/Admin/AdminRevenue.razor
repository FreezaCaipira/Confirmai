@page "/admin/revenue"

@attribute [Authorize(Roles = "admin")]

@using Confirmai.Services.Admin
@using Confirmai.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@using Confirmai.Services.Core
@inject UiTextService T


<PageTitle>@T["AdminRevenue.PageTitle"]</PageTitle>

<div class="entity-shell admin-page">
    <section class="entity-shell-grid" aria-label="@T["AdminRevenue.Title"]">
        <article class="entity-shell-card entity-shell-main">
            <h1 class="page-section-title">@T["AdminRevenue.Title"]</h1>

            <div class="admin-revenue-filters">
                <div class="admin-revenue-filter-row">
                    <label class="admin-revenue-label">@T["AdminRevenue.StartDate"]</label>
                    <input type="date" class="admin-revenue-input" @bind="startDate" />
                </div>
                <div class="admin-revenue-filter-row">
                    <label class="admin-revenue-label">@T["AdminRevenue.EndDate"]</label>
                    <input type="date" class="admin-revenue-input" @bind="endDate" />
                </div>
                <button class="admin-revenue-btn" @onclick="LoadReportAsync">
                    <i class="fas fa-search"></i> @T["AdminRevenue.Filter"]
                </button>
                <button class="admin-revenue-btn admin-revenue-btn--secondary" @onclick="ClearFilters">
                    <i class="fas fa-times"></i> @T["AdminRevenue.Clear"]
                </button>
            </div>

            @if (isLoading)
            {
                <p class="listing-state">@T["AdminRevenue.Loading"]</p>
            }
            else if (summary is not null)
            {
                <div class="admin-revenue-summary">
                    <h2 class="admin-revenue-section-title">@T["AdminRevenue.Summary"]</h2>
                    <div class="admin-revenue-grid">
                        <div class="admin-revenue-card">
                            <span class="admin-revenue-card-label">@T["AdminRevenue.Transactions"]</span>
                            <span class="admin-revenue-card-value">@summary.TotalTransactions</span>
                        </div>
                        <div class="admin-revenue-card admin-revenue-card--highlight">
                            <span class="admin-revenue-card-label">@T["AdminRevenue.FeesCollected"]</span>
                            <span class="admin-revenue-card-value">R$ @summary.TotalFeesCollected.ToString("N2", PtBr)</span>
                        </div>
                        <div class="admin-revenue-card">
                            <span class="admin-revenue-card-label">@T["AdminRevenue.BaseAmount"]</span>
                            <span class="admin-revenue-card-value">R$ @summary.TotalBaseAmount.ToString("N2", PtBr)</span>
                        </div>
                    </div>
                    <div class="admin-revenue-grid">
                        <div class="admin-revenue-card admin-revenue-card--success">
                            <span class="admin-revenue-card-label">@T["AdminRevenue.PayoutsSent"]</span>
                            <span class="admin-revenue-card-value">@summary.TotalPayoutsSent</span>
                        </div>
                        <div class="admin-revenue-card admin-revenue-card--success">
                            <span class="admin-revenue-card-label">@T["AdminRevenue.PayoutsConfirmed"]</span>
                            <span class="admin-revenue-card-value">@summary.TotalPayoutsConfirmed</span>
                        </div>
                        <div class="admin-revenue-card admin-revenue-card--warning">
                            <span class="admin-revenue-card-label">@T["AdminRevenue.PayoutsPending"]</span>
                            <span class="admin-revenue-card-value">@summary.TotalPayoutsPending</span>
                        </div>
                        <div class="admin-revenue-card admin-revenue-card--error">
                            <span class="admin-revenue-card-label">@T["AdminRevenue.PayoutsFailed"]</span>
                            <span class="admin-revenue-card-value">@summary.TotalPayoutsFailed</span>
                        </div>
                    </div>
                </div>

                @if (groupBreakdown.Any())
                {
                    <div class="admin-revenue-breakdown">
                        <h2 class="admin-revenue-section-title">@T["AdminRevenue.ByGroup"]</h2>
                        <table class="admin-revenue-table">
                            <thead>
                                <tr>
                                    <th>@T["AdminRevenue.Group"]</th>
                                    <th>@T["AdminRevenue.Transactions"]</th>
                                    <th>@T["AdminRevenue.Fees"]</th>
                                    <th>@T["AdminRevenue.BaseAmount"]</th>
                                    <th>@T["AdminRevenue.Sent"]</th>
                                    <th>@T["AdminRevenue.Confirmed"]</th>
                                    <th>@T["AdminRevenue.Pending"]</th>
                                    <th>@T["AdminRevenue.Failed"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var group in groupBreakdown)
                                {
                                    <tr>
                                        <td>@group.GroupName</td>
                                        <td>@group.TotalTransactions</td>
                                        <td>R$ @group.TotalFeesCollected.ToString("N2", PtBr)</td>
                                        <td>R$ @group.TotalBaseAmount.ToString("N2", PtBr)</td>
                                        <td>@group.TotalPayoutsSent</td>
                                        <td>@group.TotalPayoutsConfirmed</td>
                                        <td>@group.TotalPayoutsPending</td>
                                        <td>@group.TotalPayoutsFailed</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="listing-state">@T["AdminRevenue.NoData"]</p>
                }
            }
        </article>
    </section>

    <section class="entity-shell-footer" aria-label="@T["AdminCommon.ExtraActions"]">
        <button class="back-btn" @onclick='() => NavigationManager.NavigateTo("/admin")'>@T["AdminRevenue.Back"]</button>
    </section>
</div>
