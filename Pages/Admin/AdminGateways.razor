@page "/admin/gateways"

@attribute [Authorize(Roles = "admin")]

@using Confirmai.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop


<div class="entity-shell admin-page admin-gateways-shell">

    <section class="entity-shell-grid" aria-label="@T["AdminGateways.Aria"]">
        <article class="entity-shell-card entity-shell-main">
            <h1 class="page-section-title">@T["AdminGateways.Title"]</h1>
            @if (isLoading)
            {
                <div class="loading-spinner">@T["Common.Loading"]</div>
            }
            else
            {
            <table class="product-table gateways-table">
                <thead>
                    <tr>
                        <th>@T["Common.Name"]</th>
                        <th class="status-col">@T["Common.Status"]</th>
                        <th class="status-col">@T["AdminGateways.CredentialsHeader"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var method in methods)
                {
                    var isConfigured = configuredGatewayNames.Contains(method.Name);
                    <tr>
                        <td>@method.Name</td>
                        <td class="gateway-status">
                            <label class="switch-toggle">
                                <input type="checkbox"
                                       @bind="method.Enabled"
                                       @bind:event="onchange"
                                       @bind:after="async () => await OnSwitchChanged(method)" />
                                <span class="slider"></span>
                            </label>
                            <span class="gateway-status-label @(method.Enabled ? "active" : "inactive")">
                                @(method.Enabled ? T["AdminGateways.Active"] : T["AdminGateways.Inactive"])
                            </span>
                        </td>
                        <td class="gateway-status">
                            @if (isConfigured)
                            {
                                <span class="gateway-status-label active">@T["AdminGateways.Configured"]</span>
                            }
                            else
                            {
                                <span class="gateway-status-label inactive" title="@T["AdminGateways.NotConfiguredHint"]">⚠ @T["AdminGateways.NotConfigured"]</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            }
        </article>
    </section>

    <section class="entity-shell-footer" aria-label="@T["AdminCommon.ExtraActions"]">
        <button class="back-btn" @onclick='() => NavigationManager.NavigateTo("/admin")'>@T["Common.Back"]</button>
    </section>
</div>
