@page "/admin/server-requests"

@attribute [Authorize(Roles = "admin")]

@using Microsoft.AspNetCore.Authorization
@using Confirmai.Enums
@inject ServerRegistrationRequestService ServerRegistrationRequestService
@inject AuthenticationStateProvider AuthStateProvider
@inject UiTextService T

<PageTitle>@T["AdminServerRequests.PageTitle"]</PageTitle>

<div class="entity-shell parchment-a admin-page admin-server-requests-shell">

    <section class="entity-shell-grid" aria-label="@T["AdminServerRequests.Aria"]">
        <article class="entity-shell-card entity-shell-main">
            <h1 class="page-section-title">@T["AdminServerRequests.Title"]</h1>
            @if (isLoading)
            {
                <div class="loading-spinner">@T["Common.Loading"]</div>
            }
            else
            {
                <div class="admin-kpi-grid server-requests-kpis">
                    <article class="admin-kpi-card">
                        <p class="admin-kpi-label">@T["AdminServerRequests.KpiPending"]</p>
                        <p class="admin-kpi-value">@pendingRequests.Count</p>
                    </article>
                    <article class="admin-kpi-card">
                        <p class="admin-kpi-label">@T["AdminServerRequests.KpiApproved"]</p>
                        <p class="admin-kpi-value">@reviewedRequests.Count(r => r.Status == ServerRegistrationRequestStatus.Approved)</p>
                    </article>
                    <article class="admin-kpi-card">
                        <p class="admin-kpi-label">@T["AdminServerRequests.KpiRejected"]</p>
                        <p class="admin-kpi-value">@reviewedRequests.Count(r => r.Status == ServerRegistrationRequestStatus.Rejected)</p>
                    </article>
                    <article class="admin-kpi-card">
                        <p class="admin-kpi-label">@T["AdminServerRequests.KpiTotal"]</p>
                        <p class="admin-kpi-value">@reviewedRequests.Count</p>
                    </article>
                </div>

                <div class="filter-bar admin-filter-card server-requests-filter-card">
                    <input type="text" @bind="searchText" @bind:event="oninput" placeholder="@T["AdminServerRequests.FilterSearch"]" />
                    <input type="date" @bind="fromDate" />
                    <input type="date" @bind="toDate" />
                    <select @bind="reviewedStatusFilter">
                        <option value="all">@T["AdminServerRequests.FilterReviewedAll"]</option>
                        <option value="approved">@T["AdminServerRequests.FilterApproved"]</option>
                        <option value="rejected">@T["AdminServerRequests.FilterRejected"]</option>
                    </select>
                    <div class="filter-action-buttons">
                        <button type="button" @onclick="ApplyFilters">@T["AdminServerRequests.Filter"]</button>
                        <button type="button" class="back-btn" @onclick="ClearFilters">@T["AdminServerRequests.Clear"]</button>
                        <button type="button" class="details-btn" @onclick="RefreshAsync">@T["AdminServerRequests.Refresh"]</button>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(statusMessage))
                {
                    <p class="@(statusMessageIsError ? "error-msg" : "success-msg")">@statusMessage</p>
                }

                <div class="server-header-row">
                    <h3>@T["AdminServerRequests.PendingTitle"]</h3>
                    <span class="identity-muted">@filteredPendingRequests.Count @T["AdminServerRequests.PendingCount"]</span>
                </div>

                <section class="server-requests-section">
                @if (!pagedPendingRequests.Any())
                {
                    <div class="admin-server-empty">@T["AdminServerRequests.EmptyPending"]</div>
                }
                else
                {
                    <div class="server-requests-table-wrap">
                    <table class="product-table admin-server-requests-table">
                        <thead>
                            <tr>
                                <th>@T["AdminServerRequests.ColId"]</th>
                                <th>@T["AdminServerRequests.ColServer"]</th>
                                <th>@T["AdminServerRequests.ColVersion"]</th>
                                <th>@T["AdminServerRequests.ColRegion"]</th>
                                <th>@T["AdminServerRequests.ColSite"]</th>
                                <th>@T["AdminServerRequests.ColRequester"]</th>
                                <th>@T["AdminServerRequests.ColCreatedAt"]</th>
                                <th>@T["AdminServerRequests.ColActions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in pagedPendingRequests)
                            {
                                <tr>
                                    <td data-label="ID">#@request.Id</td>
                                    <td data-label="Servidor">
                                        <b>@request.RequestedName</b>
                                        @if (!string.IsNullOrWhiteSpace(request.RequestedLogoPath))
                                        {
                                            <div><img src="@request.RequestedLogoPath" alt="Logo @request.RequestedName" class="server-request-logo-thumb" /></div>
                                        }
                                    </td>
                                    <td data-label="Versao">@request.TibiaVersion</td>
                                    <td data-label="Regiao">@(GetRequestRegion(request) ?? "-")</td>
                                    <td data-label="Site">
                                        @if (!string.IsNullOrWhiteSpace(request.WebsiteUrl))
                                        {
                                            <a href="@request.WebsiteUrl" target="_blank" rel="noopener noreferrer">@T["AdminServerRequests.OpenSite"]</a>
                                        }
                                        else
                                        {
                                            <span class="identity-muted">-</span>
                                        }
                                    </td>
                                    <td data-label="Solicitante">@(request.RequesterUser?.Email ?? request.RequesterUserId)</td>
                                    <td data-label="Criado em">@request.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td data-label="Acoes">
                                        <div class="server-request-row-actions">
                                            <input type="text"
                                                   class="input"
                                                   value="@GetReviewNote(request.Id)"
                                                   @oninput="(ChangeEventArgs e) => SetReviewNote(request.Id, e.Value?.ToString())"
                                                   placeholder="@T["AdminServerRequests.NotePlaceholder"]"
                                                   disabled="@processingRequestIds.Contains(request.Id)" />
                                            <div class="server-request-row-buttons">
                                                <button class="success-btn" type="button" @onclick="() => ApproveAsync(request.Id)" disabled="@processingRequestIds.Contains(request.Id)">@T["AdminServerRequests.Approve"]</button>
                                                <button class="danger" type="button" @onclick="() => RejectAsync(request.Id)" disabled="@processingRequestIds.Contains(request.Id)">@T["AdminServerRequests.Reject"]</button>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>

                    <div class="pagination">
                        <button type="button" @onclick="PrevPendingPage" disabled="@(pendingPage <= 1)">@T["AdminServerRequests.Prev"]</button>
                        <span class="pagination-info">@T["AdminServerRequests.Page"] @pendingPage @T["AdminServerRequests.PageOf"] @pendingTotalPages</span>
                        <button type="button" @onclick="NextPendingPage" disabled="@(pendingPage >= pendingTotalPages)">@T["AdminServerRequests.Next"]</button>
                    </div>
                }
                </section>

                <div class="server-header-row server-reviewed-header">
                    <h3>@T["AdminServerRequests.ReviewedTitle"]</h3>
                    <span class="identity-muted">@filteredReviewedRequests.Count @T["AdminServerRequests.ReviewedCount"]</span>
                </div>

                <section class="server-requests-section">
                @if (!pagedReviewedRequests.Any())
                {
                    <div class="admin-server-empty">@T["AdminServerRequests.EmptyReviewed"]</div>
                }
                else
                {
                    <div class="server-requests-table-wrap">
                    <table class="product-table admin-server-requests-table">
                        <thead>
                            <tr>
                                <th>@T["AdminServerRequests.ColId"]</th>
                                <th>@T["AdminServerRequests.ColServer"]</th>
                                <th>@T["AdminServerRequests.ColVersion"]</th>
                                <th>@T["AdminServerRequests.ColStatus"]</th>
                                <th>@T["AdminServerRequests.ColReviewedAt"]</th>
                                <th>@T["AdminServerRequests.ColGm"]</th>
                                <th>@T["AdminServerRequests.ColNote"]</th>
                                <th>@T["AdminServerRequests.ColServerCreated"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in pagedReviewedRequests)
                            {
                                <tr>
                                    <td data-label="ID">#@request.Id</td>
                                    <td data-label="Servidor">@request.RequestedName</td>
                                    <td data-label="Versao">@request.TibiaVersion</td>
                                    <td data-label="Status">
                                        <span class="order-status-badge @GetStatusBadgeClass(request.Status)">@GetStatusLabel(request.Status)</span>
                                    </td>
                                    <td data-label="Revisado em">@request.ReviewedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td data-label="GM">
                                        @if (!string.IsNullOrWhiteSpace(request.RequesterUserId))
                                        {
                                            <a href="@($"/profile/{request.RequesterUserId}")">@(request.RequesterUser?.Email ?? request.RequesterUserId)</a>
                                        }
                                        else
                                        {
                                            <span class="identity-muted">-</span>
                                        }
                                    </td>
                                    <td data-label="Observacao">@(string.IsNullOrWhiteSpace(request.ReviewNote) ? "-" : request.ReviewNote)</td>
                                    <td data-label="Servidor criado">
                                        @if (request.Status == ServerRegistrationRequestStatus.Approved && request.ApprovedServerId.HasValue)
                                        {
                                            <a class="details-btn action-btn" href="@($"/servers/{request.ApprovedServerId.Value}"))">@T["AdminServerRequests.Open"]</a>
                                        }
                                        else
                                        {
                                            <span class="identity-muted">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>

                    <div class="pagination">
                        <button type="button" @onclick="PrevReviewedPage" disabled="@(reviewedPage <= 1)">@T["AdminServerRequests.Prev"]</button>
                        <span class="pagination-info">@T["AdminServerRequests.Page"] @reviewedPage @T["AdminServerRequests.PageOf"] @reviewedTotalPages</span>
                        <button type="button" @onclick="NextReviewedPage" disabled="@(reviewedPage >= reviewedTotalPages)">@T["AdminServerRequests.Next"]</button>
                    </div>
                }
                </section>
            }
        </article>
    </section>
</div>

@code {
    private bool isLoading = true;
    private string? statusMessage;
    private bool statusMessageIsError;
    private string reviewerUserId = string.Empty;
    private string searchText = string.Empty;
    private string reviewedStatusFilter = "all";
    private DateTime? fromDate;
    private DateTime? toDate;
    private List<ServerRegistrationRequest> pendingRequests = new();
    private List<ServerRegistrationRequest> reviewedRequests = new();
    private List<ServerRegistrationRequest> filteredPendingRequests = new();
    private List<ServerRegistrationRequest> filteredReviewedRequests = new();
    private List<ServerRegistrationRequest> pagedPendingRequests = new();
    private List<ServerRegistrationRequest> pagedReviewedRequests = new();
    private readonly HashSet<int> processingRequestIds = new();
    private Dictionary<int, string> reviewNotes = new();
    private int pendingPage = 1;
    private int reviewedPage = 1;
    private const int PendingPageSize = 8;
    private const int ReviewedPageSize = 8;
    private int pendingTotalPages => Math.Max(1, (int)Math.Ceiling(filteredPendingRequests.Count / (double)PendingPageSize));
    private int reviewedTotalPages => Math.Max(1, (int)Math.Ceiling(filteredReviewedRequests.Count / (double)ReviewedPageSize));

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        reviewerUserId = authState.User.FindFirst(c =>
                c.Type == "sub"
                || c.Type.Contains("nameidentifier", StringComparison.OrdinalIgnoreCase))
            ?.Value ?? string.Empty;

        await LoadDataAsync();
        isLoading = false;
    }

    private async Task LoadDataAsync()
    {
        pendingRequests = await ServerRegistrationRequestService.GetPendingAsync();
        reviewedRequests = await ServerRegistrationRequestService.GetRecentReviewedAsync();

        foreach (var request in pendingRequests)
        {
            if (!reviewNotes.ContainsKey(request.Id))
            {
                reviewNotes[request.Id] = string.Empty;
            }
        }

        ApplyFilters();
    }

    private async Task ApproveAsync(int requestId)
    {
        if (string.IsNullOrWhiteSpace(reviewerUserId))
        {
            statusMessageIsError = true;
            statusMessage = T["AdminServerRequests.ErrorNoAdmin"];
            return;
        }

        if (processingRequestIds.Contains(requestId))
        {
            return;
        }

        var note = reviewNotes.TryGetValue(requestId, out var value) ? value : null;

        processingRequestIds.Add(requestId);
        try
        {
            var result = await ServerRegistrationRequestService.ApproveAsync(requestId, reviewerUserId, note);
            statusMessageIsError = !result.Succeeded;
            statusMessage = result.Succeeded && result.ServerId.HasValue
                ? $"{result.Message} ID do servidor: {result.ServerId.Value}."
                : result.Message;

            await LoadDataAsync();
        }
        finally
        {
            processingRequestIds.Remove(requestId);
        }
    }

    private async Task RejectAsync(int requestId)
    {
        if (string.IsNullOrWhiteSpace(reviewerUserId))
        {
            statusMessageIsError = true;
            statusMessage = T["AdminServerRequests.ErrorNoAdmin"];
            return;
        }

        if (processingRequestIds.Contains(requestId))
        {
            return;
        }

        var note = reviewNotes.TryGetValue(requestId, out var value) ? value : null;

        processingRequestIds.Add(requestId);
        try
        {
            var result = await ServerRegistrationRequestService.RejectAsync(requestId, reviewerUserId, note);
            statusMessageIsError = !result.Succeeded;
            statusMessage = result.Message;

            await LoadDataAsync();
        }
        finally
        {
            processingRequestIds.Remove(requestId);
        }
    }

    private async Task RefreshAsync()
    {
        await LoadDataAsync();
        statusMessageIsError = false;
        statusMessage = T["AdminServerRequests.Refreshed"];
    }

    private void ApplyFilters()
    {
        filteredPendingRequests = pendingRequests
            .Where(MatchesSearch)
            .Where(MatchesCreatedDate)
            .ToList();

        filteredReviewedRequests = reviewedRequests
            .Where(MatchesSearch)
            .Where(MatchesReviewedStatus)
            .Where(MatchesReviewedDate)
            .ToList();

        pendingPage = Math.Clamp(pendingPage, 1, pendingTotalPages);
        reviewedPage = Math.Clamp(reviewedPage, 1, reviewedTotalPages);

        UpdatePagedLists();
    }

    private void ClearFilters()
    {
        searchText = string.Empty;
        reviewedStatusFilter = "all";
        fromDate = null;
        toDate = null;
        pendingPage = 1;
        reviewedPage = 1;
        ApplyFilters();
    }

    private void UpdatePagedLists()
    {
        pagedPendingRequests = filteredPendingRequests
            .Skip((pendingPage - 1) * PendingPageSize)
            .Take(PendingPageSize)
            .ToList();

        pagedReviewedRequests = filteredReviewedRequests
            .Skip((reviewedPage - 1) * ReviewedPageSize)
            .Take(ReviewedPageSize)
            .ToList();
    }

    private void NextPendingPage()
    {
        if (pendingPage < pendingTotalPages)
        {
            pendingPage++;
            UpdatePagedLists();
        }
    }

    private void PrevPendingPage()
    {
        if (pendingPage > 1)
        {
            pendingPage--;
            UpdatePagedLists();
        }
    }

    private void NextReviewedPage()
    {
        if (reviewedPage < reviewedTotalPages)
        {
            reviewedPage++;
            UpdatePagedLists();
        }
    }

    private void PrevReviewedPage()
    {
        if (reviewedPage > 1)
        {
            reviewedPage--;
            UpdatePagedLists();
        }
    }

    private string GetReviewNote(int requestId)
    {
        return reviewNotes.TryGetValue(requestId, out var value) ? value : string.Empty;
    }

    private void SetReviewNote(int requestId, string? value)
    {
        reviewNotes[requestId] = value ?? string.Empty;
    }

    private string GetStatusLabel(ServerRegistrationRequestStatus status)
    {
        return status switch
        {
            ServerRegistrationRequestStatus.Pending => T["AdminServerRequests.StatusPending"],
            ServerRegistrationRequestStatus.Approved => T["AdminServerRequests.StatusApproved"],
            ServerRegistrationRequestStatus.Rejected => T["AdminServerRequests.StatusRejected"],
            _ => "-"
        };
    }

    private static string GetStatusBadgeClass(ServerRegistrationRequestStatus status)
    {
        return status switch
        {
            ServerRegistrationRequestStatus.Pending => "aguardandorevisaoadm",
            ServerRegistrationRequestStatus.Approved => "pago",
            ServerRegistrationRequestStatus.Rejected => "cancelado",
            _ => "outro"
        };
    }

    private static string? GetRequestRegion(ServerRegistrationRequest request)
    {
        if (string.IsNullOrWhiteSpace(request.RequestNote))
        {
            return null;
        }

        const string prefix = "Regiao:";
        var lines = request.RequestNote.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        foreach (var line in lines)
        {
            if (line.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
            {
                var value = line[prefix.Length..].Trim();
                return string.IsNullOrWhiteSpace(value) ? null : value;
            }
        }

        return null;
    }

    private bool MatchesSearch(ServerRegistrationRequest request)
    {
        var term = searchText?.Trim();
        if (string.IsNullOrWhiteSpace(term))
        {
            return true;
        }

        return request.RequestedName.Contains(term, StringComparison.OrdinalIgnoreCase)
            || request.TibiaVersion.Contains(term, StringComparison.OrdinalIgnoreCase)
            || (request.RequesterUser?.Email?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
            || (request.ReviewerUser?.Email?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
            || (request.RequestNote?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
            || request.Id.ToString().Contains(term, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesCreatedDate(ServerRegistrationRequest request)
    {
        return MatchesDateRange(request.CreatedAt);
    }

    private bool MatchesReviewedDate(ServerRegistrationRequest request)
    {
        return MatchesDateRange(request.ReviewedAt ?? request.CreatedAt);
    }

    private bool MatchesDateRange(DateTime utcDate)
    {
        var localDate = utcDate.ToLocalTime().Date;

        if (fromDate.HasValue && localDate < fromDate.Value.Date)
        {
            return false;
        }

        if (toDate.HasValue && localDate > toDate.Value.Date)
        {
            return false;
        }

        return true;
    }

    private bool MatchesReviewedStatus(ServerRegistrationRequest request)
    {
        return reviewedStatusFilter switch
        {
            "approved" => request.Status == ServerRegistrationRequestStatus.Approved,
            "rejected" => request.Status == ServerRegistrationRequestStatus.Rejected,
            _ => true
        };
    }
}
