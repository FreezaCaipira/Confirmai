@page "/admin/users/edit/{UserId}"

@attribute [Authorize(Roles = "admin")]

@using Confirmai.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Confirmai.Models
@using Confirmai.Models.Admin
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms


<div class="entity-shell admin-page">

    <section class="entity-shell-grid" aria-label="@T["AdminUserEdit.Aria"]">
        <article class="entity-shell-card entity-shell-main form-card">
            @if (isLoading)
            {
                <div class="loading-spinner">@T["Common.Loading"]</div>
            }
            else if (user == null)
            {
                <p>@T["AdminUserEdit.NotFound"]</p>
            }
            else
            {
                <EditForm Model="model" OnValidSubmit="Save">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="form-group">
                        <label>Instagram</label>
                        <InputText class="input" @bind-Value="model.InstagramHandle" />
                    </div>
                    <div class="form-group">
                        <label>Discord</label>
                        <InputText class="input" @bind-Value="model.DiscordHandle" />
                    </div>
                    <div class="form-group">
                        <label>PayPal</label>
                        <InputText class="input" @bind-Value="model.PaypalAddress" />
                    </div>
                    <div class="form-group">
                        <label>Binance</label>
                        <InputText class="input" @bind-Value="model.BinanceAddress" />
                    </div>
                    <div class="form-group">
                        <label>PIX</label>
                        <InputText class="input" @bind-Value="model.PixKey" />
                    </div>
                    <div class="form-group">
                        <label>X</label>
                        <InputText class="input" @bind-Value="model.XHandle" />
                    </div>
                    <div class="form-actions">
                        <button class="cancel-btn" type="button" @onclick='() => NavigationManager.NavigateTo($"/admin/users")'>@T["Common.Cancel"]</button>
                        <button class="save-btn" type="submit" disabled="@isSaving">@T["Common.Save"]</button>
                    </div>
                </EditForm>
            }
        </article>
    </section>
</div>
