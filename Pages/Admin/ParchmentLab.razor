@page "/admin/parchment-lab"

@attribute [Authorize(Roles = "admin")]

@using Microsoft.AspNetCore.Authorization
@using Confirmai.Services.Core
@inject UiTextService T

<div class="entity-shell parchment-lab-page">

    <section class="entity-shell-grid" aria-label="@T["AdminParchmentLab.Aria"]">
        <article class="entity-shell-card entity-shell-main">
            <div class="parchment-grid">
                <section class="parchment-sample parchment-sample-a">
                    <h3>@T["AdminParchmentLab.VariantA"]</h3>
                    <p>@T["AdminParchmentLab.VariantADesc"]</p>
                    <ul>
                        <li>@T["AdminParchmentLab.VariantA1"]</li>
                        <li>@T["AdminParchmentLab.VariantA2"]</li>
                        <li>@T["AdminParchmentLab.VariantA3"]</li>
                    </ul>
                </section>

                <section class="parchment-sample parchment-sample-b">
                    <h3>@T["AdminParchmentLab.VariantB"]</h3>
                    <p>@T["AdminParchmentLab.VariantBDesc"]</p>
                    <ul>
                        <li>@T["AdminParchmentLab.VariantB1"]</li>
                        <li>@T["AdminParchmentLab.VariantB2"]</li>
                        <li>@T["AdminParchmentLab.VariantB3"]</li>
                    </ul>
                </section>

                <section class="parchment-sample parchment-sample-c">
                    <h3>@T["AdminParchmentLab.VariantC"]</h3>
                    <p>@T["AdminParchmentLab.VariantCDesc"]</p>
                    <ul>
                        <li>@T["AdminParchmentLab.VariantC1"]</li>
                        <li>@T["AdminParchmentLab.VariantC2"]</li>
                        <li>@T["AdminParchmentLab.VariantC3"]</li>
                    </ul>
                </section>

                <section class="parchment-sample parchment-sample-d">
                    <h3>@T["AdminParchmentLab.VariantD"]</h3>
                    <p>@T["AdminParchmentLab.VariantDDesc"]</p>
                    <ul>
                        <li>@T["AdminParchmentLab.VariantD1"]</li>
                        <li>@T["AdminParchmentLab.VariantD2"]</li>
                        <li>@T["AdminParchmentLab.VariantD3"]</li>
                    </ul>
                </section>
            </div>

            <div class="parchment-choice-hint">
                @T["AdminParchmentLab.Hint"]
            </div>
        </article>
    </section>

    <section class="entity-shell-footer">
        <button class="back-btn" @onclick='() => Navigation.NavigateTo("/admin")'>@T["AdminParchmentLab.Back"]</button>
    </section>
</div>
