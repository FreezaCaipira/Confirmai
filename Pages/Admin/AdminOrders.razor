@page "/admin/orders"

@attribute [Authorize(Roles = "admin")]

@using Confirmai.Models
@using Confirmai.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using Confirmai.Shared.Helpers
@using Confirmai.Data

@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject BitcoinQuoteService BitcoinQuoteService
@inject CurrencyPreferenceService CurrencyPreferenceService
@inject AdminOrdersFilterStateService AdminOrdersFilterStateService
@inject UiTextService T

<div class="entity-shell admin-page admin-orders-shell">

    <section class="entity-shell-grid" aria-label="@T["AdminOrders.Aria"]">
        <article class="entity-shell-card entity-shell-main">
            <h1 class="page-section-title">@T["AdminOrders.Title"]</h1>
            <div class="filter-bar admin-filter-card">
                <input type="number" placeholder="@T["AdminOrders.Filter.Id"]" @bind="filterId" min="0" />
                <input type="text" placeholder="@T["AdminOrders.Filter.Product"]" @bind="filterProduct" @bind:event="oninput" />
                <input type="text" placeholder="@T["AdminOrders.Filter.Buyer"]" @bind="filterBuyer" @bind:event="oninput" />
                <input type="text" placeholder="@T["AdminOrders.Filter.Seller"]" @bind="filterSeller" @bind:event="oninput" />
                <input type="number" placeholder="@T["AdminOrders.Filter.Min"]" @bind="filterMinAmount" min="0" />
                <input type="number" placeholder="@T["AdminOrders.Filter.Max"]" @bind="filterMaxAmount" min="0" />
                <select @bind="filterStatus">
                    <option value="">@T["AdminOrders.Filter.AllStatuses"]</option>
                    <option value="Pendente">Aguardando pagamento</option>
                    <option value="Pago">Pago</option>
                    <option value="AguardandoEntrega">Aguardando entrega</option>
                    <option value="AguardandoEntregaInGame">Aguardando entrega in-game</option>
                    <option value="AguardandoRevisaoAdm">Aguardando revisão ADM</option>
                    <option value="Entregue">Entregue</option>
                    <option value="Finalizado">Finalizado</option>
                    <option value="Disputa">Em disputa</option>
                    <option value="Cancelado">Cancelado</option>
                    <option value="Reembolsado">Reembolsado</option>
                </select>
                <input type="date" @bind="filterDate" />
                <button type="button" @onclick="@(async () => await ApplyFiltersAndPersist())">@T["Common.Filter"]</button>
                <button type="button" @onclick="@(async () => await ClearFilters())">@T["Common.Clear"]</button>
            </div>

            @if (showRestoredFiltersNotice)
            {
                <div class="orders-review-restored-notice">
                    <span>@T["AdminOrders.RestoredFilters"]</span>
                    <button type="button" class="orders-review-restored-close" @onclick="DismissRestoredNotice" aria-label="@T["AdminCommon.CloseNotice"]">&times;—</button>
                </div>
            }

            <AdminDataState IsLoading="@isLoading" IsEmpty="@(!pagedOrders.Any())" LoadingText="@T["Common.Loading"]" EmptyText="@T["AdminOrders.Empty"]" EmptyIcon="fas fa-clipboard-list" EmptyHint="@T["AdminOrders.EmptyHint"]">
                <table class="product-table">
                    <thead>
                        <tr>
                            <th>@T["AdminOrders.Product"]</th>
                            <th>@T["AdminOrders.Buyer"]</th>
                            <th>@T["AdminOrders.Seller"]</th>
                            <th>@T["Common.Value"]</th>
                            <th>@T["Common.Status"]</th>
                            <th>@T["Common.Date"]</th>
                            <th>@T["Common.Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in pagedOrders)
                        {
                            <tr>
                                <td data-label="@T["AdminOrders.Product"]">
                                    @if (t.Product != null)
                                    {
                                        <a class="evidence-link" href="@($"/admin/items/view/{t.ProductId}")">
                                            @t.Product.Name
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-danger">@T["AdminOrders.RemovedProduct"] (ID: @t.ProductId)</span>
                                    }
                                </td>
                                <td data-label="@T["AdminOrders.Buyer"]">
                                    @if (t.Buyer != null)
                                    {
                                        <a class="evidence-link" href="@($"/admin/users/view/{t.BuyerId}")">
                                            @t.Buyer.UserName
                                        </a>
                                    }
                                    else
                                    {
                                        @if (t.BuyerId == null)
                                        {
                                            <span>(deletado)</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger">@T["AdminOrders.Unknown"] (ID: @t.BuyerId)</span>
                                        }
                                    }
                                </td>
                                <td data-label="@T["AdminOrders.Seller"]">
                                    @if (t.Seller != null)
                                    {
                                        <a class="evidence-link" href="@($"/admin/users/view/{t.SellerId}")">
                                            @t.Seller.UserName
                                        </a>
                                    }
                                    else
                                    {
                                        @if (t.SellerId == null)
                                        {
                                            <span>(deletado)</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger">@T["AdminOrders.Unknown"] (ID: @t.SellerId)</span>
                                        }
                                    }
                                </td>
                                <td data-label="@T["Common.Value"]">@FormatOrderAmount(t.Amount, t.Payment?.Currency)</td>
                                <td data-label="@T["Common.Status"]">
                                    <span class="order-status-badge @OrderStatusHelper.GetStatusCssClass(t.Status)">
                                        @OrderStatusHelper.GetStatusText(t.Status, T)
                                    </span>
                                </td>
                                <td data-label="@T["Common.Date"]">@t.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                                <td data-label="@T["Common.Actions"]">
                                    <div class="admin-actions-row">
                                        <button class="details-btn action-btn icon-only" @onclick="() => GoToDetails(t.Id)" title="@T["Common.Details"]" aria-label="@T["Common.Details"]">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <a class="history-btn action-btn icon-only" href="@($"/admin/audit/Order/{t.Id}")" title="@T["AdminAuditTimeline.ViewHistory"]" aria-label="@T["AdminAuditTimeline.ViewHistory"]">
                                            <i class="fas fa-history"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="pagination">
                    <button type="button" @onclick="@(async () => await PrevPage())" disabled="@(currentPage <= 1)">@T["Common.Previous"]</button>
                    <span class="pagination-info">@T["Common.Page"] @currentPage @T["Common.Of"] @totalPages</span>
                    <button type="button" @onclick="@(async () => await NextPage())" disabled="@(currentPage >= totalPages)">@T["Common.Next"]</button>
                </div>
            </AdminDataState>
        </article>
    </section>

    <section class="entity-shell-footer" aria-label="@T["AdminCommon.ExtraActions"]">
        <button class="back-btn" @onclick='() => NavigationManager.NavigateTo("/admin")'>@T["Common.Back"]</button>
    </section>
</div>

@code {
    private bool isLoading = true;
    private bool filtersLoaded;
    private bool showRestoredFiltersNotice;
    private List<OrderModel> pagedOrders = new();
    private int totalCount;

    private int? filterId;
    private string filterProduct = "";
    private string filterBuyer = "";
    private string filterSeller = "";
    private decimal? filterMinAmount;
    private decimal? filterMaxAmount;
    private string filterStatus = "";
    private DateTime? filterDate;
    private decimal? btcUsdRate;
    private decimal? btcBrlRate;

    private int pageSize = 10;
    private int currentPage = 1;
    private int totalPages => Math.Max(1, (int)Math.Ceiling((double)totalCount / pageSize));

    [Inject] public IJSRuntime JS { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        var quote = await BitcoinQuoteService.GetQuoteAsync();
        btcUsdRate = quote?.btc_usd;
        btcBrlRate = quote?.btc_brl;
        await LoadPageAsync();
        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || filtersLoaded) return;

        await LoadFilterStateFromStorageAsync();
        await LoadPageAsync();
        filtersLoaded = true;
        StateHasChanged();
    }

    private async Task LoadPageAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var query = db.Orders.AsNoTracking().AsQueryable();

        if (filterId.HasValue)
            query = query.Where(o => o.Id == filterId.Value);
        if (!string.IsNullOrWhiteSpace(filterProduct))
            query = query.Where(o => o.Product != null && o.Product.Name.Contains(filterProduct));
        if (!string.IsNullOrWhiteSpace(filterBuyer))
            query = query.Where(o => (o.Buyer != null && o.Buyer.UserName != null && o.Buyer.UserName.Contains(filterBuyer)) || (o.BuyerId != null && o.BuyerId.Contains(filterBuyer)));
        if (!string.IsNullOrWhiteSpace(filterSeller))
            query = query.Where(o => (o.Seller != null && o.Seller.UserName != null && o.Seller.UserName.Contains(filterSeller)) || (o.SellerId != null && o.SellerId.Contains(filterSeller)));
        if (filterMinAmount.HasValue)
            query = query.Where(o => o.Amount >= filterMinAmount.Value);
        if (filterMaxAmount.HasValue)
            query = query.Where(o => o.Amount <= filterMaxAmount.Value);
        if (!string.IsNullOrWhiteSpace(filterStatus) && Enum.TryParse<PaymentStatus>(filterStatus, out var parsedStatus))
            query = query.Where(o => o.Status == parsedStatus);
        if (filterDate.HasValue)
            query = query.Where(o => o.CreatedAt.Date == filterDate.Value.Date);

        totalCount = await query.CountAsync();
        if (currentPage > totalPages) currentPage = totalPages;

        pagedOrders = await query
            .OrderByDescending(o => o.CreatedAt)
            .Include(o => o.Product)
            .Include(o => o.Payment)
            .Include(o => o.Buyer)
            .Include(o => o.Seller)
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToListAsync();
    }

    private async Task ApplyFiltersAndPersist()
    {
        currentPage = 1;
        showRestoredFiltersNotice = false;
        await LoadPageAsync();
        await PersistFilterStateAsync();
    }

    private void GoToDetails(int id)
    {
        NavigationManager.NavigateTo($"/orders/{id}");
    }

    private async Task ClearFilters()
    {
        filterId = null;
        filterProduct = "";
        filterBuyer = "";
        filterSeller = "";
        filterMinAmount = null;
        filterMaxAmount = null;
        filterStatus = "";
        filterDate = null;
        currentPage = 1;
        showRestoredFiltersNotice = false;
        await LoadPageAsync();
        await PersistFilterStateAsync();
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await LoadPageAsync();
            await PersistFilterStateAsync();
        }
    }

    private async Task PrevPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadPageAsync();
            await PersistFilterStateAsync();
        }
    }

    private async Task LoadFilterStateFromStorageAsync()
    {
        var state = await AdminOrdersFilterStateService.LoadAsync();

        filterId = state.Id;
        filterProduct = state.Product;
        filterBuyer = state.Buyer;
        filterSeller = state.Seller;
        filterMinAmount = state.MinAmount;
        filterMaxAmount = state.MaxAmount;
        filterStatus = state.Status;
        filterDate = state.Date;
        currentPage = state.Page ?? 1;

        showRestoredFiltersNotice =
            filterId.HasValue
            || !string.IsNullOrWhiteSpace(filterProduct)
            || !string.IsNullOrWhiteSpace(filterBuyer)
            || !string.IsNullOrWhiteSpace(filterSeller)
            || filterMinAmount.HasValue
            || filterMaxAmount.HasValue
            || !string.IsNullOrWhiteSpace(filterStatus)
            || filterDate.HasValue
            || currentPage > 1;
    }

    private async Task PersistFilterStateAsync()
    {
        await AdminOrdersFilterStateService.SaveAsync(new AdminOrdersFilterState
        {
            Id = filterId,
            Product = filterProduct,
            Buyer = filterBuyer,
            Seller = filterSeller,
            MinAmount = filterMinAmount,
            MaxAmount = filterMaxAmount,
            Status = filterStatus,
            Date = filterDate,
            Page = currentPage
        });
    }

    private void DismissRestoredNotice()
    {
        showRestoredFiltersNotice = false;
    }

    private MarkupString FormatBtcWithUsd(decimal amount)
    {
        return BtcUsdFormatter.FormatMarkup(amount, btcUsdRate, btcBrlRate, CurrencyPreferenceService.SelectedFiatCurrency);
    }

    private string FormatOrderAmount(decimal amount, string? currency)
    {
        return currency switch
        {
            "BRL" => $"R$ {amount:N2}",
            "USD" => $"$ {amount:N2}",
            _ => BtcUsdFormatter.Format(amount, btcUsdRate, btcBrlRate, CurrencyPreferenceService.SelectedFiatCurrency)
        };
    }
}

