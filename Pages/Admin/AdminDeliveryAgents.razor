@page "/admin/delivery-agents"

@attribute [Authorize(Roles = "admin")]

@using Confirmai.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore

@inject AppDbContext Db
@inject NavigationManager NavigationManager
@inject UiTextService T

<div class="entity-shell parchment-a admin-page">

    <section class="entity-shell-grid" aria-label="@T["AdminDeliveryAgents.Aria"]">
        <article class="entity-shell-card entity-shell-main">
            <div class="filter-bar admin-filter-card">
                <input type="text" placeholder="@T["AdminDeliveryAgents.Filter.Search"]" @bind="searchTerm" @bind:event="oninput" @bind:after="OnSearchChanged" />
                <div class="filter-action-buttons delivery-agent-filter-actions">
                    <button type="button" @onclick="LoadAgentsAsync">@T["Common.Filter"]</button>
                    <button type="button" class="back-btn" @onclick="ClearFiltersAsync">@T["Common.Clear"]</button>
                    <button type="button" class="success-btn" @onclick="OpenCreateModal">@T["AdminDeliveryAgents.New"]</button>
                </div>
            </div>

            <AdminDataState IsLoading="@isLoading" IsEmpty="@(!filteredAgents.Any())" EmptyText="@T["AdminDeliveryAgents.Empty"]" EmptyIcon="fas fa-truck" EmptyHint="@T["AdminDeliveryAgents.EmptyHint"]">
                <table class="product-table">
                    <thead>
                        <tr>
                            <th>@T["AdminDeliveryAgents.Name"]</th>
                            <th>@T["AdminDeliveryAgents.Contact"]</th>
                            <th>@T["AdminDeliveryAgents.BusinessDays"]</th>
                            <th>@T["Common.Status"]</th>
                            <th>@T["AdminDeliveryAgents.CreatedAt"]</th>
                            <th>@T["Common.Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var agent in filteredAgents.Skip((currentPage - 1) * pageSize).Take(pageSize))
                    {
                        <tr>
                            <td data-label="@T["AdminDeliveryAgents.Name"]">@agent.Name</td>
                            <td data-label="@T["AdminDeliveryAgents.Contact"]">@(string.IsNullOrWhiteSpace(agent.Contact) ? "-" : agent.Contact)</td>
                            <td data-label="@T["AdminDeliveryAgents.BusinessDays"]">@agent.EstimatedBusinessDays</td>
                            <td data-label="@T["Common.Status"]">
                                <span class="gateway-status-label @(agent.IsActive ? "active" : "inactive")">@(agent.IsActive ? T["AdminDeliveryAgents.Active"] : T["AdminDeliveryAgents.Inactive"])</span>
                            </td>
                            <td data-label="@T["AdminDeliveryAgents.CreatedAt"]">@agent.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td data-label="@T["Common.Actions"]">
                                <div class="admin-actions-row">
                                    <button class="details-btn action-btn icon-only" @onclick='() => NavigationManager.NavigateTo($"/admin/delivery-agents/view/{agent.Id}")' title="@T["Common.Details"]" aria-label="@T["Common.Details"]">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    <button class="edit-btn action-btn icon-only" @onclick="() => StartEdit(agent)" title="@T["Common.Edit"]" aria-label="@T["Common.Edit"]">
                                        <i class="fas fa-pencil-alt"></i>
                                    </button>
                                    <button class="warning-btn action-btn icon-only" @onclick="() => ToggleStatusAsync(agent)" title="@(agent.IsActive ? T["AdminDeliveryAgents.Deactivate"] : T["AdminDeliveryAgents.Activate"])" aria-label="@(agent.IsActive ? T["AdminDeliveryAgents.Deactivate"] : T["AdminDeliveryAgents.Activate"])">
                                        <i class="fas @(agent.IsActive ? "fa-ban" : "fa-check")"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>

                <div class="pagination">
                    <button type="button" @onclick="PrevPage" disabled="@(currentPage <= 1)">@T["Common.Previous"]</button>
                    <span class="pagination-info">@T["Common.Page"] @currentPage @T["Common.Of"] @totalPages</span>
                    <button type="button" @onclick="NextPage" disabled="@(currentPage >= totalPages)">@T["Common.Next"]</button>
                </div>
            </AdminDataState>
        </article>
    </section>

    <section class="entity-shell-footer" aria-label="@T["AdminCommon.ExtraActions"]">
        <button class="back-btn" @onclick='() => NavigationManager.NavigateTo("/admin")'>@T["Common.Back"]</button>
    </section>
</div>

@if (showFormModal)
{
    <div class="modal-overlay" @onclick="CloseFormModal">
        <div class="modal-card delivery-agent-modal" role="dialog" aria-modal="true" aria-labelledby="delivery-agent-modal-title" @onclick:stopPropagation="true">
            <h4 class="modal-title" id="delivery-agent-modal-title">@(editingAgentId.HasValue ? T["AdminDeliveryAgents.Edit"] : T["AdminDeliveryAgents.New"])</h4>
            <div class="modal-content">
                <div class="delivery-agent-form-grid">
                    <div class="delivery-agent-field">
                        <label for="delivery-agent-name">@T["AdminDeliveryAgents.Name"]</label>
                        <input id="delivery-agent-name" type="text" @bind="formName" />
                    </div>

                    <div class="delivery-agent-field">
                        <label for="delivery-agent-contact">@T["AdminDeliveryAgents.Contact"]</label>
                        <input id="delivery-agent-contact" type="text" @bind="formContact" />
                    </div>

                    <div class="delivery-agent-field">
                        <label for="delivery-agent-days">@T["AdminDeliveryAgents.BusinessDays"]</label>
                        <input id="delivery-agent-days" type="number" min="1" max="60" @bind="formEstimatedBusinessDays" />
                    </div>

                    <div class="delivery-agent-field delivery-agent-status-field">
                        <label>@T["Common.Status"]</label>
                        <div class="delivery-agent-status-inline">
                            <label class="switch-toggle">
                                <input type="checkbox" @bind="formIsActive" />
                                <span class="slider"></span>
                            </label>
                            <span class="gateway-status-label @(formIsActive ? "active" : "inactive")">@(formIsActive ? T["AdminDeliveryAgents.Active"] : T["AdminDeliveryAgents.Inactive"])</span>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(formMessage))
                {
                    <p class="@(formError ? "error-msg" : "success-msg")">@formMessage</p>
                }
            </div>

            <div class="modal-actions">
                <button class="success-btn" @onclick="SaveAsync">@(editingAgentId.HasValue ? T["Common.Save"] : T["AdminDeliveryAgents.Create"])</button>
                <button class="back-btn" @onclick="CancelEdit">@T["Common.Cancel"]</button>
            </div>
        </div>
    </div>
}

@code {
    private List<DeliveryAgent> allAgents = new();
    private List<DeliveryAgent> filteredAgents = new();

    private string searchTerm = string.Empty;
    private int? editingAgentId;
    private bool showFormModal;
    private string formName = string.Empty;
    private string? formContact;
    private int formEstimatedBusinessDays = 2;
    private bool formIsActive = true;
    private string? formMessage;
    private bool formError;
    private const int pageSize = 10;
    private int currentPage = 1;
    private bool isLoading = true;
    private int totalPages => Math.Max(1, (int)Math.Ceiling((double)filteredAgents.Count / pageSize));

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await LoadAgentsAsync();
        isLoading = false;
    }

    private async Task LoadAgentsAsync()
    {
        allAgents = await Db.DeliveryAgents
            .AsNoTracking()
            .OrderBy(d => d.Name)
            .ToListAsync();

        ApplySearch();
    }

    private void ApplySearch()
    {
        filteredAgents = allAgents
            .Where(d => string.IsNullOrWhiteSpace(searchTerm)
                || d.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
                || (d.Contact?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false))
            .ToList();

        if (currentPage > totalPages)
        {
            currentPage = totalPages;
        }
    }

    private Task OnSearchChanged()
    {
        currentPage = 1;
        ApplySearch();
        return Task.CompletedTask;
    }

    private Task ClearFiltersAsync()
    {
        searchTerm = string.Empty;
        currentPage = 1;
        ApplySearch();
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        formMessage = null;
        formError = false;

        if (string.IsNullOrWhiteSpace(formName))
        {
            formError = true;
            formMessage = T["AdminDeliveryAgents.ErrorNameRequired"];
            return;
        }

        if (formEstimatedBusinessDays < 1 || formEstimatedBusinessDays > 60)
        {
            formError = true;
            formMessage = T["AdminDeliveryAgents.ErrorDaysRange"];
            return;
        }

        if (editingAgentId.HasValue)
        {
            var existing = await Db.DeliveryAgents.FindAsync(editingAgentId.Value);
            if (existing == null)
            {
                formError = true;
                formMessage = T["AdminDeliveryAgents.ErrorNotFound"];
                return;
            }

            existing.Name = formName.Trim();
            existing.Contact = string.IsNullOrWhiteSpace(formContact) ? null : formContact.Trim();
            existing.EstimatedBusinessDays = formEstimatedBusinessDays;
            existing.IsActive = formIsActive;
        }
        else
        {
            Db.DeliveryAgents.Add(new DeliveryAgent
            {
                Name = formName.Trim(),
                Contact = string.IsNullOrWhiteSpace(formContact) ? null : formContact.Trim(),
                EstimatedBusinessDays = formEstimatedBusinessDays,
                IsActive = formIsActive,
                CreatedAt = DateTime.UtcNow
            });
        }

        await Db.SaveChangesAsync();
        formMessage = editingAgentId.HasValue ? T["AdminDeliveryAgents.Updated"] : T["AdminDeliveryAgents.Created"];
        ResetForm();
        showFormModal = false;
        await LoadAgentsAsync();
    }

    private void StartEdit(DeliveryAgent agent)
    {
        editingAgentId = agent.Id;
        formName = agent.Name;
        formContact = agent.Contact;
        formEstimatedBusinessDays = agent.EstimatedBusinessDays;
        formIsActive = agent.IsActive;
        formMessage = null;
        formError = false;
        showFormModal = true;
    }

    private async Task ToggleStatusAsync(DeliveryAgent agent)
    {
        var existing = await Db.DeliveryAgents.FindAsync(agent.Id);
        if (existing == null)
        {
            return;
        }

        existing.IsActive = !existing.IsActive;
        await Db.SaveChangesAsync();
        await LoadAgentsAsync();
    }

    private void CancelEdit()
    {
        ResetForm();
        formMessage = null;
        formError = false;
        showFormModal = false;
    }

    private void OpenCreateModal()
    {
        ResetForm();
        formMessage = null;
        formError = false;
        showFormModal = true;
    }

    private void CloseFormModal()
    {
        CancelEdit();
    }

    private Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
        }

        return Task.CompletedTask;
    }

    private Task PrevPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
        }

        return Task.CompletedTask;
    }

    private void ResetForm()
    {
        editingAgentId = null;
        formName = string.Empty;
        formContact = null;
        formEstimatedBusinessDays = 2;
        formIsActive = true;
    }
}


