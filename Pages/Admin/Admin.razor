@page "/admin"

@using System.Globalization
@using System.Security.Claims
@using System.Text.Json
@using Confirmai.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using Confirmai.Services

@attribute [Authorize(Roles = "admin")]

@inject CurrencyPreferenceService CurrencyPreferenceService
@inject LanguagePreferenceService LanguagePreferenceService
@inject DashboardMetricsService DashboardMetricsService
@inject AdminSettingsService AdminSettingsService
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime
@inject UiTextService T

<div class="entity-shell admin-page">

    <PageTitle>@T["AdminDashboard.Title"]</PageTitle>

    <section class="entity-shell-grid" aria-label="@T["AdminDashboard.Aria"]">
        <article class="entity-shell-card entity-shell-main">
            <h1 class="page-section-title">@T["AdminDashboard.Title"]</h1>
            <p class="admin-welcome">@T["AdminDashboard.Welcome"]</p>

            <nav class="admin-nav">
                <a href="/admin/users">@T["Admin.Nav.Users"]</a>
                <a href="/admin/payments">@T["Admin.Nav.Payments"]</a>
                <a href="/admin/gateways">@T["Admin.Nav.Gateways"]</a>
                <a href="/admin/logs">@T["Admin.Nav.Logs"]</a>
                <a href="/admin/security">@T["Admin.Nav.Security"]</a>
                <a href="/admin/venues">Quadras</a>
            </nav>

            @if (isLoading)
            {
                <div class="loading-spinner">Carregando painel...</div>
            }
            else
            {
            <div class="admin-kpi-grid" aria-label="@T["AdminDashboard.KpiAria"]">
                <a class="admin-kpi-card" href="/admin/users" aria-label="@T["AdminDashboard.KpiUsersAria"]">
                    <p class="admin-kpi-label">@T["AdminDashboard.KpiUsers"]</p>
                    <p class="admin-kpi-value">@usersCount</p>
                </a>
            </div>

            <div class="admin-settings-card admin-reconciliation-health-card">
                <div class="admin-reconciliation-health-head">
                    <span><b>Saúde da reconciliação</b></span>
                    <a class="details-btn" href="/admin/payments">Abrir pagamentos</a>
                </div>
                <div class="admin-reconciliation-health-grid">
                    <span>Última atualização do bloco: @adminLastHealthRefreshLabel</span>
                    <span>Pendentes com chargeId: @adminPendingWithChargeId</span>
                    <span>Pendentes antigos (+30 min): @adminStalePending</span>
                    <span>Última varredura automática: @adminLastAutoSweepLabel</span>
                    <span class="@(adminPendingTrendWarning ? "admin-reconciliation-trend-warning" : string.Empty)">Tendência 24h: @adminPendingTrendLabel</span>
                </div>
                <div class="admin-reconciliation-thresholds">
                    <label>
                        Limiar atenção (+24h)
                        <input class="fee-input" type="number" min="1" max="200" @bind="adminWarningThreshold" />
                    </label>
                    <label>
                        Limiar crítico (+24h)
                        <input class="fee-input" type="number" min="1" max="200" @bind="adminCriticalThreshold" />
                    </label>
                    <button class="details-btn" @onclick="SaveReconciliationThresholdsAsync">Salvar limiares</button>
                    @if (!string.IsNullOrWhiteSpace(reconciliationThresholdMessage))
                    {
                        <span class="operation-fee-message @(reconciliationThresholdSaved ? "ok" : "error")">@reconciliationThresholdMessage</span>
                    }
                </div>
            </div>

            <div class="admin-settings-card">
                <label for="fiat-select"><b>@T["AdminDashboard.CurrencyLabel"]</b></label>
                <select id="fiat-select" class="fiat-select" @bind="selectedFiat" @bind:after="ApplyCurrencyPreferenceAsync">
                    <option value="USD">USD</option>
                    <option value="BRL">BRL</option>
                </select>
            </div>

            <div class="admin-settings-card">
                <span><b>@T["AdminDashboard.QuoteQueriesLabel"]</b> @quoteQueriesCount</span>
            </div>

            <div class="admin-settings-card">
                <span><b>@T["AdminLanguages.Current"]:</b> @selectedLanguage</span>
            </div>

            <div class="admin-settings-card">
                <label for="ui-language"><b>@T["AdminLanguages.Select"]:</b></label>
                <select id="ui-language" class="fiat-select" @bind="selectedLanguage">
                    @foreach (var language in LanguagePreferenceService.SupportedLanguages)
                    {
                        <option value="@language.Code">@language.Label</option>
                    }
                </select>
                <button class="details-btn" @onclick="SaveLanguageAsync">@T["AdminLanguages.Save"]</button>

                @if (!string.IsNullOrWhiteSpace(languageMessage))
                {
                    <span class="operation-fee-message ok">@languageMessage</span>
                }
            </div>

            <div class="admin-settings-card operation-fee-card">
        <label for="operation-fee"><b>@T["AdminDashboard.OperationFeeLabel"]</b></label>
        <input id="operation-fee"
               class="fee-input"
               type="number"
               min="0"
               max="100"
               step="0.01"
               @bind="operationFeePercent" />
        <button class="details-btn" @onclick="SaveOperationFeeAsync">@T["AdminDashboard.SaveFee"]</button>
        @if (!string.IsNullOrWhiteSpace(operationFeeMessage))
        {
            <span class="operation-fee-message @(operationFeeSaved ? "ok" : "error")">@operationFeeMessage</span>
        }
            </div>

            <div class="admin-settings-card operation-fee-card">
                <label for="site-pix-key"><b>Chave PIX do intermedio do site</b></label>
                <input id="site-pix-key"
                       class="fee-input"
                       type="text"
                       maxlength="160"
                       placeholder="Ex: email, telefone, cpf/cnpj ou chave aleatoria"
                       @bind="siteIntermediaryPixKey" />
                <button class="details-btn" @onclick="SaveSitePixKeyAsync">Salvar chave PIX</button>
                @if (!string.IsNullOrWhiteSpace(sitePixMessage))
                {
                    <span class="operation-fee-message @(sitePixSaved ? "ok" : "error")">@sitePixMessage</span>
                }
            </div>

            }
        </article>
    </section>
</div>

