@page "/admin/users"

@attribute [Authorize(Roles = "admin")]

@using Confirmai.Shared
@using Confirmai.Shared.Components.Admin
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Confirmai.Models
@using Microsoft.JSInterop
@using Microsoft.EntityFrameworkCore


<div class="entity-shell admin-page admin-users-shell">

    <section class="entity-shell-grid" aria-label="@T["AdminUsers.Aria"]">
        <article class="entity-shell-card entity-shell-main">
            <h1 class="page-section-title">@T["AdminUsers.Title"]</h1>
            <AdminUsersFilterBar
                FilterEmail="@filterEmail"
                FilterRole="@filterRole"
                FilterStatus="@filterStatus"
                OnApplyFilters="@HandleApplyFilters"
                OnClearFilters="@HandleClearFilters" />

            @if (showRestoredFiltersNotice)
            {
                <div class="orders-review-restored-notice">
                    <span>@T["AdminUsers.RestoredFilters"]</span>
                    <button type="button" class="orders-review-restored-close" @onclick="DismissRestoredNotice" aria-label="@T["AdminCommon.CloseNotice"]">&times;</button>
                </div>
            }

            <AdminUsersTable
                TotalItems="@totalUsers"
                Users="@currentPageUsers"
                UserRoles="@userRoles"
                CurrentPage="@currentPage"
                TotalPages="@totalPages"
                OnViewUser="@ViewUser"
                OnEditUser="@EditUser"
                OnLockUser="@LockUser"
                OnUnlockUser="@UnlockUser"
                OnDeleteUser="@DeleteUser"
                OnPrevPage="@GoToPrevPage"
                OnNextPage="@GoToNextPage" />
        </article>
    </section>

    <section class="entity-shell-footer" aria-label="@T["AdminCommon.ExtraActions"]">
        <button class="back-btn" @onclick='() => NavigationManager.NavigateTo("/admin")'>@T["Common.Back"]</button>
    </section>
</div>
