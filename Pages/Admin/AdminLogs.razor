@page "/admin/logs"
@implements IDisposable

@attribute [Authorize(Roles = "admin")]

@using Confirmai.Models
@using Confirmai.Services
@using Confirmai.Shared.Components.Admin
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using System.Globalization

@inject IDbContextFactory<AppDbContext> DbFactory
@inject AdminLogsQueryService AdminLogsQueryService
@inject AdminLogsExportService AdminLogsExportService
@inject AdminLogsFilterStateService AdminLogsFilterStateService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject UiTextService T

<div class="entity-shell admin-page admin-logs-shell">

    <section class="entity-shell-grid" aria-label="@T["AdminLogs.Aria"]">
        <article class="entity-shell-card entity-shell-main">
            <h1 class="page-section-title">@T["AdminLogs.Title"]</h1>
            <AdminLogsFilterBar
                FilterGlobalSearch="@filterGlobalSearch"
                FilterUserId="@filterUserId"
                FilterSource="@filterSource"
                FilterMessage="@filterMessage"
                FilterLevel="@filterLevel"
                FilterStartDate="@filterStartDate"
                FilterEndDate="@filterEndDate"
                FilterEventType="@filterEventType"
                FilterEntityType="@filterEntityType"
                TotalLogs="@totalLogs"
                HasInvalidDateRange="@HasInvalidDateRange"
                OnGlobalSearchInput="@HandleGlobalSearchInput"
                OnApplyFilters="@ApplyFilters"
                OnClearFilters="@ClearFilters"
                OnExportCsv="@ExportCsvAsync"
                OnExportJson="@ExportJsonAsync" />

            @if (!string.IsNullOrWhiteSpace(exportNotice))
            {
                <div class="orders-review-restored-notice" role="status">
                    <span>@exportNotice</span>
                    <button type="button" class="orders-review-restored-close" @onclick="DismissExportNotice" aria-label="@T["AdminCommon.CloseNotice"]">&times;—</button>
                </div>
            }

            <AdminLogsQuickFilters
                SelectedQuickRangePreset="@selectedQuickRangePreset.ToString()"
                SelectedAuditQuickFilter="@selectedAuditQuickFilter.ToString()"
                AuditCountAll="@auditCountAll"
                AuditCountSecurityPolicy="@auditCountSecurityPolicy"
                AuditCountPaymentPanelStale="@auditCountPaymentPanelStale"
                OnSetToday="@SetTodayRangeAsync"
                OnSetLast7Days="@(() => SetLastDaysRangeAsync(7))"
                OnSetLast30Days="@(() => SetLastDaysRangeAsync(30))"
                OnSetCurrentMonth="@SetCurrentMonthRangeAsync"
                OnClearRange="@ClearDateRangeAsync"
                OnSetAuditAll="@(() => SetAuditQuickFilterAsync(AdminLogsAuditQuickFilter.All))"
                OnSetAuditSecurityPolicy="@(() => SetAuditQuickFilterAsync(AdminLogsAuditQuickFilter.SecurityPolicy))"
                OnSetAuditPaymentPanelStale="@(() => SetAuditQuickFilterAsync(AdminLogsAuditQuickFilter.PaymentPanelStale))" />

            @if (HasInvalidDateRange)
            {
                <div class="orders-review-restored-notice">
                    <span>@T["AdminLogs.InvalidDateRange"]</span>
                </div>
            }

            @if (showRestoredFiltersNotice)
            {
                <div class="orders-review-restored-notice">
                    <span>@T["AdminLogs.RestoredFilters"]</span>
                    <button type="button" class="orders-review-restored-close" @onclick="DismissRestoredNotice" aria-label="@T["AdminCommon.CloseNotice"]">&times;—</button>
                </div>
            }

            @if (HasDateRangeFilter)
            {
                <div class="orders-review-sort-summary">@T["AdminLogs.AppliedPeriod"] @ActivePeriodSummary</div>
            }

            <p class="logs-total-count">
                <b>@T["AdminLogs.Total"]</b> @totalLogs
            </p>

            <AdminLogsTable
                TotalItems="@totalLogs"
                Logs="@currentPageLogs"
                CurrentPage="@currentPage"
                TotalPages="@totalPages"
                CurrentSortColumn="@currentSortColumn.ToString()"
                SortAscending="@sortAscending"
                OnSort="@HandleSortAsync"
                OnPrevPage="@GoToPrevPage"
                OnNextPage="@GoToNextPage" />
        </article>
    </section>

    <section class="entity-shell-footer" aria-label="@T["AdminCommon.ExtraActions"]">
        <button class="back-btn" @onclick='() => NavigationManager.NavigateTo("/admin")'>@T["Common.Back"]</button>
    </section>
</div>

