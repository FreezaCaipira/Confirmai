@page "/admin/orders-review"
@attribute [Authorize(Roles = "admin")]
@implements IDisposable

@using Confirmai.Enums
@using Confirmai.Models
@using Confirmai.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using System.Globalization
@inject AppDbContext Db
@inject OperationFeeCalculatorService OperationFeeCalculatorService
@inject AdminOrderReleaseService AdminOrderReleaseService
@inject IJSRuntime JS
@inject UiTextService T
@inject PaymentEventBus PaymentEventBus

<div class="entity-shell parchment-a admin-page admin-orders-review-shell">

    <section class="entity-shell-grid" aria-label="@T["AdminOrdersReview.Aria"]">
        <article class="entity-shell-card entity-shell-main">
            <h1 class="page-section-title">@T["AdminOrdersReview.Title"]</h1>
            <div class="filter-bar admin-filter-card">
                <input type="text" placeholder="@T["AdminOrdersReview.Filter.Buyer"]" @bind="buyerFilter" @bind:event="oninput" @bind:after="OnFiltersChangedAsync" />
                <input type="text" placeholder="@T["AdminOrdersReview.Filter.Product"]" @bind="productFilter" @bind:event="oninput" @bind:after="OnFiltersChangedAsync" />
                <input type="number" placeholder="@T["AdminOrdersReview.Filter.Min"]" @bind="minAmountFilter" @bind:after="OnFiltersChangedAsync" min="0" step="0.00000001" />
                <input type="number" placeholder="@T["AdminOrdersReview.Filter.Max"]" @bind="maxAmountFilter" @bind:after="OnFiltersChangedAsync" min="0" step="0.00000001" />
                <button @onclick="ClearFiltersAsync">@T["AdminOrdersReview.ClearFilters"]</button>
                <button class="sort-reset-btn" @onclick="ResetSortingAsync" disabled="@IsDefaultSort">@T["AdminOrdersReview.ResetSort"]</button>
            </div>

            @if (showRestoredFiltersNotice)
            {
                <div class="orders-review-restored-notice">
                    <span>@T["AdminOrdersReview.RestoredFilters"]</span>
                    <button type="button" class="orders-review-restored-close" @onclick="DismissRestoredNotice" aria-label="@T["AdminCommon.CloseNotice"]">&times;—</button>
                </div>
            }

            @if (showNewOrderToast)
            {
                <div class="orders-review-restored-notice orders-review-new-order-toast" role="status" aria-live="polite">
                    <span><i class="fas fa-bell" aria-hidden="true"></i> @T["AdminOrdersReview.NewOrderToast"]</span>
                    <button type="button" class="orders-review-restored-close" @onclick="DismissNewOrderToast" aria-label="@T["AdminCommon.CloseNotice"]">&times;—</button>
                </div>
            }

            @if (orders == null)
            {
                <div class="loading-spinner">@T["Common.Loading"]</div>
            }
            else if (!orders.Any())
            {
                <div class="admin-empty-state">
                    <i class="fas fa-gavel admin-empty-state-icon"></i>
                    <p class="admin-empty-state-text">@T["AdminOrdersReview.EmptyPending"]</p>
                    <p class="admin-empty-state-hint">@T["AdminOrdersReview.EmptyPendingHint"]</p>
                </div>
            }
            else if (!FilteredOrders.Any())
            {
                <div class="admin-empty-state">
                    <i class="fas fa-search admin-empty-state-icon"></i>
                    <p class="admin-empty-state-text">@T["AdminOrdersReview.EmptyFiltered"]</p>
                    <p class="admin-empty-state-hint">@T["AdminOrdersReview.EmptyFilteredHint"]</p>
                </div>
            }
            else
            {
                <div class="orders-review-sort-summary">@T["AdminOrdersReview.SortedBy"] @CurrentSortLabel</div>

                <table class="product-table">
        <thead>
            <tr>
                <th>
                    <button class="@(SortButtonClass(OrderReviewSortColumn.Buyer))" @onclick="() => ApplySortAsync(OrderReviewSortColumn.Buyer)">
                        @T["AdminOrders.Buyer"] @SortIndicator(OrderReviewSortColumn.Buyer)
                    </button>
                </th>
                <th>
                    <button class="@(SortButtonClass(OrderReviewSortColumn.Product))" @onclick="() => ApplySortAsync(OrderReviewSortColumn.Product)">
                        @T["AdminOrders.Product"] @SortIndicator(OrderReviewSortColumn.Product)
                    </button>
                </th>
                <th>
                    <button class="@(SortButtonClass(OrderReviewSortColumn.Amount))" @onclick="() => ApplySortAsync(OrderReviewSortColumn.Amount)">
                        @T["Common.Value"] @SortIndicator(OrderReviewSortColumn.Amount)
                    </button>
                </th>
                <th>@T["Common.Status"]</th>
                <th>Origem</th>
                <th>@T["Common.Actions"]</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var order in PagedOrders)
        {
            <tr>
                <td data-label="@T["AdminOrders.Buyer"]">@order.Buyer?.UserName</td>
                <td data-label="@T["AdminOrders.Product"]">
                    <div>@order.Product?.Name</div>
                    @if (!string.IsNullOrWhiteSpace(order.Payment?.InGamePlayerName))
                    {
                        <div class="text-muted">@T["AdminOrdersReview.InGamePlayerName"]: @order.Payment.InGamePlayerName</div>
                    }
                </td>
                <td data-label="@T["Common.Value"]">@FormatAmount(order)</td>
                <td data-label="@T["Common.Status"]">
                    <span class="order-status-badge aguardandorevisaoadm">@T["AdminOrdersReview.StatusAwaiting"]</span>
                </td>
                <td data-label="Origem">
                    @if (order.ServerId.HasValue)
                    {
                        <span class="badge-active" title="Entrega confirmada pelo servidor de jogo">Servidor</span>
                    }
                    else
                    {
                        <span class="badge-payment-info" title="Entrega confirmada por evidencia manual">Manual</span>
                    }
                </td>
                <td data-label="@T["Common.Actions"]">
                    <div class="order-review-actions">
                        <a class="details-btn action-btn icon-only" href="@($"/orders/{order.Id}")" title="@T["Common.Details"]" aria-label="@T["Common.Details"]">
                            <i class="fas fa-eye"></i>
                        </a>
                        <button class="success-btn action-btn icon-only" @onclick="() => ShowReleaseModalAsync(order.Id)" title="@T["AdminOrdersReview.Release"]" aria-label="@T["AdminOrdersReview.Release"]">
                            <i class="fas fa-hand-holding-usd"></i>
                        </button>
                    </div>
                </td>
            </tr>
        }
        </tbody>
                </table>

                <div class="pagination">
                    <button @onclick="PrevPageAsync" disabled="@(currentPage <= 1)">@T["Common.Previous"]</button>
                    <span class="pagination-info">@T["Common.Page"] @currentPage @T["Common.Of"] @TotalPages</span>
                    <button @onclick="NextPageAsync" disabled="@(currentPage >= TotalPages)">@T["Common.Next"]</button>
                </div>
            }
        </article>
    </section>
</div>

@if (showReleaseModal && selectedOrder != null)
{
    <div class="modal-overlay">
        <div class="admin-release-funds-modal modal-card release-modal-card" role="dialog" aria-modal="true" aria-labelledby="admin-release-funds-title" tabindex="0" @onkeydown="HandleModalKeydown" @onkeydown:stopPropagation="true">
            <h4 class="modal-title modal-title-with-icon" id="admin-release-funds-title"><i class="fas fa-exclamation-triangle modal-title-icon"></i>@T["AdminOrdersReview.Modal.Title"]</h4>
            <div class="modal-content release-modal-content">
                <p class="release-modal-question">@T["AdminOrdersReview.Modal.Question"]</p>

                <div class="release-modal-layout">
                    <div class="payment-details-card release-summary-card">
                        <div class="details-row"><span class="label">@T["AdminOrders.Product"]:</span><span>@selectedOrder.Product?.Name</span></div>
                        <div class="details-row"><span class="label">@T["AdminOrdersReview.Quantity"]:</span><span>1</span></div>
                        <div class="details-row"><span class="label">@T["AdminOrders.Buyer"]:</span><span><a class="evidence-link" href="@($"/profile/{selectedOrder.BuyerId}")">@selectedOrder.Buyer?.UserName</a></span></div>
                        <div class="details-row"><span class="label">@T["AdminOrders.Seller"]:</span><span><a class="evidence-link" href="@($"/profile/{selectedOrder.SellerId}")">@selectedOrder.Seller?.UserName</a></span></div>
                        @if (!string.IsNullOrWhiteSpace(selectedOrder.Payment?.InGamePlayerName))
                        {
                            <div class="details-row"><span class="label">@T["AdminOrdersReview.InGamePlayerName"]:</span><span>@selectedOrder.Payment.InGamePlayerName</span></div>
                        }
                        <div class="details-row"><span class="label">@T["AdminOrdersReview.GrossAmount"]:</span><span>@FormatAmount(selectedOrder)</span></div>
                        <div class="details-row"><span class="label">@T["AdminOrdersReview.OperationFee"]:</span><span>@(releaseBreakdown?.Percent.ToString("0.##") ?? "0")%</span></div>
                        <div class="details-row"><span class="label">@T["AdminOrdersReview.FeeAmount"]:</span><span>@FormatAmountByCurrency(releaseBreakdown?.FeeAmount ?? 0m, selectedOrder)</span></div>
                        <div class="details-row"><span class="label">@T["AdminOrdersReview.NetAmount"]:</span><span><b>@FormatAmountByCurrency(releaseBreakdown?.NetAmount ?? 0m, selectedOrder)</b></span></div>
                    </div>

                    <div class="release-modal-side">
                        @if (!string.IsNullOrWhiteSpace(selectedOrder.Product?.ImagePath))
                        {
                            <div class="release-product-preview-wrapper">
                                <img src="@selectedOrder.Product.ImagePath" alt="@selectedOrder.Product.Name" class="release-product-preview-img" />
                            </div>
                        }
                    </div>
                </div>

                <div class="evidence-section release-evidence-row">
                    <div class="evidence-card">
                        <div class="evidence-card-title"><i class="fas fa-user"></i><b>@T["AdminOrders.Buyer"]</b></div>
                        @if (!string.IsNullOrEmpty(selectedOrder.BuyerEvidencePath))
                        {
                            <div>@T["AdminOrdersReview.Comment"] @selectedOrder.BuyerEvidenceComment</div>
                            <a href="@selectedOrder.BuyerEvidencePath" target="_blank">
                                <i class="fas fa-file-image"></i> @T["AdminOrdersReview.ViewEvidence"]
                            </a>
                        }
                        else
                        {
                            <div class="text-muted">@T["AdminOrdersReview.NoEvidence"]</div>
                        }
                    </div>
                    <div class="evidence-card">
                        <div class="evidence-card-title"><i class="fas fa-truck"></i><b>@T["AdminOrders.Seller"]</b></div>
                        @if (!string.IsNullOrEmpty(selectedOrder.SellerEvidencePath))
                        {
                            <div>@T["AdminOrdersReview.Comment"] @selectedOrder.SellerEvidenceComment</div>
                            <a href="@selectedOrder.SellerEvidencePath" target="_blank">
                                <i class="fas fa-file-image"></i> @T["AdminOrdersReview.ViewEvidence"]
                            </a>
                        }
                        else
                        {
                            <div class="text-muted">@T["AdminOrdersReview.NoEvidence"]</div>
                        }
                    </div>
                </div>
            </div>
            <div class="modal-actions">
                <button class="success-btn" @onclick="ConfirmReleaseFunds">@T["AdminOrdersReview.Modal.Confirm"]</button>
                <button class="back-btn" @onclick="() => showReleaseModal = false">@T["Common.Cancel"]</button>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    List<OrderModel> orders = new();
    private bool showReleaseModal = false;
    private int releaseOrderId;
    private OrderModel? selectedOrder;
    private OperationFeeBreakdown? releaseBreakdown;
    private string buyerFilter = string.Empty;
    private string productFilter = string.Empty;
    private decimal? minAmountFilter;
    private decimal? maxAmountFilter;
    private int currentPage = 1;
    private const int pageSize = 8;
    private bool filtersLoaded;
    private bool wasReleaseModalOpen;
    private bool showRestoredFiltersNotice;
    private OrderReviewSortColumn currentSortColumn = OrderReviewSortColumn.Amount;
    private bool sortAscending = false;

    private const string BuyerFilterStorageKey = "admin.ordersReview.buyerFilter";
    private const string ProductFilterStorageKey = "admin.ordersReview.productFilter";
    private const string MinAmountStorageKey = "admin.ordersReview.minAmount";
    private const string MaxAmountStorageKey = "admin.ordersReview.maxAmount";
    private const string PageStorageKey = "admin.ordersReview.page";
    private const string SortColumnStorageKey = "admin.ordersReview.sortColumn";
    private const string SortDirectionStorageKey = "admin.ordersReview.sortAscending";
    private bool IsDefaultSort => currentSortColumn == OrderReviewSortColumn.Amount && !sortAscending;
    private string CurrentSortLabel => $"{SortColumnLabel(currentSortColumn)} {(sortAscending ? "â†‘" : "â†“")}";

    private IEnumerable<OrderModel> FilteredOrders
    {
        get
        {
            var query = orders.Where(o =>
                (string.IsNullOrWhiteSpace(buyerFilter)
                    || (o.Buyer?.UserName?.Contains(buyerFilter, StringComparison.OrdinalIgnoreCase) ?? false))
                &&
                (string.IsNullOrWhiteSpace(productFilter)
                    || (o.Product?.Name?.Contains(productFilter, StringComparison.OrdinalIgnoreCase) ?? false))
                &&
                (!minAmountFilter.HasValue || o.Amount >= minAmountFilter.Value)
                &&
                (!maxAmountFilter.HasValue || o.Amount <= maxAmountFilter.Value));

            return OrderReviewSorting.Apply(query, currentSortColumn, sortAscending);
        }
    }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredOrders.Count() / (double)pageSize));

    private IEnumerable<OrderModel> PagedOrders =>
        FilteredOrders
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize);

    protected override async Task OnInitializedAsync()
    {
        orders = await Db.Orders
            .Include(o => o.Buyer)
            .Include(o => o.Seller)
            .Include(o => o.Product)
            .Include(o => o.Payment)
            .Where(o => o.Status == PaymentStatus.AguardandoRevisaoAdm)
            .ToListAsync();

        PaymentEventBus.OnOrderEnteredReview += HandleOrderEnteredReview;
    }

    private bool showNewOrderToast;

    private void HandleOrderEnteredReview(int orderId)
    {
        _ = InvokeAsync(async () =>
        {
            var newOrder = await Db.Orders
                .Include(o => o.Buyer)
                .Include(o => o.Seller)
                .Include(o => o.Product)
                .Include(o => o.Payment)
                .FirstOrDefaultAsync(o => o.Id == orderId);

            if (newOrder != null && !orders.Any(o => o.Id == orderId))
            {
                orders.Add(newOrder);
                showNewOrderToast = true;
                StateHasChanged();
            }
        });
    }

    private void DismissNewOrderToast() => showNewOrderToast = false;

    public void Dispose()
    {
        PaymentEventBus.OnOrderEnteredReview -= HandleOrderEnteredReview;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !filtersLoaded)
        {
            await LoadFiltersFromStorageAsync();
            filtersLoaded = true;
            StateHasChanged();
        }

        await SyncModalAccessibilityAsync();
    }

    private async Task ClearFiltersAsync()
    {
        buyerFilter = string.Empty;
        productFilter = string.Empty;
        minAmountFilter = null;
        maxAmountFilter = null;
        currentPage = 1;
        showRestoredFiltersNotice = false;
        await PersistFilterStateAsync();
    }

    private async Task ResetSortingAsync()
    {
        if (IsDefaultSort)
        {
            return;
        }

        currentSortColumn = OrderReviewSortColumn.Amount;
        sortAscending = false;
        currentPage = 1;
        await PersistFilterStateAsync();
    }

    private async Task OnFiltersChangedAsync()
    {
        currentPage = 1;
        await PersistFilterStateAsync();
    }

    private async Task NextPageAsync()
    {
        if (currentPage < TotalPages)
        {
            currentPage++;
            await PersistFilterStateAsync();
        }
    }

    private async Task PrevPageAsync()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await PersistFilterStateAsync();
        }
    }

    private async Task ShowReleaseModalAsync(int orderId)
    {
        releaseOrderId = orderId;
        selectedOrder = orders.FirstOrDefault(o => o.Id == orderId);
        if (selectedOrder is null)
        {
            showReleaseModal = false;
            releaseBreakdown = null;
            return;
        }

        releaseBreakdown = await OperationFeeCalculatorService.CalculateBreakdownAsync(selectedOrder.Amount);
        showReleaseModal = true;
    }

    private async Task ConfirmReleaseFunds()
    {
        showReleaseModal = false;
        await ReleaseFunds(releaseOrderId);
    }

    private void HandleModalKeydown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            showReleaseModal = false;
        }
    }

    private async Task SyncModalAccessibilityAsync()
    {
        try
        {
            if (showReleaseModal && !wasReleaseModalOpen)
            {
                await JS.InvokeVoidAsync("ConfirmaiModal.open", "#admin-release-funds-modal");
            }
            else if (!showReleaseModal && wasReleaseModalOpen)
            {
                await JS.InvokeVoidAsync("ConfirmaiModal.close");
            }
        }
        catch
        {
            // No-op: fallback to native browser focus behavior if JS interop is unavailable.
        }

        wasReleaseModalOpen = showReleaseModal;
    }

    private async Task ReleaseFunds(int orderId)
    {
        var adminUserId = await GetCurrentUserIdAsync();
        var result = await AdminOrderReleaseService.ReleaseFundsAsync(orderId, adminUserId);
        if (!result.Succeeded)
        {
            return;
        }

        orders.RemoveAll(o => o.Id == orderId);
        if (currentPage > TotalPages)
        {
            currentPage = TotalPages;
        }

        await PersistFilterStateAsync();
        StateHasChanged();
    }

    private async Task<string?> GetCurrentUserIdAsync()
    {
        if (AuthenticationStateTask is null)
        {
            return null;
        }

        var authState = await AuthenticationStateTask;
        var user = authState.User;

        return user.Identity?.IsAuthenticated == true
            ? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
            : null;
    }

    private async Task LoadFiltersFromStorageAsync()
    {
        try
        {
            var restoredAnyState = false;

            buyerFilter = await JS.InvokeAsync<string?>("localStorage.getItem", BuyerFilterStorageKey) ?? string.Empty;
            productFilter = await JS.InvokeAsync<string?>("localStorage.getItem", ProductFilterStorageKey) ?? string.Empty;

            if (!string.IsNullOrWhiteSpace(buyerFilter) || !string.IsNullOrWhiteSpace(productFilter))
            {
                restoredAnyState = true;
            }

            var minAmountRaw = await JS.InvokeAsync<string?>("localStorage.getItem", MinAmountStorageKey);
            if (decimal.TryParse(minAmountRaw, NumberStyles.Number, CultureInfo.InvariantCulture, out var minValue))
            {
                minAmountFilter = minValue;
                restoredAnyState = true;
            }

            var maxAmountRaw = await JS.InvokeAsync<string?>("localStorage.getItem", MaxAmountStorageKey);
            if (decimal.TryParse(maxAmountRaw, NumberStyles.Number, CultureInfo.InvariantCulture, out var maxValue))
            {
                maxAmountFilter = maxValue;
                restoredAnyState = true;
            }

            var pageRaw = await JS.InvokeAsync<string?>("localStorage.getItem", PageStorageKey);
            if (int.TryParse(pageRaw, out var pageValue) && pageValue > 0)
            {
                currentPage = Math.Min(pageValue, TotalPages);
                restoredAnyState = restoredAnyState || currentPage > 1;
            }

            var sortColumnRaw = await JS.InvokeAsync<string?>("localStorage.getItem", SortColumnStorageKey);
            if (Enum.TryParse<OrderReviewSortColumn>(sortColumnRaw, out var savedSortColumn))
            {
                currentSortColumn = savedSortColumn;
                restoredAnyState = true;
            }

            var sortDirectionRaw = await JS.InvokeAsync<string?>("localStorage.getItem", SortDirectionStorageKey);
            if (bool.TryParse(sortDirectionRaw, out var savedSortAscending))
            {
                sortAscending = savedSortAscending;
                restoredAnyState = true;
            }

            showRestoredFiltersNotice = restoredAnyState;
        }
        catch
        {
            // No-op: keep default filter state when localStorage is unavailable.
        }
    }

    private async Task PersistFilterStateAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", BuyerFilterStorageKey, buyerFilter);
            await JS.InvokeVoidAsync("localStorage.setItem", ProductFilterStorageKey, productFilter);

            if (minAmountFilter.HasValue)
            {
                await JS.InvokeVoidAsync("localStorage.setItem", MinAmountStorageKey, minAmountFilter.Value.ToString(CultureInfo.InvariantCulture));
            }
            else
            {
                await JS.InvokeVoidAsync("localStorage.removeItem", MinAmountStorageKey);
            }

            if (maxAmountFilter.HasValue)
            {
                await JS.InvokeVoidAsync("localStorage.setItem", MaxAmountStorageKey, maxAmountFilter.Value.ToString(CultureInfo.InvariantCulture));
            }
            else
            {
                await JS.InvokeVoidAsync("localStorage.removeItem", MaxAmountStorageKey);
            }

            await JS.InvokeVoidAsync("localStorage.setItem", PageStorageKey, currentPage.ToString(CultureInfo.InvariantCulture));
            await JS.InvokeVoidAsync("localStorage.setItem", SortColumnStorageKey, currentSortColumn.ToString());
            await JS.InvokeVoidAsync("localStorage.setItem", SortDirectionStorageKey, sortAscending.ToString(CultureInfo.InvariantCulture));
        }
        catch
        {
            // No-op: ignore storage failures and keep in-memory behavior.
        }
    }

    private void DismissRestoredNotice()
    {
        showRestoredFiltersNotice = false;
    }

    private async Task ApplySortAsync(OrderReviewSortColumn column)
    {
        if (currentSortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            currentSortColumn = column;
            sortAscending = true;
        }

        currentPage = 1;
        await PersistFilterStateAsync();
    }

    private string SortIndicator(OrderReviewSortColumn column)
    {
        if (currentSortColumn != column)
        {
            return "â†•";
        }

        return sortAscending ? "â†‘" : "â†“";
    }

    private string SortButtonClass(OrderReviewSortColumn column)
        => currentSortColumn == column ? "table-sort-btn active" : "table-sort-btn";

    private string SortColumnLabel(OrderReviewSortColumn column)
        => column switch
        {
            OrderReviewSortColumn.Buyer => T["AdminOrders.Buyer"],
            OrderReviewSortColumn.Product => T["AdminOrders.Product"],
            _ => T["Common.Value"]
        };

    private static string FormatAmountByCurrency(decimal amount, OrderModel order)
    {
        var currency = order.Payment?.Currency;
        return currency switch
        {
            "BRL" => $"R$ {amount:N2}",
            "USD" => $"$ {amount:N2}",
            _ => $"{amount:0.########} BTC"
        };
    }

    private static string FormatAmount(OrderModel order)
        => FormatAmountByCurrency(order.Amount, order);
}

