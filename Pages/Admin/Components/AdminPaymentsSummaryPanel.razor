@using System.Collections.Generic
@using Confirmai.Pages.Admin
@using Confirmai.Services.Core
@inject UiTextService T

<section class="admin-payments-summary-card" aria-label="@T["AdminPayments.ReconciliationPanel"]">
    <div class="admin-payments-summary-grid">
        <div class="admin-payments-summary-item">
            <span class="admin-payments-summary-label">@T["AdminPayments.PendingWithChargeIdLabel"]</span>
            <strong class="admin-payments-summary-value">@PendingWithChargeId</strong>
        </div>
        <div class="admin-payments-summary-item">
            <span class="admin-payments-summary-label">@T["AdminPayments.PendingWithoutChargeIdLabel"]</span>
            <strong class="admin-payments-summary-value">@PendingWithoutChargeId</strong>
        </div>
        <div class="admin-payments-summary-item">
            <span class="admin-payments-summary-label">@T["AdminPayments.StalePendingLabel"]</span>
            <strong class="admin-payments-summary-value">@StalePending</strong>
        </div>
        <div class="admin-payments-summary-item">
            <span class="admin-payments-summary-label">@T["AdminPayments.PaidTodayLabel"]</span>
            <strong class="admin-payments-summary-value">@PaidToday</strong>
        </div>
    </div>
    <div class="admin-payments-summary-actions">
        <button type="button" class="details-btn" disabled="@IsRunningSweep" @onclick="OnRunSweep">
            @(IsRunningSweep ? @T["AdminPayments.CheckingPending"] : @T["AdminPayments.RevalidatePendingNow"])
        </button>
        <button type="button" class="details-btn" disabled="@IsRefreshing" @onclick="OnRefreshSummary">
            @(IsRefreshing ? @T["AdminPayments.Updating"] : @T["AdminPayments.RefreshDashboard"])
        </button>
        <button type="button" class="details-btn" @onclick="OnExportCsv">
            @T["AdminPayments.ExportReconciliationCsv"]
        </button>
        <button type="button" class="details-btn" @onclick="OnOpenAdvancedTools">
            @T["AdminPayments.AdvancedTools"]
        </button>
        <label class="admin-payments-auto-refresh-toggle">
            <input type="checkbox" @bind="AutoRefreshEnabled" />
            @T["AdminPayments.AutoRefresh"]
        </label>
        @if (IsAutoRefreshPaused)
        {
            <span class="admin-payments-auto-refresh-pill admin-payments-auto-refresh-pill--paused">@T["AdminPayments.AutoRefreshPaused"]</span>
        }
        <span class="admin-payments-summary-hint">@T["AdminPayments.SameRoutineHint"]</span>
        <span class="admin-payments-severity-pill @SeverityClass">Severity: @SeverityLabel</span>
    </div>
    <div class="admin-payments-summary-meta">
        <span>@T["AdminPayments.LastDashboardUpdate"] @LastRefreshLabel</span>
        <span class="@LastRefreshAgeClass">
            @T["AdminPayments.NoUpdateFor"] @LastRefreshAgeLabel
            <span class="admin-payments-summary-age-hint" title="Alerta quando excede 2 ciclos de auto-refresh (60s)." aria-label="@T["AdminPayments.StalenessAlertExplanation"]">i</span>
        </span>
        <span>@T["AdminPayments.LastAutoRefreshPause"] @LastAutoRefreshPauseLabel</span>
        <span>@T["AdminPayments.LastAutoSweep"] @LastAutomaticSweepLabel</span>
        @if (!string.IsNullOrWhiteSpace(LastAutomaticSweepDetails))
        {
            <span>@T["AdminPayments.LastSweepSummary"] @LastAutomaticSweepDetails</span>
        }
        <span>@T["AdminPayments.LastManualSweep"] @LastManualSweepLabel</span>
        @if (!string.IsNullOrWhiteSpace(LastManualSweepDetails))
        {
            <span>@T["AdminPayments.LastManualSweepSummary"] @LastManualSweepDetails</span>
        }
        <span class="admin-payments-trend @(IsPendingTrendWarning ? "admin-payments-trend--warning" : "")">@T["AdminPayments.Trend24hSweep"] @PendingTrend24hLabel</span>
        <a class="admin-payments-summary-link" href="@StalenessLogsHref">@T["AdminPayments.ViewStalenessLogs"]</a>
        <span>@T["AdminPayments.PendingByGateway"] @PendingByGatewayLabel</span>
        <span>@T["AdminPayments.PaidByGateway"] @PaidByGatewayLabel</span>
    </div>

    @if (GatewayTelemetry?.Count > 0)
    {
        <div class="admin-payments-gateway-telemetry">
            <span class="admin-payments-gateway-telemetry-title">@T["AdminPayments.GatewayTelemetryTitle"]</span>
            <table class="admin-payments-gateway-telemetry-table">
                <thead>
                    <tr>
                        <th>@T["AdminPayments.Gateway"]</th>
                        <th>@T["AdminPayments.PendingLabel"]</th>
                        <th>@T["AdminPayments.StalePendingShort"]</th>
                        <th>@T["AdminPayments.PaidTotal"]</th>
                        <th>@T["AdminPayments.PendingShare"]</th>
                        <th>@T["AdminPayments.Severity"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in GatewayTelemetry!)
                    {
                        <tr>
                            <td>@item.Gateway</td>
                            <td>@item.Pending</td>
                            <td>@item.StalePending</td>
                            <td>@item.PaidTotal</td>
                            <td>@item.PendingShareLabel</td>
                            <td>
                                <span class="admin-payments-gateway-severity @item.SeverityClass">@item.SeverityLabel</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (SweepHistory?.Count > 0)
    {
        <div class="admin-payments-sweep-history">
            <span class="admin-payments-sweep-history-title">@T["AdminPayments.Last5AutoSweeps"]</span>
            <div class="admin-payments-sparkline" role="img" aria-label="@T["AdminPayments.SparklineAria"]">
                @foreach (var point in SweepHistory!.AsEnumerable().Reverse())
                {
                    var pointHeight = GetPendingHeightPercent(point);
                    <div class="admin-payments-sparkline-point" style="height:@($"{pointHeight}%")" title="@($"{point.TimestampLabel}: {point.StillPending} pending")"></div>
                }
            </div>
            <ul>
                @foreach (var item in SweepHistory!)
                {
                    <li>@item.TimestampLabel - Considered=@item.Considered, Updated=@item.Updated, Pending=@item.StillPending, Not found=@item.NotFound</li>
                }
            </ul>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(SweepResultMessage))
    {
        <div class="orders-review-restored-notice admin-payments-reconcile-result @(SweepResultIsError ? "admin-payments-reconcile-result--error" : "admin-payments-reconcile-result--ok")">
            <span>@SweepResultMessage</span>
            <button type="button" class="orders-review-restored-close" @onclick="OnDismissSweepMessage" aria-label="Close">&times;—</button>
        </div>
    }
</section>
