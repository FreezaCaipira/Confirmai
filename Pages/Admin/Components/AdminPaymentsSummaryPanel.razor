@using System.Collections.Generic
@using Confirmai.Pages.Admin

<section class="admin-payments-summary-card" aria-label="Painel de reconciliação de pagamentos">
    <div class="admin-payments-summary-grid">
        <div class="admin-payments-summary-item">
            <span class="admin-payments-summary-label">Pendente com chargeId</span>
            <strong class="admin-payments-summary-value">@PendingWithChargeId</strong>
        </div>
        <div class="admin-payments-summary-item">
            <span class="admin-payments-summary-label">Pendente sem chargeId</span>
            <strong class="admin-payments-summary-value">@PendingWithoutChargeId</strong>
        </div>
        <div class="admin-payments-summary-item">
            <span class="admin-payments-summary-label">Pendente obsoleto (+30 min)</span>
            <strong class="admin-payments-summary-value">@StalePending</strong>
        </div>
        <div class="admin-payments-summary-item">
            <span class="admin-payments-summary-label">Confirmações pagas hoje</span>
            <strong class="admin-payments-summary-value">@PaidToday</strong>
        </div>
    </div>
    <div class="admin-payments-summary-actions">
        <button type="button" class="details-btn" disabled="@IsRunningSweep" @onclick="OnRunSweep">
            @(IsRunningSweep ? "Verificando pendentes..." : "Revalidar pendentes agora")
        </button>
        <button type="button" class="details-btn" disabled="@IsRefreshing" @onclick="OnRefreshSummary">
            @(IsRefreshing ? "Atualizando..." : "Atualizar dashboard")
        </button>
        <button type="button" class="details-btn" @onclick="OnExportCsv">
            Exportar reconciliação CSV
        </button>
        <button type="button" class="details-btn" @onclick="OnOpenAdvancedTools">
            Ferramentas avançadas
        </button>
        <label class="admin-payments-auto-refresh-toggle">
            <input type="checkbox" @bind="AutoRefreshEnabled" />
            Auto refresh (30s)
        </label>
        @if (IsAutoRefreshPaused)
        {
            <span class="admin-payments-auto-refresh-pill admin-payments-auto-refresh-pill--paused">Auto refresh pausado (aba em segundo plano)</span>
        }
        <span class="admin-payments-summary-hint">Usa a mesma rotina do worker automático.</span>
        <span class="admin-payments-severity-pill @SeverityClass">Severity: @SeverityLabel</span>
    </div>
    <div class="admin-payments-summary-meta">
        <span>Última atualização do dashboard: @LastRefreshLabel</span>
        <span class="@LastRefreshAgeClass">
            Sem atualização há: @LastRefreshAgeLabel
            <span class="admin-payments-summary-age-hint" title="Alerta quando excede 2 ciclos de auto-refresh (60s)." aria-label="Explicação do alerta de obsolescência">i</span>
        </span>
        <span>Última pausa por aba em segundo plano: @LastAutoRefreshPauseLabel</span>
        <span>Último sweep automático: @LastAutomaticSweepLabel</span>
        @if (!string.IsNullOrWhiteSpace(LastAutomaticSweepDetails))
        {
            <span>Resumo do último sweep: @LastAutomaticSweepDetails</span>
        }
        <span>Último sweep manual: @LastManualSweepLabel</span>
        @if (!string.IsNullOrWhiteSpace(LastManualSweepDetails))
        {
            <span>Resumo do último sweep manual: @LastManualSweepDetails</span>
        }
        <span class="admin-payments-trend @(IsPendingTrendWarning ? "admin-payments-trend--warning" : "")">Tendência 24h (pendentes no sweep): @PendingTrend24hLabel</span>
        <a class="admin-payments-summary-link" href="@StalenessLogsHref">Ver incidentes de obsolescência no log</a>
        <span>Pendentes por gateway: @PendingByGatewayLabel</span>
        <span>Pagos por gateway (total): @PaidByGatewayLabel</span>
    </div>

    @if (GatewayTelemetry?.Count > 0)
    {
        <div class="admin-payments-gateway-telemetry">
            <span class="admin-payments-gateway-telemetry-title">Telemetria por gateway (reconciliação)</span>
            <table class="admin-payments-gateway-telemetry-table">
                <thead>
                    <tr>
                        <th>Gateway</th>
                        <th>Pendente</th>
                        <th>Pendente obsoleto</th>
                        <th>Pago (total)</th>
                        <th>Share pendente</th>
                        <th>Severidade</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in GatewayTelemetry!)
                    {
                        <tr>
                            <td>@item.Gateway</td>
                            <td>@item.Pending</td>
                            <td>@item.StalePending</td>
                            <td>@item.PaidTotal</td>
                            <td>@item.PendingShareLabel</td>
                            <td>
                                <span class="admin-payments-gateway-severity @item.SeverityClass">@item.SeverityLabel</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (SweepHistory?.Count > 0)
    {
        <div class="admin-payments-sweep-history">
            <span class="admin-payments-sweep-history-title">Últimos 5 sweeps automáticos</span>
            <div class="admin-payments-sparkline" role="img" aria-label="Tendência de itens pendentes nos sweeps recentes">
                @foreach (var point in SweepHistory!.AsEnumerable().Reverse())
                {
                    var pointHeight = GetPendingHeightPercent(point);
                    <div class="admin-payments-sparkline-point" style="height:@($"{pointHeight}%")" title="@($"{point.TimestampLabel}: {point.StillPending} pending")"></div>
                }
            </div>
            <ul>
                @foreach (var item in SweepHistory!)
                {
                    <li>@item.TimestampLabel - Considered=@item.Considered, Updated=@item.Updated, Pending=@item.StillPending, Not found=@item.NotFound</li>
                }
            </ul>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(SweepResultMessage))
    {
        <div class="orders-review-restored-notice admin-payments-reconcile-result @(SweepResultIsError ? "admin-payments-reconcile-result--error" : "admin-payments-reconcile-result--ok")">
            <span>@SweepResultMessage</span>
            <button type="button" class="orders-review-restored-close" @onclick="OnDismissSweepMessage" aria-label="Close">&times;—</button>
        </div>
    }
</section>
