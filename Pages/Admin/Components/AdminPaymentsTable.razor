@using Confirmai.Data
@using Confirmai.Models
@using Microsoft.AspNetCore.Components
@using Confirmai.Services.Core
@inject UiTextService T

@if (TotalItems == 0)
{
    <AdminDataState IsLoading="false" IsEmpty="true" LoadingText="@T["AdminPayments.Loading"]" EmptyText="@T["AdminPayments.Empty"]" EmptyIcon="fas fa-money-bill-wave" EmptyHint="@T["AdminPayments.EmptyHint"]">
    </AdminDataState>
}
else
{
    <div class="payments-table-container">
        <table class="payments-table align-right">
            <thead>
                <tr>
                    <th>@T["AdminPayments.User"]</th>
                    <th>@T["AdminPayments.Gateway"]</th>
                    <th>@T["AdminPayments.Value"]</th>
                    <th>@T["AdminPayments.Status"]</th>
                    <th>@T["AdminPayments.Date"]</th>
                    <th>@T["AdminPayments.Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Payments)
                {
                    <tr>
                        <td data-label="User">
                            @if (p.User != null)
                            {
                                <a class="evidence-link" href="@($"/admin/users/view/{p.UserId}")">
                                    @p.User.UserName
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">ID: @p.UserId</span>
                            }
                        </td>
                        <td data-label="Gateway">@p.PaymentMethod</td>
                        <td data-label="Value">@FormatAmount?.Invoke(p.Amount)</td>
                        <td data-label="Status">
                            @if (p.IsPaid)
                            {
                                <span class="order-status-badge pago">@T["AdminPayments.StatusPaid"]</span>
                            }
                            else
                            {
                                <span class="order-status-badge aguardandopagamento">@T["AdminPayments.StatusPending"]</span>
                            }
                        </td>
                        <td data-label="Date">@p.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                        <td data-label="Actions">
                            <div class="admin-actions-row">
                                <button class="details-btn action-btn icon-only" @onclick="() => OnViewPayment.InvokeAsync(p.Id)" title="@T["AdminPayments.Details"]" aria-label="@T["AdminPayments.Details"]">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (TotalPages > 1)
    {
        <div class="pagination admin-users-pagination">
            <button type="button" @onclick="PrevPage" disabled="@(CurrentPage <= 1)">@T["AdminPayments.Prev"]</button>
            <span class="pagination-info">@T.Get("AdminPayments.PageInfo", CurrentPage, TotalPages)</span>
            <button type="button" @onclick="NextPage" disabled="@(CurrentPage >= TotalPages)">@T["AdminPayments.Next"]</button>
        </div>
    }
}
