@using Confirmai.Services

<div class="filter-bar admin-filter-card">
    <input type="text" placeholder="User ID" @bind="filterUserId" @bind:event="oninput" />
    <input type="number" placeholder="Min amount" @bind="filterMinAmount" min="0" />
    <input type="number" placeholder="Max amount" @bind="filterMaxAmount" min="0" />
    <select @bind="filterStatus">
        <option value="">All statuses</option>
        <option value="paid">Paid</option>
        <option value="pending">Pending</option>
    </select>
    <input type="date" @bind="filterDate" />
    <button type="button" @onclick="ApplyFilters">Filter</button>
    <button type="button" @onclick="ClearFilters">Clear</button>
</div>

@if (ShowRestoredNotice)
{
    <div class="orders-review-restored-notice">
        <span>Previous filters have been restored.</span>
        <button type="button" class="orders-review-restored-close" @onclick="DismissNotice" aria-label="Close">&times;—</button>
    </div>
}
