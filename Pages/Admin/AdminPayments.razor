@page "/admin/payments"

@attribute [Authorize(Roles = "admin")]
@implements IAsyncDisposable

@using Confirmai.Models
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using System.Text.Json
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using Confirmai.Shared.Helpers
@using Confirmai.Data
@using Confirmai.Services
@using Confirmai.Services.Admin
@using Microsoft.AspNetCore.Components.Web

@inject IDbContextFactory<AppDbContext> DbFactory
@inject BitcoinQuoteService BitcoinQuoteService
@inject CurrencyPreferenceService CurrencyPreferenceService
@inject AdminSettingsService AdminSettingsService
@inject AdminPaymentsFilterStateService AdminPaymentsFilterStateService
@inject AdminPaymentsQueryService AdminPaymentsQueryService
@inject AdminPaymentsSummaryService AdminPaymentsSummaryService
@inject EventPaymentReconciliationService EventPaymentReconciliationService
@inject EventConfirmationPaymentStatusService EventConfirmationPaymentStatusService
@inject AdminLogsExportService AdminLogsExportService
@inject AuthenticationStateProvider AuthStateProvider
@inject LogService LogService
@inject UiTextService T
@inject ReconciliationSeverityEvaluator SeverityEvaluator
@inject AdminPaymentsCommandService AdminPaymentsCommandService

<div class="entity-shell admin-page admin-payments-shell">

    <section class="entity-shell-grid" aria-label="@T["AdminPayments.Aria"]">
        <article class="entity-shell-card entity-shell-main">
            <h1 class="page-section-title">@T["AdminPayments.Title"]</h1>

            <AdminPaymentsSummaryPanel
                PendingWithChargeId="@reconciliationPendingWithChargeId"
                PendingWithoutChargeId="@reconciliationPendingWithoutChargeId"
                StalePending="@reconciliationStalePending"
                PaidToday="@reconciliationPaidToday"
                IsRunningSweep="@isRunningSweep"
                IsRefreshing="@isSummaryRefreshing"
                AutoRefreshEnabled="@isAutoRefreshEnabled"
                IsAutoRefreshPaused="@isAutoRefreshPausedByVisibility"
                SeverityLabel="@reconciliationSeverityLabel"
                SeverityClass="@reconciliationSeverityClass"
                PendingTrend24hLabel="@pendingTrend24hLabel"
                IsPendingTrendWarning="@isPendingTrendWarning"
                PendingByGatewayLabel="@pendingByGatewayLabel"
                PaidByGatewayLabel="@paidByGatewayLabel"
                LastRefreshLabel="@SummaryAgeTracker.LastRefreshLabel"
                LastRefreshAgeLabel="@SummaryAgeTracker.AgeLabel"
                LastRefreshAgeClass="@SummaryAgeTracker.AgeClass"
                LastAutoRefreshPauseLabel="@lastAutoRefreshPauseLabel"
                LastAutomaticSweepLabel="@lastAutomaticSweepLabel"
                LastAutomaticSweepDetails="@lastAutomaticSweepDetails"
                LastManualSweepLabel="@lastManualSweepLabel"
                LastManualSweepDetails="@lastManualSweepDetails"
                GatewayTelemetry="@gatewayTelemetry"
                SweepHistory="@automaticSweepHistory"
                SweepResultMessage="@sweepResultMessage"
                SweepResultIsError="@sweepResultIsError"
                StalenessLogsHref="@BuildStalenessLogsHref()"
                OnRunSweep="@RunSweepNowAsync"
                OnRefreshSummary="@RefreshSummaryNowAsync"
                OnExportCsv="@ExportReconciliationCsvAsync"
                OnOpenAdvancedTools="@OpenAdvancedToolsModal"
                OnDismissSweepMessage="@DismissSweepMessage" />

            <AdminPaymentsAdvancedToolsModal
                IsOpen="@isAdvancedToolsModalOpen"
                IsReconciling="@isReconciling"
                IsStatusTransitioning="@isStatusTransitioning"
                ReconcileResultMessage="@reconcileResultMessage"
                ReconcileResultIsError="@reconcileResultIsError"
                ReconcileResultConfirmationId="@reconcileResultConfirmationId"
                StatusTransitionResultMessage="@statusTransitionResultMessage"
                StatusTransitionResultIsError="@statusTransitionResultIsError"
                StatusTransitionConfirmationId="@statusTransitionConfirmationId"
                OnClose="@CloseAdvancedToolsModalAsync"
                OnReconcileCharge="@ReconcileChargeAsync"
                OnOpenConfirmationTimeline="@OpenConfirmationTimeline"
                OnApplyStatusTransition="@ApplyStatusTransitionAsync" />

            <AdminPaymentsFilters
                FilterUserId="@filterUserId"
                FilterMinAmount="@filterMinAmount"
                FilterMaxAmount="@filterMaxAmount"
                FilterStatus="@filterStatus"
                FilterDate="@filterDate"
                ShowRestoredNotice="@showRestoredFiltersNotice"
                OnApplyFilters="@HandleFiltersApplied"
                OnClearFilters="@ClearFilters"
                OnDismissNotice="@DismissRestoredNotice" />

            <AdminPaymentsTable
                TotalItems="@totalCount"
                Payments="@currentPagePayments"
                CurrentPage="@currentPage"
                TotalPages="@totalPages"
                FormatAmount="@FormatBtcWithUsd"
                OnViewPayment="@ViewPayment"
                OnPrevPage="@GoToPrevPage"
                OnNextPage="@GoToNextPage" />

        </article>
    </section>

    <section class="entity-shell-footer" aria-label="@T["AdminCommon.ExtraActions"]">
        <button class="back-btn" @onclick='() => NavigationManager.NavigateTo("/admin")'>@T["Common.Back"]</button>
    </section>
</div>


