@page "/admin/venues"

@attribute [Authorize(Roles = "admin")]

@using Confirmai.Data
@using Confirmai.Enums
@using Confirmai.Models
@using Confirmai.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Confirmai.Services.Core
@inject UiTextService T


<div class="entity-shell admin-page admin-venues-page">

    <PageTitle>@T["AdminVenues.PageTitle"]</PageTitle>

    <section class="entity-shell-grid" aria-label="@T["AdminVenues.Aria"]">
        <article class="entity-shell-card entity-shell-main">
            <h1 class="page-section-title">@T["AdminVenues.Title"]</h1>

            <div class="filter-bar admin-filter-card">
                <input type="text" placeholder="@T["AdminVenues.FilterName"]"
                       @bind="filterName" @bind:event="oninput" @bind:after="ApplyFilter" />
                <select @bind="filterType" @bind:after="ApplyFilter">
                    <option value="">@T["AdminVenues.AllTypes"]</option>
                    @foreach (var t in Enum.GetValues<VenueType>())
                    {
                        <option value="@((int)t)">@VenueTypeLabel(t)</option>
                    }
                </select>
                <select @bind="filterState" @bind:after="ApplyFilter">
                    <option value="">@T["AdminVenues.AllStates"]</option>
                    <option value="active">@T["AdminVenues.Active"]</option>
                    <option value="inactive">@T["AdminVenues.Inactive"]</option>
                </select>
                <div class="filter-action-buttons">
                    <button type="button" @onclick="ClearFilters">@T["AdminVenues.Clear"]</button>
                    <button type="button" class="success-btn" @onclick='() => NavigationManager.NavigateTo("/admin/venues/edit/0")'>
                        <i class="fas fa-plus"></i> @T["AdminVenues.NewVenue"]
                    </button>
                </div>
            </div>

            <AdminDataState IsLoading="@isLoading"
                            IsEmpty="@(!filtered.Any())"
                            LoadingText="@T["AdminVenues.Loading"]"
                            EmptyText="@T["AdminVenues.Empty"]"
                            EmptyIcon="fas fa-map-marker-alt"
                            EmptyHint="@T["AdminVenues.EmptyHint"]">
                <table class="product-table">
                    <thead>
                        <tr>
                            <th>@T["AdminVenues.Name"]</th>
                            <th>@T["AdminVenues.Type"]</th>
                            <th>@T["AdminVenues.CityUF"]</th>
                            <th>@T["AdminVenues.Status"]</th>
                            <th>@T["AdminVenues.Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in filtered.Skip((currentPage - 1) * PageSize).Take(PageSize))
                        {
                            <tr>
                                <td data-label="Nome">@v.Name</td>
                                <td data-label="Tipo">
                                    <span class="venue-type-badge venue-type-@v.Type.ToString().ToLower()">
                                        @VenueTypeLabel(v.Type)
                                    </span>
                                </td>
                                <td data-label="Cidade / UF">@v.City — @v.StateCode</td>
                                <td data-label="Status">
                                    @if (v.IsActive)
                                    {
                                        <span class="order-status-badge pago">@T["AdminVenues.ActiveBadge"]</span>
                                    }
                                    else
                                    {
                                        <span class="order-status-badge cancelado">@T["AdminVenues.InactiveBadge"]</span>
                                    }
                                </td>
                                <td data-label="Ações">
                                    @if (confirmDeleteId == v.Id)
                                    {
                                        <div class="admin-actions-row admin-actions-row--compact">
                                            <span class="admin-delete-prompt">@T["AdminVenues.Remove"]</span>
                                            <button class="danger-btn action-btn icon-only" title="@T["Common.Confirm"]"
                                                    @onclick='() => DeleteVenue(v.Id)'>
                                                <i class="fas fa-check"></i>
                                            </button>
                                            <button class="cancel-btn action-btn icon-only" title="@T["Common.Cancel"]"
                                                    @onclick='() => confirmDeleteId = null'>
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="admin-actions-row">
                                            <button class="edit-btn action-btn icon-only"
                                                    @onclick='() => NavigationManager.NavigateTo($"/admin/venues/edit/{v.Id}")'
                                                    title="@T["AdminVenues.Edit"]" aria-label="@T["AdminVenues.Edit"]">
                                                <i class="fas fa-pencil-alt"></i>
                                            </button>
                                            <button class="danger action-btn icon-only"
                                                    @onclick="() => ToggleActive(v)"
                                                    title="@(v.IsActive ? @T["AdminVenues.Deactivate"] : @T["AdminVenues.Activate"])"
                                                    aria-label="@(v.IsActive ? @T["AdminVenues.Deactivate"] : @T["AdminVenues.Activate"])">
                                                <i class="fas @(v.IsActive ? "fa-ban" : "fa-check")"></i>
                                            </button>
                                            <button class="danger-btn action-btn icon-only"
                                                    @onclick='() => { confirmDeleteId = v.Id; deleteError = string.Empty; }'
                                                    title="@T["AdminVenues.RemoveAction"]" aria-label="@T["AdminVenues.RemoveAction"]">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="pagination">
                    <button type="button" @onclick="PrevPage" disabled="@(currentPage <= 1)">@T["AdminVenues.Previous"]</button>
                    <span class="pagination-info">@T.Get("AdminVenues.PageInfo", currentPage, TotalPages)</span>
                    <button type="button" @onclick="NextPage" disabled="@(currentPage >= TotalPages)">@T["AdminVenues.Next"]</button>
                </div>
            </AdminDataState>

            @if (!string.IsNullOrWhiteSpace(deleteError))
            {
                <p class="validation-message validation-message--margin-top-lg">@deleteError</p>
            }
        </article>
    </section>

    <section class="entity-shell-footer" aria-label="@T["AdminCommon.ExtraActions"]">
        <button class="back-btn" @onclick='() => NavigationManager.NavigateTo("/admin")'>@T["AdminVenues.Back"]</button>
    </section>

</div>
