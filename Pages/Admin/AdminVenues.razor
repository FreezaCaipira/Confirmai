@page "/admin/venues"

@attribute [Authorize(Roles = "admin")]

@using Confirmai.Data
@using Confirmai.Enums
@using Confirmai.Models
@using Confirmai.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore


<div class="entity-shell admin-page admin-venues-page">

    <PageTitle>Quadras / Venues — Confirmai</PageTitle>

    <section class="entity-shell-grid" aria-label="Gerenciamento de quadras">
        <article class="entity-shell-card entity-shell-main">
            <h1 class="page-section-title">Quadras &amp; Venues</h1>

            <div class="filter-bar admin-filter-card">
                <input type="text" placeholder="Filtrar por nome…"
                       @bind="filterName" @bind:event="oninput" @bind:after="ApplyFilter" />
                <select @bind="filterType" @bind:after="ApplyFilter">
                    <option value="">Todos os tipos</option>
                    @foreach (var t in Enum.GetValues<VenueType>())
                    {
                        <option value="@((int)t)">@VenueTypeLabel(t)</option>
                    }
                </select>
                <select @bind="filterState" @bind:after="ApplyFilter">
                    <option value="">Todos os estados</option>
                    <option value="active">Ativas</option>
                    <option value="inactive">Inativas</option>
                </select>
                <div class="filter-action-buttons">
                    <button type="button" @onclick="ClearFilters">Limpar</button>
                    <button type="button" class="success-btn" @onclick='() => NavigationManager.NavigateTo("/admin/venues/edit/0")'>
                        <i class="fas fa-plus"></i> Nova Quadra
                    </button>
                </div>
            </div>

            <AdminDataState IsLoading="@isLoading"
                            IsEmpty="@(!filtered.Any())"
                            LoadingText="Carregando quadras…"
                            EmptyText="Nenhuma quadra encontrada."
                            EmptyIcon="fas fa-map-marker-alt"
                            EmptyHint="Cadastre quadras para vinculá-las aos rachas.">
                <table class="product-table">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Tipo</th>
                            <th>Cidade / UF</th>
                            <th>Status</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in filtered.Skip((currentPage - 1) * PageSize).Take(PageSize))
                        {
                            <tr>
                                <td data-label="Nome">@v.Name</td>
                                <td data-label="Tipo">
                                    <span class="venue-type-badge venue-type-@v.Type.ToString().ToLower()">
                                        @VenueTypeLabel(v.Type)
                                    </span>
                                </td>
                                <td data-label="Cidade / UF">@v.City — @v.StateCode</td>
                                <td data-label="Status">
                                    @if (v.IsActive)
                                    {
                                        <span class="order-status-badge pago">Ativa</span>
                                    }
                                    else
                                    {
                                        <span class="order-status-badge cancelado">Inativa</span>
                                    }
                                </td>
                                <td data-label="Ações">
                                    @if (confirmDeleteId == v.Id)
                                    {
                                        <div class="admin-actions-row admin-actions-row--compact">
                                            <span class="admin-delete-prompt">Remover?</span>
                                            <button class="danger-btn action-btn icon-only" title="Confirmar"
                                                    @onclick='() => DeleteVenue(v.Id)'>
                                                <i class="fas fa-check"></i>
                                            </button>
                                            <button class="cancel-btn action-btn icon-only" title="Cancelar"
                                                    @onclick='() => confirmDeleteId = null'>
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="admin-actions-row">
                                            <button class="edit-btn action-btn icon-only"
                                                    @onclick='() => NavigationManager.NavigateTo($"/admin/venues/edit/{v.Id}")'
                                                    title="Editar" aria-label="Editar">
                                                <i class="fas fa-pencil-alt"></i>
                                            </button>
                                            <button class="danger action-btn icon-only"
                                                    @onclick="() => ToggleActive(v)"
                                                    title="@(v.IsActive ? "Desativar" : "Ativar")"
                                                    aria-label="@(v.IsActive ? "Desativar" : "Ativar")">
                                                <i class="fas @(v.IsActive ? "fa-ban" : "fa-check")"></i>
                                            </button>
                                            <button class="danger-btn action-btn icon-only"
                                                    @onclick='() => { confirmDeleteId = v.Id; deleteError = string.Empty; }'
                                                    title="Remover" aria-label="Remover">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="pagination">
                    <button type="button" @onclick="PrevPage" disabled="@(currentPage <= 1)">Anterior</button>
                    <span class="pagination-info">Página @currentPage de @TotalPages</span>
                    <button type="button" @onclick="NextPage" disabled="@(currentPage >= TotalPages)">Próxima</button>
                </div>
            </AdminDataState>

            @if (!string.IsNullOrWhiteSpace(deleteError))
            {
                <p class="validation-message validation-message--margin-top-lg">@deleteError</p>
            }
        </article>
    </section>

    <section class="entity-shell-footer" aria-label="Ações extras">
        <button class="back-btn" @onclick='() => NavigationManager.NavigateTo("/admin")'>Voltar</button>
    </section>

</div>
