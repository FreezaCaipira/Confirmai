@page "/docs/integration"

@attribute [Authorize(Policy = "ServerAdmin")]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop

<PageTitle>@T["Docs.Integration.PageTitle"] — Confirmai</PageTitle>

<div class="entity-shell parchment-a integration-shell">

    <div class="page-title-bar integration-title-bar">
        <h1 class="page-title-bar-title">@T["Docs.Integration.MainTitle"]</h1>
        <p class="page-title-bar-subtitle">@T["Docs.Integration.Subtitle"]</p>
    </div>

    <section class="entity-shell-grid" aria-label="@T["Docs.Integration.Aria"]">
        <article class="entity-shell-card entity-shell-main integration-article">

            <!-- Visão geral -->
            <div class="integration-intro">
                <p>
                    @((MarkupString)T["Docs.Integration.Intro"])
                </p>
                <div class="integration-badges">
                    <span class="int-badge int-badge-auth">@T["Docs.Integration.BadgeAuth"]</span>
                    <span class="int-badge int-badge-secure">@T["Docs.Integration.BadgeSecure"]</span>
                    <span class="int-badge int-badge-rate">@T["Docs.Integration.BadgeRate"]</span>
                </div>
            </div>

            <hr class="integration-divider" />

            <!-- Passo a passo -->
            <h2 class="integration-section-title">@T["Docs.Integration.HowToIntegrate"]</h2>

            <!-- Passo 1 -->
            <div class="integration-step">
                <div class="integration-step-number">1</div>
                <div class="integration-step-body">
                    <h3 class="integration-step-title">@T["Docs.Integration.Step1Title"]</h3>
                    <p>
                        @T["Docs.Integration.Step1Desc"]
                    </p>
                    <ol class="integration-substeps">
                        <li>@T["Docs.Integration.Step1Sub1"]</li>
                        <li>@((MarkupString)T["Docs.Integration.Step1Sub2"])</li>
                        <li>@((MarkupString)T["Docs.Integration.Step1Sub3"])</li>
                    </ol>
                    <div class="integration-tip">
                        <span class="int-tip-icon">💡</span>
                        @((MarkupString)T["Docs.Integration.Step1Tip"])
                    </div>
                </div>
            </div>

            <!-- Passo 2 -->
            <div class="integration-step">
                <div class="integration-step-number">2</div>
                <div class="integration-step-body">
                    <h3 class="integration-step-title">@T["Docs.Integration.Step2Title"]</h3>
                    <p>@T["Docs.Integration.Step2Desc"]</p>
                    <div class="integration-download-row">
                        <a href="/downloads/market_integration.lua" download class="int-download-btn">
                            @T["Docs.Integration.Step2DownloadCanary"]
                        </a>
                        <a href="/downloads/tfs-Confirmai.lua" download class="int-download-btn">
                            @T["Docs.Integration.Step2DownloadTfs"]
                        </a>
                    </div>
                    <div class="integration-tip">
                        <span class="int-tip-icon">⚠️</span>
                        @((MarkupString)T["Docs.Integration.Step2Tip"])
                    </div>
                </div>
            </div>

            <!-- Passo 3 -->
            <div class="integration-step">
                <div class="integration-step-number">3</div>
                <div class="integration-step-body">
                    <h3 class="integration-step-title">@T["Docs.Integration.Step3Title"]</h3>
                    <p>
                        @((MarkupString)T["Docs.Integration.Step3Desc"])
                    </p>
                    <pre class="integration-code"><code>local OsmConfig = &#x7B;
    baseUrl = "https://Confirmai.com",
    apiKey  = "osm_SuaChaveAqui",   -- &lt;-- substitua aqui
&#x7D;</code></pre>
                    <div class="integration-tip int-tip-danger">
                        <span class="int-tip-icon">🔒</span>
                        @T["Docs.Integration.Step3Tip"]
                    </div>
                </div>
            </div>

            <!-- Passo 4 -->
            <div class="integration-step">
                <div class="integration-step-number">4</div>
                <div class="integration-step-body">
                    <h3 class="integration-step-title">@T["Docs.Integration.Step4Title"]</h3>

                    <div class="integration-tab-group">
                        <div class="integration-tab-label"><strong>Canary</strong></div>
                        <div class="integration-tab-content">
                            <p>@((MarkupString)T["Docs.Integration.Step4Canary"])</p>
                        </div>
                        <div class="integration-tab-label"><strong>TFS 1.x</strong></div>
                        <div class="integration-tab-content">
                            <p>
                                @((MarkupString)T["Docs.Integration.Step4Tfs"])
                            </p>
                            <pre class="integration-code"><code>dofile("data/lib/tfs-Confirmai.lua")</code></pre>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Passo 5 -->
            <div class="integration-step">
                <div class="integration-step-number">5</div>
                <div class="integration-step-body">
                    <h3 class="integration-step-title">@T["Docs.Integration.Step5Title"]</h3>
                    <p>
                        @T["Docs.Integration.Step5Desc"]
                    </p>
                    <pre class="integration-code"><code>[Confirmai] Conexao OK — &#x7B;"status":"ok","serverName":"Seu Servidor",...&#x7D;</code></pre>
                    <p>@T["Docs.Integration.Step5ManualTest"]</p>
                    <div class="integration-curl-wrap">
                        <pre class="integration-code" id="curl-ping"><code>curl -H "X-Api-Key: osm_SuaChaveAqui" \
     https://Confirmai.com/api/v1/server/ping</code></pre>
                        <button class="int-copy-btn" @onclick='() => CopyCode("curl-ping")'>@T["Docs.Integration.Step5Copy"]</button>
                    </div>
                    <p>@T["Docs.Integration.Step5Expected"]</p>
                    <pre class="integration-code"><code>&#x7B;
  "status": "ok",
  "serverId": 42,
  "serverName": "Seu Servidor",
  "timestamp": "2026-04-20T12:00:00Z"
&#x7D;</code></pre>
                </div>
            </div>

            <hr class="integration-divider" />

            <!-- Referência de endpoints -->
            <h2 class="integration-section-title">@T["Docs.Integration.EndpointsTitle"]</h2>
            <p class="integration-endpoints-intro">
                @((MarkupString)T["Docs.Integration.EndpointsIntro"])
            </p>

            <div class="integration-table-wrap">
                <table class="integration-table">
                    <thead>
                        <tr>
                            <th>@T["Docs.Integration.ColMethod"]</th>
                            <th>@T["Docs.Integration.ColEndpoint"]</th>
                            <th>@T["Docs.Integration.ColDescription"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><span class="http-method http-get">GET</span></td>
                            <td><code>/ping</code></td>
                            <td>@T["Docs.Integration.EpPing"]</td>
                        </tr>
                        <tr>
                            <td><span class="http-method http-get">GET</span></td>
                            <td><code>/trades/pending</code></td>
                            <td>@T["Docs.Integration.EpTradesPending"]</td>
                        </tr>
                        <tr>
                            <td><span class="http-method http-post">POST</span></td>
                            <td><code>/trades/confirm</code></td>
                            <td>@T["Docs.Integration.EpTradesConfirm"]</td>
                        </tr>
                        <tr>
                            <td><span class="http-method http-post">POST</span></td>
                            <td><code>/inventory/report</code></td>
                            <td>@T["Docs.Integration.EpInventoryReport"]</td>
                        </tr>
                        <tr>
                            <td><span class="http-method http-get">GET</span></td>
                            <td><code>/offers?itemKey=</code></td>
                            <td>@T["Docs.Integration.EpOffers"]</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <hr class="integration-divider" />

            <!-- Sem HTTP -->
            <h2 class="integration-section-title" id="sem-http">@T["Docs.Integration.NoHttpTitle"]</h2>
            <p>
                @T["Docs.Integration.NoHttpDesc"]
            </p>
            <div class="integration-alt-cards">
                <div class="integration-alt-card">
                    <h4>@T["Docs.Integration.NoHttpOptA"]</h4>
                    <p>
                        @((MarkupString)T["Docs.Integration.NoHttpOptADesc"])
                    </p>
                </div>
                <div class="integration-alt-card">
                    <h4>@T["Docs.Integration.NoHttpOptB"]</h4>
                    <p>
                        @T["Docs.Integration.NoHttpOptBDesc"]
                    </p>
                </div>
            </div>
            <p>
                @T["Docs.Integration.NoHttpHelp"]
            </p>

            <hr class="integration-divider" />

            <!-- Segurança -->
            <h2 class="integration-section-title">@T["Docs.Integration.SecurityTitle"]</h2>
            <div class="integration-security-grid">
                <div class="integration-security-item">
                    <span class="int-sec-icon">🔑</span>
                    <div>
                        <strong>@T["Docs.Integration.SecKeyUnique"]</strong>
                        <p>@T["Docs.Integration.SecKeyUniqueDesc"]</p>
                    </div>
                </div>
                <div class="integration-security-item">
                    <span class="int-sec-icon">🛡️</span>
                    <div>
                        <strong>@T["Docs.Integration.SecHashDb"]</strong>
                        <p>@T["Docs.Integration.SecHashDbDesc"]</p>
                    </div>
                </div>
                <div class="integration-security-item">
                    <span class="int-sec-icon">⏱️</span>
                    <div>
                        <strong>@T["Docs.Integration.SecRateLimit"]</strong>
                        <p>@T["Docs.Integration.SecRateLimitDesc"]</p>
                    </div>
                </div>
                <div class="integration-security-item">
                    <span class="int-sec-icon">🚫</span>
                    <div>
                        <strong>@T["Docs.Integration.SecPerms"]</strong>
                        <p>@T["Docs.Integration.SecPermsDesc"]</p>
                    </div>
                </div>
            </div>

            <hr class="integration-divider" />

            <!-- Precisa de ajuda -->
            <div class="integration-help-box">
                <h3>@T["Docs.Integration.HelpTitle"]</h3>
                <p>
                    @T["Docs.Integration.HelpDesc"]
                </p>
                <a href="/servers/admin-request" class="int-help-cta">@T["Docs.Integration.HelpCta"]</a>
            </div>

        </article>
    </section>
</div>
