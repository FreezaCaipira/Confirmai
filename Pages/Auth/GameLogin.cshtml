@page "/auth/game-login"
@model Confirmai.Pages.Auth.GameLoginModel

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login via Tibia - Confirmai</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: system-ui, -apple-system, sans-serif;
            background: #0e0e14;
            color: #d4c8a8;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .card {
            background: #1a1a24;
            border: 1px solid #2e2e3e;
            border-radius: 12px;
            padding: 2.5rem 2rem;
            max-width: 420px;
            width: 100%;
            text-align: center;
        }
        .icon { font-size: 3rem; margin-bottom: 1rem; }
        h1 { font-size: 1.4rem; margin-bottom: 0.5rem; color: #e8dfc0; }
        .sub { color: #8a8070; font-size: 0.9rem; margin-bottom: 1.5rem; }
        .player-name {
            font-size: 1.2rem;
            font-weight: bold;
            color: #f0c44a;
            margin-bottom: 1.5rem;
        }
        .btn {
            display: block;
            width: 100%;
            padding: 0.8rem;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            cursor: pointer;
            text-decoration: none;
            margin-bottom: 0.75rem;
        }
        .btn-primary { background: #f0c44a; color: #1a1a24; font-weight: bold; }
        .btn-secondary { background: #2e2e3e; color: #d4c8a8; }
        .btn:hover { opacity: 0.9; }
        .error { color: #e05555; background: rgba(224,85,85,0.12); border: 1px solid rgba(224,85,85,0.3); border-radius: 8px; padding: 0.8rem; margin-bottom: 1rem; font-size: 0.9rem; }
        .success { color: #4ae0a0; background: rgba(74,224,160,0.1); border: 1px solid rgba(74,224,160,0.3); border-radius: 8px; padding: 0.8rem; margin-bottom: 1rem; font-size: 0.9rem; }
        .sep { color: #3e3e4e; margin: 1rem 0; font-size: 0.85rem; }
        input[type=email], input[type=password] {
            width: 100%; padding: 0.7rem 0.9rem; margin-bottom: 0.75rem;
            background: #0e0e14; border: 1px solid #2e2e3e; border-radius: 6px;
            color: #d4c8a8; font-size: 0.95rem;
        }
        input::placeholder { color: #5a5060; }
        label { display: block; text-align: left; font-size: 0.85rem; color: #8a8070; margin-bottom: 0.3rem; }
        .form-section { text-align: left; }
    </style>
</head>
<body>
<div class="card">
    @if (Model.IsExpired)
    {
        <div class="icon">⏰</div>
        <h1>Link expirado</h1>
        <p class="sub">Este link de acesso expirou. Digite <strong>!market</strong> novamente no jogo para gerar um novo.</p>
    }
    else if (Model.IsInvalid)
    {
        <div class="icon">❌</div>
        <h1>Link inválido</h1>
        <p class="sub">Este link não é válido. Verifique se copiou a URL completa.</p>
    }
    else if (Model.IsSuccess)
    {
        <div class="icon">✅</div>
        <h1>Acesso confirmado!</h1>
        <div class="success">Você entrou como <strong>@Model.PlayerName</strong> no servidor <strong>@Model.ServerName</strong>.</div>
        <a href="/" class="btn btn-primary">Ir para o marketplace</a>
    }
    else
    {
        <div class="icon">⚔️</div>
        <h1>Entrar no marketplace</h1>
        <p class="sub">Identificamos seu personagem no servidor</p>
        <div class="player-name">@Model.PlayerName</div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="error">@Model.ErrorMessage</div>
        }

        @if (Model.HasExistingAccount)
        {
            <p class="sub">Este personagem já está vinculado a uma conta. Faça login nessa conta para acessar o marketplace.</p>
            <form method="post" asp-page-handler="LoginAndLink" class="form-section">
                <input type="hidden" name="token" value="@Model.Token" />
                <label>E-mail</label>
                <input type="email" name="email" required placeholder="seu@email.com" />
                <label>Senha</label>
                <input type="password" name="password" required placeholder="••••••••" />
                <button type="submit" class="btn btn-primary">Entrar</button>
            </form>
        }
        else
        {
            <p class="sub">Primeira vez aqui? Crie sua conta do marketplace em segundos.</p>
            <form method="post" asp-page-handler="Register" class="form-section">
                <input type="hidden" name="token" value="@Model.Token" />
                <label>E-mail</label>
                <input type="email" name="email" required placeholder="seu@email.com" />
                <label>Senha</label>
                <input type="password" name="password" required placeholder="Mínimo 6 caracteres" />
                <label>Confirmar senha</label>
                <input type="password" name="confirmPassword" required placeholder="Repita a senha" />
                <button type="submit" class="btn btn-primary">Criar conta e entrar</button>
            </form>
            <div class="sep">— já tenho conta —</div>
            <form method="post" asp-page-handler="LoginAndLink" class="form-section">
                <input type="hidden" name="token" value="@Model.Token" />
                <label>E-mail</label>
                <input type="email" name="email" required placeholder="seu@email.com" />
                <label>Senha</label>
                <input type="password" name="password" required placeholder="••••••••" />
                <button type="submit" class="btn btn-secondary">Entrar com conta existente</button>
            </form>
        }
    }
</div>
</body>
</html>
