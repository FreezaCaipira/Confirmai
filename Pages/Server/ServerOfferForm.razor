@page "/servers/{ServerId:int}/items/{ItemKey}/offer"

@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using System.Security.Claims
@using Confirmai.Models
@using Microsoft.EntityFrameworkCore
@using Confirmai.Data

@inject TibiaServerService TibiaServerService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject AppDbContext Db
@inject UiTextService T

<PageTitle>@T["ServerOfferForm.Title"]</PageTitle>

<div class="entity-shell parchment-a server-classic-layout">
    <section class="entity-shell-grid server-offer-create-grid" aria-label="@T["ServerOfferForm.Aria"]">
        <article class="entity-shell-card entity-shell-main server-offer-create-card" style="@BuildItemAccentStyle(itemAccentColor)">
            <div class="server-item-offers-topbar">
                <button class="server-item-offers-back" type="button" @onclick="BackToItemOffers">@T["ServerOfferForm.Back"]</button>
            </div>

            @if (isLoading)
            {
                <div class="loading-spinner">@T["ServerOfferForm.Loading"]</div>
            }
            else
            {
            <div class="server-offer-item-preview" style="@BuildItemAccentStyle(itemAccentColor)">
                <div class="server-offer-item-preview-image">
                    @if (!string.IsNullOrWhiteSpace(itemImagePath))
                    {
                        <img src="@itemImagePath" alt="Imagem de @itemName" />
                    }
                    else
                    {
                        <div class="mk-img-placeholder" aria-hidden="true">IMG</div>
                    }
                </div>

                <div class="server-offer-item-preview-meta">
                    <p class="server-offer-item-preview-kicker">@T["ServerOfferForm.Kicker"]</p>
                    <h3 class="server-offer-create-title">@itemName</h3>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <p class="identity-alert identity-alert-danger">@errorMessage</p>
            }

            <EditForm Model="model" OnValidSubmit="CreateOfferAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="sof-form-section">
                    <div class="sof-form-section-header">@T["ServerOfferForm.FormSection"]</div>
                    <div class="sof-form-body">
                    <div class="sof-form-grid">
                        <div class="form-group">
                            <label>@T["ServerOfferForm.FieldCurrency"]</label>
                            <InputSelect @bind-Value="model.PricingGateway" @bind-Value:after="OnPricingGatewayChangedAsync" class="input">
                                <option value="BRL">BRL — Real (PIX)</option>
                                <option value="USD">USD — Dólar</option>
                                <option value="BTC">BTC — Bitcoin</option>
                            </InputSelect>
                        </div>

                        <div class="form-group">
                            <label>@T["ServerOfferForm.FieldQuantity"]</label>
                            <InputNumber @bind-Value="model.Quantity" class="input" />
                        </div>

                        <div class="form-group">
                            <label>@T["ServerOfferForm.FieldUnitPrice"] @GetCurrencySymbolByCurrency(model.PricingGateway)</label>
                            <InputNumber @bind-Value="model.UnitPrice" class="input" />
                        </div>
                    </div>
                    </div>
                </div>

                @if (string.IsNullOrWhiteSpace(sellerInGamePlayerName))
                {
                    <div class="tibia-pay-no-char-warning">
                        <strong>@T["ServerOfferForm.CharUnlinkedTitle"]</strong>
                        <p>@T["ServerOfferForm.CharUnlinkedDesc"]</p>
                    </div>
                }
                <div class="form-actions">
                    <button type="button" class="cancel-btn" @onclick="BackToItemOffers">@T["ServerOfferForm.Cancel"]</button>
                    <button type="submit" class="save-btn" disabled="@(isSubmitting || string.IsNullOrWhiteSpace(sellerInGamePlayerName))">@(isSubmitting ? T["ServerOfferForm.Submitting"] : T["ServerOfferForm.Submit"])</button>
                </div>
            </EditForm>
            }
        </article>

        <article class="entity-shell-card server-offer-info-card">
            <h3 class="server-offer-info-title">@T["ServerOfferForm.InfoTitle"]</h3>

            @* --- Personagem vinculado --- *@
            <div class="server-offer-char-row">
                @if (string.IsNullOrWhiteSpace(sellerInGamePlayerName))
                {
                    <div class="server-offer-char-unlinked">
                        <span class="server-offer-char-icon">⚔️</span>
                        <div>
                            <strong>@T["ServerOfferForm.CharUnlinkedLabel"]</strong>
                            <small>@T["ServerOfferForm.CharUnlinkedLabelDesc"]</small>
                        </div>
                    </div>
                }
                else
                {
                    <div class="server-offer-char-linked">
                        <span class="server-offer-char-icon">🧙</span>
                        <div>
                            <strong>@sellerInGamePlayerName</strong>
                            <small>@T["ServerOfferForm.CharLinked"]</small>
                        </div>
                    </div>
                }
            </div>

            @if (activeOfferCount > 0)
            {
                <p class="server-offer-info-warning">
                    <i class="fas fa-info-circle"></i>
                    Você já tem <strong>@activeOfferCount</strong> oferta(s) ativa(s) deste item.
                </p>
            }
        </article>
    </section>
</div>

@code {
    [Parameter] public int ServerId { get; set; }
    [Parameter] public string ItemKey { get; set; } = string.Empty;

    private string itemName = "Item";
    private string? itemImagePath;
    private string? itemAccentColor;
    private string currentUserId = string.Empty;
    private string? sellerInGamePlayerName;
    private int activeOfferCount;
    private bool isSubmitting;
    private bool isLoading = true;
    private string? errorMessage;
    private List<GatewayInfo> activeGateways = new();
    private CreateOfferInput model = new();

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        model.PricingGateway = "BRL";
        ApplyUnitPriceDefaultByGateway();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier)
            ?? authState.User.FindFirstValue("sub")
            ?? string.Empty;

        var normalizedItemKey = NormalizeItemKey(Uri.UnescapeDataString(ItemKey ?? string.Empty));
        var items = await TibiaServerService.GetItemsForServerAsync(ServerId);
        var item = items.FirstOrDefault(p => NormalizeItemKey(p.Name) == normalizedItemKey);
        itemName = item?.Name ?? Uri.UnescapeDataString(ItemKey ?? string.Empty);
        itemImagePath = item?.ImagePath;
        itemAccentColor = item?.AccentColor;

        if (!string.IsNullOrWhiteSpace(currentUserId))
        {
            var member = await Db.ServerMembers
                .AsNoTracking()
                .FirstOrDefaultAsync(m => m.ServerId == ServerId && m.UserId == currentUserId);
            sellerInGamePlayerName = member?.InGamePlayerName;

            var normalizedForCount = NormalizeItemKey(Uri.UnescapeDataString(ItemKey ?? string.Empty));
            activeOfferCount = await Db.ItemOffers
                .AsNoTracking()
                .CountAsync(o => o.ServerId == ServerId && o.SellerUserId == currentUserId
                    && o.ItemKey == normalizedForCount && o.IsActive);
        }

        isLoading = false;
    }

    private async Task CreateOfferAsync()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(currentUserId))
        {
            errorMessage = T["ServerOfferForm.ErrorNotAuth"];
            return;
        }

        if (string.IsNullOrWhiteSpace(sellerInGamePlayerName))
        {
            errorMessage = T["ServerOfferForm.ErrorNoChar"];
            return;
        }

        isSubmitting = true;

        var normalizedItemKey = NormalizeItemKey(Uri.UnescapeDataString(ItemKey ?? string.Empty));
        var result = await TibiaServerService.CreateItemOfferAsync(new TibiaServerService.CreateItemOfferRequest
        {
            ServerId = ServerId,
            ItemKey = normalizedItemKey,
            ItemName = itemName,
            SellerUserId = currentUserId,
            Quantity = model.Quantity,
            UnitPrice = model.UnitPrice,
            PricingGateway = model.PricingGateway
        });

        isSubmitting = false;

        if (!result.Success)
        {
            errorMessage = result.Message;
            return;
        }

        BackToItemOffers();
    }

    private void BackToItemOffers()
    {
        var safeItemKey = Uri.EscapeDataString(Uri.UnescapeDataString(ItemKey ?? string.Empty));
        Navigation.NavigateTo($"/servers/{ServerId}/items/{safeItemKey}");
    }

    private static string NormalizeItemKey(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return string.Empty;
        }

        return name.Trim().ToUpperInvariant();
    }

    private static string BuildItemAccentStyle(string? accentColor)
    {
        var main = NormalizeAccentColor(accentColor) ?? "#BF4B13";
        var dark = DarkenHex(main, 0.25m);
        var border = DarkenHex(main, 0.14m);
        var titleColor = DarkenHex(main, 0.3m);
        var bodyTop = MixWithWhite(main, 0.82m);
        var bodyBottom = MixWithWhite(main, 0.7m);
        var secondaryTop = MixWithWhite(main, 0.9m);
        var secondaryBottom = MixWithWhite(main, 0.8m);
        var buttonTop = MixWithWhite(main, 0.66m);
        var buttonBottom = MixWithWhite(main, 0.5m);
        var buttonText = DarkenHex(main, 0.74m);

        return $"--item-accent:{main};--item-accent-dark:{dark};--item-accent-border:{border};--item-title-color:{titleColor};--item-body-bg-top:{bodyTop};--item-body-bg-bottom:{bodyBottom};--item-secondary-bg-top:{secondaryTop};--item-secondary-bg-bottom:{secondaryBottom};--item-button-top:{buttonTop};--item-button-bottom:{buttonBottom};--item-button-text:{buttonText};";
    }

    private static string? NormalizeAccentColor(string? color)
    {
        if (string.IsNullOrWhiteSpace(color))
        {
            return null;
        }

        var normalized = color.Trim();
        if (normalized.StartsWith('#'))
        {
            normalized = normalized[1..];
        }

        if (normalized.Length != 6)
        {
            return null;
        }

        foreach (var ch in normalized)
        {
            if (!Uri.IsHexDigit(ch))
            {
                return null;
            }
        }

        return $"#{normalized.ToUpperInvariant()}";
    }

    private static string DarkenHex(string hexColor, decimal amount)
    {
        var hex = hexColor.TrimStart('#');
        var r = Convert.ToInt32(hex.Substring(0, 2), 16);
        var g = Convert.ToInt32(hex.Substring(2, 2), 16);
        var b = Convert.ToInt32(hex.Substring(4, 2), 16);

        var factor = 1m - amount;
        r = Math.Clamp((int)Math.Round(r * (double)factor), 0, 255);
        g = Math.Clamp((int)Math.Round(g * (double)factor), 0, 255);
        b = Math.Clamp((int)Math.Round(b * (double)factor), 0, 255);

        return $"#{r:X2}{g:X2}{b:X2}";
    }

    private static string MixWithWhite(string hexColor, decimal whiteRatio)
    {
        var hex = hexColor.TrimStart('#');
        var r = Convert.ToInt32(hex.Substring(0, 2), 16);
        var g = Convert.ToInt32(hex.Substring(2, 2), 16);
        var b = Convert.ToInt32(hex.Substring(4, 2), 16);

        var ratio = Math.Clamp((double)whiteRatio, 0d, 1d);
        r = Math.Clamp((int)Math.Round(r + ((255 - r) * ratio)), 0, 255);
        g = Math.Clamp((int)Math.Round(g + ((255 - g) * ratio)), 0, 255);
        b = Math.Clamp((int)Math.Round(b + ((255 - b) * ratio)), 0, 255);

        return $"#{r:X2}{g:X2}{b:X2}";
    }

    private static string GetCurrencySymbolByCurrency(string? currency)
    {
        return currency switch
        {
            "BRL" => "R$",
            "USD" => "$",
            "BTC" => "₿",
            _ => "$"
        };
    }

    private Task OnPricingGatewayChangedAsync()
    {
        ApplyUnitPriceDefaultByGateway();
        return Task.CompletedTask;
    }

    private void ApplyUnitPriceDefaultByGateway()
    {
        model.UnitPrice = model.PricingGateway == "BTC" ? 0.0001m : 0m;
    }

    private sealed class CreateOfferInput
    {
        [Range(1, int.MaxValue, ErrorMessage = "Quantidade deve ser maior que zero.")]
        public int Quantity { get; set; } = 1;

        [Required(ErrorMessage = "Selecione a moeda de precificação.")]
        public string PricingGateway { get; set; } = "BRL";

        [Range(typeof(decimal), "0.00001", "79228162514264337593543950335", ErrorMessage = "Preço deve ser maior que zero.")]
        public decimal UnitPrice { get; set; } = 0m;
    }
}
