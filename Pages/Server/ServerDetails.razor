@page "/servers/{ServerId:int}"

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Confirmai.Data
@using Confirmai.Enums
@using System.Security.Claims
@inject TibiaServerService TibiaServerService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject AppDbContext Db
@inject UiTextService T

<PageTitle>@(server != null ? server.Name + " - Market" : T["Servers.Title"])</PageTitle>

<div class="entity-shell parchment-a server-classic-layout">
    @if (isLoading)
    {
        <section class="entity-shell-grid" aria-label="@T["ServerDetails.Loading"]">
            <article class="entity-shell-card entity-shell-main">
                <div class="loading-spinner">@T["ServerDetails.Loading"]</div>
            </article>
        </section>
    }
    else if (server == null)
    {
        <section class="entity-shell-grid" aria-label="@T["ServerDetails.NotFound"]">
            <article class="entity-shell-card entity-shell-main dashboard-servers-empty">
                <h3>@T["ServerDetails.NotFound"]</h3>
                <p>@T["ServerDetails.NotFoundDesc"]</p>
                <button class="mk-btn mk-btn-muted" type="button" @onclick='() => Navigation.NavigateTo("/servers")'>@T["ServerDetails.Back"]</button>
            </article>
        </section>
    }
    else
    {
        <section class="entity-shell-grid server-details-layout" aria-label="Resumo do servidor">
            <article class="entity-shell-card entity-shell-main server-details-left">
                <h3 class="server-market-title">@server.Name - Market</h3>

                @* --- CTA para usuários anônimos --- *@
                @if (string.IsNullOrWhiteSpace(currentUserId))
                {
                    <div class="server-anon-cta">
                        <i class="fas fa-shield-alt server-anon-cta-icon"></i>
                        <div class="server-anon-cta-body">
                            <strong>@T["ServerDetails.AnonCtaTitle"]</strong>
                            <span>@T["ServerDetails.AnonCtaDesc"]</span>
                        </div>
                        <div class="server-anon-cta-actions">
                            <a class="server-anon-cta-btn server-anon-cta-btn--primary" href="/Identity/Account/Register">@T["ServerDetails.AnonRegister"]</a>
                            <a class="server-anon-cta-btn server-anon-cta-btn--muted" href="/Identity/Account/Login">@T["ServerDetails.AnonLogin"]</a>
                        </div>
                    </div>
                }

                @* --- Banner de personagem vinculado --- *@
                @if (!string.IsNullOrWhiteSpace(currentUserId))
                {
                    @if (string.IsNullOrWhiteSpace(linkedPlayerName))
                    {
                        <div class="server-details-char-banner server-details-char-banner--unlinked">
                            <span>⚔️</span>
                            <span>@T["ServerDetails.CharUnlinked"]</span>
                        </div>
                    }
                    else
                    {
                        <div class="server-details-char-banner server-details-char-banner--linked">
                            <span>🧙</span>
                            <span>@T["ServerDetails.CharLinked"] <strong>@linkedPlayerName</strong></span>
                        </div>
                    }
                }
                <section class="server-items-filter-strip" aria-label="Filtros de itens">
                    <section class="server-category-board" aria-label="Categorias 7.4">
                        @foreach (var group in categoryGroups)
                        {
                            <div class="server-category-group @(string.Equals(group.Title, "Others", StringComparison.OrdinalIgnoreCase) ? "server-category-group-compact" : string.Empty)">
                                <h4>@group.Title</h4>
                                <div class="server-category-grid" role="list" aria-label="@group.Title">
                                    @foreach (var chip in group.Categories)
                                    {
                                        <button type="button"
                                                class="server-category-tile @(selectedCategoryChip == chip.Key ? "active" : string.Empty)"
                                                role="listitem"
                                                @onclick='() => SelectCategoryChip(chip.Key)'>
                                            <img class="server-category-icon" src="@chip.SpritePath" alt="" aria-hidden="true" />
                                            <span class="server-category-label">@chip.Label</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </section>
                </section>

                @if (!FilteredItemGroups.Any())
                {
                    <p class="market-empty">@T["ServerDetails.ItemsEmpty"]</p>
                }
                else
                {
                    <div class="world-select-grid">
                        @foreach (var item in FilteredItemGroups)
                        {
                            <article class="world-select-card" style="@BuildItemAccentStyle(item.AccentColor)">
                                <div class="world-select-body">
                                    <div class="world-select-head">
                                        <div class="world-select-title-wrap">
                                            @if (!string.IsNullOrWhiteSpace(item.ImagePath))
                                            {
                                                <img class="world-select-mini-logo" src="@item.ImagePath" alt="Imagem de @item.Name" />
                                            }
                                            else
                                            {
                                                <span class="world-select-pixel-icon" aria-hidden="true"></span>
                                            }
                                            <div class="world-select-title-text">
                                                <h3>@item.Name</h3>
                                                <span class="world-select-submeta">@item.CategoryLabel</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="world-select-metrics">
                                        <div>
                                            <strong>@item.SoldCount</strong>
                                            <small>@T["ServerDetails.ItemSold"]</small>
                                        </div>
                                        <div>
                                            <strong>@item.OffersCount</strong>
                                            <small>@T["ServerDetails.ItemOffers"]</small>
                                        </div>
                                    </div>

                                    <div class="world-select-actions">
                                        <button type="button"
                                                class="world-select-add-offer"
                                                @onclick='() => OnAddOfferClicked(item)'>@T["ServerDetails.AddOffer"]</button>
                                        <button type="button" class="world-select-manage" @onclick='() => OpenItemOffers(item.Key)'>@T["ServerDetails.ViewOffers"]</button>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
            </article>

        </section>
    }
</div>

@code {
    [Parameter] public int ServerId { get; set; }

    private TibiaServer? server;
    private bool isLoading = true;
    private string currentUserId = string.Empty;
    private string? linkedPlayerName;
    private List<Product> items = new();
    private List<ItemOfferGroup> itemGroups = new();
    private List<TibiaServerService.ServerMemberView> members = new();
    private TibiaServerService.ServerSalesCounters counters = new();
    private string selectedCategoryChip = "all";
    private List<ItemOfferGroup> FilteredItemGroups => itemGroups
        .Where(GroupMatchesCategoryChip)
        .ToList();

    private readonly List<CategoryGroup> categoryGroups =
    [
        new(
            "Equipamentos",
            [
                new("helmets", "Helmets", "/images/sprites/74/categories/helmets.png"),
                new("armors", "Armors", "/images/sprites/74/categories/armors.png"),
                new("legs", "Legs", "/images/sprites/74/categories/legs.png"),
                new("boots", "Boots", "/images/sprites/74/categories/boots.png"),
                new("shields", "Shields", "/images/sprites/74/categories/shields.png"),
                new("necklaces", "Necklaces", "/images/sprites/74/categories/necklaces.png"),
                new("rings", "Rings", "/images/sprites/74/categories/rings.png")
            ]),
        new(
            "Weapons",
            [
                new("axes", "Axes", "/images/sprites/74/categories/axes.png"),
                new("clubs", "Clubs", "/images/sprites/74/categories/clubs.png"),
                new("swords", "Swords", "/images/sprites/74/categories/swords.png"),
                new("distance", "Distance", "/images/sprites/74/categories/distance.png"),
                new("ammunition", "Ammunition", "/images/sprites/74/categories/ammunition.png")
            ]),
        new(
            "Others",
            [
                new("runes", "Runes", "/images/sprites/74/categories/runes.png"),
                new("valuables", "Valuables", "/images/sprites/74/categories/valuables.png"),
                new("tools", "Tools", "/images/sprites/74/categories/tools.png")
            ])
    ];

    private static readonly Dictionary<string, string[]> CategoryAliases = new(StringComparer.OrdinalIgnoreCase)
    {
        ["all"] = ["*"],
        ["helmets"] = ["helmet", "helmets", "elmo", "elmos"],
        ["armors"] = ["armor", "armors", "armour", "armours", "set", "sets", "peitoral", "armadura", "armaduras"],
        ["legs"] = ["leg", "legs", "calca", "calcas", "pants"],
        ["boots"] = ["boot", "boots", "bota", "botas"],
        ["shields"] = ["shield", "shields", "escudo", "escudos"],
        ["necklaces"] = ["necklace", "necklaces", "amulet", "amulets", "colar", "colares"],
        ["rings"] = ["ring", "rings", "anel", "aneis"],
        ["axes"] = ["axe", "axes", "machado", "machados"],
        ["clubs"] = ["club", "clubs", "mace", "maces", "hammer", "hammers", "clava", "clavas"],
        ["swords"] = ["sword", "swords", "espada", "espadas"],
        ["distance"] = ["distance", "ranged", "bow", "bows", "crossbow", "crossbows", "arco", "arcos", "distance weapon", "distance weapons"],
        ["ammunition"] = ["ammunition", "ammo", "arrow", "arrows", "bolt", "bolts", "municao", "municoes"],
        ["runes"] = ["rune", "runes", "runa", "runas"],
        ["valuables"] = ["valuable", "valuables", "jewels", "joias", "jewel", "quest", "relic", "relics", "loot"],
        ["tools"] = ["tool", "tools", "ferramenta", "ferramentas"]
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier)
            ?? authState.User.FindFirstValue("sub")
            ?? string.Empty;

        server = await TibiaServerService.GetByIdAsync(ServerId);
        if (server != null)
        {
            items = await TibiaServerService.GetItemsForServerAsync(ServerId);
            var soldByProduct = await TibiaServerService.GetPaidOrderCountsByProductAsync(ServerId);
            var activeOfferCounts = await TibiaServerService.GetActiveOfferCountsByItemAsync(ServerId);
            itemGroups = BuildItemGroups(items, soldByProduct, activeOfferCounts);
            members = await TibiaServerService.GetMembersAsync(ServerId);
            counters = await TibiaServerService.GetSalesCountersAsync(ServerId);

            if (!string.IsNullOrWhiteSpace(currentUserId))
            {
                var member = await Db.ServerMembers
                    .AsNoTracking()
                    .FirstOrDefaultAsync(m => m.ServerId == ServerId && m.UserId == currentUserId);
                linkedPlayerName = member?.InGamePlayerName;
            }
        }

        isLoading = false;
    }

    private void OpenItemOffers(string itemKey)
    {
        var safeItemKey = Uri.EscapeDataString(itemKey ?? string.Empty);
        Navigation.NavigateTo($"/servers/{ServerId}/items/{safeItemKey}");
    }

    private void OpenAddOffer(ItemOfferGroup group)
    {
        var safeItemKey = Uri.EscapeDataString(group.Key ?? string.Empty);
        Navigation.NavigateTo($"/servers/{ServerId}/items/{safeItemKey}/offer");
    }

    private void OnAddOfferClicked(ItemOfferGroup group)
    {
        if (string.IsNullOrWhiteSpace(currentUserId))
        {
            AuthNavigationHelper.NavigateToLoginForCurrentUrl(Navigation);
            return;
        }

        OpenAddOffer(group);
    }

    private void SelectCategoryChip(string chipKey)
    {
        selectedCategoryChip = string.Equals(selectedCategoryChip, chipKey, StringComparison.OrdinalIgnoreCase)
            ? "all"
            : chipKey;

    }

    private bool GroupMatchesCategoryChip(ItemOfferGroup group)
    {
        if (string.IsNullOrWhiteSpace(selectedCategoryChip) || string.Equals(selectedCategoryChip, "all", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        return group.Offers.Any(o => MatchesCategoryChip(o.Category, selectedCategoryChip));
    }

    private static bool MatchesCategoryChip(string? category, string chipKey)
    {
        if (string.IsNullOrWhiteSpace(chipKey) || string.Equals(chipKey, "all", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        var normalized = (category ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(normalized))
        {
            return false;
        }

        if (!CategoryAliases.TryGetValue(chipKey, out var aliases) || aliases.Length == 0)
        {
            return normalized.Equals(chipKey, StringComparison.OrdinalIgnoreCase);
        }

        return aliases.Any(alias => normalized.Equals(alias, StringComparison.OrdinalIgnoreCase));
    }

    private static List<ItemOfferGroup> BuildItemGroups(
        List<Product> sourceItems,
        Dictionary<int, int> soldByProduct,
        Dictionary<string, int> activeOfferCounts)
    {
        return sourceItems
            .GroupBy(p => NormalizeItemKey(p.Name))
            .Select(g =>
            {
                var offers = g
                    .OrderByDescending(p => p.CreatedAt)
                    .ToList();

                var firstWithImage = offers.FirstOrDefault(p => !string.IsNullOrWhiteSpace(p.ImagePath));
                var soldCount = offers.Sum(p => soldByProduct.TryGetValue(p.Id, out var count) ? count : 0);
                var accentColor = offers
                    .Select(p => NormalizeAccentColor(p.AccentColor))
                    .FirstOrDefault(c => c != null);

                var normalizedItemKey = g.Key;
                var activeOffersCount = activeOfferCounts.TryGetValue(normalizedItemKey, out var count)
                    ? count
                    : 0;

                return new ItemOfferGroup(
                    g.Key,
                    offers.First().Name,
                    firstWithImage?.ImagePath,
                    string.IsNullOrWhiteSpace(offers.First().Category) ? "Geral" : offers.First().Category!,
                    accentColor,
                    activeOffersCount,
                    soldCount,
                    offers
                );
            })
            .OrderByDescending(x => x.SoldCount)
            .ThenByDescending(x => x.OffersCount)
            .ThenBy(x => x.Name)
            .ToList();
    }

    private static string NormalizeItemKey(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "item-sem-nome";
        }

        return name.Trim().ToUpperInvariant();
    }

    private sealed record ItemOfferGroup(
        string Key,
        string Name,
        string? ImagePath,
        string CategoryLabel,
        string? AccentColor,
        int OffersCount,
        int SoldCount,
        List<Product> Offers);

    private sealed record CategoryGroup(string Title, List<CategoryChip> Categories);
    private sealed record CategoryChip(string Key, string Label, string SpritePath);

    private string GetRoleLabel(TibiaServerService.ServerMemberView member)
    {
        if (member.IsSystemAdmin)
        {
            return T["ServerDetails.RoleSystemAdmin"];
        }

        return member.Role == ServerMemberRole.ServerAdmin
            ? T["ServerDetails.RoleServerAdmin"]
            : T["ServerDetails.RoleUser"];
    }

    private RenderFragment RenderCounterList(List<TibiaServerService.SalesCounterItem> list) => builder =>
    {
        if (!list.Any())
        {
            builder.OpenElement(0, "p");
            builder.AddAttribute(1, "class", "identity-muted");
            builder.AddContent(2, T["ServerDetails.NoSales"]);
            builder.CloseElement();
            return;
        }

        builder.OpenElement(3, "ol");
        builder.AddAttribute(4, "class", "server-counter-list");

        var seq = 5;
        foreach (var item in list)
        {
            builder.OpenElement(seq++, "li");
            builder.AddContent(seq++, $"{item.ProductName} ({item.Count})");
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private static string BuildItemAccentStyle(string? accentColor)
    {
        var main = NormalizeAccentColor(accentColor) ?? "#BF4B13";
        var dark = DarkenHex(main, 0.23m);
        var border = DarkenHex(main, 0.12m);
        var titleColor = MixWithWhite(main, 0.84m);
        var bodyBgTop = MixWithWhite(main, 0.74m);
        var bodyBgBottom = MixWithWhite(main, 0.64m);
        var bodyGlow = MixWithWhite(main, 0.58m);
        var metricTop = MixWithWhite(main, 0.82m);
        var metricBottom = MixWithWhite(main, 0.7m);
        var metricBorder = MixWithWhite(main, 0.52m);
        var separator = MixWithWhite(main, 0.44m);

        return $"--item-accent:{main};--item-accent-dark:{dark};--item-accent-border:{border};--item-title-color:{titleColor};--item-body-bg-top:{bodyBgTop};--item-body-bg-bottom:{bodyBgBottom};--item-body-glow:{bodyGlow};--item-metric-top:{metricTop};--item-metric-bottom:{metricBottom};--item-metric-border:{metricBorder};--item-separator:{separator};";
    }

    private static string? NormalizeAccentColor(string? color)
    {
        if (string.IsNullOrWhiteSpace(color))
        {
            return null;
        }

        var normalized = color.Trim();
        if (normalized.StartsWith('#'))
        {
            normalized = normalized[1..];
        }

        if (normalized.Length != 6)
        {
            return null;
        }

        if (!int.TryParse(normalized, System.Globalization.NumberStyles.HexNumber, System.Globalization.CultureInfo.InvariantCulture, out _))
        {
            return null;
        }

        return $"#{normalized.ToUpperInvariant()}";
    }

    private static string DarkenHex(string hexColor, decimal amount)
    {
        var hex = hexColor.TrimStart('#');
        var r = Convert.ToInt32(hex.Substring(0, 2), 16);
        var g = Convert.ToInt32(hex.Substring(2, 2), 16);
        var b = Convert.ToInt32(hex.Substring(4, 2), 16);

        var factor = 1m - amount;
        r = Math.Clamp((int)Math.Round(r * (double)factor), 0, 255);
        g = Math.Clamp((int)Math.Round(g * (double)factor), 0, 255);
        b = Math.Clamp((int)Math.Round(b * (double)factor), 0, 255);

        return $"#{r:X2}{g:X2}{b:X2}";
    }

    private static string MixWithWhite(string hexColor, decimal whiteRatio)
    {
        var hex = hexColor.TrimStart('#');
        var r = Convert.ToInt32(hex.Substring(0, 2), 16);
        var g = Convert.ToInt32(hex.Substring(2, 2), 16);
        var b = Convert.ToInt32(hex.Substring(4, 2), 16);

        var ratio = Math.Clamp((double)whiteRatio, 0d, 1d);
        r = Math.Clamp((int)Math.Round(r + ((255 - r) * ratio)), 0, 255);
        g = Math.Clamp((int)Math.Round(g + ((255 - g) * ratio)), 0, 255);
        b = Math.Clamp((int)Math.Round(b + ((255 - b) * ratio)), 0, 255);

        return $"#{r:X2}{g:X2}{b:X2}";
    }
}
