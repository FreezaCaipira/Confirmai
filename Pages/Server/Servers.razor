@page "/"
@page "/servers"
@attribute [AllowAnonymous]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using Confirmai.Enums
@using Confirmai.Services
@implements IDisposable
@inject TibiaServerService TibiaServerService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject UiTextService T
@inject PersistentComponentState ApplicationState

<PageTitle>@T["Servers.Title"]</PageTitle>

<div class="entity-shell parchment-a">
    <section class="entity-shell-grid" aria-label="@T["Servers.Aria"]">
        <article class="entity-shell-card entity-shell-main servers-list-market">
            <div class="server-header-row">
                <h3 class="servers-list-title">@T["Servers.Title"]</h3>
            </div>

            @if (isLoading)
            {
                <div class="world-select-grid" aria-busy="true" aria-live="polite" aria-label="@T["Servers.Loading"]">
                    @for (var i = 0; i < SkeletonCardCount; i++)
                    {
                        <article class="world-select-card world-select-card-skeleton" aria-hidden="true">
                            <div class="world-select-cover skeleton-shimmer"></div>
                            <div class="world-select-body">
                                <div class="world-select-head">
                                    <div class="skeleton-line skeleton-line-title skeleton-shimmer"></div>
                                    <div class="skeleton-pill skeleton-shimmer"></div>
                                </div>
                                <div class="world-select-metrics">
                                    <div>
                                        <div class="skeleton-line skeleton-line-strong skeleton-shimmer"></div>
                                        <div class="skeleton-line skeleton-line-small skeleton-shimmer"></div>
                                    </div>
                                    <div>
                                        <div class="skeleton-line skeleton-line-strong skeleton-shimmer"></div>
                                        <div class="skeleton-line skeleton-line-small skeleton-shimmer"></div>
                                    </div>
                                </div>
                                <div class="skeleton-line skeleton-line-meta skeleton-shimmer"></div>
                                <div class="world-select-actions">
                                    <div class="skeleton-button skeleton-shimmer"></div>
                                    <div class="skeleton-button skeleton-shimmer"></div>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
            else if (!servers.Any())
            {
                <p class="market-empty">@T["Servers.Empty"]</p>
            }
            else
            {
                <div class="world-select-grid">
                    @foreach (var server in servers)
                    {
                        serverStats.TryGetValue(server.Id, out var stats);
                        var salesCompleted = stats?.CompletedSales ?? 0;
                        var itemsForSale = stats?.ActiveOffers ?? 0;

                        <article class="world-select-card">
                            @if (!string.IsNullOrWhiteSpace(server.LogoPath))
                            {
                                <div class="world-select-cover">
                                    <img class="world-select-cover-img" src="@server.LogoPath" alt="@T["Servers.LogoCoverAlt"] @server.Name" loading="lazy" />
                                </div>
                            }
                            else
                            {
                                <div class="world-select-cover world-select-cover-fallback" aria-hidden="true">
                                    <span>@server.Name</span>
                                </div>
                            }

                            <div class="world-select-body">
                                <div class="world-select-head">
                                    <div class="world-select-title-wrap">
                                        <span class="world-select-pixel-icon" aria-hidden="true"></span>
                                        <h3>@server.Name</h3>
                                    </div>
                                    <span class="world-select-status @(server.IsActive ? "online" : "offline")">
                                        <span class="world-select-dot" aria-hidden="true"></span>
                                        @(server.IsActive ? T["Servers.MarketActive"] : T["Servers.MarketPaused"])
                                    </span>
                                </div>

                                <div class="world-select-metrics">
                                    <div>
                                        <strong>@salesCompleted.ToString("N0")</strong>
                                        <small>@T["Servers.SalesCompleted"]</small>
                                    </div>
                                    <div>
                                        <strong>@itemsForSale.ToString("N0")</strong>
                                        <small>@T["Servers.ItemsForSale"]</small>
                                    </div>
                                </div>

                                <p class="world-select-meta">
                                    @(string.IsNullOrWhiteSpace(server.Region) ? T["Servers.Region.Global"] : server.Region)
                                    | Tibia @(string.IsNullOrWhiteSpace(server.TibiaVersion) ? T["Servers.TibiaVersion.Unknown"] : server.TibiaVersion)
                                    | @T["Servers.StartedIn"] @server.CreatedAt.ToLocalTime().ToString("MMMM, yyyy")
                                </p>

                                @if (isSiteAdmin || IsServerManager(server))
                                {
                                    <p class="world-select-manager-flag">@T["Servers.Manager.Label"] @(isSiteAdmin ? T["Servers.ManageRoleAdmin"] : T["Servers.ManageRoleGm"])</p>
                                }

                                <div class="world-select-actions">
                                    <button type="button" class="world-select-join" @onclick='() => OpenServerMarket(server.Id)'>@T["Servers.EnterMarket"]</button>
                                    <button type="button" class="world-select-manage" @onclick='() => Navigation.NavigateTo($"/servers/{server.Id}/players")'>@T["Servers.Players"]</button>
                                    @if (isSiteAdmin || IsServerManager(server))
                                    {
                                        <button type="button" class="world-select-manage" @onclick='() => Navigation.NavigateTo($"/servers/{server.Id}/manage")'>@T["Servers.Manage"]</button>
                                    }
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }

            @if (!isLoading)
            {
                <div class="servers-actions-row">
                    <button class="save-btn" type="button" @onclick="OpenCreateServerFlow">@T["Servers.NewServer"]</button>
                    @if (isSiteAdmin)
                    {
                        <button class="save-btn" type="button" @onclick='() => Navigation.NavigateTo("/admin/server-requests")'>@T["Servers.ReviewRequests"]</button>
                    }
                </div>
            }
        </article>
    </section>
</div>

@code {
    private const int SkeletonCardCount = 6;
    private const string PersistKey = "Servers.Page.State";

    private bool isLoading = true;
    private List<TibiaServer> servers = new();
    private Dictionary<int, TibiaServerService.ServerCardStats> serverStats = new();
    private HashSet<int> adminServerIds = new();
    private bool isAuthenticated;
    private bool isSiteAdmin;
    private string? currentUserId;

    private PersistingComponentStateSubscription persistingSubscription;

    private sealed class PersistedServerCard
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? Region { get; set; }
        public string? TibiaVersion { get; set; }
        public string? LogoPath { get; set; }
        public bool IsActive { get; set; }
        public DateTime CreatedAt { get; set; }
    }

    private sealed class PersistedState
    {
        public List<PersistedServerCard> Servers { get; set; } = new();
        public Dictionary<int, int[]> Stats { get; set; } = new(); // serverId -> [completedSales, activeOffers]
    }

    protected override async Task OnInitializedAsync()
    {
        persistingSubscription = ApplicationState.RegisterOnPersisting(PersistState);

        var authStateTask = AuthStateProvider.GetAuthenticationStateAsync();

        // Try to restore from prerender; falls back to live queries when missing.
        var restored = TryRestoreState();

        var authState = await authStateTask;
        var user = authState.User;
        isAuthenticated = user.Identity?.IsAuthenticated == true;
        isSiteAdmin = user.IsInRole("admin");
        currentUserId = user.FindFirst(c => c.Type == "sub" || c.Type.Contains("nameidentifier"))?.Value;

        if (!restored)
        {
            // Run independent queries in parallel; service uses the scoped DbContext
            // for both, so we await sequentially when no factory is available — but
            // GetAllAsync and GetAllServerCardStatsAsync are cached (60s) so the
            // second prerender + circuit hydration round-trip is essentially free.
            servers = await TibiaServerService.GetAllAsync();
            serverStats = await TibiaServerService.GetAllServerCardStatsAsync();
        }

        // Per-user lookup; cheap, single indexed query, never cached.
        adminServerIds = await TibiaServerService.GetServerAdminIdsForUserAsync(currentUserId);

        isLoading = false;
    }

    private bool TryRestoreState()
    {
        if (!ApplicationState.TryTakeFromJson<PersistedState>(PersistKey, out var state) || state is null)
        {
            return false;
        }

        servers = state.Servers
            .Select(s => new TibiaServer
            {
                Id = s.Id,
                Name = s.Name,
                Region = s.Region,
                TibiaVersion = s.TibiaVersion,
                LogoPath = s.LogoPath,
                IsActive = s.IsActive,
                CreatedAt = s.CreatedAt
            })
            .ToList();

        serverStats = state.Stats.ToDictionary(
            kvp => kvp.Key,
            kvp => new TibiaServerService.ServerCardStats(
                kvp.Value.Length > 0 ? kvp.Value[0] : 0,
                kvp.Value.Length > 1 ? kvp.Value[1] : 0));

        return true;
    }

    private Task PersistState()
    {
        var snapshot = new PersistedState
        {
            Servers = servers.Select(s => new PersistedServerCard
            {
                Id = s.Id,
                Name = s.Name,
                Region = s.Region,
                TibiaVersion = s.TibiaVersion,
                LogoPath = s.LogoPath,
                IsActive = s.IsActive,
                CreatedAt = s.CreatedAt
            }).ToList(),
            Stats = serverStats.ToDictionary(
                kvp => kvp.Key,
                kvp => new[] { kvp.Value.CompletedSales, kvp.Value.ActiveOffers })
        };

        ApplicationState.PersistAsJson(PersistKey, snapshot);
        return Task.CompletedTask;
    }

    private bool IsServerManager(TibiaServer server) => adminServerIds.Contains(server.Id);

    private void OpenServerMarket(int serverId)
    {
        Navigation.NavigateTo($"/servers/{serverId}");
    }

    private void OpenCreateServerFlow()
    {
        if (isAuthenticated)
        {
            Navigation.NavigateTo("/servers/admin-request");
            return;
        }

        AuthNavigationHelper.NavigateToLogin(Navigation, "/servers/admin-request");
    }

    public void Dispose()
    {
        persistingSubscription.Dispose();
    }
}
