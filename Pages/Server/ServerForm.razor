@page "/servers/create"

@attribute [Authorize(Roles = "admin")]

@using Microsoft.AspNetCore.Authorization
@inject TibiaServerService TibiaServerService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject UiTextService T

<PageTitle>@T["ServerForm.Title"]</PageTitle>

<div class="entity-shell parchment-a">

    <section class="entity-shell-grid" aria-label="@T["ServerForm.Aria"]">
        <article class="entity-shell-card entity-shell-main form-card server-form-card">
            <EditForm Model="server" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="form-group">
                    <label>@T["ServerForm.FieldName"]</label>
                    <InputText @bind-Value="server.Name" class="input" />
                    <ValidationMessage For="@(() => server.Name)" />
                </div>

                <div class="form-group">
                    <label>@T["ServerForm.FieldRegion"]</label>
                    <InputText @bind-Value="server.Region" class="input" />
                    <ValidationMessage For="@(() => server.Region)" />
                </div>

                <div class="form-group">
                    <label>@T["ServerForm.FieldTibiaVersion"]</label>
                    <InputText @bind-Value="server.TibiaVersion" class="input" placeholder="Ex.: 7.4" />
                    <ValidationMessage For="@(() => server.TibiaVersion)" />
                </div>

                <div class="form-group">
                    <label>@T["ServerForm.FieldWebsite"]</label>
                    <InputText @bind-Value="server.WebsiteUrl" class="input" />
                    <ValidationMessage For="@(() => server.WebsiteUrl)" />
                </div>

                <div class="form-group">
                    <label>@T["ServerForm.FieldLogo"]</label>
                    <InputFile OnChange="OnLogoSelected" accept=".jpg,.jpeg,.png,.gif,.webp" />
                    @if (!string.IsNullOrWhiteSpace(selectedLogoName))
                    {
                        <small class="identity-muted">@T["ServerForm.FileSelected"] @selectedLogoName</small>
                    }
                </div>

                <div class="form-group">
                    <label>@T["ServerForm.FieldGmEmail"]</label>
                    <InputText @bind-Value="gmEmail" class="input" placeholder="gm@servidor.com" />
                    <small class="identity-muted">@T["ServerForm.GmEmailHint"]</small>
                    @if (!string.IsNullOrWhiteSpace(gmError))
                    {
                        <div class="text-danger">@gmError</div>
                    }
                </div>

                <div class="form-group form-group-checkbox">
                    <label class="checkbox-label">
                        <InputCheckbox @bind-Value="server.IsActive" />
                        @T["ServerForm.IsActive"]
                    </label>
                </div>

                <div class="form-actions">
                    <button class="cancel-btn" type="button" @onclick='() => Navigation.NavigateTo("/servers")'>@T["ServerForm.Cancel"]</button>
                    <button class="save-btn" type="submit" disabled="@isSaving">@T["ServerForm.Save"]</button>
                </div>
            </EditForm>
        </article>
    </section>
</div>

@code {
    private TibiaServer server = new();
    private bool isSaving;
    private string gmEmail = string.Empty;
    private string? gmError;
    private IBrowserFile? logoFile;
    private string? selectedLogoName;

    private async Task HandleValidSubmit()
    {
        isSaving = true;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(c => c.Type == "sub" || c.Type.Contains("nameidentifier"))?.Value;

        if (string.IsNullOrWhiteSpace(userId))
        {
            gmError = T["ServerForm.ErrorNoUser"];
            isSaving = false;
            return;
        }

        string? gmUserId = null;
        if (!string.IsNullOrWhiteSpace(gmEmail))
        {
            gmUserId = await TibiaServerService.TryGetUserIdByEmailAsync(gmEmail);
            if (string.IsNullOrWhiteSpace(gmUserId))
            {
                gmError = T["ServerForm.ErrorGmNotFound"];
                isSaving = false;
                return;
            }
        }

        await TibiaServerService.AddAsync(server, userId, gmUserId, logoFile);
        isSaving = false;
        Navigation.NavigateTo("/servers");
    }

    private void OnLogoSelected(InputFileChangeEventArgs e)
    {
        logoFile = e.File;
        selectedLogoName = e.File.Name;
    }
}
