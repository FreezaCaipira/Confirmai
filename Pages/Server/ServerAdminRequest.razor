@page "/servers/admin-request"

@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@inject ServerRegistrationRequestService ServerRegistrationRequestService
@inject AuthenticationStateProvider AuthStateProvider
@inject UiTextService T

<PageTitle>@T["ServerAdminRequest.Title"]</PageTitle>

<div class="entity-shell parchment-a">

    <section class="entity-shell-grid" aria-label="@T["ServerAdminRequest.Aria"]">
        <article class="entity-shell-card entity-shell-main form-card server-request-form">
            @if (isLoading)
            {
                <div class="loading-spinner">@T["ServerAdminRequest.Loading"]</div>
            }
            else
            {
                <EditForm Model="form" OnValidSubmit="SubmitRequest">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <fieldset class="sr-fieldset">
                        <legend class="sr-legend">@T["ServerAdminRequest.LegendServer"]</legend>

                        <div class="form-group">
                            <label>@T["ServerAdminRequest.FieldName"] <span class="sr-required" aria-hidden="true">*</span></label>
                            <InputText @bind-Value="form.ServerName" class="input" placeholder="Ex.: Freeza Server" />
                        </div>

                        <div class="sr-row-2col">
                            <div class="form-group">
                                <label>@T["ServerAdminRequest.FieldTibiaVersion"] <span class="sr-required" aria-hidden="true">*</span></label>
                                <InputText @bind-Value="form.TibiaVersion" class="input" placeholder="Ex.: 7.4" />
                            </div>

                            <div class="form-group">
                                <label>@T["ServerAdminRequest.FieldRegion"] <span class="sr-optional">@T["ServerAdminRequest.Optional"]</span></label>
                                <InputText @bind-Value="form.Region" class="input" placeholder="Ex.: Brasil" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label>@T["ServerAdminRequest.FieldWebsite"] <span class="sr-optional">@T["ServerAdminRequest.Optional"]</span></label>
                            <InputText @bind-Value="form.WebsiteUrl" class="input" placeholder="https://..." />
                        </div>
                    </fieldset>

                    <fieldset class="sr-fieldset">
                        <legend class="sr-legend">@T["ServerAdminRequest.LegendMedia"]</legend>

                        <div class="form-group">
                            <label>@T["ServerAdminRequest.FieldLogo"] <span class="sr-optional">@T["ServerAdminRequest.Optional"]</span></label>
                            <div class="sr-file-drop">
                                <InputFile OnChange="OnLogoSelected" accept=".jpg,.jpeg,.png,.gif,.webp" />
                                @if (!string.IsNullOrWhiteSpace(selectedLogoName))
                                {
                                    <span class="sr-file-name">@selectedLogoName</span>
                                }
                                else
                                {
                                    <span class="sr-file-hint">@T["ServerAdminRequest.FileHint"]</span>
                                }
                            </div>
                        </div>

                        <div class="form-group">
                            <label>@T["ServerAdminRequest.FieldNotes"] <span class="sr-optional">@T["ServerAdminRequest.Optional"]</span></label>
                            <InputTextArea @bind-Value="form.RequestNote" class="input" rows="4" placeholder="@T["ServerAdminRequest.NotesPH"]" />
                        </div>
                    </fieldset>

                    <div class="sr-submit-row">
                        <button class="sr-submit-btn" type="submit" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span>@T["ServerAdminRequest.Submitting"]</span>
                            }
                            else
                            {
                                <span>@T["ServerAdminRequest.Submit"]</span>
                            }
                        </button>
                    </div>
                </EditForm>

                @if (!string.IsNullOrWhiteSpace(statusMessage))
                {
                    <div class="sr-status-banner">@statusMessage</div>
                }
            }
        </article>
    </section>
</div>

@code {
    private sealed class ServerRegistrationForm
    {
        [Required(ErrorMessage = "Informe o nome do servidor.")]
        [StringLength(120)]
        public string ServerName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe a versão do Tibia.")]
        [StringLength(40)]
        public string TibiaVersion { get; set; } = string.Empty;

        [StringLength(60)]
        public string Region { get; set; } = string.Empty;

        [StringLength(200)]
        public string WebsiteUrl { get; set; } = string.Empty;

        [StringLength(1000)]
        public string RequestNote { get; set; } = string.Empty;
    }

    private bool isLoading = true;
    private bool isSubmitting;
    private ServerRegistrationForm form = new();
    private IBrowserFile? logoFile;
    private string? selectedLogoName;
    private string? statusMessage;

    protected override async Task OnInitializedAsync()
    {
        await Task.CompletedTask;
        isLoading = false;
    }

    private async Task SubmitRequest()
    {
        isSubmitting = true;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userId = user.FindFirst(c => c.Type == "sub" || c.Type.Contains("nameidentifier"))?.Value;
        if (string.IsNullOrWhiteSpace(userId))
        {
            statusMessage = T["ServerAdminRequest.ErrorNoUser"];
            isSubmitting = false;
            return;
        }

        await ServerRegistrationRequestService.CreateAsync(
            new ServerRegistrationRequestService.CreateServerRegistrationRequestInput
            {
                Name = form.ServerName,
                TibiaVersion = form.TibiaVersion,
                Region = form.Region,
                WebsiteUrl = form.WebsiteUrl,
                RequestNote = form.RequestNote
            },
            userId,
            logoFile
        );

        form = new ServerRegistrationForm();
        logoFile = null;
        selectedLogoName = null;
        statusMessage = T["ServerAdminRequest.Success"];
        isSubmitting = false;
    }

    private void OnLogoSelected(InputFileChangeEventArgs e)
    {
        logoFile = e.File;
        selectedLogoName = e.File.Name;
    }
}
