@page "/servers/{ServerId:int}/items/{ItemKey}"

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using System.Globalization
@using System.Security.Claims
@using Confirmai.Models

@inject TibiaServerService TibiaServerService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject UiTextService T

<PageTitle>@itemName</PageTitle>

<div class="entity-shell parchment-a server-classic-layout server-item-offers-page">
    @if (isLoading)
    {
        <section class="entity-shell-grid" aria-label="@T["ServerItemOffers.Loading"]">
            <article class="entity-shell-card entity-shell-main">
                <div class="loading-spinner">@T["ServerItemOffers.Loading"]</div>
            </article>
        </section>
    }
    else if (server == null)
    {
        <section class="entity-shell-grid" aria-label="@T["ServerItemOffers.NotFound"]">
            <article class="entity-shell-card entity-shell-main dashboard-servers-empty">
                <h3>@T["ServerItemOffers.NotFound"]</h3>
                <p>@T["ServerItemOffers.NotFoundDesc"]</p>
                <button class="mk-btn mk-btn-muted" type="button" @onclick='() => Navigation.NavigateTo("/servers")'>@T["ServerItemOffers.Back"]</button>
            </article>
        </section>
    }
    else
    {
        <section class="entity-shell-grid" aria-label="Ofertas por item">
            <article class="entity-shell-card entity-shell-main server-item-offers-main" style="@BuildItemAccentStyle(itemAccentColor)">
                <div class="server-item-offers-topbar">
                    <button class="server-item-offers-back" type="button" @onclick='() => Navigation.NavigateTo($"/servers/{ServerId}")'>@T["ServerItemOffers.Back"]</button>
                    <button class="server-item-offers-create" type="button" @onclick="OnCreateOfferClicked">@T["ServerItemOffers.NewOffer"]</button>
                </div>

                @if (string.IsNullOrWhiteSpace(currentUserId))
                {
                    <div class="server-anon-cta">
                        <i class="fas fa-shield-alt server-anon-cta-icon"></i>
                        <div class="server-anon-cta-body">
                            <strong>@T["ServerItemOffers.AnonCtaTitle"]</strong>
                            <span>@T["ServerItemOffers.AnonCtaDesc"]</span>
                        </div>
                        <div class="server-anon-cta-actions">
                            <a class="server-anon-cta-btn server-anon-cta-btn--primary" href="/Identity/Account/Register">@T["ServerItemOffers.AnonRegister"]</a>
                            <a class="server-anon-cta-btn server-anon-cta-btn--muted" href="/Identity/Account/Login">@T["ServerItemOffers.AnonLogin"]</a>
                        </div>
                    </div>
                }

                <article class="server-auction-card server-item-summary-card" style="@BuildItemAccentStyle(itemAccentColor)">
                    <header class="server-auction-head">
                        <h4>@itemName</h4>
                    </header>

                    <div class="server-item-summary-body">
                        <div class="server-item-summary-image">
                            @if (!string.IsNullOrWhiteSpace(itemTemplate?.ImagePath))
                            {
                                <img src="@itemTemplate.ImagePath" alt="Imagem de @itemName" />
                            }
                            else
                            {
                                <div class="mk-img-placeholder" aria-hidden="true">IMG</div>
                            }
                        </div>

                        <div class="item-summary-grid">
                            <div class="item-summary-col">
                                <div class="server-auction-row server-auction-keyline item-summary-row">
                                    <span class="server-auction-key">@T["ServerItemOffers.FieldName"]</span>
                                    <span class="server-auction-value strong">@itemName</span>
                                </div>
                                <div class="server-auction-row server-auction-keyline item-summary-row">
                                    <span class="server-auction-key">@T["ServerItemOffers.FieldAtkDefArm"]</span>
                                    <span class="server-auction-value">@(itemTemplate?.Attack ?? 0) / @(itemTemplate?.Defense ?? 0) / @(itemTemplate?.Armor ?? 0)</span>
                                </div>
                                <div class="server-auction-row server-auction-keyline item-summary-row">
                                    <span class="server-auction-key">@T["ServerItemOffers.FieldWeight"]</span>
                                    <span class="server-auction-value">@((itemTemplate?.Weight ?? 0m).ToString("0.##", CultureInfo.InvariantCulture)) oz</span>
                                </div>
                                <div class="server-auction-row server-auction-keyline item-summary-row">
                                    <span class="server-auction-key server-auction-key--nowrap">@T["ServerItemOffers.FieldActiveOffers"]</span>
                                    <span class="server-auction-value strong">@itemOffers.Count</span>
                                </div>
                            </div>

                            <div class="item-summary-col">
                                <div class="server-auction-row server-auction-keyline item-summary-row">
                                    <span class="server-auction-key">@T["ServerItemOffers.FieldCategory"]</span>
                                    <span class="server-auction-value">@(string.IsNullOrWhiteSpace(itemTemplate?.Category) ? T["ServerItemOffers.CategoryFallback"] : itemTemplate!.Category)</span>
                                </div>
                                <div class="server-auction-row server-auction-keyline item-summary-row">
                                    <span class="server-auction-key">@T["ServerItemOffers.FieldDescription"]</span>
                                    <span class="server-auction-value">@(string.IsNullOrWhiteSpace(itemTemplate?.Description) ? T["ServerItemOffers.NoDescription"] : itemTemplate!.Description)</span>
                                </div>
                                <div class="server-auction-row server-auction-keyline item-summary-row">
                                    <span class="server-auction-key">@T["ServerItemOffers.FieldLootList"]</span>
                                    <span class="server-auction-value">@(string.IsNullOrWhiteSpace(itemTemplate?.DropSources) ? T["ServerItemOffers.NoDropSources"] : itemTemplate!.DropSources)</span>
                                </div>
                                <div class="server-auction-row server-auction-keyline item-summary-row">
                                    <span class="server-auction-key">@T["ServerItemOffers.FieldAvgPrice"]</span>
                                    <span class="server-auction-value strong">@(activeOffersAveragePrice.HasValue ? $"{activeOffersAveragePrice.Value.ToString("0.#####", CultureInfo.InvariantCulture)} {activeOffersAveragePriceUnitLabel}" : T["ServerItemOffers.NoOffers"])</span>
                                </div>
                            </div>

                        </div>
                    </div>
                </article>

                @if (!offerCards.Any())
                {
                    <p class="market-empty">@T["ServerItemOffers.Empty"]</p>
                }
                else
                {
                    <div class="product-list server-items-list server-item-offers-list">
                        @foreach (var card in offerCards)
                        {
                            <article class="offer-card-v2" style="@BuildItemAccentStyle(card.AccentColor)">
                                <div class="offer-card-v2-grid">
                                    <div class="offer-card-v2-price-wrap">
                                        <div class="offer-card-v2-price">@FormatOfferCardPrice(card.UnitPrice, card.PricingGateway)</div>
                                        <span class="offer-card-v2-price-label">@T["ServerItemOffers.PriceLabel"] (@(GetCurrencyLabelByGateway(card.PricingGateway)))</span>
                                    </div>

                                    <div class="offer-card-v2-seller-soft">
                                        @T["ServerItemOffers.Seller"]
                                        <a class="offer-card-v2-seller-link" href="@BuildProfileUrl(card.SellerUserId)">@card.SellerUserName</a>
                                        @if (card.FailedDeliveryCount > 0)
                                        {
                                            <span class="offer-card-v2-failed-badge" title="@T["ServerItemOffers.FailedBadgeTitle"]">
                                                <i class="fas fa-exclamation-triangle"></i> @card.FailedDeliveryCount
                                            </span>
                                        }
                                    </div>

                                    <div class="offer-card-v2-meta-grid">
                                        <div class="offer-card-v2-statbox">
                                            <span class="offer-card-v2-key">@T["ServerItemOffers.Available"]</span>
                                            <span class="offer-card-v2-value strong">@card.OfferQuantity</span>
                                        </div>

                                        <div class="offer-card-v2-statbox">
                                            <span class="offer-card-v2-key">@T["ServerItemOffers.Buy"]</span>
                                            <input
                                                class="offer-card-v2-qty-input"
                                                type="number"
                                                min="1"
                                                max="@card.OfferQuantity"
                                                value="@GetSelectedBuyQuantity(card)"
                                                @onchange='e => SetSelectedBuyQuantity(card.SellerUserId, card.OfferQuantity, e.Value?.ToString())' />
                                        </div>

                                        <div class="offer-card-v2-statbox offer-card-v2-statbox-full offer-card-v2-statbox-muted">
                                            <span class="offer-card-v2-key">@T["ServerItemOffers.SoldBySeller"]</span>
                                            <span class="offer-card-v2-value">@card.SoldBySeller</span>
                                        </div>
                                    </div>

                                    <div class="offer-card-v2-references-row">
                                        <span class="offer-card-v2-key offer-card-v2-key-block">@T["ServerItemOffers.References"]</span>
                                        @if (card.Recommendations.Any())
                                        {
                                            <div class="offer-card-v2-references">
                                                @foreach (var rec in card.Recommendations)
                                                {
                                                    <a class="offer-card-v2-reference-pill" href="@BuildProfileUrl(rec.UserId)">@rec.UserName</a>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="offer-card-v2-own">@T["ServerItemOffers.NoRecommendations"]</span>
                                        }
                                    </div>
                                </div>

                                <div class="offer-card-v2-footer">
                                    @if (string.IsNullOrWhiteSpace(currentUserId))
                                    {
                                        <button class="offer-card-v2-buy-btn" type="button" @onclick="NavigateToLoginForCurrentPage">@T["ServerItemOffers.Buy"]</button>
                                    }
                                    else if (!string.Equals(currentUserId, card.SellerUserId, StringComparison.Ordinal))
                                    {
                                        <button class="offer-card-v2-buy-btn" type="button" @onclick='() => OpenBuyFromSeller(card)'>@T["ServerItemOffers.Buy"]</button>

                                        <div class="offer-card-v2-secondary-actions">
                                            <button class="offer-card-v2-message-btn" type="button" @onclick='() => OpenMessageSeller(card.SellerUserId)'>@T["ServerItemOffers.MessageBtn"]</button>
                                            <button class="offer-card-v2-reference-btn" type="button" @onclick='() => ToggleRecommendation(card.SellerUserId)'>
                                                @(card.RecommendedByMe ? T["ServerItemOffers.RemoveRecommendBtn"] : T["ServerItemOffers.RecommendBtn"])
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="offer-card-v2-buy-btn offer-card-v2-cancel-btn" type="button" @onclick='() => CancelOwnOffer(card)'>@T["ServerItemOffers.CancelOfferBtn"]</button>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            </article>
        </section>
    }
</div>

@code {
    [Parameter] public int ServerId { get; set; }
    [Parameter] public string ItemKey { get; set; } = string.Empty;

    private TibiaServer? server;
    private bool isLoading = true;
    private string currentUserId = string.Empty;
    private string itemName = "Item";
    private string? itemAccentColor;
    private Product? itemTemplate;
    private List<TibiaServerService.ItemOfferView> itemOffers = new();
    private List<TibiaServerService.SellerRecommendationView> recommendations = new();
    private List<SellerOfferCard> offerCards = new();
    private readonly Dictionary<string, int> selectedBuyQuantities = new(StringComparer.Ordinal);
    private decimal? activeOffersAveragePrice;
    private string activeOffersAveragePriceUnitLabel = "BTC";

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier)
            ?? authState.User.FindFirstValue("sub")
            ?? string.Empty;

        server = await TibiaServerService.GetByIdAsync(ServerId);
        if (server == null)
        {
            isLoading = false;
            return;
        }

        var normalizedItemKey = NormalizeItemKey(Uri.UnescapeDataString(ItemKey ?? string.Empty));
        var allServerItems = await TibiaServerService.GetItemsForServerAsync(ServerId);
        var itemCandidates = allServerItems
            .Where(p => NormalizeItemKey(p.Name) == normalizedItemKey)
            .ToList();

        itemName = itemCandidates.FirstOrDefault()?.Name ?? Uri.UnescapeDataString(ItemKey ?? string.Empty);
        itemTemplate = itemCandidates.FirstOrDefault();
        itemAccentColor = itemCandidates
            .Select(p => NormalizeAccentColor(p.AccentColor))
            .FirstOrDefault(c => c != null);

        await RefreshOffersAsync(normalizedItemKey);

        isLoading = false;
    }

    private async Task ToggleRecommendation(string sellerUserId)
    {
        if (string.IsNullOrWhiteSpace(currentUserId))
        {
            return;
        }

        var normalizedItemKey = NormalizeItemKey(Uri.UnescapeDataString(ItemKey ?? string.Empty));
        await TibiaServerService.ToggleSellerRecommendationAsync(ServerId, normalizedItemKey, sellerUserId, currentUserId);

        await RefreshOffersAsync(normalizedItemKey);
    }

    private async Task CancelOwnOffer(SellerOfferCard card)
    {
        if (string.IsNullOrWhiteSpace(currentUserId) || !string.Equals(currentUserId, card.SellerUserId, StringComparison.Ordinal))
        {
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm", T["ServerItemOffers.ConfirmCancel"]);
        if (!confirmed)
        {
            return;
        }

        var normalizedItemKey = NormalizeItemKey(Uri.UnescapeDataString(ItemKey ?? string.Empty));
        await TibiaServerService.DeactivateOwnItemOffersAsync(ServerId, normalizedItemKey, currentUserId);
        await RefreshOffersAsync(normalizedItemKey);
    }

    private async Task RefreshOffersAsync(string normalizedItemKey)
    {
        recommendations = await TibiaServerService.GetSellerRecommendationsForItemAsync(ServerId, normalizedItemKey);
        itemOffers = await TibiaServerService.GetActiveItemOffersAsync(ServerId, normalizedItemKey);
        activeOffersAveragePrice = itemOffers.Count == 0
            ? null
            : itemOffers.Average(o => o.UnitPrice);
        activeOffersAveragePriceUnitLabel = ResolveAveragePriceUnitLabel(itemOffers);
        var soldBySeller = await TibiaServerService.GetPaidOrderCountsBySellerForItemAsync(ServerId, normalizedItemKey);
        BuildSellerCards(soldBySeller);
    }

    private static string ResolveAveragePriceUnitLabel(List<TibiaServerService.ItemOfferView> offers)
    {
        var gateways = offers
            .Select(o => o.PricingGateway)
            .Where(g => !string.IsNullOrWhiteSpace(g))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (gateways.Count == 1)
        {
            return GetCurrencyLabelByGateway(gateways[0]);
        }

        if (gateways.Count > 1)
        {
            return "MIXTO";
        }

        return "BTC";
    }

    private static string FormatOfferCardPrice(decimal price, string? currency)
    {
        var label = GetCurrencyLabelByGateway(currency);
        return label switch
        {
            "BRL" => $"R$ {price.ToString("N2", CultureInfo.GetCultureInfo("pt-BR"))}",
            "USD" => $"$ {price.ToString("N2", CultureInfo.InvariantCulture)}",
            _ => $"{price.ToString("0.#####", CultureInfo.InvariantCulture)} BTC"
        };
    }

    private static string GetCurrencyLabelByGateway(string? gateway)
    {
        if (string.IsNullOrWhiteSpace(gateway))
            return "BTC";

        // New format: currency code stored directly
        var upper = gateway.ToUpperInvariant();
        if (upper == "BRL" || upper == "USD" || upper == "BTC")
            return upper;

        // Legacy: gateway-name-based fallback
        if (gateway.Contains("pix", StringComparison.OrdinalIgnoreCase))
            return "BRL";

        return "BTC";
    }

    private static string ResolveSellerPricingGateway(IGrouping<string, TibiaServerService.ItemOfferView> offersBySeller)
    {
        var gateways = offersBySeller
            .Select(o => o.PricingGateway)
            .Where(g => !string.IsNullOrWhiteSpace(g))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (gateways.Count == 1)
        {
            return gateways[0]!;
        }

        if (gateways.Count > 1)
        {
            return "Misto";
        }

        return "Pix";
    }

    private void OpenCreateOffer()
    {
        var safeItemKey = Uri.EscapeDataString(Uri.UnescapeDataString(ItemKey ?? string.Empty));
        Navigation.NavigateTo($"/servers/{ServerId}/items/{safeItemKey}/offer");
    }

    private void OnCreateOfferClicked()
    {
        if (string.IsNullOrWhiteSpace(currentUserId))
        {
            AuthNavigationHelper.NavigateToLoginForCurrentUrl(Navigation);
            return;
        }

        OpenCreateOffer();
    }

    private void NavigateToLoginForCurrentPage()
    {
        AuthNavigationHelper.NavigateToLoginForCurrentUrl(Navigation);
    }

    private void OpenBuyFromSeller(SellerOfferCard card)
    {
        var productId = card.ProductId;
        var targetProductId = productId > 0
            ? productId
            : itemTemplate?.Id ?? 0;

        if (targetProductId <= 0)
        {
            return;
        }

        var quantity = GetSelectedBuyQuantity(card);
        var safeSellerId = Uri.EscapeDataString(card.SellerUserId);
        var safeUnitPrice = card.UnitPrice.ToString("0.#####", CultureInfo.InvariantCulture);
        var currentRelativePath = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        var safeReturnUrl = Uri.EscapeDataString(currentRelativePath);

        Navigation.NavigateTo($"/marketplace/buy/{targetProductId}?serverId={ServerId}&sellerId={safeSellerId}&qty={quantity}&maxQty={card.OfferQuantity}&unitPrice={safeUnitPrice}&currency={Uri.EscapeDataString(card.PricingGateway ?? "BTC")}&offerId={card.OfferId}&returnUrl={safeReturnUrl}");
    }

    private void OpenMessageSeller(string sellerUserId)
    {
        var safeItem = Uri.EscapeDataString(itemName);
        Navigation.NavigateTo($"{BuildProfileUrl(sellerUserId)}&intent=message&item={safeItem}");
    }

    private string BuildProfileUrl(string userId)
    {
        var safeUserId = Uri.EscapeDataString(userId ?? string.Empty);
        var currentRelativePath = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        return $"/profile/{safeUserId}?serverId={ServerId}&returnUrl={Uri.EscapeDataString(currentRelativePath)}";
    }

    private void BuildSellerCards(Dictionary<string, int> soldBySeller)
    {
        offerCards = itemOffers
            .Where(p => !string.IsNullOrWhiteSpace(p.SellerUserId))
            .GroupBy(p => p.SellerUserId)
            .Select(g =>
            {
                var sellerId = g.Key;
                var first = g.OrderBy(p => p.UnitPrice).First();
                var sellerName = string.IsNullOrWhiteSpace(first.SellerUserName)
                    ? sellerId
                    : first.SellerUserName;

                var sellerRecommendations = recommendations
                    .Where(r => string.Equals(r.SellerUserId, sellerId, StringComparison.Ordinal))
                    .GroupBy(r => r.RecommenderUserId)
                    .Select(x => new RecommendationBadge(x.Key, x.First().RecommenderUserName))
                    .OrderBy(x => x.UserName)
                    .ToList();

                var recommendedByMe = sellerRecommendations.Any(r => string.Equals(r.UserId, currentUserId, StringComparison.Ordinal));

                return new SellerOfferCard(
                    sellerId,
                    sellerName,
                    first.ProductId,
                    g.Sum(p => p.Quantity),
                    g.Min(p => p.UnitPrice),
                    ResolveSellerPricingGateway(g),
                    soldBySeller.TryGetValue(sellerId, out var soldCount) ? soldCount : 0,
                    NormalizeAccentColor(g.Select(p => p.AccentColor).FirstOrDefault()) ?? itemAccentColor,
                    recommendedByMe,
                    sellerRecommendations,
                    first.OfferId,
                    g.Max(p => p.FailedDeliveryCount));
            })
            .OrderByDescending(x => x.Recommendations.Count)
            .ThenByDescending(x => x.SoldBySeller)
            .ThenBy(x => x.UnitPrice)
            .ToList();

        SyncSelectedQuantities();
    }

    private int GetSelectedBuyQuantity(SellerOfferCard card)
    {
        if (!selectedBuyQuantities.TryGetValue(card.SellerUserId, out var selected))
        {
            selected = 1;
            selectedBuyQuantities[card.SellerUserId] = selected;
        }

        return Math.Clamp(selected, 1, Math.Max(1, card.OfferQuantity));
    }

    private void SetSelectedBuyQuantity(string sellerUserId, int maxQuantity, string? rawValue)
    {
        if (!int.TryParse(rawValue, out var parsed))
        {
            parsed = 1;
        }

        selectedBuyQuantities[sellerUserId] = Math.Clamp(parsed, 1, Math.Max(1, maxQuantity));
    }

    private void SyncSelectedQuantities()
    {
        var activeSellers = offerCards.Select(c => c.SellerUserId).ToHashSet(StringComparer.Ordinal);
        var staleKeys = selectedBuyQuantities.Keys.Where(k => !activeSellers.Contains(k)).ToList();
        foreach (var key in staleKeys)
        {
            selectedBuyQuantities.Remove(key);
        }

        foreach (var card in offerCards)
        {
            var current = selectedBuyQuantities.TryGetValue(card.SellerUserId, out var existing) ? existing : 1;
            selectedBuyQuantities[card.SellerUserId] = Math.Clamp(current, 1, Math.Max(1, card.OfferQuantity));
        }
    }

    private static string NormalizeItemKey(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return string.Empty;
        }

        return name.Trim().ToUpperInvariant();
    }

    private static string BuildItemAccentStyle(string? accentColor)
    {
        var main = NormalizeAccentColor(accentColor) ?? "#BF4B13";
        var dark = DarkenHex(main, 0.25m);
        var border = DarkenHex(main, 0.14m);
        var bodyTop = MixWithWhite(main, 0.82m);
        var bodyBottom = MixWithWhite(main, 0.7m);
        var secondaryTop = MixWithWhite(main, 0.9m);
        var secondaryBottom = MixWithWhite(main, 0.8m);
        var softTop = MixWithWhite(main, 0.94m);
        var softBottom = MixWithWhite(main, 0.86m);
        var subcardTop = MixWithWhite(main, 0.74m);
        var subcardBottom = MixWithWhite(main, 0.58m);
        var inputBg = MixWithWhite(main, 0.965m);
        var inkStrong = DarkenHex(main, 0.68m);
        var ink = DarkenHex(main, 0.56m);
        var inkMuted = DarkenHex(main, 0.44m);
        var separator = MixWithWhite(DarkenHex(main, 0.3m), 0.55m);
        var buttonTop = MixWithWhite(main, 0.66m);
        var buttonBottom = MixWithWhite(main, 0.5m);
        var disabledTop = MixWithWhite(main, 0.78m);
        var disabledBottom = MixWithWhite(main, 0.64m);
        var buttonText = DarkenHex(main, 0.74m);
        var focusRing = MixWithWhite(main, 0.38m);

        return $"--item-accent:{main};--item-accent-dark:{dark};--item-accent-border:{border};--item-body-bg-top:{bodyTop};--item-body-bg-bottom:{bodyBottom};--item-secondary-bg-top:{secondaryTop};--item-secondary-bg-bottom:{secondaryBottom};--item-soft-bg-top:{softTop};--item-soft-bg-bottom:{softBottom};--item-subcard-bg-top:{subcardTop};--item-subcard-bg-bottom:{subcardBottom};--item-input-bg:{inputBg};--item-ink-strong:{inkStrong};--item-ink:{ink};--item-ink-muted:{inkMuted};--item-separator:{separator};--item-button-top:{buttonTop};--item-button-bottom:{buttonBottom};--item-button-text:{buttonText};--item-disabled-top:{disabledTop};--item-disabled-bottom:{disabledBottom};--item-focus-ring:{focusRing};";
    }

    private static string? NormalizeAccentColor(string? color)
    {
        if (string.IsNullOrWhiteSpace(color))
        {
            return null;
        }

        var normalized = color.Trim();
        if (normalized.StartsWith('#'))
        {
            normalized = normalized[1..];
        }

        if (normalized.Length != 6)
        {
            return null;
        }

        if (!int.TryParse(normalized, NumberStyles.HexNumber, CultureInfo.InvariantCulture, out _))
        {
            return null;
        }

        return $"#{normalized.ToUpperInvariant()}";
    }

    private static string DarkenHex(string hexColor, decimal amount)
    {
        var hex = hexColor.TrimStart('#');
        var r = Convert.ToInt32(hex.Substring(0, 2), 16);
        var g = Convert.ToInt32(hex.Substring(2, 2), 16);
        var b = Convert.ToInt32(hex.Substring(4, 2), 16);

        var factor = 1m - amount;
        r = Math.Clamp((int)Math.Round(r * (double)factor), 0, 255);
        g = Math.Clamp((int)Math.Round(g * (double)factor), 0, 255);
        b = Math.Clamp((int)Math.Round(b * (double)factor), 0, 255);

        return $"#{r:X2}{g:X2}{b:X2}";
    }

    private static string MixWithWhite(string hexColor, decimal whiteRatio)
    {
        var hex = hexColor.TrimStart('#');
        var r = Convert.ToInt32(hex.Substring(0, 2), 16);
        var g = Convert.ToInt32(hex.Substring(2, 2), 16);
        var b = Convert.ToInt32(hex.Substring(4, 2), 16);

        var ratio = Math.Clamp((double)whiteRatio, 0d, 1d);
        r = Math.Clamp((int)Math.Round(r + ((255 - r) * ratio)), 0, 255);
        g = Math.Clamp((int)Math.Round(g + ((255 - g) * ratio)), 0, 255);
        b = Math.Clamp((int)Math.Round(b + ((255 - b) * ratio)), 0, 255);

        return $"#{r:X2}{g:X2}{b:X2}";
    }

    private sealed record RecommendationBadge(string UserId, string UserName);

    private sealed record SellerOfferCard(
        string SellerUserId,
        string SellerUserName,
        int ProductId,
        int OfferQuantity,
        decimal UnitPrice,
        string? PricingGateway,
        int SoldBySeller,
        string? AccentColor,
        bool RecommendedByMe,
        List<RecommendationBadge> Recommendations,
        int OfferId,
        int FailedDeliveryCount);
}
