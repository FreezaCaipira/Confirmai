@page "/servers/{ServerId:int}/manage"

@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using Confirmai.Data
@using Confirmai.Enums
@using Confirmai.Models
@using Confirmai.Services
@inject TibiaServerService TibiaServerService
@inject ServerApiKeyService ApiKeyService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject AppDbContext Db
@inject IJSRuntime JS
@inject UiTextService T

<PageTitle>@T["ServerManage.Loading"]</PageTitle>

<div class="entity-shell parchment-a server-classic-layout server-manage-page">

    <section class="entity-shell-grid" aria-label="@T["ServerManage.SectionData"]">
        @if (isLoading)
        {
            <article class="entity-shell-card entity-shell-main form-card server-form-card">
                <div class="loading-spinner">@T["ServerManage.Loading"]</div>
            </article>
        }
        else if (server == null)
        {
            <article class="entity-shell-card entity-shell-main form-card server-form-card">
                <div class="dashboard-servers-empty">
                    <h3>@T["ServerManage.NotFound"]</h3>
                    <p>@T["ServerManage.NotFoundDesc"]</p>
                    <button class="mk-btn mk-btn-muted" type="button" @onclick='() => Navigation.NavigateTo("/servers")'>@T["ServerDetails.Back"]</button>
                </div>
            </article>
        }
        else if (!canManage)
        {
            <article class="entity-shell-card entity-shell-main form-card server-form-card">
                <div class="dashboard-servers-empty">
                    <h3>@T["ServerManage.AccessDenied"]</h3>
                    <p>@T["ServerManage.AccessDeniedDesc"]</p>
                    <button class="mk-btn mk-btn-muted" type="button" @onclick='() => Navigation.NavigateTo($"/servers/{ServerId}")'>@T["ServerDetails.Back"]</button>
                </div>
            </article>
        }
        else
        {
            <article class="entity-shell-card entity-shell-main form-card server-form-card server-manage-main">

                @* ── Cabeçalho: logo + nome + navegação ── *@
                <section class="server-manage-page-header" aria-label="Resumo do servidor">
                    @if (!string.IsNullOrWhiteSpace(server.LogoPath))
                    {
                        <img class="server-manage-logo" src="@server.LogoPath" alt="Logo de @server.Name" />
                    }
                    else
                    {
                        <div class="server-manage-logo-fallback" aria-hidden="true">
                            @server.Name[..Math.Min(2, server.Name.Length)].ToUpperInvariant()
                        </div>
                    }
                    <div class="server-manage-header-meta">
                        <h2>@server.Name</h2>
                        <p>@(string.IsNullOrWhiteSpace(server.Region) ? "Global" : server.Region) · Tibia @(string.IsNullOrWhiteSpace(server.TibiaVersion) ? "n/d" : server.TibiaVersion)</p>
                    </div>
                    <div class="server-manage-header-actions">
                        <button class="mk-btn mk-btn-muted" type="button" @onclick='() => Navigation.NavigateTo($"/servers/{ServerId}")'>@T["ServerManage.ViewServer"]</button>
                        <button class="mk-btn mk-btn-muted" type="button" @onclick='() => Navigation.NavigateTo("/servers")'>@T["ServerManage.Servers"]</button>
                    </div>
                </section>

                @* ── Dados do servidor ── *@
                <h3 class="server-manage-section">@T["ServerManage.SectionData"]</h3>

                <EditForm Model="server" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="form-group">
                        <label>@T["ServerManage.FieldName"]</label>
                        <InputText @bind-Value="server.Name" class="input" />
                        <ValidationMessage For="@(() => server.Name)" />
                    </div>

                    <div class="form-group">
                        <label>@T["ServerManage.FieldRegion"]</label>
                        <InputText @bind-Value="server.Region" class="input" />
                        <ValidationMessage For="@(() => server.Region)" />
                    </div>

                    <div class="form-group">
                        <label>@T["ServerManage.FieldTibiaVersion"]</label>
                        <InputText @bind-Value="server.TibiaVersion" class="input" placeholder="Ex.: 7.4" />
                        <ValidationMessage For="@(() => server.TibiaVersion)" />
                    </div>

                    <div class="form-group">
                        <label>@T["ServerManage.FieldWebsite"]</label>
                        <InputText @bind-Value="server.WebsiteUrl" class="input" />
                        <ValidationMessage For="@(() => server.WebsiteUrl)" />
                    </div>

                    <div class="form-group">
                        <label>@T["ServerManage.FieldLogo"]</label>
                        <InputFile OnChange="OnLogoSelected" accept=".jpg,.jpeg,.png,.gif,.webp" />
                        @if (!string.IsNullOrWhiteSpace(selectedLogoName))
                        {
                            <small class="identity-muted">@T["ServerManage.FileSelected"] @selectedLogoName</small>
                        }
                        else if (!string.IsNullOrWhiteSpace(server.LogoPath))
                        {
                            <small class="identity-muted">@T["ServerManage.CurrentLogo"]</small>
                        }
                    </div>

                    <div class="form-group form-group-checkbox">
                        <label class="checkbox-label">
                            <InputCheckbox @bind-Value="server.IsActive" />
                            @T["ServerManage.IsActive"]
                        </label>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(serverValidationError))
                    {
                        <div class="text-danger">@serverValidationError</div>
                    }

                    <div class="form-actions">
                        <button class="cancel-btn" type="button" @onclick='() => Navigation.NavigateTo("/servers")'>@T["ServerManage.Cancel"]</button>
                        <button class="save-btn" type="submit" disabled="@isSaving">@T["ServerManage.Save"]</button>
                        @if (isSiteAdmin)
                        {
                            <button class="danger" type="button" @onclick="DeleteServerAsync" disabled="@isSaving">@T["ServerManage.Delete"]</button>
                        }
                    </div>
                </EditForm>

                @* ── Integrantes do servidor ── *@
                <h3 class="server-manage-section">@T["ServerManage.SectionMembers"]</h3>
                <p class="identity-muted">@T["ServerManage.MembersHint"]</p>

                <div class="form-group">
                    <label>@T["ServerManage.FieldMemberEmail"]</label>
                    <input class="input" type="email" @bind="memberEmail" placeholder="player@servidor.com" />
                </div>

                <div class="form-group">
                    <label>@T["ServerManage.FieldMemberRole"]</label>
                    <select class="input" @bind="selectedRole">
                        <option value="@ServerMemberRole.User">@T["ServerManage.RoleUser"]</option>
                        <option value="@ServerMemberRole.ServerAdmin">@T["ServerManage.RoleServerAdmin"]</option>
                    </select>
                </div>

                <div class="form-actions">
                    <button class="mk-btn mk-btn-muted" type="button" @onclick="AddMember" disabled="@isSaving">@T["ServerManage.AddMember"]</button>
                </div>

                @if (members.Any())
                {
                    <div class="server-members-table-wrap">
                        <table class="product-table server-members-table">
                            <thead>
                                <tr>
                                    <th>@T["ServerManage.MemberTableUser"]</th>
                                    <th>@T["ServerManage.MemberTableEmail"]</th>
                                    <th>@T["ServerManage.MemberTableRole"]</th>
                                    <th>@T["ServerManage.MemberTableActions"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var member in members)
                                {
                                    <tr>
                                        <td>@member.UserName</td>
                                        <td>@member.Email</td>
                                        <td>@GetRoleLabel(member)</td>
                                        <td>
                                            <button type="button" class="danger" @onclick="() => RemoveMember(member.UserId)" disabled="@isSaving">@T["ServerManage.RemoveMember"]</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="identity-muted">@T["ServerManage.NoMembers"]</p>
                }

                @if (!string.IsNullOrWhiteSpace(memberValidationError))
                {
                    <div class="text-danger">@memberValidationError</div>
                }

                @* ── Integração via API ── *@
                <h3 class="server-manage-section">@T["ServerManage.SectionApi"]</h3>
                <p class="identity-muted">
                    @T["ServerManage.ApiHint"]
                    <a href="/docs/integration" target="_blank" class="int-docs-link">@T["ServerManage.ApiDocs"]</a>
                </p>

                @if (apiKeys.Any())
                {
                    <table class="product-table server-apikeys-table">
                        <thead>
                            <tr>
                                <th>@T["ServerManage.ApiKeyPrefix"]</th>
                                <th>@T["ServerManage.ApiKeyLabel"]</th>
                                <th>@T["ServerManage.ApiKeyStatus"]</th>
                                <th>@T["ServerManage.ApiKeyLastUsed"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var key in apiKeys)
                            {
                                <tr class="@(!key.IsActive ? "revoked-row" : "")">
                                    <td><code>@key.KeyPrefix…</code></td>
                                    <td>@(key.Label ?? "—")</td>
                                    <td>
                                        @if (key.IsActive)
                                        {
                                            <span class="badge-active">@T["ServerManage.ApiKeyActive"]</span>
                                        }
                                        else
                                        {
                                            <span class="badge-revoked">@T["ServerManage.ApiKeyRevoked"]</span>
                                        }
                                    </td>
                                    <td>@(key.LastUsedAt?.ToString("dd/MM/yyyy HH:mm") ?? T["ServerManage.ApiKeyNever"])</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="identity-muted">@T["ServerManage.ApiKeyNoKeys"]</p>
                }

                <p class="server-apikey-tip">
                    @T["ServerManage.ApiKeyTip"]
                </p>

                @* ── Trades pendentes in-game ── *@
                <h3 class="server-manage-section">@T["ServerManage.SectionTrades"]</h3>
                <p class="identity-muted">@T["ServerManage.TradesHint"]</p>

                @if (pendingTrades.Count == 0)
                {
                    <p class="identity-muted">@T["ServerManage.TradesEmpty"]</p>
                }
                else
                {
                    <div class="server-pending-trades-wrap">
                        <table class="product-table server-pending-trades-table">
                            <thead>
                                <tr>
                                    <th>@T["ServerManage.TradeOrder"]</th>
                                    <th>@T["ServerManage.TradeProduct"]</th>
                                    <th>@T["ServerManage.TradeBuyer"]</th>
                                    <th>@T["ServerManage.TradeCharacter"]</th>
                                    <th>@T["ServerManage.TradeValue"]</th>
                                    <th>@T["ServerManage.TradeDate"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var trade in pendingTrades)
                                {
                                    <tr>
                                        <td><a href="/orders/@trade.Id">#@trade.Id</a></td>
                                        <td>@(trade.Product?.Name ?? "—")</td>
                                        <td>@(trade.Buyer?.UserName ?? trade.BuyerId ?? "(deletado)")</td>
                                        <td>@(trade.Payment?.InGamePlayerName ?? "—")</td>
                                        <td>@FormatTradeAmount(trade.Amount, trade.Payment?.Currency)</td>
                                        <td>@trade.CreatedAt.ToString("dd/MM HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @* ── Auditoria de entregas in-game ── *@
                <h3 class="server-manage-section">@T["ServerManage.SectionAudit"]</h3>
                <p class="identity-muted">@T["ServerManage.AuditHint"]</p>

                @if (auditLogs.Count == 0)
                {
                    <p class="identity-muted">@T["ServerManage.AuditEmpty"]</p>
                }
                else
                {
                    <div class="server-audit-table-wrap">
                        <table class="product-table server-audit-table">
                            <thead>
                                <tr>
                                    <th>@T["ServerManage.AuditDateTime"]</th>
                                    <th>@T["ServerManage.AuditEvent"]</th>
                                    <th>@T["ServerManage.AuditOrder"]</th>
                                    <th>@T["ServerManage.AuditSeller"]</th>
                                    <th>@T["ServerManage.AuditBuyer"]</th>
                                    <th>@T["ServerManage.AuditItem"]</th>
                                    <th>@T["ServerManage.AuditQty"]</th>
                                    <th>@T["ServerManage.AuditStatus"]</th>
                                    <th>@T["ServerManage.AuditDetail"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var log in auditLogs)
                                {
                                    <tr class="@(!log.Success ? "audit-row-fail" : "")">
                                        <td class="audit-ts">@log.OccurredAtUtc.ToString("dd/MM HH:mm:ss")</td>
                                        <td><code>@log.EventType</code></td>
                                        <td>
                                            @if (log.OrderId.HasValue)
                                            {
                                                <a href="/orders/@log.OrderId">#@log.OrderId</a>
                                            }
                                            else
                                            {
                                                <span>—</span>
                                            }
                                        </td>
                                        <td>@(log.ActorPlayerName ?? "—")</td>
                                        <td>@(log.TargetPlayerName ?? "—")</td>
                                        <td><small>@(log.ItemKey ?? "—")</small></td>
                                        <td>@(log.Quantity?.ToString() ?? "—")</td>
                                        <td>
                                            @if (log.Success)
                                            {
                                                <span class="badge-active">OK</span>
                                            }
                                            else
                                            {
                                                <span class="badge-revoked">FALHA</span>
                                            }
                                        </td>
                                        <td class="audit-detail">@(log.Detail ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (auditLogs.Count >= 100)
                    {
                        <p class="identity-muted audit-limit-note">@T["ServerManage.AuditLimit"]</p>
                    }
                }

            </article>
        }
    </section>
</div>

@code {
    [Parameter] public int ServerId { get; set; }

    private TibiaServer? server;
    private bool isLoading = true;
    private bool isSaving;
    private bool canManage;
    private bool isSiteAdmin;
    private string? currentUserId;
    private string memberEmail = string.Empty;

    // API key integration
    private List<ServerApiKeyService.ApiKeyView> apiKeys = new();
    private ServerMemberRole selectedRole = ServerMemberRole.User;
    private List<TibiaServerService.ServerMemberView> members = new();
    private string? serverValidationError;
    private string? memberValidationError;
    private IBrowserFile? logoFile;
    private string? selectedLogoName;
    private List<DeliveryAuditLog> auditLogs = new();
    private List<OrderModel> pendingTrades = new();

    private static string FormatTradeAmount(decimal amount, string? currency) => currency switch
    {
        "BRL" => $"R$ {amount:N2}",
        "USD" => $"$ {amount:N2}",
        _ => $"{amount.ToString("0.########")} BTC"
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isSiteAdmin = user.IsInRole("admin");
        currentUserId = user.FindFirst(c => c.Type == "sub" || c.Type.Contains("nameidentifier", StringComparison.OrdinalIgnoreCase))?.Value;

        server = await TibiaServerService.GetByIdAsync(ServerId);
        if (server != null)
        {
            canManage = isSiteAdmin || (!string.IsNullOrWhiteSpace(currentUserId)
                && server.Members.Any(m =>
                    string.Equals(m.UserId, currentUserId, StringComparison.OrdinalIgnoreCase)
                    && m.Role == ServerMemberRole.ServerAdmin));
        }

        if (canManage)
        {
            await LoadMembersAsync();
            await LoadApiKeysAsync();
            await LoadAuditLogsAsync();
            await LoadPendingTradesAsync();
        }

        isLoading = false;
    }

    private async Task LoadMembersAsync()
    {
        members = await TibiaServerService.GetMembersAsync(ServerId);
    }

    private async Task LoadApiKeysAsync()
    {
        apiKeys = await ApiKeyService.GetKeysForServerAsync(ServerId);
    }

    private async Task LoadAuditLogsAsync()
    {
        auditLogs = await Db.DeliveryAuditLogs
            .AsNoTracking()
            .Where(d => d.ServerId == ServerId)
            .OrderByDescending(d => d.OccurredAtUtc)
            .Take(100)
            .ToListAsync();
    }

    private async Task LoadPendingTradesAsync()
    {
        pendingTrades = await Db.Orders
            .AsNoTracking()
            .Include(o => o.Product)
            .Include(o => o.Buyer)
            .Include(o => o.Payment)
            .Where(o => o.ServerId == ServerId && o.Status == PaymentStatus.AguardandoEntregaInGame)
            .OrderBy(o => o.CreatedAt)
            .ToListAsync();
    }

    private string GetRoleLabel(TibiaServerService.ServerMemberView member)
    {
        if (member.IsSystemAdmin)
        {
            return T["ServerManage.RoleSystemAdmin"];
        }

        return member.Role == ServerMemberRole.ServerAdmin ? T["ServerManage.RoleServerAdmin"] : T["ServerManage.RoleUser"];
    }

    private async Task HandleValidSubmit()
    {
        if (server == null || !canManage)
        {
            return;
        }

        serverValidationError = null;
        isSaving = true;

        var updated = await TibiaServerService.UpdateAsync(ServerId, server, null, null, logoFile);
        isSaving = false;

        if (!updated)
        {
            serverValidationError = T["ServerManage.ErrorNotUpdated"];
            return;
        }

        await LoadMembersAsync();
    }

    private async Task AddMember()
    {
        if (!canManage)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(memberEmail))
        {
            memberValidationError = T["ServerManage.ErrorEmailRequired"];
            return;
        }

        isSaving = true;
        memberValidationError = null;

        var result = await TibiaServerService.AddOrUpdateMemberByEmailAsync(ServerId, memberEmail, selectedRole);
        isSaving = false;

        if (result == TibiaServerService.AddServerMemberResult.UserNotFound)
        {
            memberValidationError = T["ServerManage.ErrorUserNotFound"];
            return;
        }

        if (result == TibiaServerService.AddServerMemberResult.ServerNotFound)
        {
            memberValidationError = T["ServerManage.ErrorServerNotFound"];
            return;
        }

        memberEmail = string.Empty;
        await LoadMembersAsync();
    }

    private async Task RemoveMember(string userId)
    {
        if (!canManage)
        {
            return;
        }

        isSaving = true;
        await TibiaServerService.RemoveMemberAsync(ServerId, userId);
        isSaving = false;
        await LoadMembersAsync();
    }

    private async Task DeleteServerAsync()
    {
        if (!isSiteAdmin || server == null)
        {
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm", T["ServerManage.ConfirmDelete"]);
        if (!confirmed)
        {
            return;
        }

        isSaving = true;
        serverValidationError = null;

        var deleted = await TibiaServerService.DeleteAsync(ServerId);

        isSaving = false;

        if (!deleted)
        {
            serverValidationError = T["ServerManage.ErrorNotDeleted"];
            return;
        }

        Navigation.NavigateTo("/servers");
    }

    private void OnLogoSelected(InputFileChangeEventArgs e)
    {
        logoFile = e.File;
        selectedLogoName = e.File.Name;
    }
}
