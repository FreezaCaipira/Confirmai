@page "/mailbox"

@attribute [Authorize]

@using Confirmai.Data
@using Confirmai.Pages.Components
@using Confirmai.Services.Utility
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop

@inject IDbContextFactory<AppDbContext> DbFactory
@inject MailboxQueryService MailboxQueryService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject UiTextService T

<PageTitle>@T["Mailbox.PageTitle"]</PageTitle>

<div class="mailbox-page">
    <section class="panel mailbox-panel" aria-label="@T["Mailbox.Aria"]">
        @if (isLoading)
        {
            <div class="loading-spinner">@T["Mailbox.Loading"]</div>
        }
        else
        {
            <div class="panel-head mailbox-head">
                <h3 class="panel-title"><i class="fas fa-inbox"></i> @T["Mailbox.Title"]</h3>
                @{ var unreadTotal = conversationContacts.Sum(c => c.UnreadCount); }
                @if (unreadTotal > 0)
                {
                    <span class="panel-count">@unreadTotal</span>
                }
            </div>

            <div class="mailbox-body">
                <div class="mailbox-col-list">
                    <MailboxFilters
                        SearchTerm="@searchTerm"
                        PageSize="@pageSize"
                        InboxUnreadOnly="@inboxUnreadOnly"
                        OnApplyFilters="@ApplyFiltersAsync"
                        OnResetFilters="@ResetFiltersAsync" />

                    <MailboxConversationList
                        Conversations="@conversationContacts"
                        SelectedConversationKey="@selectedConversationKey"
                        CurrentPage="@conversationPage"
                        PageSize="@pageSize"
                        ConversationTotal="@conversationTotal"
                        ActiveConversationTotal="@activeConversationTotal"
                        ArchivedConversationTotal="@archivedConversationTotal"
                        ShowArchived="@showArchivedConversations"
                        OnSelectConversation="@SelectConversationCallback"
                        OnMarkAsRead="@MarkAsReadCallback"
                        OnArchive="@ArchiveCallback"
                        OnSwitchFolder="@SwitchFolderCallback"
                        OnPreviousPage="@PreviousPageCallback"
                        OnNextPage="@NextPageCallback" />
                </div>

                <MailboxThreadPane
                    SelectedContact="@SelectedContact"
                    ConversationMessages="@conversationMessages"
                    ComposerBody="@composerBody"
                    ComposerInfoMessage="@composerInfoMessage"
                    IsThreadLoading="@isThreadLoading"
                    IsSendingReply="@isSendingReply"
                    ThreadStreamRef="@threadStreamRef"
                    OnSendReply="@SendReplyCallback" />
            </div>
        }
    </section>
</div>
