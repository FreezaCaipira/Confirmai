@page "/pagamento/evento/{ConfirmationId:int}"

@attribute [Authorize]
@implements IDisposable

@using Confirmai.Data
@using Confirmai.Enums
@using Confirmai.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@using System.Security.Claims

@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject EfiBankPixService EfiBankService

<PageTitle>Pagamento — Confirmai</PageTitle>

<div class="entity-shell">
    <section class="entity-shell-grid" aria-label="Pagamento de partida">
        <article class="entity-shell-card entity-shell-main">

            @if (isLoading)
            {
                <p class="listing-state">Carregando…</p>
            }
            else if (conf is null)
            {
                <div class="evpay-not-found">
                    <p>Confirmação não encontrada.</p>
                    <a href="/" class="detail-back-link"><i class="fas fa-arrow-left"></i> Voltar</a>
                </div>
            }
            else
            {
                var ev       = conf.Event;
                var isFutsal = ev.Sport == Sport.Futsal;
                var backUrl  = isFutsal ? $"/futsal/{ev.Id}" : $"/poker/{ev.Id}";
                var ptBr     = new CultureInfo("pt-BR");

                @* ── Cabeçalho ─────────────────────────────────────────── *@
                <div class="evpay-header">
                    <div class="evpay-header-top">
                        <span class="evpay-sport-badge">@(isFutsal ? "⚽ Futsal" : "🃏 Poker")</span>
                        <a href="@backUrl" class="detail-back-link">
                            <i class="fas fa-arrow-left"></i> Voltar
                        </a>
                    </div>
                    <h1 class="evpay-title">@ev.Group.Name</h1>
                    <p class="evpay-meta">
                        <i class="fas fa-calendar-alt"></i>
                        @ev.StartsAt.ToLocalTime().ToString("dddd, dd/MM/yyyy 'às' HH:mm", ptBr)
                    </p>
                    @if (!string.IsNullOrWhiteSpace(ev.Location))
                    {
                        <p class="evpay-meta"><i class="fas fa-map-marker-alt"></i> @ev.Location</p>
                    }
                </div>

                @* ── Resumo do pagamento ────────────────────────────────── *@
                <div class="evpay-summary-card">
                    <div class="evpay-summary-row">
                        <span class="evpay-summary-label">Jogador</span>
                        <span class="evpay-summary-value">@(conf.User?.FullName ?? conf.User?.UserName ?? "—")</span>
                    </div>
                    <div class="evpay-summary-row">
                        <span class="evpay-summary-label">Posição</span>
                        <span class="evpay-summary-value">
                            @(conf.Position == FutsalPosition.Goalkeeper ? "🥅 Goleiro" : "⚽ Linha")
                        </span>
                    </div>
                    <div class="evpay-summary-divider"></div>
                    <div class="evpay-summary-row evpay-summary-row--total">
                        <span class="evpay-summary-label">Valor a pagar</span>
                        <span class="evpay-summary-amount">R$ @ev.Price!.Value.ToString("N2", ptBr)</span>
                    </div>
                </div>

                @* ── Status / Ação ──────────────────────────────────────── *@
                @if (conf.HasPaid || payState == PayState.Paid)
                {
                    @* ── Pago ─────────────────────────────────────────── *@
                    <div class="evpay-status evpay-status--paid">
                        <i class="fas fa-check-circle"></i>
                        <div>
                            <strong>Pagamento confirmado</strong>
                            <p>Sua participação está garantida. Boa partida!</p>
                        </div>
                    </div>
                    <a href="@backUrl" class="evpay-action-btn evpay-action-btn--back">
                        <i class="fas fa-arrow-left"></i> Voltar para a partida
                    </a>
                }
                else if (payState == PayState.AwaitingPayment)
                {
                    @* ── QR Code Pix ──────────────────────────────────── *@
                    <div class="evpay-qr-section">
                        <div class="evpay-qr-image">
                            <QRCode Value="@brCode" />
                        </div>

                        <div class="evpay-awaiting">
                            <span class="evpay-awaiting-dot"></span>
                            Aguardando pagamento…
                        </div>

                        <p class="evpay-brcode">@brCode</p>

                        <button class="evpay-action-btn evpay-action-btn--copy"
                                @onclick="CopyBrCode">
                            <i class="@(copied ? "fas fa-check" : "fas fa-copy")"></i>
                            @(copied ? "Copiado!" : "Copiar código Pix")
                        </button>
                    </div>
                }
                else
                {
                    @* ── Selecionar método ────────────────────────────── *@
                    <div class="evpay-methods">
                        <h2 class="evpay-methods-title">Forma de pagamento</h2>
                        <div class="evpay-method-list">
                            <label class="evpay-method-option evpay-method-option--selected">
                                <span class="evpay-method-icon">💠</span>
                                <span class="evpay-method-name">Pix</span>
                                <span class="evpay-method-badge">1,19% · EfiBank</span>
                            </label>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(errorMsg))
                    {
                        <p class="evpay-error">@errorMsg</p>
                    }

                    @if (!EfiBankService.IsEnabled)
                    {
                        <p class="evpay-disclaimer">
                            <i class="fas fa-clock"></i>
                            Pagamento via Pix em breve. Entre em contato com o organizador.
                        </p>
                    }
                    else
                    {
                    <button class="evpay-action-btn evpay-action-btn--pay"
                            disabled="@(payState == PayState.Generating)"
                            @onclick="GeneratePixCharge">
                        @if (payState == PayState.Generating)
                        {
                            <span>Gerando QR Code…</span>
                        }
                        else
                        {
                            <i class="fas fa-qrcode"></i>
                            <span>Gerar QR Code Pix — R$ @ev.Price!.Value.ToString("N2", ptBr)</span>
                        }
                    </button>
                    }
                }
            }

        </article>
    </section>
</div>

@code {
    private enum PayState { Idle, Generating, AwaitingPayment, Paid }

    [Parameter] public int ConfirmationId { get; set; }

    private EventConfirmation? conf;
    private bool    isLoading = true;
    private string  errorMsg  = string.Empty;
    private string  userId    = string.Empty;

    private PayState payState = PayState.Idle;
    private string?  brCode;
    private bool     copied;
    private CancellationTokenSource? _pollCts;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        userId   = auth.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;

        await using var db = await DbFactory.CreateDbContextAsync();
        conf = await db.EventConfirmations
            .Include(c => c.Event).ThenInclude(e => e.Group)
            .Include(c => c.User)
            .FirstOrDefaultAsync(c => c.Id == ConfirmationId && c.UserId == userId);

        // Redirecionar se não tem preço ou é goleiro
        if (conf is not null && (conf.Event.Price is null || conf.Position == FutsalPosition.Goalkeeper))
        {
            var backUrl = conf.Event.Sport == Sport.Futsal
                ? $"/futsal/{conf.Event.Id}"
                : $"/poker/{conf.Event.Id}";
            NavigationManager.NavigateTo(backUrl);
            return;
        }

        isLoading = false;
    }

    private async Task GeneratePixCharge()
    {
        if (conf is null || conf.Event.Price is null) return;
        payState = PayState.Generating;
        errorMsg = string.Empty;

        try
        {
            var (txId, pixBrCode) = await EfiBankService
                .CreateChargeAsync(conf.Event.Price.Value, conf.Id);

            // Persist txId so the webhook can resolve the confirmation
            await using var db = await DbFactory.CreateDbContextAsync();
            var entity = await db.EventConfirmations.FindAsync(conf.Id);
            if (entity is not null)
            {
                entity.PixTxId = txId;
                await db.SaveChangesAsync();
                conf.PixTxId = txId;
            }

            brCode   = pixBrCode;
            payState = PayState.AwaitingPayment;
            _ = StartPollingAsync(txId);
        }
        catch (Exception ex)
        {
            errorMsg = $"Erro ao gerar QR Code: {ex.Message}";
            payState = PayState.Idle;
        }
    }

    private async Task StartPollingAsync(string txId)
    {
        _pollCts?.Cancel();
        _pollCts = new CancellationTokenSource();
        var ct = _pollCts.Token;

        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(5000, ct);

                // Check DB first (fastest if webhook already fired)
                await using (var db = await DbFactory.CreateDbContextAsync())
                {
                    var fresh = await db.EventConfirmations.FindAsync(conf!.Id);
                    if (fresh?.HasPaid is true)
                    {
                        conf.HasPaid = true;
                        payState = PayState.Paid;
                        await InvokeAsync(StateHasChanged);
                        return;
                    }
                }

                // Also query EfiBank API directly for faster feedback
                if (await EfiBankService.IsChargePaidAsync(txId))
                {
                    await using var db = await DbFactory.CreateDbContextAsync();
                    var entity = await db.EventConfirmations.FindAsync(conf!.Id);
                    if (entity is not null)
                    {
                        entity.HasPaid = true;
                        await db.SaveChangesAsync();
                    }
                    conf!.HasPaid = true;
                    payState = PayState.Paid;
                    await InvokeAsync(StateHasChanged);
                    return;
                }
            }
        }
        catch (TaskCanceledException) { }
    }

    private async Task CopyBrCode()
    {
        // No JS interop available without IJSRuntime injection;
        // simply set the copied flag for visual feedback.
        // The brCode is selectable via user-select:all CSS.
        copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        copied = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        _pollCts?.Cancel();
        _pollCts?.Dispose();
    }
}
