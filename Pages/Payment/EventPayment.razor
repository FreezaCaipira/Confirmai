@page "/pagamento/evento/{ConfirmationId:int}"

@attribute [Authorize]
@implements IAsyncDisposable

@using Confirmai.Enums
@using Confirmai.Configuration
@using Confirmai.Models
@using Confirmai.Pages.Payment.Components
@using Confirmai.Services.Admin
@using Confirmai.Services.Core
@using Confirmai.Services.Payment
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Globalization
@using System.Security.Claims

@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject PixProofUploadService PixProofUploadService
@inject AdminConfirmationService AdminConfirmationService
@inject UiTextService Ui
@inject ILogger<EventPayment> _logger
@inject Microsoft.Extensions.Options.IOptions<Confirmai.Configuration.FeeOptions> FeeOptions

<PageTitle>@Ui["Payment.PageTitle"] — Confirmai</PageTitle>

<div class="entity-shell">
    <section class="entity-shell-grid" aria-label="@Ui["Payment.PageTitle"]">
        <article class="entity-shell-card entity-shell-main evpay-main">

            @if (isLoading)
            {
                <p class="listing-state">@Ui["Payment.Loading"]</p>
            }
            else if (conf is null)
            {
                <div class="evpay-not-found">
                    <p>@Ui["Payment.ConfirmationNotFound"]</p>
                    <a href="/" class="detail-back-link"><i class="fas fa-arrow-left"></i> @Ui["Common.Back"]</a>
                </div>
            }
            else
            {
                var ev       = conf.Event;
                var isFutsal = ev.Sport == Sport.Futsal;
                var backUrl  = isFutsal ? $"/futsal/{ev.Id}" : $"/poker/{ev.Id}";
                var ptBr     = new CultureInfo("pt-BR");

                <EventPaymentHeader 
                    Event="@ev"
                    IsFutsal="@isFutsal"
                    BackUrl="@backUrl" />

                <EventPaymentSummary 
                    Confirmation="@conf" />

                @if (conf.PaymentStatus == EventConfirmationPaymentStatus.Paid || payState == PayState.Paid)
                {
                    @if (isAdminViewing)
                    {
                        <div class="evpay-status evpay-status--paid">
                            <i class="fas fa-check-circle"></i>
                            <div>
                                <strong>@Ui["Payment.Confirmed"]</strong>
                                <p>@string.Format(Ui["Payment.ConfirmedFor"], conf.User?.FullName ?? conf.User?.UserName ?? Ui["Payment.Player"])</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <EventPaymentStatus BackUrl="@backUrl" />
                    }
                }
                else if (isAdminViewing)
                {
                    <div class="evpay-admin-review">
                        <div class="evpay-admin-review-header">
                            <i class="fas fa-user-shield"></i>
                            <span>@string.Format(Ui["Payment.AdminReview"], conf.User?.FullName ?? conf.User?.UserName ?? Ui["Payment.Player"])</span>
                        </div>
                        @if (conf.PixProofUploadedAt.HasValue)
                        {
                            <div class="evpay-admin-proof">
                                <p class="evpay-admin-proof-label">@string.Format(Ui["Payment.ProofSentAt"], conf.PixProofUploadedAt.Value.ToLocalTime().ToString("dd/MM/yyyy 'às' HH:mm"))</p>
                                <img src="/api/pix-proof/@conf.Id" class="evpay-admin-proof-img" alt="@Ui["Payment.ProofAlt"]" />
                            </div>
                            @if (adminMarkPaidError)
                            {
                                <p class="evpay-admin-error">@Ui["Payment.ErrorConfirm"]</p>
                            }
                            @if (adminConfirmPay)
                            {
                                <div class="evpay-admin-confirm-row">
                                    <span class="evpay-admin-confirm-label">@string.Format(Ui["Payment.ConfirmPaymentFor"], conf.User?.FullName ?? conf.User?.UserName ?? Ui["Payment.Player"])</span>
                                    <div class="evpay-admin-confirm-actions">
                                        <button class="evpay-admin-confirm-btn evpay-admin-confirm-btn--yes" type="button" disabled="@adminMarkPaidLoading" @onclick="AdminMarkPaid">
                                            @if (adminMarkPaidLoading)
                                            {
                                                <i class="fas fa-spinner fa-spin"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-check"></i> <span>@Ui["Payment.YesConfirm"]</span>
                                            }
                                        </button>
                                        <button class="evpay-admin-confirm-btn evpay-admin-confirm-btn--no" type="button" @onclick="() => adminConfirmPay = false">
                                            <i class="fas fa-times"></i> <span>@Ui["Common.Cancel"]</span>
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <button class="evpay-admin-confirm-btn" type="button" @onclick="() => adminConfirmPay = true">
                                    <i class="fas fa-check"></i> <span>@Ui["Payment.ConfirmPayment"]</span>
                                </button>
                            }
                        }
                        else
                        {
                            <p class="evpay-admin-no-proof">@Ui["Payment.NoProofSent"]</p>
                            @if (adminConfirmPay)
                            {
                                <div class="evpay-admin-confirm-row">
                                    <span class="evpay-admin-confirm-label">@string.Format(Ui["Payment.MarkAsPaidFor"], conf.User?.FullName ?? conf.User?.UserName ?? Ui["Payment.Player"])</span>
                                    <div class="evpay-admin-confirm-actions">
                                        <button class="evpay-admin-confirm-btn evpay-admin-confirm-btn--yes" type="button" disabled="@adminMarkPaidLoading" @onclick="AdminMarkPaid">
                                            @if (adminMarkPaidLoading)
                                            {
                                                <i class="fas fa-spinner fa-spin"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-check"></i> <span>@Ui["Payment.YesConfirm"]</span>
                                            }
                                        </button>
                                        <button class="evpay-admin-confirm-btn evpay-admin-confirm-btn--no" type="button" @onclick="() => adminConfirmPay = false">
                                            <i class="fas fa-times"></i> <span>@Ui["Common.Cancel"]</span>
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <button class="evpay-admin-confirm-btn" type="button" @onclick="() => adminConfirmPay = true">
                                    <i class="fas fa-check"></i> <span>@Ui["Payment.MarkAsPaid"]</span>
                                </button>
                            }
                        }
                    </div>
                }
                else if (payState == PayState.AwaitingPayment)
                {
                    <EventPaymentQr 
                        BrCode="@brCode"
                        Copied="@copied"
                        OnCopyBrCode="@CopyBrCodeCallback" />
                }
                else
                {
                    @if (ShouldShowGateways)
                    {
                        <EventPaymentGateways
                            AvailableGateways="@availableGateways"
                            ComingSoonGateways="@GetComingSoonGateways()"
                            SelectedGatewayName="@selectedGatewayName"
                            GroupGatewaysEnabled="@groupGatewaysEnabled"
                            IsGenerating="@(payState == PayState.Generating)"
                            ErrorMsg="@errorMsg"
                            Price="@(ev.Price!.Value)"
                            SelectedGatewayDisplayName="@GetSelectedGatewayDisplayName()"
                            OnSelectGateway="@SelectGatewayCallback"
                            OnGenerateCharge="@GeneratePixChargeCallback" />
                    }

                    @if (ShouldShowManualPix)
                    {
                        <EventPaymentPixAdmin
                            GroupAdminPixKey="@GetGroupAdminPixKey(ev.Group)"
                            GroupName="@ev.Group.Name"
                            GroupCity="@ev.Group.City"
                            Price="@(ev.Price!.Value)"
                            CopiedAdminPix="@copiedAdminPix"
                            PixQrPayload="@BuildPixStaticPayload(GetGroupAdminPixKey(ev.Group) ?? "", ev.Group.Name, ev.Group.City, ev.Price!.Value)"
                            OnCopyAdminPixKey="@CopyAdminPixKeyCallback" />

                        <EventPaymentProof
                            Confirmation="@conf"
                            UploadingProof="@uploadingProof"
                            ProofError="@proofError"
                            ProofSuccessMessage="@proofSuccessMessage"
                            OnProofUpload="@UploadProofCallback" />
                    }
                }
            }

        </article>
    </section>
</div>

