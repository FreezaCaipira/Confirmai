@page "/pagamento/evento/{ConfirmationId:int}"

@attribute [Authorize]
@implements IAsyncDisposable

@using Confirmai.Data
@using Confirmai.Enums
@using Confirmai.Models
@using Confirmai.Pages.Payment.Components
@using Confirmai.Services.Admin
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@using System.Security.Claims

@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject EventPaymentGatewayFactory EventGatewayFactory
@inject PixProofUploadService PixProofUploadService
@inject AdminConfirmationService AdminConfirmationService
@inject ILogger<EventPayment> _logger

<PageTitle>Pagamento — Confirmai</PageTitle>

<div class="entity-shell">
    <section class="entity-shell-grid" aria-label="Pagamento de partida">
        <article class="entity-shell-card entity-shell-main evpay-main">

            @if (isLoading)
            {
                <p class="listing-state">Carregando…</p>
            }
            else if (conf is null)
            {
                <div class="evpay-not-found">
                    <p>Confirmação não encontrada.</p>
                    <a href="/" class="detail-back-link"><i class="fas fa-arrow-left"></i> Voltar</a>
                </div>
            }
            else
            {
                var ev       = conf.Event;
                var isFutsal = ev.Sport == Sport.Futsal;
                var backUrl  = isFutsal ? $"/futsal/{ev.Id}" : $"/poker/{ev.Id}";
                var ptBr     = new CultureInfo("pt-BR");

                <EventPaymentHeader 
                    Event="@ev"
                    IsFutsal="@isFutsal"
                    BackUrl="@backUrl" />

                <EventPaymentSummary 
                    Confirmation="@conf" />

                @if (conf.PaymentStatus == EventConfirmationPaymentStatus.Paid || payState == PayState.Paid)
                {
                    @if (isAdminViewing)
                    {
                        <div class="evpay-status evpay-status--paid">
                            <i class="fas fa-check-circle"></i>
                            <div>
                                <strong>Pagamento confirmado</strong>
                                <p>Pagamento de @conf.User?.FullName foi confirmado.</p>
                            </div>
                        </div>
                        <a href="@backUrl" class="evpay-action-btn evpay-action-btn--back">
                            <i class="fas fa-arrow-left"></i> Voltar para a partida
                        </a>
                    }
                    else
                    {
                        <EventPaymentStatus BackUrl="@backUrl" />
                    }
                }
                else if (isAdminViewing)
                {
                    <div class="evpay-admin-review">
                        <div class="evpay-admin-review-header">
                            <i class="fas fa-user-shield"></i>
                            <span>Revisão de pagamento — @conf.User?.FullName</span>
                        </div>
                        @if (conf.PixProofUploadedAt.HasValue)
                        {
                            <div class="evpay-admin-proof">
                                <p class="evpay-admin-proof-label">Comprovante enviado em @conf.PixProofUploadedAt.Value.ToLocalTime().ToString("dd/MM/yyyy 'às' HH:mm")</p>
                                <img src="/api/pix-proof/@conf.Id" class="evpay-admin-proof-img" alt="Comprovante Pix" />
                            </div>
                            @if (adminMarkPaidError)
                            {
                                <p class="evpay-admin-error">Erro ao confirmar pagamento. Tente novamente.</p>
                            }
                            @if (adminConfirmPay)
                            {
                                <div class="evpay-admin-confirm-row">
                                    <span class="evpay-admin-confirm-label">Confirmar pagamento de @conf.User?.FullName?</span>
                                    <div class="evpay-admin-confirm-actions">
                                        <button class="evpay-admin-confirm-btn evpay-admin-confirm-btn--yes" type="button" disabled="@adminMarkPaidLoading" @onclick="AdminMarkPaid">
                                            @if (adminMarkPaidLoading)
                                            {
                                                <i class="fas fa-spinner fa-spin"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-check"></i> <span>Sim, confirmar</span>
                                            }
                                        </button>
                                        <button class="evpay-admin-confirm-btn evpay-admin-confirm-btn--no" type="button" @onclick="() => adminConfirmPay = false">
                                            <i class="fas fa-times"></i> <span>Cancelar</span>
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <button class="evpay-admin-confirm-btn" type="button" @onclick="() => adminConfirmPay = true">
                                    <i class="fas fa-check"></i> <span>Confirmar pagamento</span>
                                </button>
                            }
                        }
                        else
                        {
                            <p class="evpay-admin-no-proof">O jogador ainda não enviou comprovante.</p>
                            @if (adminConfirmPay)
                            {
                                <div class="evpay-admin-confirm-row">
                                    <span class="evpay-admin-confirm-label">Marcar @conf.User?.FullName como pago?</span>
                                    <div class="evpay-admin-confirm-actions">
                                        <button class="evpay-admin-confirm-btn evpay-admin-confirm-btn--yes" type="button" disabled="@adminMarkPaidLoading" @onclick="AdminMarkPaid">
                                            @if (adminMarkPaidLoading)
                                            {
                                                <i class="fas fa-spinner fa-spin"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-check"></i> <span>Sim, confirmar</span>
                                            }
                                        </button>
                                        <button class="evpay-admin-confirm-btn evpay-admin-confirm-btn--no" type="button" @onclick="() => adminConfirmPay = false">
                                            <i class="fas fa-times"></i> <span>Cancelar</span>
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <button class="evpay-admin-confirm-btn" type="button" @onclick="() => adminConfirmPay = true">
                                    <i class="fas fa-check"></i> <span>Marcar como pago</span>
                                </button>
                            }
                        }
                        <a href="@backUrl" class="detail-back-link"><i class="fas fa-arrow-left"></i> Voltar para a partida</a>
                    </div>
                }
                else if (payState == PayState.AwaitingPayment)
                {
                    <EventPaymentQr 
                        BrCode="@brCode"
                        Copied="@copied"
                        OnCopyBrCode="@CopyBrCodeCallback" />
                }
                else
                {
                    <EventPaymentGateways
                        AvailableGateways="@availableGateways"
                        ComingSoonGateways="@GetComingSoonGateways()"
                        SelectedGatewayName="@selectedGatewayName"
                        GroupGatewaysEnabled="@groupGatewaysEnabled"
                        IsGenerating="@(payState == PayState.Generating)"
                        ErrorMsg="@errorMsg"
                        Price="@(ev.Price!.Value)"
                        SelectedGatewayDisplayName="@GetSelectedGatewayDisplayName()"
                        OnSelectGateway="@SelectGatewayCallback"
                        OnGenerateCharge="@GeneratePixChargeCallback" />

                    <EventPaymentPixAdmin
                        GroupAdminPixKey="@GetGroupAdminPixKey(ev.Group)"
                        GroupName="@ev.Group.Name"
                        GroupCity="@ev.Group.City"
                        Price="@(ev.Price!.Value)"
                        CopiedAdminPix="@copiedAdminPix"
                        PixQrPayload="@BuildPixStaticPayload(GetGroupAdminPixKey(ev.Group)!, ev.Group.Name, ev.Group.City, ev.Price!.Value)"
                        OnCopyAdminPixKey="@CopyAdminPixKeyCallback" />

                    <EventPaymentProof
                        Confirmation="@conf"
                        UploadingProof="@uploadingProof"
                        ProofError="@proofError"
                        ProofSuccessMessage="@proofSuccessMessage"
                        OnProofUpload="@UploadProofCallback" />
                }
            }

        </article>
    </section>
</div>

