@page "/marketplace/buy/{ProductId:int}"

@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Confirmai.Shared
@using Confirmai.Models
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.JSInterop
@using System.Globalization
@using Confirmai.Pages.Payment
@using Microsoft.Extensions.Options
@using Confirmai.Configuration
@using System.Text

@inject BitcoinPaymentFactory PaymentFactory
@inject AuthenticationStateProvider AuthProvider
@inject LogService LogService
@inject NavigationManager NavigationManager
@inject GatewayService GatewayService
@inject PaymentConfirmationService PaymentConfirmationService
@inject BitcoinQuoteService BitcoinQuoteService
@inject CurrencyPreferenceService CurrencyPreferenceService
@inject LanguagePreferenceService LanguagePreferenceService
@inject AdminSettingsService AdminSettingsService
@inject UiTextService T
@inject IJSRuntime JS
@inject PaymentEventBus PaymentEventBus
@inject IOptions<AbacatePayOptions> AbacatePayOpts

<div class="entity-shell payment-container parchment-b tibia-pay-shell">

    <section class="entity-shell-grid" aria-label="@T["PaymentBuy.Title"]">
        <article class="entity-shell-card entity-shell-main">
            @if (product == null)
            {
                <p>@T["PaymentBuy.LoadingProduct"]</p>
            }
            else
            {
                <div class="tibia-pay-grid">
                <PaymentProductSummary
                    Product="@product"
                    SellerUser="@sellerUser"
                    SelectedQuantity="@selectedPurchaseQuantity"
                    UnitPrice="@GetUnitPriceAmount()"
                    TotalAmount="@Amount"
                    Currency="@offerCurrency"
                    BtcUsdRate="@btcUsdRate"
                    BtcBrlRate="@btcBrlRate" />

                <PaymentCheckoutPanel
                    Address="@Address"
                    IsPaid="@IsPaid"
                    ActiveGateways="@ActiveGateways"
                    SelectedMethod="@SelectedMethod"
                    UseSiteIntermediary="@UseSiteIntermediary"
                    QRCodeValue="@QRCodeValue"
                    PixCurrencyNotice="@pixCurrencyNotice"
                    PixSellerKeyNotice="@pixSellerKeyNotice"
                    FeedbackMessage="@feedbackMessage"
                    FeedbackType="@feedbackType"
                    IsLoading="@isLoading"
                    IsPixCurrentPayment="@IsPixCurrentPayment"
                    CopyIcon="@copyIcon"
                    AbacatePayIsEnabled="@AbacatePayOpts.Value.IsEnabled"
                    ShowPrivateKey="@ShowPrivateKeyValue"
                    PrivateKey="@paymentRecord?.PrivateKey"
                    OnGeneratePayment="@GenerateAddressCallback"
                    OnCheckPayment="@CheckPaymentCallback"
                    OnMethodChanged="@MethodChangedCallback"
                    OnIntermediaryChanged="@IntermediaryChangedCallback"
                    OnCopyAddress="@CopyAddressCallback" />
                </div>
            }

            @if (isLoading)
            {
                <div class="loading-spinner">
                    <span class="oi oi-reload spinning"></span> @T["PaymentBuy.Processing"]
                </div>
            }
        </article>
    </section>
</div>
