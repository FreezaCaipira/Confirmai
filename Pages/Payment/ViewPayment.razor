@page "/payments/view/{PaymentId:int}"

@attribute [Authorize]

@using Confirmai.Shared
@using Confirmai.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore


<div class="entity-shell payment-container parchment-b view-pay-shell">

    <section class="entity-shell-grid" aria-label="@T["PaymentView.Aria"]">
        <article class="entity-shell-card entity-shell-main">
            @if (payment == null)
            {
                <div class="alert alert-warning">@T["PaymentView.NotFound"]</div>
            }
            else
            {
                <div class="view-pay-grid">
                    <section class="view-pay-card view-pay-card-invoice">
                        <div class="view-pay-card-head">
                            <h2>@AddressLabel</h2>
                        </div>
                        <div class="view-pay-card-body">
                            @if (payment.PaymentMethod == "BTCPayServer" && payment.Address.StartsWith("http"))
                            {
                                <div class="view-pay-field">
                                    <div class="view-pay-label">@T["PaymentView.Checkout"]</div>
                                    <a href="@payment.Address" target="_blank" rel="noopener noreferrer" class="view-pay-btn">
                                        @string.Format(T["PaymentView.OpenCheckout"], payment.PaymentMethod)
                                    </a>
                                    <div class="view-pay-hint">@string.Format(T["PaymentView.QrHint"], payment.PaymentMethod)</div>
                                </div>
                            }
                            else
                            {
                                @if (!payment.IsPaid && !IsPixPayment)
                                {
                                    <div class="view-pay-action-row">
                                        <button type="button" class="view-pay-btn" @onclick="OnCheckPaymentClick" disabled="@isCheckingPayment">
                                            @if (isCheckingPayment)
                                            {
                                                <span class="oi oi-reload spinning" aria-hidden="true"></span>
                                                <span>@T["PaymentView.Rechecking"]</span>
                                            }
                                            else
                                            {
                                                <span>@T["PaymentBuy.Check"]</span>
                                            }
                                        </button>
                                    </div>
                                }
                                <div class="view-pay-qrcode">
                                    <QRCode Value="@QRCodeValue" />
                                </div>

                                @if (isCheckingPayment)
                                {
                                    <div class="view-pay-checking" role="status" aria-live="polite">
                                        @T["PaymentView.CheckingGateways"]
                                    </div>
                                }
                            }

                            @if (!string.IsNullOrWhiteSpace(feedbackMessage))
                            {
                                <div class="payment-inline-feedback payment-inline-feedback-@feedbackType" role="status" aria-live="polite">
                                    @feedbackMessage
                                </div>
                            }
                        </div>
                    </section>

                    <section class="view-pay-card view-pay-card-meta">
                        <div class="view-pay-card-head view-pay-card-head-meta">
                            <h2>@T["PaymentView.Title"]</h2>
                        </div>
                        <div class="view-pay-card-body">
                            <div class="view-pay-row">
                                <span class="view-pay-label">@T["PaymentDetails.PaymentId"]</span>
                                <span class="view-pay-value view-pay-value-id">@(string.IsNullOrWhiteSpace(payment.PaymentId) ? "-" : payment.PaymentId)</span>
                            </div>
                            @{
                                var sellerUser = payment.Seller
                                    ?? payment.Product?.User;
                                var sellerName = sellerUser?.UserName;
                            }
                            @if (payment.User != null)
                            {
                                <div class="view-pay-row">
                                    <span class="view-pay-label">@T["Common.Buyer"]</span>
                                    <span class="view-pay-value"><a href="/profile/@payment.User.Id">@payment.User.UserName</a></span>
                                </div>
                            }
                            @if (sellerUser != null)
                            {
                                <div class="view-pay-row">
                                    <span class="view-pay-label">@T["Common.Seller"]</span>
                                    <span class="view-pay-value"><a href="/profile/@sellerUser.Id">@sellerName</a></span>
                                </div>
                            }
                            <div class="view-pay-row">
                                <span class="view-pay-label">@T["Common.Gateway"]</span>
                                <span class="view-pay-value">@(string.IsNullOrWhiteSpace(payment.PaymentMethod) ? "-" : payment.PaymentMethod)</span>
                            </div>
                            <div class="view-pay-row">
                                <span class="view-pay-label">@T["Common.Date"]</span>
                                <span class="view-pay-value">@payment.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            <div class="view-pay-row">
                                <span class="view-pay-label">@T["Common.Status"]</span>
                                <span class="view-pay-value">
                                    <span class="view-pay-status @(payment.IsPaid ? "paid" : "pending")">
                                        @(payment.IsPaid ? T["Common.Paid"] : T["Common.Pending"])
                                    </span>
                                </span>
                            </div>
                            <div class="view-pay-row">
                                <span class="view-pay-label">@T["Common.Address"]</span>
                                <span class="view-pay-value view-pay-value-address">@payment.Address</span>
                            </div>
                            <div class="view-pay-row">
                                <span class="view-pay-label">@T["Common.Value"]</span>
                                <span class="view-pay-value view-pay-value-amount">@FormatPaymentAmount(payment.Amount, payment.Currency)</span>
                            </div>
                            @if (payment.PaidAt != null)
                            {
                                <div class="view-pay-row">
                                    <span class="view-pay-label">@T["PaymentDetails.PaidAt"]</span>
                                    <span class="view-pay-value">@payment.PaidAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                            }

                        </div>
                    </section>
                </div>
            }

            @if (isLoading)
            {
                <div class="loading-spinner">
                    <span class="oi oi-reload spinning"></span> @T["Common.Loading"]
                </div>
            }
        </article>
    </section>
</div>
