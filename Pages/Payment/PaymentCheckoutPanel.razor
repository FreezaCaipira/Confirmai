@using Confirmai.Shared
@using Microsoft.AspNetCore.Components

<section class="tibia-pay-card tibia-pay-card-checkout">
    <div class="tibia-pay-card-head">
        <h2>@T["PaymentBuy.GeneratePayment"]</h2>
    </div>
    <div class="tibia-pay-card-body">
        @if (!ActiveGateways.Any())
        {
            <div class="no-gateways">
                <b>@T["PaymentBuy.NoMethod"]</b>
                <div class="no-gateways-hint">
                    @T["PaymentBuy.NoMethodHint"]
                </div>
            </div>
        }
        else if (string.IsNullOrEmpty(Address))
        {
            <div class="tibia-pay-form-grid">
                <div class="tibia-pay-switch-block">
                    <label class="tibia-pay-switch" for="use-intermediary">
                        <input id="use-intermediary" type="checkbox" @bind="UseSiteIntermediary" @bind:after="HandleIntermediaryChanged" />
                        <span class="tibia-pay-switch-lever" aria-hidden="true"></span>
                        <span class="tibia-pay-switch-text">
                            @(UseSiteIntermediary
                                ? T["PaymentBuy.WithIntermediary"]
                                : T["PaymentBuy.WithoutIntermediary"])
                        </span>
                    </label>
                </div>
                @if (!UseSiteIntermediary)
                {
                    <div class="tibia-pay-no-intermediary-warning">
                        <i class="fas fa-exclamation-triangle"></i>
                        <span>@((MarkupString)T["PaymentBuy.NoIntermediaryWarning"])</span>
                    </div>
                }

                <div class="tibia-pay-field">
                    <label class="tibia-pay-label" for="payment-method">@T["PaymentBuy.PaymentMethod"]</label>
                    <select id="payment-method" class="tibia-pay-select" @bind="SelectedMethod" @bind:after="HandleMethodChanged" aria-label="@T["PaymentBuy.SelectGateway"]">
                        @foreach (var gateway in ActiveGateways)
                        {
                            <option value="@gateway.Name">@gateway.Name</option>
                        }
                    </select>
                </div>

                @if (!string.IsNullOrWhiteSpace(PixCurrencyNotice))
                {
                    <div class="payment-inline-feedback payment-inline-feedback-warning" role="status" aria-live="polite">
                        @PixCurrencyNotice
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(PixSellerKeyNotice))
                {
                    <div class="payment-inline-feedback payment-inline-feedback-warning" role="status" aria-live="polite">
                        @PixSellerKeyNotice
                    </div>
                }

                <div class="tibia-pay-action-wrap">
                    <button class="tibia-pay-btn" @onclick="HandleGeneratePayment" aria-label="@T["PaymentBuy.GenerateAddress"]">
                        @T["PaymentBuy.GenerateAddress"]
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="tibia-pay-status-block">
                <div class="tibia-pay-label">@(IsPixCurrentPayment ? T["PaymentBuy.PixCodeLabel"] : T["PaymentBuy.InvoiceAddress"])</div>
                <div class="tibia-pay-address-wrap">
                    <div class="tibia-pay-address">@Address</div>
                    <button class="tibia-pay-copy-btn" @onclick="HandleCopyAddress" title="@T["PaymentBuy.Copy"]" aria-label="@T["PaymentBuy.CopyCode"]">
                        <i class="@CopyIcon"></i>
                    </button>
                </div>
            </div>
            <div class="tibia-pay-qrcode">
                <QRCode Value="@QRCodeValue" />
            </div>

            <div class="tibia-pay-status-block tibia-pay-status-main">
                <div class="tibia-pay-label">@T["Common.Status"]</div>
                <div class="tibia-pay-status-row">
                    @if (IsPaid)
                    {
                        <span class="tibia-pay-pill tibia-pay-pill-ok">@T["PaymentBuy.PaidReceived"]</span>
                    }
                    else
                    {
                        <div class="tibia-pay-waiting-message" role="status" aria-live="polite">
                            <span class="tibia-pay-waiting-title">@(IsPixCurrentPayment && !AbacatePayIsEnabled ? T["PaymentBuy.WaitingManualPix"] : T["PaymentBuy.Waiting"])</span>
                        </div>
                        @if (!IsPixCurrentPayment || AbacatePayIsEnabled)
                        {
                            <button type="button" class="tibia-pay-btn" @onclick="HandleCheckPayment" aria-label="@T["PaymentBuy.Check"]">
                                @T["PaymentBuy.Check"]
                            </button>
                        }
                    }
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(FeedbackMessage))
            {
                <div class="payment-inline-feedback payment-inline-feedback-@FeedbackType" role="status" aria-live="polite">
                    @FeedbackMessage
                </div>
            }

            @if (ShowPrivateKey && !string.IsNullOrEmpty(PrivateKey))
            {
                <div class="tibia-pay-private-key">
                    <div class="tibia-pay-label">
                        <i class="fas fa-key"></i>
                        @T["PaymentBuy.PrivateKey"]
                    </div>
                    <div class="tibia-pay-private-key-value">
                        <code>@PrivateKey</code>
                    </div>
                    <div class="no-gateways-hint">
                        <i class="fas fa-exclamation-triangle"></i>
                        @T["PaymentBuy.PrivateKeyWarning"]
                    </div>
                </div>
            }
        }
    </div>
</section>
