@page "/payments"

@attribute [Authorize]

@using Confirmai.Data
@using Confirmai.Models
@using Confirmai.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop

@implements IAsyncDisposable

@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@inject LogService LogService
@inject IJSRuntime JS
@inject BitcoinQuoteService BitcoinQuoteService
@inject CurrencyPreferenceService CurrencyPreferenceService
@inject UiTextService T
@inject PaymentEventBus PaymentEventBus

<div id="payments-history-page" class="payments-history-shell payments-history-shell--bg @(activeTab == "sent" ? "payments-history-shell--sent" : "payments-history-shell--received")">
    <section class="entity-shell-grid" aria-label="@T["PaymentHistory.Aria"]">
        <article class="entity-shell-card entity-shell-main">
            <h1 class="page-section-title">@T["PaymentHistory.Title"]</h1>
            <div class="filter-bar admin-filter-card payments-filter-card">
                <input type="number" placeholder="@T["PaymentHistory.Filter.MinValue"]" @bind="filterMinAmount" min="0" />
                <input type="number" placeholder="@T["PaymentHistory.Filter.MaxValue"]" @bind="filterMaxAmount" min="0" />
                <select @bind="filterStatus">
                    <option value="">@T["PaymentHistory.Filter.AllStatus"]</option>
                    <option value="paid">@T["Common.Paid"]</option>
                    <option value="pending">@T["Common.Pending"]</option>
                </select>
                <input type="text" placeholder="@T["PaymentHistory.Filter.Gateway"]" @bind="filterGateway" @bind:event="oninput" />
                <input type="date" @bind="filterDate" />
                <button @onclick="ApplyFilters">@T["Common.Filter"]</button>
                <button @onclick="ClearFilters">@T["Common.Clear"]</button>
                <div class="export-actions">
                    <button class="export-btn" @onclick="ExportToCsv" title="Exportar CSV">
                        <i class="fas fa-file-csv"></i> CSV
                    </button>
                    <button class="export-btn" @onclick="ExportToPdf" title="Exportar PDF">
                        <i class="fas fa-file-pdf"></i> PDF
                    </button>
                </div>
            </div>

            <div class="payments-tab-bar">
                <button class="payments-tab-btn @(activeTab == "sent" ? "active" : "")" @onclick='() => SwitchTab("sent")'>
                    <i class="fas fa-paper-plane"></i>
                    <span class="payments-tab-label">@T["PaymentHistory.TabSent"]</span>
                    @if (payments?.Count > 0)
                    {
                        <span class="payments-tab-count">@payments.Count</span>
                    }
                </button>
                <button class="payments-tab-btn @(activeTab == "received" ? "active" : "")" @onclick='() => SwitchTab("received")'>
                    <i class="fas fa-inbox"></i>
                    <span class="payments-tab-label">@T["PaymentHistory.TabReceived"]</span>
                    @if (receivedPayments?.Count > 0)
                    {
                        <span class="payments-tab-count">@receivedPayments.Count</span>
                    }
                </button>
            </div>

            <AdminDataState IsLoading="@(filteredPayments == null)" IsEmpty="@(filteredPayments != null && !filteredPayments.Any())" LoadingText="@T["Common.Loading"]" EmptyText="@T["PaymentHistory.Empty"]" EmptyIcon="fas fa-money-bill-wave" EmptyHint="@T["PaymentHistory.EmptyHint"]">
                <div class="payments-table-wrap">
                <table class="product-table payments-history-table">
        <thead>
            <tr>
                <th>@T["Common.Date"]</th>
                <th>@T["PaymentHistory.Product"]</th>
                @if (activeTab == "received")
                {
                    <th>@T["PaymentHistory.Buyer"]</th>
                }
                <th>@T["Common.Value"]</th>
                <th>@T["Common.Status"]</th>
                <th>@T["Common.Gateway"]</th>
                <th>@T["Common.Actions"]</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var p in filteredPayments?.Skip((currentPage - 1) * pageSize).Take(pageSize) ?? Enumerable.Empty<PaymentRecord>())
        {
            <tr class="@(activeTab == "received" ? (p.IsPaid ? "tr--paid" : "tr--pending") : "")">
                <td data-label="@T["Common.Date"]" class="td--date">@p.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                <td data-label="@T["PaymentHistory.Product"]">@GetProductDisplayName(p)</td>
                @if (activeTab == "received")
                {
                    <td data-label="@T["PaymentHistory.Buyer"]">@(p.User?.UserName ?? "-")</td>
                }
                <td data-label="@T["Common.Value"]">@FormatPaymentAmount(p.Amount, p.Currency)</td>
                <td data-label="@T["Common.Status"]">
                    @if (p.IsPaid)
                    {
                        <span class="order-status-badge pago">@T["Common.Paid"]</span>
                    }
                    else
                    {
                        <span class="order-status-badge aguardandopagamento">@T["Common.Pending"]</span>
                    }
                </td>
                <td data-label="@T["Common.Gateway"]">@p.PaymentMethod</td>
                <td data-label="@T["Common.Actions"]">
                    @if (activeTab == "sent")
                    {
                        @if (!p.IsPaid)
                        {
                            <button class="edit-btn action-btn icon-only" @onclick='() => Navigation.NavigateTo($"/payments/view/{p.Id}")' title="@T["Common.View"]" aria-label="@T["Common.View"]">
                                <i class="fas fa-eye"></i>
                            </button>
                            <button class="danger action-btn icon-only" @onclick='() => ConfirmCancelPayment(p.Id)' title="@T["Common.Cancel"]" aria-label="@T["Common.Cancel"]">
                                <i class="fas fa-times"></i>
                            </button>
                        }
                        else
                        {
                            <button class="details-btn action-btn icon-only" @onclick='() => Navigation.NavigateTo($"/payments/view/{p.Id}")' title="@T["Common.Details"]" aria-label="@T["Common.Details"]">
                                <i class="fas fa-eye"></i>
                            </button>
                        }
                    }
                    else
                    {
                        <button class="details-btn action-btn icon-only" @onclick='() => Navigation.NavigateTo($"/payments/view/{p.Id}")' title="@T["Common.Details"]" aria-label="@T["Common.Details"]">
                            <i class="fas fa-eye"></i>
                        </button>
                    }
                </td>
            </tr>
        }
        </tbody>
                </table>
            </div>

                <div class="pagination payments-history-pagination">
                    <button type="button" @onclick="@(() => PrevPage())" disabled="@(!CanGoToPreviousPage)">@T["Common.Previous"]</button>
                    <span class="pagination-info">@T["Common.Page"] @currentPage @T["Common.Of"] @totalPages</span>
                    <button type="button" @onclick="@(() => NextPage())" disabled="@(!CanGoToNextPage)">@T["Common.Next"]</button>
                </div>
            </AdminDataState>
        </article>
    </section>
</div>

