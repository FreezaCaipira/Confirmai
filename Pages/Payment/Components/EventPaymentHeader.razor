@using Confirmai.Enums
@using Confirmai.Models
@using Confirmai.Services.Core

@inject UiTextService Ui

<div class="evpay-header">
    <div class="evpay-header-top">
        <a href="@BackUrl" class="detail-back-link">
            <i class="fas fa-arrow-left"></i> @Ui["Common.Back"]
        </a>
    </div>
    <div class="evpay-header-badge">
        <span class="detail-sport-badge">@(IsFutsal ? "⚽ Futsal" : "🃏 Poker")</span>
    </div>
    <h1 class="evpay-title">@Event!.Group.Name</h1>
    <p class="evpay-meta">
        <i class="fas fa-calendar-alt"></i>
        @Ui.FormatDateTime(Event.StartsAt.ToLocalTime(), "DateTimeFullLong")
    </p>
    @if (!string.IsNullOrWhiteSpace(Event.Location))
    {
        <p class="evpay-meta"><i class="fas fa-map-marker-alt"></i> @Event.Location</p>
    }
</div>
