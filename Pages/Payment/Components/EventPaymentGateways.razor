@using Confirmai.Models
@using Confirmai.Configuration
@using Confirmai.Services.Core
@using System.Globalization
@using Microsoft.Extensions.Options
@inject UiTextService Ui

@if (GroupGatewaysEnabled)
{
    <div class="evpay-methods">
        <h2 class="evpay-methods-title">Forma de pagamento</h2>
        <div class="evpay-method-list">
            @foreach (var gateway in AvailableGateways)
            {
                var isSelected = string.Equals(SelectedGatewayName, gateway.Name, StringComparison.OrdinalIgnoreCase);
                <button type="button"
                        class="evpay-method-option @(isSelected ? "evpay-method-option--selected" : string.Empty)"
                        @onclick="() => HandleSelectGateway(gateway.Name)">
                    <span class="evpay-method-icon">💠</span>
                    <span class="evpay-method-name">@gateway.DisplayName</span>
                    <span class="evpay-method-badge">@gateway.Name</span>
                </button>
            }

            @foreach (var gateway in ComingSoonGateways)
            {
                <button type="button"
                        class="evpay-method-option evpay-method-option--disabled"
                        disabled
                        aria-disabled="true"
                        title="Integração em breve">
                    <span class="evpay-method-icon">🧾</span>
                    <span class="evpay-method-name">@gateway.DisplayName</span>
                    <span class="evpay-method-badge evpay-method-badge--soon">em breve</span>
                </button>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMsg))
    {
        <p class="evpay-error">@ErrorMsg</p>
    }

    @if (!AvailableGateways.Any())
    {
        <p class="evpay-disclaimer">
            <i class="fas fa-clock"></i>
            Nenhum gateway de pagamento está disponível no momento.
        </p>
    }
    else
    {
        @if (FeeOptions.Value.IsConfigured && SelectedGatewaySupportsFee)
        {
            <div class="evpay-fee-breakdown">
                <div class="evpay-fee-row">
                    <span class="evpay-fee-label">Valor da partida:</span>
                    <span class="evpay-fee-value">R$ @Price.ToString("N2", PtBr)</span>
                </div>
                <div class="evpay-fee-row">
                    <span class="evpay-fee-label">Taxa do app:</span>
                    <span class="evpay-fee-value">R$ @AppFeeAmount.ToString("N2", PtBr)</span>
                </div>
                <div class="evpay-fee-row">
                    <span class="evpay-fee-label">Taxa do gateway:</span>
                    <span class="evpay-fee-value">R$ @GatewayFeeAmount.ToString("N2", PtBr)</span>
                </div>
                <div class="evpay-fee-row evpay-fee-row--total">
                    <span class="evpay-fee-label">Total a pagar:</span>
                    <span class="evpay-fee-value">R$ @TotalAmount.ToString("N2", PtBr)</span>
                </div>
            </div>
        }

        <button class="evpay-action-btn evpay-action-btn--pay"
                disabled="@(IsGenerating)"
                @onclick="HandleGenerateCharge">
            @if (IsGenerating)
            {
                <span>Gerando QR Code…</span>
            }
            else
            {
                <i class="fas fa-qrcode"></i>
                <span>Gerar QR Code (@SelectedGatewayDisplayName) — R$ @TotalAmount.ToString("N2", PtBr)</span>
            }
        </button>
    }
}
else
{
    <p class="evpay-disclaimer">
        <i class="fas fa-info-circle"></i>
        @Ui["Payment.ManualFlow"]
    </p>
}
