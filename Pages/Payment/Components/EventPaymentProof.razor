@using Confirmai.Models
@using Confirmai.Services.Core

@inject UiTextService Ui

<div class="evpay-proof">
    <div class="evpay-proof-header">
        <i class="fas fa-camera"></i>
        <span>@Ui["Payment.ProofTitle"]</span>
    </div>
    @if (Confirmation?.PixProofUploadedAt.HasValue ?? false)
    {
        <div class="evpay-proof-sent">
            <i class="fas fa-check-circle evpay-proof-sent-icon"></i>
            <span>@string.Format(Ui["Payment.ProofSentAtShort"], Ui.FormatDateTime(Confirmation.PixProofUploadedAt.Value.ToLocalTime(), "DateTimeFull"))</span>
        </div>
        <img src="/api/pix-proof/@Confirmation.Id" class="evpay-proof-thumb" alt="@Ui["Payment.ProofAlt"]" />
        <label class="evpay-proof-btn evpay-proof-btn--update">
            @if (UploadingProof)
            {
                <i class="fas fa-spinner fa-spin"></i> <span>@Ui["Payment.Sending"]</span>
            }
            else
            {
                <i class="fas fa-sync-alt"></i> <span>@Ui["Payment.UpdateProof"]</span>
            }
            <InputFile OnChange="HandleProofUpload" accept="image/jpeg,image/png,image/webp" class="evpay-proof-input-hidden" disabled="@UploadingProof" />
        </label>
    }
    else
    {
        <p class="evpay-proof-hint">
            @Ui["Payment.ProofHint"]
        </p>
        <label class="evpay-proof-btn">
            @if (UploadingProof)
            {
                <i class="fas fa-spinner fa-spin"></i> <span>@Ui["Payment.Sending"]</span>
            }
            else
            {
                <i class="fas fa-upload"></i> <span>@Ui["Payment.SendProof"]</span>
            }
            <InputFile OnChange="HandleProofUpload" accept="image/jpeg,image/png,image/webp" class="evpay-proof-input-hidden" disabled="@UploadingProof" />
        </label>
    }
    @if (!string.IsNullOrWhiteSpace(ProofError))
    {
        <p class="evpay-proof-error">@ProofError</p>
    }
    @if (!string.IsNullOrWhiteSpace(ProofSuccessMessage))
    {
        <p class="evpay-proof-success evpay-proof-success--fadeout">
            <i class="fas fa-check-circle"></i> @ProofSuccessMessage
        </p>
    }
</div>
