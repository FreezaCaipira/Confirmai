@using Confirmai.Enums
@using Confirmai.Models
@using Confirmai.Configuration
@using Confirmai.Services.Core
@using System.Globalization
@using Microsoft.Extensions.Options

@inject UiTextService Ui

<div class="evpay-summary-card">
    <div class="evpay-summary-row">
        <span class="evpay-summary-label">@Ui["Payment.SummaryPlayer"]</span>
        <span class="evpay-summary-value">@(Confirmation?.User?.FullName ?? Confirmation?.User?.UserName ?? "—")</span>
    </div>
    <div class="evpay-summary-row">
        <span class="evpay-summary-label">@Ui["Payment.SummaryPosition"]</span>
        <span class="evpay-summary-value">
            @if (Confirmation?.Position == FutsalPosition.Goalkeeper)
            {
                <span><i class="fas fa-hand-paper"></i> @Ui["Payment.SummaryGoalkeeper"]</span>
            }
            else
            {
                <span>⚽ @Ui["Payment.SummaryOutfield"]</span>
            }
        </span>
    </div>
    <div class="evpay-summary-divider"></div>
    @if (ShowFeeBreakdown)
    {
        <div class="evpay-summary-row">
            <span class="evpay-summary-label">@Ui["Payment.SummaryMatchPrice"]</span>
            <span class="evpay-summary-value">R$ @BasePrice.ToString("N2", PtBr)</span>
        </div>
        <div class="evpay-summary-row">
            <span class="evpay-summary-label">@Ui["Payment.SummaryPlatformFee"]</span>
            <span class="evpay-summary-value">R$ @ManualFee.ToString("N2", PtBr)</span>
        </div>
    }
    <div class="evpay-summary-row evpay-summary-row--total">
        <span class="evpay-summary-label">@Ui["Payment.SummaryAmount"]</span>
        <span class="evpay-summary-amount">R$ @GetTotalAmount().ToString("N2", PtBr)</span>
    </div>
</div>
