@using System.Globalization
@using Confirmai.Services.Core

@inject UiTextService Ui

<div class="evpay-admin-pix">
    <div class="evpay-admin-pix-header">
        <i class="fas fa-hand-holding-usd"></i>
        <span>@Ui["Payment.PixDirectToOrganizer"]</span>
    </div>
    @if (!string.IsNullOrWhiteSpace(GroupAdminPixKey))
    {
        <p class="evpay-admin-pix-hint">
            @string.Format(Ui["Payment.PixHint"], Price.ToString("N2", PtBr))
        </p>
        <div class="evpay-admin-pix-qr">
            <QRCode Value="@PixQrPayload" />
        </div>
        <div class="evpay-admin-pix-key">
            <code class="evpay-admin-pix-code">@GroupAdminPixKey</code>
            <button type="button" class="evpay-admin-pix-copy"
                    @onclick="HandleCopyAdminPixKey">
                <i class="fas @(CopiedAdminPix ? "fa-check" : "fa-copy")"></i>
                @(CopiedAdminPix ? Ui["Payment.Copied"] : Ui["Payment.Copy"])
            </button>
        </div>
    }
    else
    {
        <p class="evpay-admin-pix-no-key">
            <i class="fas fa-exclamation-circle"></i>
            @Ui["Payment.NoPixKey"]
        </p>
    }
</div>
