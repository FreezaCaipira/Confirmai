@page "/profile/{Id}"

@using System.Security.Claims
@using System.Globalization
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@using Confirmai.Pages.Components.Profile


<PageTitle>@(loading ? T["Profile.Loading"] : DisplayName) · Confirmai</PageTitle>

<ProfileLoadingStates
    IsLoading="@loading"
    UserNotFound="@(user == null)" />

@if (!loading && user is not null)
{
    <div class="entity-shell profile-page">

        @* ── Card de identidade (header + avatar unificados) ─────────────── *@
        <ProfileHeaderCard User="@user" IsOwnProfile="@isOwnProfile"
            CurrentAvatarPath="@user?.AvatarPath"
            SelectedFile="@avatarFile"
            IsSavingAvatar="@isSavingAvatar"
            AvatarFeedback="@avatarFeedback"
            OnAvatarSelected="@AvatarSelectedCallback"
            OnSaveAvatar="@SaveAvatarCallback" />

        @* ── Contatos sociais (visitante e dono) ─────────────────────────── *@
        <ProfileContactsDisplay User="@user" IsOwnProfile="@isOwnProfile" />

        @if (isOwnProfile)
        {
            @* ── Meus dados (edicao sempre visivel, sem details) ───────────── *@
            <ProfileEditForm
                EditModel="@profileEditModel"
                IsSaving="@isSavingProfile"
                SaveFeedback="@profileSaveFeedback"
                OnSaveProfile="@SaveOwnProfileCallback" />

            @* ── Recebimento (Pix) — bloco proprio com ancora ─────────────── *@
            <section id="pix" class="profile-card profile-pix-section @(_highlightPix ? "profile-pix-section--highlight" : "")">
                <h3 class="profile-pix-title">@T["Profile.PixReceiverTitle"]</h3>
                <p class="profile-pix-hint">@T["Profile.PixReceiverHint"]</p>
                <div class="profile-pix-row">
                    <label class="profile-contact-label" for="profile-pix-key">@T["Profile.Pix"]</label>
                    <input id="profile-pix-key"
                           class="profile-pix-input"
                           @bind="profileEditModel.PixKey"
                           placeholder="@T["Profile.PixNotConfigured"]"
                           disabled="@isSavingProfile" />
                    <button class="mk-btn mk-btn-primary" type="button"
                            disabled="@isSavingProfile"
                            @onclick="SaveOwnProfileCallback">
                        @(isSavingProfile ? T["Profile.Saving"] : T["Profile.Save"])
                    </button>
                </div>
                @if (!string.IsNullOrWhiteSpace(profileSaveFeedback))
                {
                    <p class="profile-pix-feedback" role="status">@profileSaveFeedback</p>
                }
            </section>
        }

        @* ── Card de esportes ─────────────────────────────────────────────── *@
        <ProfileSportStats
            ActiveSport="@activeSport"
            FutsalTotal="@futsalTotal"
            FutsalOutfieldTotal="@futsalOutfieldTotal"
            FutsalGoalkeeperTotal="@futsalGoalkeeperTotal"
            PokerTotal="@pokerTotal"
            OnSetSport="@SetSportCallback" />

        @* ── Chat (só para outros perfis autenticados) ───────────────────── *@
        @if (!isOwnProfile && isAuthenticated)
        {
            <div class="profile-card profile-message-card">
                <h3 class="profile-message-title">@T["Profile.ChatTitle"]</h3>
                <div class="profile-chat-thread" aria-label="@T["Profile.ChatAria"]">
                    <ProfileChatThread ChatMessages="@chatMessages" />
                </div>

                <ChatComposeBox
                    MessageBody="@messageBody"
                    IsSending="@isSendingMessage"
                    Feedback="@messageFeedback"
                    ShowRefreshButton="@chatMessages.Any()"
                    OnSendMessage="@SendMailboxMessageCallback"
                    OnRefreshChat="@RefreshChatCallback" />
            </div>
        }

    </div>
}
