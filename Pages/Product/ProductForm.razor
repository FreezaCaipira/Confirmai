@page "/products/create"
@page "/products/edit/{Id:int}"

@attribute [Authorize]

@using Confirmai.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities



<PageTitle>@(Id == 0 ? T["ProductForm.NewTitle"] : T["ProductForm.EditTitle"])</PageTitle>

<div class="entity-shell parchment-a">

    <section class="entity-shell-grid" aria-label="@T["ProductForm.Aria"]">
        <article class="entity-shell-card entity-shell-main product-form">
            <EditForm Model="product" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />

                @if (isLoading)
                {
                    <div class="loading-spinner">
                        <span class="oi oi-reload spinning"></span> @T["ProductForm.Processing"]
                    </div>
                }
                else
                {
                    <fieldset class="pf-fieldset">
                        <legend class="pf-legend">Informacoes basicas</legend>

                        <div class="form-group">
                            <label>@T["Common.Name"] <span class="pf-required" aria-hidden="true">*</span></label>
                            <InputText @bind-Value="product.Name" class="input" />
                            <ValidationMessage For="@(() => product.Name)" class="validation-message" />
                        </div>

                        <div class="form-group">
                            <label>@T["Common.Description"]</label>
                            <InputTextArea @bind-Value="product.Description" class="input" />
                            <ValidationMessage For="@(() => product.Description)" />
                        </div>

                        <div class="pf-row-2col">
                            <div class="form-group">
                                <label>@T["ProductForm.Category"] <span class="pf-required" aria-hidden="true">*</span></label>
                                <InputSelect @bind-Value="product.Category" class="input">
                                    @foreach (var category in categoryOptions)
                                    {
                                        <option value="@category.Value">@category.Label</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => product.Category)" />
                            </div>

                            <div class="form-group">
                                <label>Gateway de precificacao</label>
                                <InputSelect @bind-Value="product.PricingGateway" class="input">
                                    @foreach (var gateway in pricingGatewayOptions)
                                    {
                                        <option value="@gateway.Name">@gateway.Name</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => product.PricingGateway)" />
                            </div>
                        </div>
                    </fieldset>

                    <fieldset class="pf-fieldset">
                        <legend class="pf-legend">Aparencia</legend>

                        <div class="form-group">
                            <label>Cor de fundo</label>
                            <div class="accent-color-control">
                                <input type="color" class="accent-color-input" @bind="accentColorInput" />
                                <div class="accent-color-preview" style="--accent-preview:@accentColorInput;">
                                    <span class="accent-color-swatch" aria-hidden="true"></span>
                                    <div class="accent-color-meta">
                                        <strong>Preview do card</strong>
                                        <small>@accentColorInput.ToUpperInvariant()</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>@T["ProductForm.Image"]</label>
                            <div class="pf-file-drop">
                                <InputFile OnChange="OnInputFileChange" />
                                @if (!string.IsNullOrEmpty(product.ImagePath))
                                {
                                    <img src="@product.ImagePath" alt="@T["ProductForm.ImageAlt"]" class="product-preview" />
                                }
                                else
                                {
                                    <span class="pf-file-hint">JPG, PNG, GIF ou WEBP</span>
                                }
                            </div>
                        </div>
                    </fieldset>

                    <div class="pf-submit-row">
                        <button class="pf-cancel-btn" type="button" @onclick='() => Navigation.NavigateTo("/products")'>
                            @T["Common.Cancel"]
                        </button>
                        <button class="pf-submit-btn" type="submit" disabled="@isLoading">
                            @T["Common.Save"]
                        </button>
                    </div>
                }
            </EditForm>
        </article>
    </section>
</div>
