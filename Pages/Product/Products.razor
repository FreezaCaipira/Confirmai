@page "/products"

@inject NavigationManager Navigation

<PageTitle>Redirecionando...</PageTitle>

<div class="entity-shell parchment-a">
    <section class="entity-shell-grid" aria-label="Redirecionamento">
        <article class="entity-shell-card entity-shell-main">
            <p class="identity-muted">Redirecionando para servidores...</p>
        </article>
    </section>
</div>

@code {
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            Navigation.NavigateTo("/servers", replace: true);
        }
    }
}
