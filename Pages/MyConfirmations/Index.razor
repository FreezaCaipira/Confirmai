@page "/minhas-confirmacoes"

@attribute [Authorize]

@using Confirmai.Data
@using Confirmai.Enums
@using Confirmai.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@using System.Security.Claims

@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Minhas Confirmações — Confirmai</PageTitle>

<div class="entity-shell">
    <section class="entity-shell-grid" aria-label="Eventos confirmados">
        <article class="entity-shell-card entity-shell-main">

            <h1 class="page-section-title">Minhas Confirmações</h1>

            @if (isLoading)
            {
                <p class="listing-state">Carregando suas confirmações…</p>
            }
            else if (!upcoming.Any() && !past.Any())
            {
                <div class="listing-state listing-empty">
                    <p>Você ainda não confirmou presença em nenhum evento.</p>
                    <div style="margin-top:.75rem;display:flex;gap:.5rem;flex-wrap:wrap">
                        <a href="/futsal" class="my-conf-browse-btn">⚽ Ver Futsal</a>
                        <a href="/poker"  class="my-conf-browse-btn my-conf-browse-btn--poker">🃏 Ver Poker</a>
                    </div>
                </div>
            }
            else
            {
                @if (upcoming.Any())
                {
                    <div class="my-conf-section">
                        <h2 class="my-conf-section-title">
                            <i class="fas fa-calendar-check"></i> Próximos (@upcoming.Count)
                        </h2>
                        <div class="my-conf-list">
                            @foreach (var c in upcoming)
                            {
                                var ev        = c.Event;
                                var isFutsal  = ev.Sport == Sport.Futsal;
                                var detailUrl = isFutsal ? $"/futsal/{ev.Id}" : $"/poker/{ev.Id}";
                                var confId    = c.Id;
                                <div class="my-conf-card">
                                    <div class="my-conf-sport @(isFutsal ? "my-conf-sport--futsal" : "my-conf-sport--poker")">
                                        @(isFutsal ? "⚽" : "🃏")
                                    </div>
                                    <div class="my-conf-body">
                                        <div class="my-conf-name-row">
                                            <strong class="my-conf-name">@ev.Group.Name</strong>
                                            @if (isFutsal && c.Position.HasValue)
                                            {
                                                <span class="my-conf-pos">@(c.Position == FutsalPosition.Goalkeeper ? "🥅 Goleiro" : "👟 Linha")</span>
                                            }
                                            @if (!isFutsal && ev.PokerEventType.HasValue)
                                            {
                                                <span class="my-conf-pos">@PokerTypeLabel(ev.PokerEventType)</span>
                                            }
                                        </div>
                                        <p class="my-conf-meta">
                                            📅 @ev.StartsAt.ToLocalTime().ToString("ddd, dd/MM/yyyy 'às' HH:mm", PtBr)
                                        </p>
                                        <p class="my-conf-meta">📍 @ev.Location &nbsp;·&nbsp; 👥 @ev.Confirmations.Count confirmados</p>
                                    </div>
                                    <div class="my-conf-actions">
                                        <a href="@detailUrl" class="my-conf-btn my-conf-btn--view">Ver</a>
                                        <button class="my-conf-btn my-conf-btn--cancel"
                                                disabled="@(cancellingId == confId)"
                                                @onclick="() => HandleCancel(c)">
                                            @(cancellingId == confId ? "…" : "Cancelar")
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (past.Any())
                {
                    <div class="my-conf-section my-conf-section--past">
                        <h2 class="my-conf-section-title">
                            <i class="fas fa-history"></i> Anteriores (@past.Count)
                        </h2>
                        <div class="my-conf-list">
                            @foreach (var c in past)
                            {
                                var ev        = c.Event;
                                var isFutsal  = ev.Sport == Sport.Futsal;
                                var detailUrl = isFutsal ? $"/futsal/{ev.Id}" : $"/poker/{ev.Id}";
                                <div class="my-conf-card my-conf-card--past">
                                    <div class="my-conf-sport @(isFutsal ? "my-conf-sport--futsal" : "my-conf-sport--poker")">
                                        @(isFutsal ? "⚽" : "🃏")
                                    </div>
                                    <div class="my-conf-body">
                                        <div class="my-conf-name-row">
                                            <strong class="my-conf-name">@ev.Group.Name</strong>
                                            @if (isFutsal && c.Position.HasValue)
                                            {
                                                <span class="my-conf-pos">@(c.Position == FutsalPosition.Goalkeeper ? "🥅 Goleiro" : "👟 Linha")</span>
                                            }
                                            @if (!ev.IsActive)
                                            {
                                                <span class="my-conf-cancelled">Cancelado</span>
                                            }
                                        </div>
                                        <p class="my-conf-meta">
                                            📅 @ev.StartsAt.ToLocalTime().ToString("ddd, dd/MM/yyyy 'às' HH:mm", PtBr)
                                        </p>
                                    </div>
                                    <div class="my-conf-actions">
                                        <a href="@detailUrl" class="my-conf-btn my-conf-btn--view">Ver</a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            }

        </article>
    </section>
</div>

@code {
    private static readonly CultureInfo PtBr = new("pt-BR");

    private List<EventConfirmation> upcoming = new();
    private List<EventConfirmation> past     = new();
    private bool   isLoading    = true;
    private int?   cancellingId = null;
    private string userId       = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        userId   = auth.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        if (string.IsNullOrWhiteSpace(userId)) { isLoading = false; return; }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        var now   = DateTime.UtcNow;

        await using var db = await DbFactory.CreateDbContextAsync();
        var confs = await db.EventConfirmations
            .Include(c => c.Event).ThenInclude(e => e.Group)
            .Include(c => c.Event).ThenInclude(e => e.Confirmations)
            .Where(c => c.UserId == userId)
            .OrderBy(c => c.Event.StartsAt)
            .ToListAsync();

        upcoming = confs.Where(c => c.Event.StartsAt >= now && c.Event.IsActive).ToList();
        past     = confs.Where(c => c.Event.StartsAt < now || !c.Event.IsActive)
                        .OrderByDescending(c => c.Event.StartsAt)
                        .ToList();
        isLoading = false;
    }

    private async Task HandleCancel(EventConfirmation conf)
    {
        cancellingId = conf.Id;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var entity = await db.EventConfirmations.FindAsync(conf.Id);
            if (entity is not null) db.EventConfirmations.Remove(entity);
            await db.SaveChangesAsync();
            await LoadAsync();
        }
        finally { cancellingId = null; }
    }

    private static string PokerTypeLabel(PokerEventType? t) => t switch
    {
        PokerEventType.CashGame => "💰 Cash",
        PokerEventType.HomeGame => "🏠 Home",
        _                       => "🏆 Torneio",
    };
}
