@page "/meus-eventos"

@attribute [Authorize]

@using Confirmai.Data
@using Confirmai.Enums
@using Confirmai.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@using System.Security.Claims

@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject EventNotificationService NotificationService

<PageTitle>Minhas Partidas — Confirmai</PageTitle>

<div class="events-page">

    <section class="events-block" aria-label="Minhas partidas">

            <div class="my-events-back-row">
                <a href="@(SelectedSport == Sport.Futsal ? "/futsal" : "/poker")" class="listing-back-btn">
                    <i class="fas fa-arrow-left"></i> Voltar
                </a>
            </div>

            <h1 class="page-section-title my-events-title">Minhas Partidas</h1>

            @if (SelectedSport == Sport.Futsal)
            {
                <div class="my-events-action-row">
                    <a href="/futsal/schedule/create" class="my-events-create-btn my-events-create-btn--futsal">
                        <i class="fas fa-sync-alt"></i> Recorrência semanal
                    </a>
                </div>
            }

            <div class="my-events-filter-row">
                <div class="my-events-view-tabs">
                    <button class="my-events-tab @(eventFilter == "upcoming" ? "my-events-tab--active" : "")"
                            @onclick='() => eventFilter = "upcoming"'>
                        Próximas (@events.Count(e => e.IsActive && e.StartsAt >= DateTime.UtcNow))
                    </button>
                    <button class="my-events-tab @(eventFilter == "finished" ? "my-events-tab--active" : "")"
                            @onclick='() => eventFilter = "finished"'>
                        Encerradas (@events.Count(e => !e.IsActive || e.StartsAt < DateTime.UtcNow))
                    </button>
                </div>
                <div class="my-events-create-btns">
                    @if (SelectedSport == Sport.Futsal)
                    {
                        <a href="/futsal/create" class="my-events-create-btn my-events-create-btn--futsal">
                            <i class="fas fa-plus"></i> Nova Partida
                        </a>
                    }
                    else if (SelectedSport == Sport.Poker)
                    {
                        <a href="/poker/create?tipo=torneio" class="my-events-create-btn my-events-create-btn--poker">
                            <i class="fas fa-trophy"></i> Novo Torneio
                        </a>
                    }
                </div>
            </div>

            @if (isLoading)
            {
                <p class="listing-state">Carregando seus eventos…</p>
            }
            else if (!FilteredEvents.Any())
            {
                <div class="listing-state listing-empty">
                    <p>Nenhuma partida @(eventFilter == "finished" ? "encerrada" : "próxima").</p>
                    <p class="listing-empty-hint">Use o botão acima para criar sua primeira partida@(SelectedSport == Sport.Poker ? " ou torneio" : "").</p>
                </div>
            }
            else
            {
                <div class="my-events-list">
                    @foreach (var ev in FilteredEvents)
                    {
                        var isFutsal = ev.Sport == Sport.Futsal;
                        var isPast   = ev.StartsAt < DateTime.UtcNow;
                        var detailUrl = isFutsal ? $"/futsal/{ev.Id}" : $"/poker/{ev.Id}";

                        <div class="my-event-card @(isFutsal ? "my-event-card--futsal" : "my-event-card--poker") @(!ev.IsActive ? "my-event-card--inactive" : isPast ? "my-event-card--past" : "")">
                            <div class="my-event-card-overlay"></div>
                            <div class="my-event-card-bg-icon">
                                <i class="@(isFutsal ? "fas fa-futbol" : "fas fa-cards")"></i>
                            </div>
                            <div class="my-event-sport-badge @(isFutsal ? "my-event-sport-badge--futsal" : "my-event-sport-badge--poker")">
                                @(isFutsal ? "⚽" : "🃏")
                            </div>

                            <div class="my-event-body">
                                <div class="my-event-name-row">
                                    <strong class="my-event-name">@ev.Group.Name</strong>
                                    @if (!ev.IsActive)
                                    {
                                        <span class="my-event-status my-event-status--cancelled">Cancelado</span>
                                    }
                                    else if (isPast)
                                    {
                                        <span class="my-event-status my-event-status--past">Encerrado</span>
                                    }
                                    else
                                    {
                                        <span class="my-event-status my-event-status--active">Ativo</span>
                                    }
                                    @if (!isFutsal && ev.PokerEventType.HasValue)
                                    {
                                        <span class="my-event-type-badge my-event-type-badge--@ev.PokerEventType.ToString()!.ToLower()">
                                            @PokerTypeLabel(ev.PokerEventType.Value)
                                        </span>
                                    }
                                </div>
                                <p class="my-event-meta">
                                    📅 @ev.StartsAt.ToLocalTime().ToString("ddd, dd/MM/yyyy 'às' HH:mm", PtBr)
                                    &nbsp;·&nbsp;
                                    👥 @ev.Confirmations.Count@(ev.MaxPlayers > 0 ? $"/{ev.MaxPlayers}" : "") confirmados
                                </p>
                                @if (!string.IsNullOrWhiteSpace(ev.Location))
                                {
                                    <p class="my-event-location">📍 @ev.Location</p>
                                }
                            </div>

                            <div class="my-event-actions">
                                <a href="@detailUrl" class="my-event-action-btn my-event-action-btn--view">
                                    Ver detalhes
                                </a>
                                @if (ev.IsActive && !isPast)
                                {
                                    <button class="my-event-action-btn my-event-action-btn--cancel"
                                            disabled="@(cancellingId == ev.Id)"
                                            @onclick="() => CancelEvent(ev)">
                                        @(cancellingId == ev.Id ? "…" : "Cancelar")
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

    </section>

</div>

