@page "/jogos"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@using System.Net.Http.Json
@using System.Security.Claims
@using Confirmai.Data
@using Confirmai.Enums
@using Confirmai.Models
@using Confirmai.Shared
@using Confirmai.Shared.Components
@using Microsoft.JSInterop

@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject IHttpClientFactory HttpClientFactory
@inject UiTextService Ui

<PageTitle>@(activeTab == TabMyGames ? $"{Ui["Index.TabMyGames"]} — Confirmai" : "Confirmai")</PageTitle>

<CascadingValue Value="CurrentCityContext">
    <div class="sports-page">

    <div class="sports-tabs" role="tablist" aria-label="Jogos">
        <button class="sports-tab @(activeTab == TabExplore ? "sports-tab--active" : string.Empty)"
                type="button" role="tab" aria-selected="@(activeTab == TabExplore)"
                @onclick='() => SetTabAsync(TabExplore)'>
            🔍 @Ui["Index.TabExplore"]
        </button>
        <AuthorizeView>
            <Authorized>
                <button class="sports-tab @(activeTab == TabMyGames ? "sports-tab--active" : string.Empty)"
                        type="button" role="tab" aria-selected="@(activeTab == TabMyGames)"
                        @onclick='() => SetTabAsync(TabMyGames)'>
                    📅 @Ui["Index.TabMyGames"]
                </button>
            </Authorized>
        </AuthorizeView>
    </div>

    @if (activeTab == TabExplore)
    {
        <CitySelector
            SelectedCityKey="@SelectedCityKey"
            SelectedCityKeyChanged="SelectedCityKeyChanged"
            OtherStateCode="@otherStateCode"
            OtherStateCodeChanged="otherStateCodeChanged"
            CustomCity="@CustomCity"
            CustomCityChanged="CustomCityChanged"
            Cities="@Cities"
            OtherCityOptions="@otherCityOptions"
            OnOtherCityChange="LoadOtherCitiesAsync" />

        <section class="sports-grid" aria-label="Esportes disponíveis">
            <a href="@FutsalHref" class="sport-card sport-card--futsal">
                <div class="sport-card-icon" aria-hidden="true">⚽</div>
                <div class="sport-card-body">
                    <h3 class="sport-card-name">Futsal</h3>
                    <p class="sport-card-desc">@Ui["Index.FutsalCardDesc"]</p>
                </div>
                <span class="sport-card-cta">@Ui["Index.ViewMatches"]</span>
            </a>
            <a href="@PokerHref" class="sport-card sport-card--poker">
                <div class="sport-card-icon" aria-hidden="true">🃏</div>
                <div class="sport-card-body">
                    <h3 class="sport-card-name">Poker</h3>
                    <p class="sport-card-desc">@Ui["Index.PokerCardDesc"]</p>
                </div>
                <span class="sport-card-cta">@Ui["Index.ViewTournaments"]</span>
            </a>
        </section>
    }
    else
    {
        <AuthorizeView>
            <Authorized>
                <div class="my-conf-container">
                    @if (confLoading)
                    {
                        <p class="listing-state">@Ui["Index.LoadingConfirmations"]</p>
                    }
                    else if (!upcoming.Any() && !past.Any() && !cancelled.Any())
                    {
                        <div class="listing-state listing-empty">
                            <p>@Ui["Index.NoConfirmations"]</p>
                            <div class="browse-buttons-row">
                                <a href="/futsal" class="my-conf-browse-btn">⚽ @Ui["Index.ViewFutsal"]</a>
                                <a href="/poker"  class="my-conf-browse-btn my-conf-browse-btn--poker">🃏 @Ui["Index.ViewPoker"]</a>
                            </div>
                        </div>
                    }
                    else
                    {
                        @if (upcoming.Any())
                        {
                            <div class="my-conf-section">
                                <h2 class="my-conf-section-title">
                                    <i class="fas fa-calendar-check"></i> @Ui["Index.Upcoming"] (@upcoming.Count)
                                </h2>
                                <div class="my-conf-list">
                                    @foreach (var c in upcoming)
                                    {
                                        var ev       = c.Event;
                                        var isFutsal = ev.Sport == Sport.Futsal;
                                        var detailUrl = isFutsal ? $"/futsal/{ev.Id}" : $"/poker/{ev.Id}";
                                        <div class="my-conf-card">
                                            <div class="my-conf-sport @(isFutsal ? "my-conf-sport--futsal" : "my-conf-sport--poker")">
                                                @(isFutsal ? "⚽" : "🃏")
                                            </div>
                                            <div class="my-conf-body">
                                                <div class="my-conf-name-row">
                                                    <strong class="my-conf-name">@ev.Group.Name</strong>
                                                    <span class="meta-chip meta-chip--confirmed"><i class="fas fa-check"></i> @Ui["Index.Confirmed"]</span>
                                                    @if (isFutsal && c.Position.HasValue)
                                                    {
                                                        <span class="my-conf-pos">@(c.Position == FutsalPosition.Goalkeeper ? $"🥅 {Ui["Index.Goalkeeper"]}" : $"👟 {Ui["Index.Line"]}")</span>
                                                    }
                                                    @if (!isFutsal && ev.PokerEventType.HasValue)
                                                    {
                                                        <span class="my-conf-pos">@PokerTypeLabel(ev.PokerEventType)</span>
                                                    }
                                                </div>
                                                <p class="my-conf-meta">📅 @Ui.FormatDateTime(ev.StartsAt.ToLocalTime(), "DateTimeFullShort")</p>
                                                <p class="my-conf-meta">📍 @ev.Location &nbsp;·&nbsp; 👥 @ev.Confirmations.Count @Ui["Index.ConfirmedCount"]</p>
                                            </div>
                                            <div class="my-conf-actions">
                                                <a href="@detailUrl" class="my-conf-btn my-conf-btn--view"><i class="fas fa-arrow-right"></i> @Ui["Index.Enter"]</a>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (past.Any() || cancelled.Any())
                        {
                            <div class="my-conf-history-tabs">
                                <button class="my-conf-tab @(!showCancelled ? "active" : string.Empty)" type="button" @onclick="() => showCancelled = false">
                                    <i class="fas fa-history"></i> @Ui["Index.Previous"] (@past.Count)
                                </button>
                                <button class="my-conf-tab @(showCancelled ? "active" : string.Empty)" type="button" @onclick="() => showCancelled = true">
                                    <i class="fas fa-ban"></i> @Ui["Index.Cancelled"] (@cancelled.Count)
                                </button>
                            </div>

                            @if (!showCancelled)
                            {
                                @if (past.Any())
                                {
                                    <div class="my-conf-section my-conf-section--past">
                                        <div class="my-conf-list">
                                            @foreach (var c in past)
                                            {
                                                var ev       = c.Event;
                                                var isFutsal = ev.Sport == Sport.Futsal;
                                                var detailUrl = isFutsal ? $"/futsal/{ev.Id}" : $"/poker/{ev.Id}";
                                                <div class="my-conf-card my-conf-card--past">
                                                    <div class="my-conf-sport @(isFutsal ? "my-conf-sport--futsal" : "my-conf-sport--poker")">
                                                        @(isFutsal ? "⚽" : "🃏")
                                                    </div>
                                                    <div class="my-conf-body">
                                                        <div class="my-conf-name-row">
                                                            <strong class="my-conf-name">@ev.Group.Name</strong>
                                                            <span class="meta-chip meta-chip--confirmed"><i class="fas fa-check"></i> @Ui["Index.Confirmed"]</span>
                                                            @if (isFutsal && c.Position.HasValue)
                                                            {
                                                                <span class="my-conf-pos">@(c.Position == FutsalPosition.Goalkeeper ? $"🥅 {Ui["Index.Goalkeeper"]}" : $"👟 {Ui["Index.Line"]}")</span>
                                                            }
                                                        </div>
                                                        <p class="my-conf-meta">📅 @Ui.FormatDateTime(ev.StartsAt.ToLocalTime(), "DateTimeFullShort")</p>
                                                    </div>
                                                    <div class="my-conf-actions">
                                                        <a href="@detailUrl" class="my-conf-btn my-conf-btn--view"><i class="fas fa-arrow-right"></i> @Ui["Index.Enter"]</a>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <p class="listing-state">@Ui["Index.NoPrevious"]</p>
                                }
                            }
                            else
                            {
                                @if (cancelled.Any())
                                {
                                    <div class="my-conf-section">
                                        <div class="my-conf-list">
                                            @foreach (var c in cancelled)
                                            {
                                                var ev       = c.Event;
                                                var isFutsal = ev.Sport == Sport.Futsal;
                                                var detailUrl = isFutsal ? $"/futsal/{ev.Id}" : $"/poker/{ev.Id}";
                                                <div class="my-conf-card my-conf-card--cancelled">
                                                    <div class="my-conf-sport @(isFutsal ? "my-conf-sport--futsal" : "my-conf-sport--poker")">
                                                        @(isFutsal ? "⚽" : "🃏")
                                                    </div>
                                                    <div class="my-conf-body">
                                                        <div class="my-conf-name-row">
                                                            <strong class="my-conf-name">@ev.Group.Name</strong>
                                                            <span class="my-conf-cancelled"><i class="fas fa-ban"></i> @Ui["Index.Cancelled"]</span>
                                                            @if (isFutsal && c.Position.HasValue)
                                                            {
                                                                <span class="my-conf-pos">@(c.Position == FutsalPosition.Goalkeeper ? $"🥅 {Ui["Index.Goalkeeper"]}" : $"👟 {Ui["Index.Line"]}")</span>
                                                            }
                                                        </div>
                                                        <p class="my-conf-meta">📅 @Ui.FormatDateTime(ev.StartsAt.ToLocalTime(), "DateTimeFullShort")</p>
                                                    </div>
                                                    <div class="my-conf-actions">
                                                        <a href="@detailUrl" class="my-conf-btn my-conf-btn--view"><i class="fas fa-arrow-right"></i> @Ui["Index.Enter"]</a>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <p class="listing-state">@Ui["Index.NoCancelled"]</p>
                                }
                            }
                        }
                    }
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="listing-state">
                    <p><a href="/Identity/Account/Login?ReturnUrl=%2F%3Ftab%3Dmeus-jogos">@Ui["Index.LoginRequired"]</a> @Ui["Index.LoginRequiredSuffix"]</p>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    }
    </div>
</CascadingValue>

@code {
    private static readonly CultureInfo PtBr = new("pt-BR");

    // ── Constants ─────────────────────────────────────────────────
    private const string DefaultCityKey = "Pouso Alegre|MG";
    private const string DefaultCityName = "Pouso Alegre";
    private const string DefaultStateCode = "MG";
    private const string OtherCityKey = "__other__";
    private const string TabExplore = "explorar";
    private const string TabMyGames = "meus-jogos";

    // ── Tab ────────────────────────────────────────────────────────
    [Parameter]
    [SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    private string activeTab = TabExplore;

    // ── Explorar state ─────────────────────────────────────────────
    private List<CityOption> Cities = new();
    private string SelectedCityKey = DefaultCityKey;
    private string CustomCity = string.Empty;

    // Callbacks for two-way binding with CitySelector
    private void SelectedCityKeyChanged(string value) => SelectedCityKey = value;
    private void otherStateCodeChanged(string value) => otherStateCode = value;
    private void CustomCityChanged(string value) => CustomCity = value;

    private string FutsalHref => BuildHref("/futsal");
    private string PokerHref  => BuildHref("/poker");

    // ── City Context for CascadingValue ───────────────────────────────
    private CityContext CurrentCityContext
    {
        get
        {
            if (SelectedCityKey == OtherCityKey)
            {
                var trimmed = CustomCity.Trim();
                if (string.IsNullOrEmpty(trimmed)) return new CityContext(null, null);
                return new CityContext(trimmed, otherStateCode);
            }
            var opt = Cities.FirstOrDefault(c => c.Key == SelectedCityKey);
            return opt is null ? new CityContext(null, null) : new CityContext(opt.City, opt.StateCode);
        }
    }

    private string BuildHref(string basePath)
    {
        if (SelectedCityKey == OtherCityKey)
        {
            var trimmed = CustomCity.Trim();
            if (string.IsNullOrEmpty(trimmed)) return basePath;
            return !string.IsNullOrEmpty(otherStateCode)
                ? $"{basePath}?cidade={Uri.EscapeDataString(trimmed)}&estado={otherStateCode}"
                : $"{basePath}?cidade={Uri.EscapeDataString(trimmed)}";
        }
        var opt = Cities.FirstOrDefault(c => c.Key == SelectedCityKey);
        return opt is null
            ? basePath
            : $"{basePath}?cidade={Uri.EscapeDataString(opt.City)}&estado={opt.StateCode}";
    }

    // ── Meus Jogos state ───────────────────────────────────────────
    private List<EventConfirmation> upcoming  = new();
    private List<EventConfirmation> past      = new();
    private List<EventConfirmation> cancelled = new();
    private bool confLoaded    = false;
    private bool confLoading   = false;
    private bool showCancelled = false;
    private string userId      = string.Empty;

    // ── Outra cidade ───────────────────────────────────────────────
    private string       otherStateCode  = string.Empty;
    private List<IbgeMunicipio> otherCityOptions = new();

    private async Task LoadOtherCitiesAsync()
    {
        if (string.IsNullOrWhiteSpace(otherStateCode)) return;
        try
        {
            var http   = HttpClientFactory.CreateClient();
            var result = await http.GetFromJsonAsync<IbgeMunicipio[]>(
                $"https://servicodados.ibge.gov.br/api/v1/localidades/estados/{otherStateCode}/municipios?orderBy=nome");
            otherCityOptions = result?.ToList() ?? new();
        }
        catch { otherCityOptions = new(); }
    }

    protected override Task OnParametersSetAsync()
    {
        // Sync tab with URL (handles back/forward navigation and redirects from /minhas-confirmacoes).
        // userId may be empty here on first call (before OnInitializedAsync), so data loading
        // is deferred to OnInitializedAsync in that case.
        var newTab = Tab == TabMyGames ? TabMyGames : TabExplore;
        activeTab = newTab;

        if (newTab == TabMyGames && !confLoaded && !string.IsNullOrWhiteSpace(userId))
            return LoadConfirmationsAsync();

        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        // Load city options
        await using var db = await DbFactory.CreateDbContextAsync();
        var rows = await db.Groups
            .Where(g => g.IsActive)
            .Select(g => new { g.City, g.StateCode })
            .Distinct()
            .OrderBy(c => c.City)
            .ToListAsync();

        Cities = rows
            .Select(r => new CityOption(
                $"{r.City}|{r.StateCode}",
                $"{r.City} - {r.StateCode}",
                r.City,
                r.StateCode))
            .ToList();

        if (!Cities.Any(c => c.Key == DefaultCityKey))
            Cities.Insert(0, new CityOption(DefaultCityKey, $"{DefaultCityName} - {DefaultStateCode}", DefaultCityName, DefaultStateCode));

        // Resolve auth (unavailable during OnParametersSetAsync on first load)
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;

        // OnParametersSetAsync ran before us with empty userId; load now if still needed
        if (activeTab == TabMyGames && !confLoaded)
            await LoadConfirmationsAsync();
    }

    private async Task SetTabAsync(string tab)
    {
        activeTab = tab;
        NavigationManager.NavigateTo(tab == TabMyGames ? "/jogos?tab=meus-jogos" : "/jogos", replace: true);
        if (tab == TabMyGames && !confLoaded)
            await LoadConfirmationsAsync();
    }

    private async Task LoadConfirmationsAsync()
    {
        if (string.IsNullOrWhiteSpace(userId)) { confLoading = false; return; }

        confLoading = true;
        var now = DateTime.UtcNow;

        await using var db = await DbFactory.CreateDbContextAsync();
        var confs = await db.EventConfirmations
            .Include(c => c.Event).ThenInclude(e => e.Group)
            .Include(c => c.Event).ThenInclude(e => e.Confirmations)
            .Where(c => c.UserId == userId)
            .OrderBy(c => c.Event.StartsAt)
            .ToListAsync();

        upcoming  = confs.Where(c => c.Event.StartsAt >= now && c.Event.IsActive).ToList();
        past      = confs.Where(c => c.Event.StartsAt <  now && c.Event.IsActive)
                         .OrderByDescending(c => c.Event.StartsAt).ToList();
        cancelled = confs.Where(c => !c.Event.IsActive)
                         .OrderByDescending(c => c.Event.StartsAt).ToList();
        confLoading = false;
        confLoaded  = true;
    }

    private static string PokerTypeLabel(PokerEventType? t) => t switch
    {
        PokerEventType.CashGame => "💰 Cash",
        PokerEventType.HomeGame => "🏠 Home",
        _                       => "🏆 Torneio",
    };
}