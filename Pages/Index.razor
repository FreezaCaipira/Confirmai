@page "/"
@page "/eventos"
@page "/jogos"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Confirmai.Enums
@using Confirmai.Models
@using Confirmai.Shared.Components
@using Confirmai.Shared.Components.Groups

<PageTitle>@Ui["Index.PageTitle"] — Confirmai</PageTitle>

<div class="home">
    <AuthorizeView>
        <NotAuthorized>
            <header class="home-hero home-hero--landing">
                <div class="home-hero-text">
                    <h1 class="home-hero-title">@Ui["Index.LandingTitle"]</h1>
                    <p class="home-hero-sub">@Ui["Index.LandingSubtitle"]</p>
                </div>
                <div class="home-hero-actions">
                    <a href="/Identity/Account/Login" class="home-btn home-btn--primary">@Ui["Nav.Login"]</a>
                    <a href="/Identity/Account/Register" class="home-btn">@Ui["Nav.Register"]</a>
                </div>
            </header>
            <NoGroupsHint />
        </NotAuthorized>

        <Authorized>
            @if (isLoading)
            {
                <div class="home-skeleton">
                    <Skeleton Class="skeleton--card" />
                    <Skeleton Class="skeleton--card" />
                </div>
            }
            else if (myGroups.Count == 0)
            {
                <header class="home-hero">
                    <div class="home-hero-text">
                        <h1 class="home-hero-title">@Ui["Index.NoGroupTitle"]</h1>
                        <p class="home-hero-sub">@Ui["Index.NoGroupSubtitle"]</p>
                    </div>
                </header>
                <GroupEntryPanel />
                <NoGroupsHint />
            }
            else
            {
                <header class="home-hero">
                    <div class="home-hero-text">
                        <h1 class="home-hero-title">@Ui["Index.PageTitle"]</h1>
                        <p class="home-hero-sub">@Ui["Index.MyMatchesSubtitle"]</p>
                    </div>
                    <div class="home-view-toggle" role="tablist" aria-label="@Ui["Index.PageTitle"]">
                        <button type="button" role="tab" aria-selected="@(view == ViewPlaying)"
                                class="home-view-btn @(view == ViewPlaying ? "home-view-btn--active" : string.Empty)"
                                @onclick="() => SetView(ViewPlaying)">
                            @Ui["Index.ViewPlaying"] <span class="home-view-count">@upcoming.Count</span>
                        </button>
                        @if (organizesAny)
                        {
                            <button type="button" role="tab" aria-selected="@(view == ViewOrganizing)"
                                    class="home-view-btn @(view == ViewOrganizing ? "home-view-btn--active" : string.Empty)"
                                    @onclick="() => SetView(ViewOrganizing)">
                                @Ui["Index.ViewOrganizing"] <span class="home-view-count">@organizing.Count</span>
                            </button>
                        }
                    </div>
                </header>

                <section class="home-groups" aria-label="@Ui["Groups.MyGroups"]">
                    <div class="home-section-head">
                        <h2 class="home-section-title">@Ui["Groups.MyGroups"] <span class="home-section-count">@myGroups.Count</span></h2>
                        <a href="/grupos" class="home-link">@Ui["Index.ManageGroups"] →</a>
                    </div>
                    <div class="home-section-body home-group-chips">
                        @foreach (var g in myGroups)
                        {
                            <a href="/grupo/@g.Id" class="home-group-chip">
                                <span class="home-group-chip-icon" aria-hidden="true">@(g.Sport == Sport.Poker ? "🃏" : "⚽")</span>
                                <span class="home-group-chip-name">@g.Name</span>
                                @if (g.IsAdmin)
                                {
                                    <span class="home-group-chip-role">@Ui["Index.RoleAdmin"]</span>
                                }
                            </a>
                        }
                    </div>
                </section>

                @if (pendingPaymentGroups.Count > 0)
                {
                    <section class="home-pending" aria-label="@Ui["Index.PendingPaymentsTitle"]">
                        <div class="home-pending-card">
                            <span class="home-pending-icon" aria-hidden="true"><i class="fas fa-exclamation-circle"></i></span>
                            <div class="home-pending-body">
                                <strong>@Ui["Index.PendingPaymentsTitle"]</strong>
                                <div class="home-pending-links">
                                    @foreach (var p in pendingPaymentGroups)
                                    {
                                        <a href="/grupo/@p.GroupId/pagamentos" class="home-pending-link">
                                            @p.GroupName (@p.Count) →
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </section>
                }

                @if (view == ViewOrganizing && organizesAny)
                {
                    <section class="home-section" aria-label="@Ui["Index.ViewOrganizing"]">
                        <div class="home-section-head">
                            <h2 class="home-section-title">@Ui["Index.Upcoming"] <span class="home-section-count">@organizing.Count</span></h2>
                        </div>
                        <div class="home-section-body">
                        @if (organizing.Count == 0)
                        {
                            <div class="home-empty">
                                <p>@Ui["Index.NoOrganizing"]</p>
                                <div class="home-empty-actions">
                                    @foreach (var g in myGroups.Where(g => g.IsAdmin))
                                    {
                                        <a href="/grupo/@g.Id/partidas" class="home-btn">@Ui["Index.CreateMatchIn"] @g.Name</a>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="home-list">
                                @foreach (var ev in organizing)
                                {
                                    <a href="@DetailUrl(ev)" class="home-event">
                                        <div class="home-event-when">
                                            <span class="home-event-day">@Ui.FormatDateTime(ev.StartsAt.ToLocalTime(), "DateTimeFullShort")</span>
                                        </div>
                                        <div class="home-event-body">
                                            <strong class="home-event-group">@ev.Group.Name</strong>
                                            <span class="home-event-meta">
                                                @if (!string.IsNullOrWhiteSpace(ev.Location))
                                                {
                                                    <span>📍 @ev.Location</span>
                                                }
                                                <span>👥 @ev.Confirmations.Count@(ev.MaxPlayers > 0 ? $"/{ev.MaxPlayers}" : string.Empty) @Ui["Index.ConfirmedCount"]</span>
                                            </span>
                                        </div>
                                        <span class="home-event-cta">@Ui["Index.Manage"] →</span>
                                    </a>
                                }
                            </div>
                        }
                        </div>
                    </section>
                }
                else
                {
                    <section class="home-section" aria-label="@Ui["Index.ViewPlaying"]">
                        <div class="home-section-head">
                            <h2 class="home-section-title">@Ui["Index.Upcoming"] <span class="home-section-count">@upcoming.Count</span></h2>
                        </div>
                        <div class="home-section-body">
                        @if (upcoming.Count == 0)
                        {
                            <div class="home-empty">
                                <p>@Ui["Index.NoUpcoming"]</p>
                                <div class="home-empty-actions">
                                    @foreach (var g in myGroups)
                                    {
                                        <a href="/grupo/@g.Id/partidas" class="home-btn">@g.Name →</a>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="home-list">
                                @foreach (var c in upcoming)
                                {
                                    <ConfirmationCard Confirmation="@c" IsPast="false" IsCancelled="false" />
                                }
                            </div>
                        }
                        </div>
                    </section>

                    <section class="home-section home-section--history" aria-label="@Ui["Index.History"]">
                            <div class="home-section-head">
                                <h2 class="home-section-title">@Ui["Index.History"]</h2>
                                <div class="home-view-toggle home-view-toggle--small" role="tablist">
                                    <button type="button" role="tab" aria-selected="@(!showCancelled)"
                                            class="home-view-btn @(!showCancelled ? "home-view-btn--active" : string.Empty)"
                                            @onclick="() => showCancelled = false">
                                        @Ui["Index.Previous"] <span class="home-view-count">@past.Count</span>
                                    </button>
                                    <button type="button" role="tab" aria-selected="@showCancelled"
                                            class="home-view-btn @(showCancelled ? "home-view-btn--active" : string.Empty)"
                                            @onclick="() => showCancelled = true">
                                        @Ui["Index.Cancelled"] <span class="home-view-count">@cancelled.Count</span>
                                    </button>
                                </div>
                            </div>
                            <div class="home-section-body home-list">
                                @if (showCancelled)
                                {
                                    @if (cancelled.Count == 0)
                                    {
                                        <div class="home-empty"><p>@Ui["Index.NoCancelled"]</p></div>
                                    }
                                    @foreach (var c in cancelled.Take(HistoryLimit))
                                    {
                                        <ConfirmationCard Confirmation="@c" IsPast="true" IsCancelled="true" />
                                    }
                                }
                                else
                                {
                                    @if (past.Count == 0)
                                    {
                                        <div class="home-empty"><p>@Ui["Index.NoPrevious"]</p></div>
                                    }
                                    @foreach (var c in past.Take(HistoryLimit))
                                    {
                                        <ConfirmationCard Confirmation="@c" IsPast="true" IsCancelled="false" />
                                    }
                                }
                            </div>
                        </section>
                }
            }
        </Authorized>
    </AuthorizeView>
</div>
