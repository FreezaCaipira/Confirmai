@page "/"
@page "/eventos"
@page "/jogos"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@using System.Net.Http.Json
@using System.Security.Claims
@using Confirmai.Data
@using Confirmai.Enums
@using Confirmai.Models
@using Confirmai.Shared
@using Confirmai.Shared.Components
@using Confirmai.Shared.Components.Groups
@using Microsoft.JSInterop


<PageTitle>@(activeTab == TabMyGames ? $"{Ui["Index.TabMyGames"]} — Confirmai" : "Confirmai")</PageTitle>

<CascadingValue Value="CurrentCityContext">
    <div class="sports-page">

    <div class="sports-shell">

    <div class="sports-back-row">
        <a href="/grupos" class="detail-back-link">
            <i class="fas fa-arrow-left"></i> @Ui["Common.Back"]
        </a>
        <a href="/grupos" class="detail-back-link detail-back-link--groups">
            <i class="fas fa-layer-group"></i> @Ui["Groups.Title"]
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(userId) && userGroupCount == 0)
    {
        <NoGroupsHint ShowGroupsButton="true" />
    }

    <div class="sports-tabs">
        <CitySelector
            SelectedCityKey="@SelectedCityKey"
            SelectedCityKeyChanged="SelectedCityKeyChanged"
            Cities="@Cities" />
    </div>

    <section class="sports-grid" aria-label="@Ui["Index.SportsAvailable"]">
        <SportCard Sport="Sport.Futsal" Href="@FutsalHref" Description="@Ui["Index.FutsalCardDesc"]" CtaText="@Ui["Index.ViewMatches"]" MatchCount="@futsalMatchCount" />
        <SportCard Sport="Sport.Poker" Href="@PokerHref" Description="@Ui["Index.PokerCardDesc"]" CtaText="@Ui["Index.ViewTournaments"]" MatchCount="@pokerMatchCount" ComingSoon="true" />
        <SportCard Sport="Sport.Volleyball" Href="@VolleyballHref" Description="@Ui["Index.VolleyballCardDesc"]" CtaText="@Ui["Index.ViewMatches"]" MatchCount="@volleyballMatchCount" ComingSoon="true" />
        <SportCard Sport="Sport.BeachTennis" Href="@BeachTennisHref" Description="@Ui["Index.BeachTennisCardDesc"]" CtaText="@Ui["Index.ViewMatches"]" MatchCount="@beachTennisMatchCount" ComingSoon="true" />
        <SportCard Sport="Sport.Footvolley" Href="@FootvolleyHref" Description="@Ui["Index.FootvolleyCardDesc"]" CtaText="@Ui["Index.ViewMatches"]" MatchCount="@footvolleyMatchCount" ComingSoon="true" />
        <SportCard Sport="Sport.Chess" Href="@ChessHref" Description="@Ui["Index.ChessCardDesc"]" CtaText="@Ui["Index.ViewMatches"]" MatchCount="@chessMatchCount" ComingSoon="true" />
    </section>

    @if (activeTab == TabMyGames)
    {
        <AuthorizeView>
            <Authorized>
                <div class="my-conf-container">
                    @if (confLoading)
                    {
                        <div class="skeleton-container">
                            <Skeleton Class="skeleton--card" />
                            <Skeleton Class="skeleton--card" />
                            <Skeleton Class="skeleton--card" />
                        </div>
                    }
                    else if (!upcoming.Any() && !past.Any() && !cancelled.Any())
                    {
                        <NoGroupsHint ShowGroupsButton="true" />
                        <EmptyState Message="@Ui["Index.NoConfirmations"]" Actions="EmptyStateActions" />
                    }
                    else
                    {
                        <div class="my-conf-filters">
                            <select class="my-conf-filter" @bind="filterSport">
                                <option value="">@Ui["Index.FilterAllSports"]</option>
                                <option value="Futsal">@Ui["Index.SportFutsal"]</option>
                                <option value="Poker">@Ui["Index.SportPoker"]</option>
                                <option value="Volleyball">@Ui["Index.SportVolleyball"]</option>
                                <option value="BeachTennis">@Ui["Index.SportBeachTennis"]</option>
                                <option value="Footvolley">@Ui["Index.SportFootvolley"]</option>
                                <option value="Chess">@Ui["Index.SportChess"]</option>
                            </select>
                            <select class="my-conf-filter" @bind="filterPeriod">
                                <option value="all">@Ui["Index.FilterAllPeriods"]</option>
                                <option value="7days">@Ui["Index.FilterLast7Days"]</option>
                                <option value="30days">@Ui["Index.FilterLast30Days"]</option>
                            </select>
                        </div>

                        @if (upcoming.Any())
                        {
                            <div class="my-conf-section">
                                <h2 class="my-conf-section-title">
                                    <i class="fas fa-calendar-check"></i> @Ui["Index.Upcoming"] (@upcoming.Count)
                                </h2>
                                <div class="my-conf-list">
                                    @foreach (var c in upcoming)
                                    {
                                        <ConfirmationCard Confirmation="@c" IsPast="false" IsCancelled="false" />
                                    }
                                </div>
                            </div>
                        }

                        @if (past.Any())
                        {
                            <div class="my-conf-section my-conf-section--past">
                                <h2 class="my-conf-section-title">
                                    <i class="fas fa-history"></i> @Ui["Index.Previous"] (@past.Count)
                                </h2>
                                <div class="my-conf-list">
                                    @foreach (var c in past)
                                    {
                                        <ConfirmationCard Confirmation="@c" IsPast="true" IsCancelled="false" />
                                    }
                                </div>
                            </div>
                        }

                        @if (cancelled.Any())
                        {
                            <div class="my-conf-section my-conf-section--cancelled">
                                <h2 class="my-conf-section-title">
                                    <i class="fas fa-times-circle"></i> @Ui["Index.Cancelled"] (@cancelled.Count)
                                </h2>
                                <div class="my-conf-list">
                                    @foreach (var c in cancelled)
                                    {
                                        <ConfirmationCard Confirmation="@c" IsPast="true" IsCancelled="true" />
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="listing-state">
                    <p><a href="/Identity/Account/Login?ReturnUrl=%2F%3Ftab%3Dmeus-jogos">@Ui["Index.LoginRequired"]</a> @Ui["Index.LoginRequiredSuffix"]</p>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    }
    </div>
    </div>
</CascadingValue>
