@page "/"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@using System.Security.Claims
@using Confirmai.Data
@using Confirmai.Enums
@using Confirmai.Models
@using Microsoft.JSInterop

@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>@(activeTab == "meus-jogos" ? "Meus Jogos — Confirmai" : "Confirmai")</PageTitle>

<div class="sports-page">

    <div class="sports-tabs" role="tablist" aria-label="Jogos">
        <button class="sports-tab @(activeTab == "explorar" ? "sports-tab--active" : string.Empty)"
                type="button" role="tab" aria-selected="@(activeTab == "explorar")"
                @onclick='() => SetTabAsync("explorar")'>
            🔍 Explorar
        </button>
        <AuthorizeView>
            <Authorized>
                <button class="sports-tab @(activeTab == "meus-jogos" ? "sports-tab--active" : string.Empty)"
                        type="button" role="tab" aria-selected="@(activeTab == "meus-jogos")"
                        @onclick='() => SetTabAsync("meus-jogos")'>
                    📅 Meus Jogos
                </button>
            </Authorized>
        </AuthorizeView>
    </div>

    @if (activeTab == "explorar")
    {
        <section class="city-selector" aria-label="Filtro de cidade">
            <label class="city-label" for="city-select">
                <svg class="city-pin" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"
                     aria-hidden="true">
                    <path d="M20 10c0 6-8 13-8 13s-8-7-8-13a8 8 0 0 1 16 0Z" />
                    <circle cx="12" cy="10" r="3" />
                </svg>
                Cidade
            </label>
            <div class="city-controls">
                <select class="city-select" id="city-select" @bind="SelectedCityKey">
                    @foreach (var c in Cities)
                    {
                        <option value="@c.Key">@c.Label</option>
                    }
                    <option value="__other__">Outra cidade...</option>
                </select>
                @if (SelectedCityKey == "__other__")
                {
                    <input class="city-input"
                           type="text"
                           placeholder="Ex: Belo Horizonte - MG"
                           maxlength="80"
                           @bind="CustomCity"
                           @bind:event="oninput" />
                }
            </div>
        </section>

        <section class="sports-grid" aria-label="Esportes disponíveis">
            <a href="@FutsalHref" class="sport-card sport-card--futsal">
                <div class="sport-card-icon" aria-hidden="true">⚽</div>
                <div class="sport-card-body">
                    <h3 class="sport-card-name">Futsal</h3>
                    <p class="sport-card-desc">Peladas, campeonatos e escolinhas na quadra</p>
                </div>
                <span class="sport-card-cta">Ver partidas →</span>
            </a>
            <a href="@PokerHref" class="sport-card sport-card--poker">
                <div class="sport-card-icon" aria-hidden="true">🃏</div>
                <div class="sport-card-body">
                    <h3 class="sport-card-name">Poker</h3>
                    <p class="sport-card-desc">Torneios, cash games e ligas semanais</p>
                </div>
                <span class="sport-card-cta">Ver torneios →</span>
            </a>
        </section>
    }
    else
    {
        <AuthorizeView>
            <Authorized>
                <div class="my-conf-container">
                    @if (confLoading)
                    {
                        <p class="listing-state">Carregando suas confirmações…</p>
                    }
                    else if (!upcoming.Any() && !past.Any() && !cancelled.Any())
                    {
                        <div class="listing-state listing-empty">
                            <p>Você ainda não confirmou presença em nenhum evento.</p>
                            <div style="margin-top:.75rem;display:flex;gap:.5rem;flex-wrap:wrap">
                                <a href="/futsal" class="my-conf-browse-btn">⚽ Ver Futsal</a>
                                <a href="/poker"  class="my-conf-browse-btn my-conf-browse-btn--poker">🃏 Ver Poker</a>
                            </div>
                        </div>
                    }
                    else
                    {
                        @if (upcoming.Any())
                        {
                            <div class="my-conf-section">
                                <h2 class="my-conf-section-title">
                                    <i class="fas fa-calendar-check"></i> Próximos (@upcoming.Count)
                                </h2>
                                <div class="my-conf-list">
                                    @foreach (var c in upcoming)
                                    {
                                        var ev       = c.Event;
                                        var isFutsal = ev.Sport == Sport.Futsal;
                                        var detailUrl = isFutsal ? $"/futsal/{ev.Id}" : $"/poker/{ev.Id}";
                                        <div class="my-conf-card">
                                            <div class="my-conf-sport @(isFutsal ? "my-conf-sport--futsal" : "my-conf-sport--poker")">
                                                @(isFutsal ? "⚽" : "🃏")
                                            </div>
                                            <div class="my-conf-body">
                                                <div class="my-conf-name-row">
                                                    <strong class="my-conf-name">@ev.Group.Name</strong>
                                                    <span class="meta-chip meta-chip--confirmed"><i class="fas fa-check"></i> Confirmado</span>
                                                    @if (isFutsal && c.Position.HasValue)
                                                    {
                                                        <span class="my-conf-pos">@(c.Position == FutsalPosition.Goalkeeper ? "🥅 Goleiro" : "👟 Linha")</span>
                                                    }
                                                    @if (!isFutsal && ev.PokerEventType.HasValue)
                                                    {
                                                        <span class="my-conf-pos">@PokerTypeLabel(ev.PokerEventType)</span>
                                                    }
                                                </div>
                                                <p class="my-conf-meta">📅 @ev.StartsAt.ToLocalTime().ToString("ddd, dd/MM/yyyy 'às' HH:mm", PtBr)</p>
                                                <p class="my-conf-meta">📍 @ev.Location &nbsp;·&nbsp; 👥 @ev.Confirmations.Count confirmados</p>
                                            </div>
                                            <div class="my-conf-actions">
                                                <a href="@detailUrl" class="my-conf-btn my-conf-btn--view"><i class="fas fa-arrow-right"></i> Entrar</a>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (past.Any() || cancelled.Any())
                        {
                            <div class="my-conf-history-tabs">
                                <button class="my-conf-tab @(!showCancelled ? "active" : string.Empty)" type="button" @onclick="() => showCancelled = false">
                                    <i class="fas fa-history"></i> Anteriores (@past.Count)
                                </button>
                                <button class="my-conf-tab @(showCancelled ? "active" : string.Empty)" type="button" @onclick="() => showCancelled = true">
                                    <i class="fas fa-ban"></i> Canceladas (@cancelled.Count)
                                </button>
                            </div>

                            @if (!showCancelled)
                            {
                                @if (past.Any())
                                {
                                    <div class="my-conf-section my-conf-section--past">
                                        <div class="my-conf-list">
                                            @foreach (var c in past)
                                            {
                                                var ev       = c.Event;
                                                var isFutsal = ev.Sport == Sport.Futsal;
                                                var detailUrl = isFutsal ? $"/futsal/{ev.Id}" : $"/poker/{ev.Id}";
                                                <div class="my-conf-card my-conf-card--past">
                                                    <div class="my-conf-sport @(isFutsal ? "my-conf-sport--futsal" : "my-conf-sport--poker")">
                                                        @(isFutsal ? "⚽" : "🃏")
                                                    </div>
                                                    <div class="my-conf-body">
                                                        <div class="my-conf-name-row">
                                                            <strong class="my-conf-name">@ev.Group.Name</strong>
                                                            <span class="meta-chip meta-chip--confirmed"><i class="fas fa-check"></i> Confirmado</span>
                                                            @if (isFutsal && c.Position.HasValue)
                                                            {
                                                                <span class="my-conf-pos">@(c.Position == FutsalPosition.Goalkeeper ? "🥅 Goleiro" : "👟 Linha")</span>
                                                            }
                                                        </div>
                                                        <p class="my-conf-meta">📅 @ev.StartsAt.ToLocalTime().ToString("ddd, dd/MM/yyyy 'às' HH:mm", PtBr)</p>
                                                    </div>
                                                    <div class="my-conf-actions">
                                                        <a href="@detailUrl" class="my-conf-btn my-conf-btn--view"><i class="fas fa-arrow-right"></i> Entrar</a>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <p class="listing-state">Nenhuma partida anterior.</p>
                                }
                            }
                            else
                            {
                                @if (cancelled.Any())
                                {
                                    <div class="my-conf-section">
                                        <div class="my-conf-list">
                                            @foreach (var c in cancelled)
                                            {
                                                var ev       = c.Event;
                                                var isFutsal = ev.Sport == Sport.Futsal;
                                                var detailUrl = isFutsal ? $"/futsal/{ev.Id}" : $"/poker/{ev.Id}";
                                                <div class="my-conf-card my-conf-card--cancelled">
                                                    <div class="my-conf-sport @(isFutsal ? "my-conf-sport--futsal" : "my-conf-sport--poker")">
                                                        @(isFutsal ? "⚽" : "🃏")
                                                    </div>
                                                    <div class="my-conf-body">
                                                        <div class="my-conf-name-row">
                                                            <strong class="my-conf-name">@ev.Group.Name</strong>
                                                            <span class="my-conf-cancelled"><i class="fas fa-ban"></i> Cancelado</span>
                                                            @if (isFutsal && c.Position.HasValue)
                                                            {
                                                                <span class="my-conf-pos">@(c.Position == FutsalPosition.Goalkeeper ? "🥅 Goleiro" : "👟 Linha")</span>
                                                            }
                                                        </div>
                                                        <p class="my-conf-meta">📅 @ev.StartsAt.ToLocalTime().ToString("ddd, dd/MM/yyyy 'às' HH:mm", PtBr)</p>
                                                    </div>
                                                    <div class="my-conf-actions">
                                                        <a href="@detailUrl" class="my-conf-btn my-conf-btn--view"><i class="fas fa-arrow-right"></i> Entrar</a>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <p class="listing-state">Nenhuma partida cancelada.</p>
                                }
                            }
                        }
                    }
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="listing-state">
                    <p><a href="/Identity/Account/Login?ReturnUrl=%2F%3Ftab%3Dmeus-jogos">Faça login</a> para ver seus jogos.</p>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    }
</div>

@code {
    private static readonly CultureInfo PtBr = new("pt-BR");

    // ── Tab ────────────────────────────────────────────────────────
    [Parameter]
    [SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    private string activeTab = "explorar";

    // ── Explorar state ─────────────────────────────────────────────
    private record CityOption(string Key, string Label, string City, string StateCode);

    private List<CityOption> Cities = new();
    private string SelectedCityKey = "Pouso Alegre|MG";
    private string CustomCity = string.Empty;

    private string FutsalHref => BuildHref("/futsal");
    private string PokerHref  => BuildHref("/poker");

    private string BuildHref(string basePath)
    {
        if (SelectedCityKey == "__other__")
        {
            var trimmed = CustomCity.Trim();
            return string.IsNullOrEmpty(trimmed)
                ? basePath
                : $"{basePath}?cidade={Uri.EscapeDataString(trimmed)}";
        }
        var opt = Cities.FirstOrDefault(c => c.Key == SelectedCityKey);
        return opt is null
            ? basePath
            : $"{basePath}?cidade={Uri.EscapeDataString(opt.City)}&estado={opt.StateCode}";
    }

    // ── Meus Jogos state ───────────────────────────────────────────
    private List<EventConfirmation> upcoming  = new();
    private List<EventConfirmation> past      = new();
    private List<EventConfirmation> cancelled = new();
    private bool confLoaded    = false;
    private bool confLoading   = false;
    private bool showCancelled = false;
    private string userId      = string.Empty;

    protected override Task OnParametersSetAsync()
    {
        // Sync tab with URL (handles back/forward navigation and redirects from /minhas-confirmacoes).
        // userId may be empty here on first call (before OnInitializedAsync), so data loading
        // is deferred to OnInitializedAsync in that case.
        var newTab = Tab == "meus-jogos" ? "meus-jogos" : "explorar";
        activeTab = newTab;

        if (newTab == "meus-jogos" && !confLoaded && !string.IsNullOrWhiteSpace(userId))
            return LoadConfirmationsAsync();

        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        // Load city options
        await using var db = await DbFactory.CreateDbContextAsync();
        var rows = await db.Groups
            .Where(g => g.IsActive)
            .Select(g => new { g.City, g.StateCode })
            .Distinct()
            .OrderBy(c => c.City)
            .ToListAsync();

        Cities = rows
            .Select(r => new CityOption(
                $"{r.City}|{r.StateCode}",
                $"{r.City} - {r.StateCode}",
                r.City,
                r.StateCode))
            .ToList();

        const string defaultKey = "Pouso Alegre|MG";
        if (!Cities.Any(c => c.Key == defaultKey))
            Cities.Insert(0, new CityOption(defaultKey, "Pouso Alegre - MG", "Pouso Alegre", "MG"));

        // Resolve auth (unavailable during OnParametersSetAsync on first load)
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;

        // OnParametersSetAsync ran before us with empty userId; load now if still needed
        if (activeTab == "meus-jogos" && !confLoaded)
            await LoadConfirmationsAsync();
    }

    private async Task SetTabAsync(string tab)
    {
        activeTab = tab;
        NavigationManager.NavigateTo(tab == "meus-jogos" ? "/?tab=meus-jogos" : "/", replace: true);
        if (tab == "meus-jogos" && !confLoaded)
            await LoadConfirmationsAsync();
    }

    private async Task LoadConfirmationsAsync()
    {
        if (string.IsNullOrWhiteSpace(userId)) { confLoading = false; return; }

        confLoading = true;
        var now = DateTime.UtcNow;

        await using var db = await DbFactory.CreateDbContextAsync();
        var confs = await db.EventConfirmations
            .Include(c => c.Event).ThenInclude(e => e.Group)
            .Include(c => c.Event).ThenInclude(e => e.Confirmations)
            .Where(c => c.UserId == userId)
            .OrderBy(c => c.Event.StartsAt)
            .ToListAsync();

        upcoming  = confs.Where(c => c.Event.StartsAt >= now && c.Event.IsActive).ToList();
        past      = confs.Where(c => c.Event.StartsAt <  now && c.Event.IsActive)
                         .OrderByDescending(c => c.Event.StartsAt).ToList();
        cancelled = confs.Where(c => !c.Event.IsActive)
                         .OrderByDescending(c => c.Event.StartsAt).ToList();
        confLoading = false;
        confLoaded  = true;
    }

    private static string PokerTypeLabel(PokerEventType? t) => t switch
    {
        PokerEventType.CashGame => "💰 Cash",
        PokerEventType.HomeGame => "🏠 Home",
        _                       => "🏆 Torneio",
    };
}