@page "/futsal/{Id:int}/escalacao"

@using System.Security.Claims
@using System.Text
@using Confirmai.Data
@using Confirmai.Enums
@using Confirmai.Models
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop

@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Escalação · Confirmai</PageTitle>

@if (isLoading)
{
    <div class="esc-loading">Carregando…</div>
}
else if (ev is null)
{
    <div class="esc-not-found">
        <h2>Partida não encontrada.</h2>
        <a href="/futsal">← Voltar</a>
    </div>
}
else if (ev.LineupConfirmedAt is null && !isAdmin)
{
    <div class="esc-unavailable">
        <i class="fas fa-lock"></i>
        <p>A escalação ainda não foi montada pelo organizador.</p>
        <a href="/futsal/@ev.Id">← Voltar à partida</a>
    </div>
}
else
{
    <div class="esc-page">
        <div class="esc-card">
            <header class="esc-header">
                <a class="esc-back-link" href="/futsal/@ev.Id">← @ev.Group.Name</a>
                <h1 class="esc-title">
                    @if (ev.LineupConfirmedAt is null)
                    {
                        <span>Montar Escalação</span>
                    }
                    else
                    {
                        <span>Escalação</span>
                    }
                </h1>
                <p class="esc-date">
                    <i class="fas fa-calendar-alt"></i>
                    @ev.StartsAt.ToString("dd/MM/yyyy HH:mm")
                </p>
            </header>

            @* ── Estado: Confirmada ───────────────────────────────────── *@
            @if (ev.LineupConfirmedAt is not null)
            {
                var confA       = ev.Confirmations.Where(c => c.TeamId == 0).OrderBy(c => c.Position).ThenBy(c => c.ConfirmedAt).ToList();
                var confB       = ev.Confirmations.Where(c => c.TeamId == 1).OrderBy(c => c.Position).ThenBy(c => c.ConfirmedAt).ToList();
                var confReserva = ev.Confirmations.Where(c => c.TeamId == null).OrderBy(c => c.ConfirmedAt).ToList();

                <div class="esc-confirmed-badge">
                    <i class="fas fa-check-circle"></i>
                    Escalação confirmada em @ev.LineupConfirmedAt.Value.ToLocalTime().ToString("dd/MM HH:mm")
                </div>

                <div class="esc-teams">
                    <div class="esc-team esc-team--a">
                        <h2 class="esc-team-title">🟡 Time A</h2>
                        <ul class="esc-player-list">
                            @foreach (var c in confA.Where(c => c.Position == FutsalPosition.Goalkeeper))
                            {
                                <li class="esc-player esc-player--gk">
                                    <span class="esc-player-icon">🥅</span>
                                    <span class="esc-player-name">@(c.User.FullName ?? c.User.Email)</span>
                                </li>
                            }
                            @{ int numA = 1; }
                            @foreach (var c in confA.Where(c => c.Position != FutsalPosition.Goalkeeper))
                            {
                                <li class="esc-player">
                                    <span class="esc-player-num">@(numA++)</span>
                                    <span class="esc-player-name">@(c.User.FullName ?? c.User.Email)</span>
                                </li>
                            }
                        </ul>
                    </div>

                    <div class="esc-team esc-team--b">
                        <h2 class="esc-team-title">🔵 Time B</h2>
                        <ul class="esc-player-list">
                            @foreach (var c in confB.Where(c => c.Position == FutsalPosition.Goalkeeper))
                            {
                                <li class="esc-player esc-player--gk">
                                    <span class="esc-player-icon">🥅</span>
                                    <span class="esc-player-name">@(c.User.FullName ?? c.User.Email)</span>
                                </li>
                            }
                            @{ int numB = 1; }
                            @foreach (var c in confB.Where(c => c.Position != FutsalPosition.Goalkeeper))
                            {
                                <li class="esc-player">
                                    <span class="esc-player-num">@(numB++)</span>
                                    <span class="esc-player-name">@(c.User.FullName ?? c.User.Email)</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                @if (confReserva.Any())
                {
                    <div class="esc-reserva">
                        <h3 class="esc-reserva-title">🔄 Reserva</h3>
                        <ul class="esc-player-list">
                            @foreach (var c in confReserva)
                            {
                                <li class="esc-player">
                                    <span class="esc-player-name">@(c.User.FullName ?? c.User.Email)</span>
                                </li>
                            }
                        </ul>
                    </div>
                }

                <div class="esc-share-bar">
                    <button class="esc-btn esc-btn--secondary" @onclick="CopyToClipboard">
                        <i class="fas @(copied ? "fa-check" : "fa-copy")"></i>
                        @(copied ? "Copiado!" : "Copiar texto")
                    </button>
                    <button class="esc-btn esc-btn--whatsapp" @onclick="ShareOnWhatsApp">
                        <i class="fab fa-whatsapp"></i> Compartilhar no WhatsApp
                    </button>
                </div>

                @if (isAdmin)
                {
                    @if (!showResetModal)
                    {
                        <div class="esc-reset-zone">
                            <button class="esc-btn esc-btn--danger-ghost" @onclick="() => showResetModal = true">
                                <i class="fas fa-undo"></i> Resetar escalação
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="esc-modal-overlay">
                            <div class="esc-modal">
                                <p>Tem certeza? A escalação será desfeita e os jogadores voltarão a não ter time atribuído.</p>
                                <div class="esc-modal-actions">
                                    <button class="esc-btn esc-btn--secondary" @onclick="() => showResetModal = false" disabled="@isSaving">Cancelar</button>
                                    <button class="esc-btn esc-btn--danger" @onclick="ResetarEscalacao" disabled="@isSaving">
                                        @(isSaving ? "Resetando…" : "Sim, resetar")
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                }
            }

            @* ── Estado: Draft (admin montando) ──────────────────────── *@
            else
            {
                <div class="esc-teams">
                    <div class="esc-team esc-team--a">
                        <h2 class="esc-team-title">🟡 Time A</h2>
                        <ul class="esc-player-list">
                            @foreach (var s in teamA.Where(s => s.IsGoalkeeper))
                            {
                                <li class="esc-player esc-player--gk">
                                    <span class="esc-player-icon">🥅</span>
                                    <span class="esc-player-name">@s.Name</span>
                                </li>
                            }
                            @{ int draftNumA = 1; }
                            @foreach (var s in teamA.Where(s => !s.IsGoalkeeper))
                            {
                                <li class="esc-player">
                                    <span class="esc-player-num">@(draftNumA++)</span>
                                    <span class="esc-player-name">@s.Name</span>
                                </li>
                            }
                        </ul>
                    </div>

                    <div class="esc-team esc-team--b">
                        <h2 class="esc-team-title">🔵 Time B</h2>
                        <ul class="esc-player-list">
                            @foreach (var s in teamB.Where(s => s.IsGoalkeeper))
                            {
                                <li class="esc-player esc-player--gk">
                                    <span class="esc-player-icon">🥅</span>
                                    <span class="esc-player-name">@s.Name</span>
                                </li>
                            }
                            @{ int draftNumB = 1; }
                            @foreach (var s in teamB.Where(s => !s.IsGoalkeeper))
                            {
                                <li class="esc-player">
                                    <span class="esc-player-num">@(draftNumB++)</span>
                                    <span class="esc-player-name">@s.Name</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                @if (reservas.Any())
                {
                    <div class="esc-reserva">
                        <h3 class="esc-reserva-title">🔄 Reserva</h3>
                        <ul class="esc-player-list">
                            @foreach (var s in reservas)
                            {
                                <li class="esc-player">
                                    <span class="esc-player-name">@s.Name</span>
                                </li>
                            }
                        </ul>
                    </div>
                }

                @if (actionError is not null)
                {
                    <p class="esc-error">@actionError</p>
                }

                <div class="esc-draft-actions">
                    <button class="esc-btn esc-btn--secondary" @onclick="Randomize">
                        <i class="fas fa-random"></i> Randomizar
                    </button>
                    <button class="esc-btn esc-btn--primary" @onclick="() => showConfirmModal = true">
                        <i class="fas fa-check"></i> Confirmar escalação
                    </button>
                </div>

                @if (showConfirmModal)
                {
                    <div class="esc-modal-overlay">
                        <div class="esc-modal">
                            <p>Confirmar esta escalação? Os times ficarão visíveis para todos os confirmados.</p>
                            <div class="esc-modal-actions">
                                <button class="esc-btn esc-btn--secondary" @onclick="() => showConfirmModal = false" disabled="@isSaving">Cancelar</button>
                                <button class="esc-btn esc-btn--primary" @onclick="ConfirmarEscalacao" disabled="@isSaving">
                                    @(isSaving ? "Salvando…" : "Sim, confirmar")
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private Event?   ev        = null;
    private bool     isLoading = true;
    private string?  currentUserId;
    private bool     isAdmin;

    private record PlayerSlot(string UserId, string Name, bool IsGoalkeeper);
    private List<PlayerSlot> teamA    = new();
    private List<PlayerSlot> teamB    = new();
    private List<PlayerSlot> reservas = new();

    private bool    showConfirmModal = false;
    private bool    showResetModal   = false;
    private bool    isSaving         = false;
    private bool    copied           = false;
    private string? actionError;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
        await LoadEvent();
        if (ev?.LineupConfirmedAt is null && isAdmin)
            Randomize();
    }

    private async Task LoadEvent()
    {
        isLoading = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        ev = await db.Events
            .Include(e => e.Group)
            .Include(e => e.Confirmations)
                .ThenInclude(c => c.User)
            .FirstOrDefaultAsync(e => e.Id == Id && e.Sport == Sport.Futsal);
        isAdmin = EventAccess.IsCreator(ev, currentUserId);
        isLoading = false;
    }

    private void Randomize()
    {
        if (ev is null) return;

        var gks = ev.Confirmations
            .Where(c => c.Position == FutsalPosition.Goalkeeper)
            .OrderBy(c => c.ConfirmedAt)
            .ToList();

        var outfield = ev.Confirmations
            .Where(c => c.Position != FutsalPosition.Goalkeeper)
            .OrderBy(_ => Random.Shared.Next())
            .ToList();

        teamA.Clear(); teamB.Clear(); reservas.Clear();

        if (gks.Count >= 1)
            teamA.Add(new PlayerSlot(gks[0].UserId, gks[0].User.FullName ?? gks[0].User.Email!, true));
        if (gks.Count >= 2)
            teamB.Add(new PlayerSlot(gks[1].UserId, gks[1].User.FullName ?? gks[1].User.Email!, true));

        for (int i = 0; i < outfield.Count; i++)
        {
            var p    = outfield[i];
            var slot = new PlayerSlot(p.UserId, p.User.FullName ?? p.User.Email!, false);
            if (i % 2 == 0) teamA.Add(slot);
            else             teamB.Add(slot);
        }

        // Se número ímpar de linha: o último (que foi para teamA) vira reserva
        if (outfield.Count % 2 != 0 && teamA.Count > 0)
        {
            var last = teamA.Last(s => !s.IsGoalkeeper);
            teamA.Remove(last);
            reservas.Add(last);
        }
    }

    private async Task ConfirmarEscalacao()
    {
        if (ev is null) return;
        isSaving    = true;
        actionError = null;

        await using var db = await DbFactory.CreateDbContextAsync();

        var userIdToTeam = new Dictionary<string, int?>();
        foreach (var s in teamA)    userIdToTeam[s.UserId] = 0;
        foreach (var s in teamB)    userIdToTeam[s.UserId] = 1;
        foreach (var s in reservas) userIdToTeam[s.UserId] = null;

        var confs = await db.EventConfirmations
            .Where(c => c.EventId == Id)
            .ToListAsync();

        foreach (var c in confs)
        {
            if (userIdToTeam.TryGetValue(c.UserId, out var teamId))
                c.TeamId = teamId;
        }

        var dbEv = await db.Events.FindAsync(Id);
        if (dbEv is not null)
            dbEv.LineupConfirmedAt = DateTime.UtcNow;

        await db.SaveChangesAsync();
        showConfirmModal = false;
        isSaving         = false;
        await LoadEvent();
    }

    private async Task ResetarEscalacao()
    {
        if (ev is null) return;
        isSaving = true;

        await using var db = await DbFactory.CreateDbContextAsync();

        var confs = await db.EventConfirmations
            .Where(c => c.EventId == Id)
            .ToListAsync();
        foreach (var c in confs)
            c.TeamId = null;

        var dbEv = await db.Events.FindAsync(Id);
        if (dbEv is not null)
            dbEv.LineupConfirmedAt = null;

        await db.SaveChangesAsync();
        showResetModal = false;
        isSaving       = false;
        await LoadEvent();
        Randomize();
    }

    private async Task CopyToClipboard()
    {
        var text = BuildShareText();
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        copied = false;
        StateHasChanged();
    }

    private async Task ShareOnWhatsApp()
    {
        var url = $"https://wa.me/?text={Uri.EscapeDataString(BuildShareText())}";
        await JS.InvokeVoidAsync("open", url, "_blank", "noopener,noreferrer");
    }

    private string BuildShareText()
    {
        if (ev is null) return string.Empty;

        var sb   = new StringBuilder();
        var teamAConfs   = ev.Confirmations.Where(c => c.TeamId == 0).OrderBy(c => c.Position).ThenBy(c => c.ConfirmedAt).ToList();
        var teamBConfs   = ev.Confirmations.Where(c => c.TeamId == 1).OrderBy(c => c.Position).ThenBy(c => c.ConfirmedAt).ToList();
        var reservaConfs = ev.Confirmations.Where(c => c.TeamId == null).OrderBy(c => c.ConfirmedAt).ToList();

        sb.AppendLine($"⚽ *Escalação — {ev.Group.Name}*");
        sb.AppendLine($"📅 {ev.StartsAt.ToString("dd/MM/yyyy HH:mm")}");
        sb.AppendLine();

        sb.AppendLine("*🟡 TIME A*");
        foreach (var c in teamAConfs.Where(c => c.Position == FutsalPosition.Goalkeeper))
            sb.AppendLine($"🥅 {c.User.FullName ?? c.User.Email}");
        int i = 1;
        foreach (var c in teamAConfs.Where(c => c.Position != FutsalPosition.Goalkeeper))
            sb.AppendLine($"{i++}. {c.User.FullName ?? c.User.Email}");
        sb.AppendLine();

        sb.AppendLine("*🔵 TIME B*");
        foreach (var c in teamBConfs.Where(c => c.Position == FutsalPosition.Goalkeeper))
            sb.AppendLine($"🥅 {c.User.FullName ?? c.User.Email}");
        i = 1;
        foreach (var c in teamBConfs.Where(c => c.Position != FutsalPosition.Goalkeeper))
            sb.AppendLine($"{i++}. {c.User.FullName ?? c.User.Email}");

        if (reservaConfs.Any())
        {
            sb.AppendLine();
            sb.AppendLine("🔄 *Reserva*");
            foreach (var c in reservaConfs)
                sb.AppendLine($"• {c.User.FullName ?? c.User.Email}");
        }

        return sb.ToString().TrimEnd();
    }
}
