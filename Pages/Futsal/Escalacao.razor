@page "/futsal/{Id:int}/escalacao"

@using System.Security.Claims
@using System.Text
@using Confirmai.Enums
@using Confirmai.Models
@using Confirmai.Pages.Components
@using Confirmai.Pages.Futsal.Components
@using Confirmai.Services.Futsal
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@implements IAsyncDisposable

@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject Confirmai.Services.Core.UiTextService Ui

<PageTitle>@(isPastEvent ? Ui["Futsal.PostMatchPageTitle"] : Ui["Futsal.EscalacaoPageTitle"]) · Confirmai</PageTitle>

@if (isLoading)
{
    <div class="esc-loading">@Ui["Common.Loading"]</div>
}
else if (ev is null)
{
    <div class="esc-not-found">
        <h2>@Ui["Futsal.MatchNotFound"]</h2>
        <a href="/futsal">← @Ui["Common.Back"]</a>
    </div>
}
else if (!isPastEvent && ev.LineupConfirmedAt is null && !isAdmin)
{
    <div class="esc-page">
        <div class="esc-card esc-card--gate">
            <div class="esc-gate">
                <div class="esc-gate-icon"><i class="fas fa-lock"></i></div>
                <h2 class="esc-gate-title">@Ui["Futsal.EscalacaoNotAvailable"]</h2>
                <p class="esc-gate-msg">@Ui["Futsal.EscalacaoNotMounted"]</p>
                <a class="esc-gate-back" href="/futsal/@ev.Id"><i class="fas fa-arrow-left"></i> @Ui["Futsal.BackToMatch"]</a>
            </div>
        </div>
    </div>
}
else if (isPastEvent && !isMember && !isAdmin)
{
    <div class="esc-page">
        <div class="esc-card esc-card--gate">
            <div class="esc-gate">
                <div class="esc-gate-icon esc-gate-icon--past"><i class="fas fa-flag-checkered"></i></div>
                <h2 class="esc-gate-title">@Ui["Futsal.PostMatchPageTitle"]</h2>
                <p class="esc-gate-msg">@Ui["Futsal.PostMatchOnlyMembers"]</p>
                <a class="esc-gate-back" href="/futsal/@ev.Id"><i class="fas fa-arrow-left"></i> @Ui["Futsal.BackToMatch"]</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="esc-page">
        <div class="esc-card">
            <header class="esc-header">
                <div class="esc-header-top">
                    <h1 class="esc-title">
                        @if (isPastEvent)
                        {
                            <span><i class="fas fa-flag-checkered"></i> @Ui["Futsal.PostMatchPageTitle"]</span>
                        }
                        else if (ev.LineupConfirmedAt is null)
                        {
                            <span>@Ui["Futsal.MontarEscalacao"]</span>
                        }
                        else
                        {
                            <span>@Ui["Futsal.EscalacaoPageTitle"]</span>
                        }
                    </h1>
                    <a class="detail-back-link" href="/futsal/@ev.Id"><i class="fas fa-arrow-left"></i> @Ui["Futsal.BackToMatch"]</a>
                </div>
                <p class="esc-date">
                    <i class="fas fa-calendar-alt"></i>
                    @ev.StartsAt.ToString("dd/MM/yyyy HH:mm")
                </p>
            </header>

            @* ── Estado: Confirmada ───────────────────────────────────── *@
            @if (ev.LineupConfirmedAt is not null)
            {
                @if (!isPastEvent)
                {
                    <div class="esc-confirmed-badge">
                        <i class="fas fa-check-circle"></i>
                        @Ui.Get("Futsal.EscalacaoConfirmedAt", ev.LineupConfirmedAt.Value.ToLocalTime().ToString("dd/MM HH:mm"))
                    </div>
                }

                <EscalacaoConfirmed
                    Event="@ev"
                    IsPastEvent="@isPastEvent"
                    IsAdmin="@isAdmin"
                    TeamAName="@teamAName"
                    TeamBName="@teamBName"
                    OnTeamNamesChanged="@HandleTeamNamesChanged"
                    AllVotes="@allVotes" />

                @* ── Placar pós-partida ───────────────────────────────── *@
                @if (isPastEvent)
                {
                    <EscalacaoScoreEditor
                        ScoreTeamA="@ev.ScoreTeamA"
                        ScoreTeamB="@ev.ScoreTeamB"
                        @bind-ScoreInputA="scoreInputA"
                        @bind-ScoreInputB="scoreInputB"
                        EditingScore="@editingScore"
                        ScoreError="@scoreError"
                        TeamAName="@teamAName"
                        TeamBName="@teamBName"
                        IsMember="@isMember"
                        IsAdmin="@isAdmin"
                        IsSaving="@isSaving"
                        ScoreRegisteredByName="@scoreRegisteredByName"
                        ScoreRegisteredAt="@ev.ScoreRegisteredAt"
                        OnEditingScoreChanged="@EditingScoreChangedCallback"
                        OnSaveScore="@SaveScoreCallback" />
                }


                <EscalacaoVoting
                    Event="@ev"
                    IsPastEvent="@isPastEvent"
                    IsMember="@isMember"
                    IsAdmin="@isAdmin"
                    CurrentUserId="@currentUserId"
                    AllVotes="@allVotes"
                    MyVote="@myVote"
                    IsEditingVote="@isEditingVote"
                    VoteError="@voteError"
                    OnCastVote="@CastVote"
                    OnEditingVoteChanged="@HandleEditingVoteChanged" />

                @if (!isPastEvent)
                {
                    <EscalacaoShare
                        Copied="@copied"
                        OnCopyToClipboard="@CopyToClipboardCallback"
                        OnShareOnWhatsApp="@ShareOnWhatsAppCallback" />
                }

                @if (isAdmin && !isPastEvent)
                {
                    @if (!showResetModal)
                    {
                        <div class="esc-reset-zone">
                            <button class="esc-btn esc-btn--danger-ghost" @onclick="() => showResetModal = true">
                                <i class="fas fa-undo"></i> @Ui["Futsal.ResetEscalacao"]
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="esc-modal-overlay">
                            <div class="esc-modal">
                                <p>@Ui["Futsal.ResetConfirm"]</p>
                                <div class="esc-modal-actions">
                                    <button class="esc-btn esc-btn--secondary" @onclick="() => showResetModal = false" disabled="@isSaving">@Ui["Common.Cancel"]</button>
                                    <button class="esc-btn esc-btn--danger" @onclick="ResetarEscalacao" disabled="@isSaving">
                                        @(isSaving ? @Ui["Futsal.Resetting"] : @Ui["Futsal.SimResetar"])
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                }
            }

            @* ── Estado: Draft (admin montando) ──────────────────────── *@
            else
            {
                <EscalacaoDraftTeamBuilder
                    TeamA="@teamA"
                    TeamB="@teamB"
                    Reservas="@reservas"
                    TeamAName="@teamAName"
                    TeamBName="@teamBName"
                    IsAdmin="@isAdmin"
                    OnSaveTeamNames="@SaveTeamNamesCallback"
                    OnMovePlayer="@MovePlayerCallback" />

                @if (actionError is not null)
                {
                    <p class="esc-error">@actionError</p>
                }

                <EscalacaoControls
                    TeamsAreBalanced="@TeamsAreBalanced"
                    ShowConfirmModal="@showConfirmModal"
                    IsSaving="@isSaving"
                    OnRandomize="@RandomizeCallback"
                    OnShowConfirmModalChanged="@ShowConfirmModalChangedCallback"
                    OnConfirmEscalacao="@ConfirmarEscalacaoCallback" />
            }
        </div>
    </div>
}

