@page "/futsal/create"

@attribute [Authorize]

@* groupId pode ser passado via ?groupId=X para associar a um grupo existente *@

@using System.Security.Claims
@using Confirmai.Data
@using Confirmai.Enums
@using Confirmai.Models
@using Confirmai.Pages.Futsal.Components
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore

@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject Confirmai.Services.Events.EventCollisionService EventCollisionService
@inject LogService LogService


<PageTitle>Criar Partida · Futsal · Confirmai</PageTitle>

<div class="create-event-page">
    <div class="create-event-card">
        <h1 class="create-event-title">
            <i class="fas fa-futbol"></i>
            @(preselectedGroup is not null
                ? $"Nova Partida — {preselectedGroup.Name}"
                : "Nova Partida de Futsal")
        </h1>

        @if (isLoading)
        {
            <div class="loading-spinner">Carregando...</div>
        }
        else
        {
            <EditForm Model="form" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <ValidationSummary class="validation-summary" />

                @* ── Identidade da partida ─────────────────────────────────────────────────── *@
                <FutsalMatchIdentity
                    Form="@form"
                    SubFormat="@subFormat"
                    PreselectedGroup="@preselectedGroup"
                    OnSubFormatChanged="@SubFormatChangedCallback" />

                @* ── Quadra ────────────────────────────────────────────────────────────────── *@
                <VenueSelector
                    Venues="@venues"
                    SelectedVenueId="@form.VenueId"
                    SelectedVenue="@selectedVenue"
                    OnVenueChanged="@VenueChangedCallback" />

                @* ── Data, hora e duração ───────────────────────────────────────────────────── *@
                <DateTimeSelector
                    Form="@form"
                    OnTimeChange="@TimeChangeCallback" />

                @* ── Vagas ──────────────────────────────────────────────────────────────────── *@
                <SlotsAndGoalkeeperConfig
                    Form="@form"
                    OnRotateInGoalChanged="@RotateInGoalChangedCallback" />

                @* ── Valor ──────────────────────────────────────────────────────────────────── *@
                <PriceInput Form="@form" />

                @* ── Periodicidade ──────────────────────────────────────────────────────────── *@
                <RecurrenceScheduler
                    Form="@form"
                    OnToggleDay="@ToggleDayCallback" />

                @* ── Privacidade: grupos são sempre privados ─────────────────────────────────── *@

                @if (!string.IsNullOrWhiteSpace(saveError))
                {
                    <p class="validation-message">
                        @saveError
                        @if (!string.IsNullOrWhiteSpace(collisionHref))
                        {
                            <a href="@collisionHref" class="collision-link">@Confirmai.Services.Events.EventCollisionService.OpenExistingEventLinkText</a>
                        }
                    </p>
                }

                <div class="form-actions">
                    <button class="cancel-btn" type="button"
                            @onclick='() => NavigationManager.NavigateTo(preselectedGroup is not null ? $"/grupo/{preselectedGroup.Id}" : "/grupos")'>
                        Cancelar
                    </button>
                    <button class="save-btn" type="submit" disabled="@(isSaving || !venues.Any())">
                        @(isSaving ? "Criando…" : "Criar Partida")
                    </button>
                </div>

            </EditForm>
        }
    </div>
</div>

