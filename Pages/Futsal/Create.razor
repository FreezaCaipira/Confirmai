@page "/futsal/create"

@attribute [Authorize]

@using System.Security.Claims
@using Confirmai.Data
@using Confirmai.Enums
@using Confirmai.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore

@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Criar Partida · Futsal · Confirmai</PageTitle>

<div class="create-event-page">
    <div class="create-event-card">
        <h1 class="create-event-title">
            <i class="fas fa-futbol"></i> Nova Partida de Futsal
        </h1>

        @if (isLoading)
        {
            <div class="loading-spinner">Carregando...</div>
        }
        else
        {
            <EditForm Model="form" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <ValidationSummary class="validation-summary" />

                @* ── Identidade da partida ───────────────────────────────────── *@
                <fieldset class="form-section">
                    <legend>Identidade da Partida</legend>

                    <div class="form-group">
                        <label>Nome da partida <span class="required">*</span></label>
                        <InputText class="input" @bind-Value="form.GroupName"
                                   placeholder='Ex: "Rachão da Galera do Zé", "Pelada de Quinta"' />
                        <ValidationMessage For="@(() => form.GroupName)" class="validation-message" />
                    </div>

                    <div class="form-group">
                        <label>Como vocês chamam o jogo na sua região?</label>
                        <InputText class="input" @bind-Value="form.LocalName"
                                   placeholder='racha, pelada, baba, rachão…' maxlength="60" />
                        <small class="form-hint">Opcional — aparece nos cards para identificar o estilo da região.</small>
                    </div>
                </fieldset>

                @* ── Quadra ──────────────────────────────────────────────────── *@
                <fieldset class="form-section">
                    <legend>Local</legend>

                    <div class="form-group">
                        <label>Quadra / Society / Campo <span class="required">*</span></label>
                        @if (!venues.Any())
                        {
                            <p class="form-hint form-hint--warn">
                                Nenhuma quadra cadastrada ainda. Solicite ao administrador do sistema.
                            </p>
                        }
                        else
                        {
                            <InputSelect class="input" @bind-Value="form.VenueId" @bind-Value:after="OnVenueChanged">
                                <option value="0">— Selecione a quadra —</option>
                                @foreach (var v in venues)
                                {
                                    <option value="@v.Id">@v.Name (@VenueTypeLabel(v.Type)) — @v.City/@v.StateCode</option>
                                }
                            </InputSelect>
                        }
                        @if (form.VenueId == 0)
                        {
                            <ValidationMessage For="@(() => form.VenueId)" class="validation-message" />
                        }
                    </div>

                    @if (selectedVenue is not null)
                    {
                        <div class="venue-preview">
                            <i class="fas fa-map-marker-alt"></i>
                            <span>@selectedVenue.Address · @selectedVenue.City — @selectedVenue.StateCode</span>
                        </div>
                    }
                </fieldset>

                @* ── Data, hora e duração ────────────────────────────────────── *@
                <fieldset class="form-section">
                    <legend>Data &amp; Horário</legend>

                    <div class="form-row-2">
                        <div class="form-group">
                            <label>Data <span class="required">*</span></label>
                            <InputDate class="input" @bind-Value="form.Date" />
                            <ValidationMessage For="@(() => form.Date)" class="validation-message" />
                        </div>
                        <div class="form-group">
                            <label>Hora de início <span class="required">*</span></label>
                            <input type="time" class="input"
                                   value="@form.Time.ToString("HH:mm")"
                                   @onchange="OnTimeChange" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Duração <span class="required">*</span></label>
                        <InputSelect class="input" @bind-Value="form.DurationMinutes">
                            @foreach (var (min, label) in DurationOptions)
                            {
                                <option value="@min">@label</option>
                            }
                        </InputSelect>
                    </div>
                </fieldset>

                @* ── Vagas ───────────────────────────────────────────────────── *@
                <fieldset class="form-section">
                    <legend>Vagas</legend>

                    <div class="form-row-2">
                        <div class="form-group">
                            <label>Nº de jogadores <span class="required">*</span></label>
                            <InputNumber class="input" @bind-Value="form.MaxPlayers" min="4" max="100" />
                            <ValidationMessage For="@(() => form.MaxPlayers)" class="validation-message" />
                        </div>
                        <div class="form-group">
                            <label>Nº de goleiros</label>
                            <InputNumber class="input" @bind-Value="form.MaxGoalkeepers" min="0" max="10" />
                            <small class="form-hint">Deixe 0 se não há vaga separada para goleiros.</small>
                        </div>
                    </div>
                </fieldset>

                @* ── Valor ───────────────────────────────────────────────────── *@
                <fieldset class="form-section">
                    <legend>Valor</legend>

                    <div class="form-group">
                        <label>Valor por jogador (R$) <span class="required">*</span></label>
                        <div class="input-prefix-wrap">
                            <span class="input-prefix">R$</span>
                            <InputNumber class="input" @bind-Value="form.Price" min="0" step="0.50" />
                        </div>
                        <ValidationMessage For="@(() => form.Price)" class="validation-message" />
                        <small class="form-hint">Use 0 para partidas sem cobrança.</small>
                    </div>
                </fieldset>

                @* ── Periodicidade ───────────────────────────────────────────── *@
                <fieldset class="form-section">
                    <legend>Periodicidade</legend>

                    <label class="switch-label">
                        <input type="checkbox" @bind="form.RecurrenceEnabled" />
                        Esta partida se repete semanalmente
                    </label>

                    @if (form.RecurrenceEnabled)
                    {
                        <div class="form-group" style="margin-top:.9rem">
                            <label>Dias da semana</label>
                            <div class="weekday-grid">
                                @foreach (var (dow, label) in WeekdayOptions)
                                {
                                    <label class="weekday-chip @(form.SelectedDays.Contains(dow) ? "weekday-chip--on" : "")">
                                        <input type="checkbox"
                                               checked="@form.SelectedDays.Contains(dow)"
                                               @onchange="e => ToggleDay(dow, (bool)(e.Value ?? false))" />
                                        @label
                                    </label>
                                }
                            </div>
                        </div>
                    }
                </fieldset>

                @if (!string.IsNullOrWhiteSpace(saveError))
                {
                    <p class="validation-message">@saveError</p>
                }

                <div class="form-actions">
                    <button class="cancel-btn" type="button"
                            @onclick='() => NavigationManager.NavigateTo("/futsal")'>
                        Cancelar
                    </button>
                    <button class="save-btn" type="submit" disabled="@(isSaving || !venues.Any())">
                        @(isSaving ? "Criando…" : "Criar Partida")
                    </button>
                </div>

            </EditForm>
        }
    </div>
</div>

@code {
    // ── Form model ──────────────────────────────────────────────────────────

    private sealed class CreateMatchForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Informe o nome da partida.")]
        [System.ComponentModel.DataAnnotations.StringLength(120, ErrorMessage = "Máximo 120 caracteres.")]
        public string GroupName { get; set; } = string.Empty;

        public string? LocalName { get; set; }

        [System.ComponentModel.DataAnnotations.Range(1, int.MaxValue, ErrorMessage = "Selecione a quadra.")]
        public int VenueId { get; set; } = 0;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Informe a data.")]
        public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Now.AddDays(1));

        public TimeOnly Time { get; set; } = new TimeOnly(20, 0);

        public int DurationMinutes { get; set; } = 90;

        [System.ComponentModel.DataAnnotations.Range(4, 100, ErrorMessage = "Mínimo 4 jogadores.")]
        public int MaxPlayers { get; set; } = 14;

        public int MaxGoalkeepers { get; set; } = 2;

        [System.ComponentModel.DataAnnotations.Range(0, 10000, ErrorMessage = "Valor inválido.")]
        public decimal Price { get; set; } = 0;

        public bool RecurrenceEnabled { get; set; } = false;
        public HashSet<DayOfWeek> SelectedDays { get; set; } = new();
    }

    // ── State ────────────────────────────────────────────────────────────────

    private CreateMatchForm form      = new();
    private List<Venue>    venues     = new();
    private Venue?         selectedVenue;
    private bool           isLoading = true;
    private bool           isSaving  = false;
    private string         saveError = string.Empty;

    // ── Options ──────────────────────────────────────────────────────────────

    private static readonly (int Min, string Label)[] DurationOptions =
    [
        (60,  "1h"),
        (75,  "1h15min"),
        (90,  "1h30min"),
        (105, "1h45min"),
        (120, "2h"),
        (150, "2h30min"),
        (180, "3h"),
    ];

    private static readonly (DayOfWeek Dow, string Label)[] WeekdayOptions =
    [
        (DayOfWeek.Monday,    "Seg"),
        (DayOfWeek.Tuesday,   "Ter"),
        (DayOfWeek.Wednesday, "Qua"),
        (DayOfWeek.Thursday,  "Qui"),
        (DayOfWeek.Friday,    "Sex"),
        (DayOfWeek.Saturday,  "Sáb"),
        (DayOfWeek.Sunday,    "Dom"),
    ];

    // ── Lifecycle ────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        venues = await db.Venues
            .Where(v => v.IsActive)
            .OrderBy(v => v.City)
            .ThenBy(v => v.Name)
            .ToListAsync();
        isLoading = false;
    }

    private void OnVenueChanged()
    {
        selectedVenue = venues.FirstOrDefault(v => v.Id == form.VenueId);
    }

    private void ToggleDay(DayOfWeek dow, bool on)
    {
        if (on) form.SelectedDays.Add(dow);
        else    form.SelectedDays.Remove(dow);
    }

    private void OnTimeChange(ChangeEventArgs e)
        => form.Time = TimeOnly.TryParse(e.Value?.ToString(), out var t) ? t : new TimeOnly(19, 0);

    private async Task Save()
    {
        isSaving  = true;
        saveError = string.Empty;

        try
        {
            var auth   = await AuthStateProvider.GetAuthenticationStateAsync();
            var userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);

            if (string.IsNullOrWhiteSpace(userId))
            {
                saveError = "Você precisa estar autenticado.";
                return;
            }

            var venue = venues.FirstOrDefault(v => v.Id == form.VenueId);
            if (venue is null)
            {
                saveError = "Quadra inválida.";
                return;
            }

            // StartsAt em UTC
            var startsAt = DateTime.SpecifyKind(
                form.Date.ToDateTime(form.Time),
                DateTimeKind.Utc);

            await using var db = await DbFactory.CreateDbContextAsync();

            // 1 — Criar Group
            var group = new Group
            {
                Name            = form.GroupName,
                Sport           = Sport.Futsal,
                City            = venue.City,
                StateCode       = venue.StateCode,
                IsActive        = true,
                CreatedByUserId = userId,
            };
            db.Groups.Add(group);
            await db.SaveChangesAsync(); // gera group.Id

            // 2 — Criar GroupMember (criador = Admin)
            db.GroupMembers.Add(new GroupMember
            {
                GroupId = group.Id,
                UserId  = userId,
                Role    = GroupMemberRole.Admin,
            });

            // 3 — Criar primeiro Event
            var ev = new Event
            {
                GroupId         = group.Id,
                Sport           = Sport.Futsal,
                VenueId         = venue.Id,
                Location        = venue.Address,
                LocalName       = form.LocalName,
                StartsAt        = startsAt,
                DurationMinutes = form.DurationMinutes,
                Price           = form.Price,
                MaxPlayers      = form.MaxPlayers,
                MaxGoalkeepers  = form.MaxGoalkeepers > 0 ? form.MaxGoalkeepers : null,
                IsActive        = true,
                CreatedByUserId = userId,
            };
            db.Events.Add(ev);

            // 4 — Criar MatchSchedule para cada dia selecionado (se periódico)
            if (form.RecurrenceEnabled && form.SelectedDays.Any())
            {
                foreach (var dow in form.SelectedDays)
                {
                    db.RachaSchedules.Add(new MatchSchedule
                    {
                        GroupId         = group.Id,
                        VenueId         = venue.Id,
                        DayOfWeek       = dow,
                        TimeOfDay       = form.Time,
                        DurationMinutes = form.DurationMinutes,
                        Price           = form.Price,
                        MaxPlayers      = form.MaxPlayers,
                        LocalName       = form.LocalName,
                        IsActive        = true,
                        CreatedByUserId = userId,
                    });
                }
            }

            await db.SaveChangesAsync();
            NavigationManager.NavigateTo($"/futsal/{ev.Id}");
        }
        catch (Exception ex)
        {
            saveError = $"Erro ao criar partida: {ex.Message}";
            isSaving  = false;
        }
    }

    private static string VenueTypeLabel(VenueType t) => t switch
    {
        VenueType.Quadra  => "Quadra",
        VenueType.Society => "Society",
        VenueType.Campo   => "Campo",
        _                 => t.ToString()
    };
}
