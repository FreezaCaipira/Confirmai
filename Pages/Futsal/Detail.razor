@page "/futsal/{Id:int}"

@attribute [AllowAnonymous]

@using System.Security.Claims
@using Confirmai.Enums
@using Confirmai.Models
@using Confirmai.Shared.Helpers
@using Confirmai.Shared.Components.Futsal
@using Confirmai.Pages.Futsal.Components
@using Confirmai.Services.Admin
@using Confirmai.Services.Futsal
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop

@inject AdminConfirmationService AdminConfirmationService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject IConfiguration Config
@inject IJSRuntime JS
@inject Confirmai.Services.Core.UiTextService Ui

<PageTitle>@(ev?.Group?.Name ?? Ui["Futsal.PageTitle"]) · Confirmai</PageTitle>

@if (isLoading)
{
    <div class="detail-loading">
        <DetailSkeleton />
    </div>
}
else if (ev is null)
{
    <div class="detail-not-found">
        <h2>@Ui["Futsal.MatchNotFound"]</h2>
        <a href="/">← @Ui["Common.Back"]</a>
    </div>
}
else
{
    var confirmedOut = ev.Confirmations.Count(c => c.Position != FutsalPosition.Goalkeeper);
    var confirmedGk  = ev.Confirmations.Count(c => c.Position == FutsalPosition.Goalkeeper);
    var maxOut       = ev.MaxGoalkeepers.HasValue ? ev.MaxPlayers - ev.MaxGoalkeepers.Value : ev.MaxPlayers;
    var isFullOut    = maxOut > 0 && confirmedOut >= maxOut;
    var isFullGk     = ev.MaxGoalkeepers > 0 && confirmedGk >= ev.MaxGoalkeepers;
    var userConf     = currentUserId is not null ? ev.Confirmations.FirstOrDefault(c => c.UserId == currentUserId) : null;
    var userOnWaitlist = userWaitlistEntry is not null;
    var isMember     = currentUserId is not null && ev.Group.Members.Any(m => m.UserId == currentUserId);
    var isAdmin      = IsGroupAdmin();
    var eventEndsAt  = ev.StartsAt.AddMinutes(ev.DurationMinutes ?? 120);
    var isPastEvent  = eventEndsAt < DateTime.UtcNow;

    <div class="detail-page">
        <div class="detail-card">
            @* ── Cabeçalho ────────────────────────────────────────────── *@
            <DetailEventHeader
                Event="@ev"
                EventNumber="@eventNumber"
                CreatorUser="@creatorUser" />

            @if (!ev.IsActive)
            {
                <div class="cancelled-banner">
                    <i class="fas fa-ban"></i> @Ui["Futsal.MatchCancelled"]
                </div>
            }

            @* ── Info chips ───────────────────────────────────────────── *@
            <DetailChipsRow Event="@ev" />

            @* ── Mapa da quadra ───────────────────────────────────────── *@
            @{
                var mapAddr = ev.Venue is not null
                    ? $"{ev.Venue.Name}, {ev.Venue.City}, {ev.Venue.StateCode}, Brasil"
                    : ev.Location;
            }
            @if (!string.IsNullOrWhiteSpace(mapAddr))
            {
                <DetailLocationSection
                    Event="@ev"
                    MapsApiKey="@(Config["Google:MapsApiKey"] ?? string.Empty)" />
            }

            @* ── Quórum ───────────────────────────────────────────────── *@
            @{
                bool hasQuorum = EventMinimums.HasQuorum(ev.Sport, confirmedOut, confirmedGk);
                int  lacking   = EventMinimums.Lacking(ev.Sport, confirmedOut, confirmedGk);
                var  minInfo   = EventMinimums.Get(ev.Sport);
            }
            @if (minInfo.Total > 0)
            {
                <DetailQuorumBar
                    HasQuorum="@hasQuorum"
                    IsPastEvent="@isPastEvent"
                    MinOutfield="@minInfo.MinOutfield"
                    MinGoalkeepers="@minInfo.MinGoalkeepers" />
            }

            @* ── Jogadores ────────────────────────────────────────────── *@
            <section class="detail-section">
                @{
                    var outFieldPlayers = ev.Confirmations
                        .Where(c => c.Position != FutsalPosition.Goalkeeper)
                        .OrderBy(c => c.ConfirmedAt)
                        .ToList();
                    var gkPlayers = ev.Confirmations
                        .Where(c => c.Position == FutsalPosition.Goalkeeper)
                        .OrderBy(c => c.ConfirmedAt)
                        .ToList();
                    int outFieldSlots = maxOut > 0 ? maxOut : outFieldPlayers.Count;
                    bool canConfirm = ev.IsActive && !isPastEvent && currentUserId is not null && userConf is null && !userOnWaitlist
                                      && (!ev.Group.IsPrivate || isMember);
                    int baseOut = ev.PlayersPerSide.HasValue ? (ev.PlayersPerSide.Value - 1) * 2 : ev.MaxPlayers;
                    var detailMvpGroup = detailMvpVotes.GroupBy(v => v.VotedForUserId).OrderByDescending(g => g.Count()).FirstOrDefault();
                    var detailMvpUserId = detailMvpGroup?.Key;
                    int detailTotalVoters = ev.Confirmations.Count(c => c.TeamId == 0 || c.TeamId == 1);
                    bool detailMvpRevealed = isPastEvent && detailMvpUserId is not null
                                             && detailMvpVotes.Count >= Math.Max(1, (int)Math.Ceiling(detailTotalVoters * 0.5));
                    var minInfoTuple = (minInfo.MinOutfield, minInfo.MinGoalkeepers);
                }

                @if (ev.MaxGoalkeepers > 0)
                {
                    <div class="players-groups-stack">
                        <FutsalOutfieldGroup 
                            Event="@ev"
                            CurrentUserId="@currentUserId"
                            IsAdmin="@isAdmin"
                            IsPastEvent="@isPastEvent"
                            CanConfirm="@canConfirm"
                            OutFieldPlayers="@outFieldPlayers"
                            OutFieldSlots="@outFieldSlots"
                            BaseOut="@baseOut"
                            ConfirmedOut="@confirmedOut"
                            MaxOut="@maxOut"
                            IsFullOut="@isFullOut"
                            ConfirmRemoveId="@confirmRemoveId"
                            ConfirmPayId="@confirmPayId"
                            ConfirmCancel="@confirmCancel"
                            DetailMvpRevealed="@detailMvpRevealed"
                            DetailMvpUserId="@detailMvpUserId"
                            MinInfo="@minInfoTuple"
                            OnConfirmAs="@ConfirmAsCallback"
                            OnConfirmPayIdChange="@ConfirmPayIdChangedCallback"
                            OnConfirmRemoveIdChange="@ConfirmRemoveIdChangedCallback"
                            OnConfirmCancelChange="@ConfirmCancelChangedCallback"
                            OnCancelConfirmation="@CancelConfirmationCallback"
                            OnAdminTogglePaid="@AdminTogglePaidCallback"
                            OnAdminRemoveConfirmation="@AdminRemoveConfirmationCallback"
                            OnAdminAddOutfieldSlot="@AdminAddOutfieldSlotCallback"
                            OnAdminRemoveOutfieldSlot="@AdminRemoveOutfieldSlotCallback"
                            OnNavigateToPaymentsModal="@NavigateToPaymentsModalCallback" />

                        <FutsalGoalkeeperGroup 
                            Event="@ev"
                            CurrentUserId="@currentUserId"
                            IsAdmin="@isAdmin"
                            IsPastEvent="@isPastEvent"
                            CanConfirm="@canConfirm"
                            GoalkeeperPlayers="@gkPlayers"
                            ConfirmedGk="@confirmedGk"
                            ConfirmRemoveId="@confirmRemoveId"
                            ConfirmCancel="@confirmCancel"
                            DetailMvpRevealed="@detailMvpRevealed"
                            DetailMvpUserId="@detailMvpUserId"
                            MinInfo="@minInfoTuple"
                            IsFullGk="@isFullGk"
                            OnConfirmAs="@ConfirmAsCallback"
                            OnConfirmRemoveIdChange="@ConfirmRemoveIdChangedCallback"
                            OnConfirmCancelChange="@ConfirmCancelChangedCallback"
                            OnCancelConfirmation="@CancelConfirmationCallback"
                            OnAdminRemoveConfirmation="@AdminRemoveConfirmationCallback"
                            OnAdminAddGoalkeeperSlot="@AdminAddGoalkeeperSlotCallback"
                            OnAdminRemoveGoalkeeperSlot="@AdminRemoveGoalkeeperSlotCallback" />
                    </div>
                }
                else
                {
                    <ol class="players-list">
                        @{
                            int outIdx = 0;
                            foreach (var c in outFieldPlayers)
                            {
                                outIdx++;
                                bool isRotation = outIdx > baseOut;
                                <li class="player-item @(isRotation ? "player-item--rotation" : "") @(c.UserId == currentUserId ? "player-item--me" : "") @(detailMvpRevealed && c.UserId == detailMvpUserId ? "player-item--mvp" : "")">
                                    <span class="player-num">@outIdx</span>
                                    <span class="player-name">@(c.User?.FullName ?? c.User?.UserName ?? @Ui["Futsal.Player"])</span>
                                    @if (c.UserId == currentUserId) { <span class="player-tag player-tag--me">@Ui["Futsal.You"]</span> }
                                    @if (detailMvpRevealed && c.UserId == detailMvpUserId) { <span class="player-tag player-tag--mvp">@Ui["Futsal.Mvp"]</span> }
                                    @if (ev.Price.HasValue)
                                    {
                                        @if (isAdmin)
                                        {
                                            bool canTogglePaid2 = !c.HasPaid || c.PaymentGatewayName == null;
                                            @if (canTogglePaid2)
                                            {
                                                @if (confirmPayId == c.Id)
                                                {
                                                    <span class="player-tag player-tag--pay-confirm">@(c.HasPaid ? @Ui["Futsal.UnmarkPaid"] : @Ui["Futsal.MarkPaid"])</span>
                                                    <button class="player-tag player-tag--admin-pay-yes" type="button" @onclick="() => AdminTogglePaid(c.Id)">
                                                        <i class="fas fa-check"></i>
                                                    </button>
                                                    <button class="player-tag player-tag--admin-pay-no" type="button" @onclick="() => confirmPayId = null">
                                                        <i class="fas fa-times"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    @if (c.HasPaid)
                                                    {
                                                        <button class="player-tag player-tag--admin-pay player-tag--paid" @onclick="() => confirmPayId = c.Id">
                                                            <i class="fas fa-check"></i> @Ui["Futsal.Paid"]
                                                        </button>
                                                    }
                                                    else if (c.PixProofUploadedAt.HasValue)
                                                    {
                                                        <button class="player-tag player-tag--admin-pay player-tag--proof-pending" @onclick="() => NavigateToPaymentsModal(c.Id)" title="@Ui["Futsal.ProofTitle"]">
                                                            <i class="fas fa-image"></i> @Ui["Futsal.Proof"]
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button class="player-tag player-tag--admin-pay player-tag--pay-pending" @onclick="() => confirmPayId = c.Id">
                                                            <i class="fas fa-exclamation-triangle"></i> @Ui["Futsal.Pending"]
                                                        </button>
                                                        <button class="player-tag player-tag--admin-pay player-tag--pay-btn" @onclick="() => confirmPayId = c.Id" type="button">
                                                            <i class="fas fa-check"></i> @Ui["Futsal.Pay"]
                                                        </button>
                                                    }
                                                }
                                            }
                                            else
                                            {
                                                <span class="player-tag player-tag--paid" title="@Ui["Futsal.GatewayPaidTitle"]">
                                                    <i class="fas fa-check"></i> @Ui["Futsal.Paid"]
                                                </span>
                                            }
                                            @if (!isPastEvent && c.UserId != currentUserId && c.PaymentGatewayName == null)
                                            {
                                                @if (confirmRemoveId == c.Id)
                                                {
                                                    <span class="player-tag player-tag--remove-confirm">@Ui["Futsal.RemoveConfirm"]</span>
                                                    <button class="player-tag player-tag--admin-remove-yes" type="button" @onclick="() => AdminRemoveConfirmation(c.Id)">
                                                        <i class="fas fa-check"></i>
                                                    </button>
                                                    <button class="player-tag player-tag--admin-remove-no" type="button" @onclick="() => confirmRemoveId = null">
                                                        <i class="fas fa-times"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="player-tag player-tag--admin-remove" type="button" @onclick="() => confirmRemoveId = c.Id">
                                                        <i class="fas fa-user-times"></i> @Ui["Futsal.Remove"]
                                                    </button>
                                                }
                                            }
                                        }
                                        else
                                        {
                                            @if (c.HasPaid)
                                            {
                                                <span class="player-tag player-tag--paid">
                                                    <i class="fas fa-check"></i> @Ui["Futsal.Paid"]
                                                </span>
                                            }
                                            else if (c.PixProofUploadedAt.HasValue && (c.UserId == currentUserId || isAdmin))
                                            {
                                                @if (isAdmin)
                                                {
                                                    <button class="player-tag player-tag--proof-pending" @onclick="() => NavigateToPaymentsModal(c.Id)" title="@Ui["Futsal.ProofTitle"]">
                                                        <i class="fas fa-image"></i> @Ui["Futsal.Proof"]
                                                    </button>
                                                }
                                                else
                                                {
                                                    <a href="/pagamento/evento/@c.Id" class="player-tag player-tag--proof-pending player-tag--pay-link" title="@Ui["Futsal.ProofTitle"]">
                                                        <i class="fas fa-image"></i> @Ui["Futsal.Proof"]
                                                    </a>
                                                }
                                            }
                                            else if (c.UserId == currentUserId)
                                            {
                                                <a href="/pagamento/evento/@c.Id" class="player-tag player-tag--pay-pending player-tag--pay-link">
                                                    <i class="fas fa-exclamation-triangle"></i> @Ui["Futsal.Pending"]
                                                </a>
                                                @if (isAdmin)
                                                {
                                                    @if (currentUserId == ev?.Group?.PixReceiverUserId)
                                                    {
                                                        <span class="player-tag player-tag--receiver-badge">
                                                            <i class="fas fa-wallet"></i> @Ui["Futsal.Receiver"]
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <a href="/pagamento/evento/@c.Id" class="player-tag player-tag--pay-btn player-tag--pay-link">
                                                            <i class="fas fa-check"></i> @Ui["Futsal.Pay"]
                                                        </a>
                                                    }
                                                }
                                            }
                                            else
                                            {
                                                <span class="player-tag player-tag--pay-pending">
                                                    <i class="fas fa-exclamation-triangle"></i> @Ui["Futsal.Pending"]
                                                </span>
                                            }
                                        }
                                    }
                                    @if (ev!.IsActive && !isPastEvent && c.UserId == currentUserId && !c.HasPaid)
                                    {
                                        @if (confirmCancel)
                                        {
                                            <span class="player-tag player-tag--cancel-confirm">@Ui["Futsal.CancelSignupConfirm"]</span>
                                            <button class="player-tag player-tag--cancel-yes" type="button" @onclick="CancelConfirmation">
                                                <i class="fas fa-check"></i>
                                            </button>
                                            <button class="player-tag player-tag--cancel-no" type="button" @onclick="() => confirmCancel = false">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="player-tag player-tag--cancel" type="button" @onclick="() => confirmCancel = true">
                                                <i class="fas fa-user-times"></i> @Ui["Futsal.Cancel"]
                                            </button>
                                        }
                                    }
                                </li>
                            }
                            for (int i = outIdx + 1; i <= outFieldSlots; i++)
                            {
                                bool slotIsRotation = i > baseOut;
                                bool isFirstEmpty = i == outIdx + 1;
                                if (canConfirm && isFirstEmpty)
                                {
                                    <li class="player-item @(slotIsRotation ? "player-item--rotation" : "") player-item--slot">
                                        <span class="player-num">@i</span>
                                        <button class="player-slot-btn" @onclick="() => ConfirmAs(FutsalPosition.Outfield)"><i class="fas fa-plus"></i> @Ui["Futsal.ConfirmPresence"]</button>
                                    </li>
                                }
                                else
                                {
                                    <li class="player-item @(slotIsRotation ? "player-item--rotation" : "") player-item--empty"><span class="player-num">@i</span><span class="player-slot-empty">–</span></li>
                                }
                            }
                        }
                    </ol>
                    @if (isFullOut && canConfirm)
                    {
                        <button class="waitlist-cta" @onclick="() => ConfirmAs(FutsalPosition.Outfield)">
                            <i class="fas fa-clock"></i> @Ui["Futsal.Waitlist"]
                        </button>
                    }
                    @if (isAdmin && ev.IsActive && !isPastEvent)
                    {
                        <div class="slot-controls">
                            <button class="slot-ctrl-btn slot-ctrl-btn--remove"
                                    disabled="@(maxOut <= minInfo.MinOutfield || maxOut <= confirmedOut)"
                                    @onclick="AdminRemoveOutfieldSlot">
                                <i class="fas fa-minus"></i> @Ui["Futsal.RemoveSlot"]
                            </button>
                            <button class="add-slot-row" @onclick="AdminAddOutfieldSlot">
                                <i class="fas fa-plus"></i> @Ui["Futsal.AddSlot"]
                            </button>
                        </div>
                    }
                }
            </section>

            @* ── Lista de espera ─────────────────────────────────────────── *@
            <FutsalWaitlist
                Event="@ev"
                CurrentUserId="@currentUserId"
                IsAdmin="@isAdmin"
                IsPastEvent="@isPastEvent"
                ConfirmLeaveWaitlist="@confirmLeaveWaitlist"
                OnStartLeaveWaitlist="@(() => confirmLeaveWaitlist = true)"
                OnLeaveWaitlist="@LeaveWaitlist"
                OnCancelLeaveWaitlist="@(() => confirmLeaveWaitlist = false)"
                OnAdminRemoveWaitlist="@AdminRemoveFromWaitlist" />

            @* ── Banner: confirmado + pagamento ─────────────────────────── *@
            @if (userConf is not null)
            {
                <div class="confirmed-inline-banner">
                    <i class="fas fa-check-circle"></i>
                    <span class="confirmed-inline-label">@Ui["Futsal.ConfirmedToPlay"] <strong>@(userConf.Position == FutsalPosition.Goalkeeper ? Ui["Futsal.Gol"] : Ui["Futsal.Linha"])</strong></span>
                    @if (userConf.Position != FutsalPosition.Goalkeeper && ev.Price.HasValue)
                    {
                        @if (userConf.HasPaid)
                        {
                            <span class="payment-done-label"><i class="fas fa-check-circle"></i> @Ui.Get("Futsal.PaidAmount", ev.Price.Value.ToString("N2"))</span>
                        }
                        else if (userConf.PixProofUploadedAt.HasValue)
                        {
                            <span class="payment-done-label"><i class="fas fa-check-circle"></i> @Ui["Futsal.ProofSent"]</span>
                        }
                        else
                        {
                            <a href="/pagamento/evento/@userConf.Id" class="pay-btn pay-btn--sm">
                                @Ui.Get("Futsal.PayAmount", ev.Price.Value.ToString("N2"))
                            </a>
                        }
                    }
                </div>
            }

            @* ── Ação de confirmação ──────────────────────────────────── *@
            @if (!ev.IsActive || currentUserId is null || !string.IsNullOrWhiteSpace(actionError))
            {
                <div class="detail-action">
                    @if (!ev.IsActive)
                    {
                        <p class="cancelled-notice">@Ui["Futsal.MatchCancelled"]</p>
                    }
                    else if (currentUserId is null)
                    {
                        <a href="/Identity/Account/Login?ReturnUrl=@Uri.EscapeDataString(NavigationManager.Uri)"
                           class="confirm-btn">
                            @Ui["Futsal.EnterToConfirm"]
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(actionError))
                    {
                        <p class="detail-error">@actionError</p>
                    }
                </div>
            }

            @if (ev.Group.IsPrivate && !isMember && ev.IsActive && currentUserId is not null && userConf is null && !userOnWaitlist)
            {
                <div class="detail-action">
                    @if (userJoinRequest?.Status == JoinRequestStatus.Pending)
                    {
                        <div class="private-group-notice">
                            <i class="fas fa-hourglass-half"></i>
                            <span>@Ui["Futsal.JoinRequestSent"]</span>
                        </div>
                        <button class="cancel-join-btn" type="button" @onclick="CancelJoinRequestAsync" disabled="@cancellingJoin">
                            <i class="fas fa-times"></i>
                            @(cancellingJoin ? @Ui["Futsal.CancellingJoin"] : @Ui["Futsal.CancelJoinRequest"])
                        </button>
                    }
                    else if (userJoinRequest?.Status == JoinRequestStatus.Rejected)
                    {
                        <div class="private-group-notice">
                            <i class="fas fa-times-circle"></i>
                            <span>@Ui["Futsal.JoinRequestRejected"]</span>
                        </div>
                    }
                    else
                    {
                        <div class="private-group-notice">
                            <i class="fas fa-lock"></i>
                            <span>@Ui["Futsal.PrivateGroup"]</span>
                        </div>
                        <button class="confirm-btn" type="button" @onclick="RequestToJoinAsync" disabled="@requestingJoin">
                            <i class="fas fa-user-plus"></i>
                            @(requestingJoin ? @Ui["Futsal.SendingJoin"] : @Ui["Futsal.RequestJoin"])
                        </button>
                    }

                    @if (!string.IsNullOrWhiteSpace(joinRequestError))
                    {
                        <p class="detail-error">@joinRequestError</p>
                    }
                </div>
            }

            @if (ev.LineupConfirmedAt is not null || isAdmin)
            {
                <DetailAdminPanel
                    EventId="@ev.Id"
                    LineupConfirmedAt="@ev.LineupConfirmedAt"
                    IsPastEvent="@isPastEvent"
                    IsAdmin="@isAdmin"
                    IsActive="@ev.IsActive"
                    HasQuorum="@hasQuorum"
                    Lacking="@lacking" />
            }

        </div>
    </div>
}

