@page "/futsal/schedule/{Id:int}/edit"

@attribute [Authorize]

@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Confirmai.Data
@using Confirmai.Enums
@using Confirmai.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore


<PageTitle>Editar Partida Semanal · Confirmai</PageTitle>

<div class="create-event-page">
    <div class="create-event-card">
        <div class="create-event-card-top">
            <h1 class="create-event-title">
                <i class="fas fa-sync-alt"></i> Editar Partida Semanal
            </h1>
            <a href="/grupo/@scheduleGroupId/partidas" class="detail-back-link"><i class="fas fa-arrow-left"></i> Voltar</a>
        </div>

        @if (isLoading)
        {
            <div class="loading-spinner">Carregando...</div>
        }
        else if (notFound)
        {
            <div class="detail-not-found">
                <h2>Agendamento não encontrado.</h2>
                <a href="/meus-eventos?esporte=futsal">← Voltar</a>
            </div>
        }
        else if (accessDenied)
        {
            <div class="detail-not-found">
                <h2>Acesso negado.</h2>
                <p>Apenas o criador pode editar este agendamento.</p>
                <a href="/meus-eventos?esporte=futsal">← Voltar</a>
            </div>
        }
        else
        {
            <p class="form-hint form-hint--margin-bottom">
                ⚠️ Alterações aqui <strong>não afetam</strong> partidas já geradas — apenas as próximas ocorrências.
            </p>

            <EditForm Model="form" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <ValidationSummary class="validation-summary" />

                @* ── Nome / Apelido ────────────────────────────────────────── *@
                <fieldset class="form-section">
                    <legend>Identificação</legend>

                    <div class="form-group">
                        <label>Como vocês chamam o jogo?</label>
                        <InputText class="input" @bind-Value="form.LocalName"
                                   placeholder='racha, pelada, baba, rachão…' maxlength="60"
                                   autocomplete="off" />
                        <small class="form-hint">Opcional — aparece nos cards para identificar o estilo da região.</small>
                    </div>
                </fieldset>

                @* ── Dia / Hora / Duração ─────────────────────────────────── *@
                <fieldset class="form-section">
                    <legend>Horário</legend>

                    <div class="form-row-2">
                        <div class="form-group">
                            <label>Dia da semana <span class="required">*</span></label>
                            <InputSelect class="input" @bind-Value="form.DayOfWeek">
                                @foreach (var (dow, label) in WeekdayOptions)
                                {
                                    <option value="@dow">@label</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="form-group">
                            <label>Hora de início <span class="required">*</span></label>
                            <input type="time" class="input"
                                   value="@form.TimeOfDay.ToString("HH:mm")"
                                   @onchange="OnTimeChange" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Duração <span class="required">*</span></label>
                        <InputSelect class="input" @bind-Value="form.DurationMinutes">
                            @foreach (var (min, label) in DurationOptions)
                            {
                                <option value="@min">@label</option>
                            }
                        </InputSelect>
                    </div>
                </fieldset>

                @* ── Local ────────────────────────────────────────────────── *@
                <fieldset class="form-section">
                    <legend>Local</legend>

                    <div class="form-group">
                        <label>Quadra / Society / Campo <span class="required">*</span></label>
                        <InputSelect class="input" @bind-Value="form.VenueId">
                            <option value="0">— selecione —</option>
                            @foreach (var v in venues)
                            {
                                <option value="@v.Id">@v.Name — @v.City/@v.StateCode</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => form.VenueId)" class="validation-message" />
                    </div>
                </fieldset>

                @* ── Vagas ────────────────────────────────────────────────── *@
                <fieldset class="form-section">
                    <legend>Vagas</legend>

                    <div class="form-row-2">
                        <div class="form-group">
                            <label>Vagas totais (linha + goleiros) <span class="required">*</span></label>
                            <InputNumber class="input" @bind-Value="form.MaxPlayers" min="1" max="100" />
                            <ValidationMessage For="@(() => form.MaxPlayers)" class="validation-message" />
                        </div>
                        <div class="form-group">
                            <label>Goleiros</label>
                            <InputNumber class="input" @bind-Value="form.MaxGoalkeepers" min="0" max="10" />
                            <small class="form-hint">0 = sem reserva de goleiro.</small>
                        </div>
                    </div>
                </fieldset>

                @* ── Valor ────────────────────────────────────────────────── *@
                <fieldset class="form-section">
                    <legend>Valor</legend>

                    <div class="form-group">
                        <label>Valor por jogador (R$) <span class="required">*</span></label>
                        <div class="input-prefix-wrap">
                            <span class="input-prefix">R$</span>
                            <InputNumber class="input" @bind-Value="form.Price" min="0" step="0.50" />
                        </div>
                        <ValidationMessage For="@(() => form.Price)" class="validation-message" />
                        <small class="form-hint">Use 0 para partidas sem cobrança.</small>
                    </div>
                </fieldset>

                @if (!string.IsNullOrWhiteSpace(saveError))
                {
                    <p class="validation-message">@saveError</p>
                }

                <div class="form-actions">
                    <button class="cancel-btn" type="button"
                            @onclick='() => NavigationManager.NavigateTo("/meus-eventos?esporte=futsal")'>
                        Cancelar
                    </button>
                    <button class="save-btn" type="submit" disabled="@isSaving">
                        @(isSaving ? "Salvando…" : "Salvar Alterações")
                    </button>
                </div>
            </EditForm>
        }
    </div>
</div>
