@page "/futsal/schedule/{Id:int}/edit"

@attribute [Authorize]

@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Confirmai.Data
@using Confirmai.Enums
@using Confirmai.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore

@inject Confirmai.Services.Core.UiTextService Ui


<PageTitle>@Ui["Futsal.ScheduleEditPageTitle"]</PageTitle>

<div class="create-event-page">
    <div class="create-event-card">
        <div class="create-event-card-top">
            <h1 class="create-event-title">
                <i class="fas fa-sync-alt"></i> @Ui["Futsal.EditMatch"] @Ui["Futsal.WeeklyMatches"]
            </h1>
            <a href="/grupo/@scheduleGroupId/partidas" class="detail-back-link"><i class="fas fa-arrow-left"></i> @Ui["Common.Back"]</a>
        </div>

        @if (isLoading)
        {
            <div class="loading-spinner">@Ui["Common.Loading"]</div>
        }
        else if (notFound)
        {
            <div class="detail-not-found">
                <h2>@Ui["Futsal.ScheduleNotFound"]</h2>
                <a href="/">← @Ui["Common.Back"]</a>
            </div>
        }
        else if (accessDenied)
        {
            <div class="detail-not-found">
                <h2>@Ui["Futsal.AccessDenied"]</h2>
                <p>@Ui["Futsal.OnlyCreatorCanEditSchedule"]</p>
                <a href="/">← @Ui["Common.Back"]</a>
            </div>
        }
        else
        {
            <p class="form-hint form-hint--margin-bottom">
                @Ui["Futsal.ScheduleWarning"]
            </p>

            <EditForm Model="form" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <ValidationSummary class="validation-summary" />

                @* ── Nome / Apelido ────────────────────────────────────────── *@
                <fieldset class="form-section">
                    <legend>@Ui["Futsal.Identification"]</legend>

                    <div class="form-group">
                        <label>@Ui["Futsal.LocalNameLabel"]</label>
                        <InputText class="input" @bind-Value="form.LocalName"
                                   placeholder='racha, pelada, baba, rachão…' maxlength="60"
                                   autocomplete="off" />
                        <small class="form-hint">@Ui["Futsal.LocalNameHint"]</small>
                    </div>
                </fieldset>

                @* ── Dia / Hora / Duração ─────────────────────────────────── *@
                <fieldset class="form-section">
                    <legend>@Ui["Futsal.Schedule"]</legend>

                    <div class="form-row-2">
                        <div class="form-group">
                            <label>@Ui["Futsal.DayOfWeek"] <span class="required">*</span></label>
                            <InputSelect class="input" @bind-Value="form.DayOfWeek">
                                @foreach (var (dow, label) in WeekdayOptions)
                                {
                                    <option value="@dow">@label</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="form-group">
                            <label>@Ui["Futsal.StartTime"] <span class="required">*</span></label>
                            <input type="time" class="input"
                                   value="@form.TimeOfDay.ToString("HH:mm")"
                                   @onchange="OnTimeChange" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>@Ui["Futsal.Duration"] <span class="required">*</span></label>
                        <InputSelect class="input" @bind-Value="form.DurationMinutes">
                            @foreach (var (min, label) in DurationOptions)
                            {
                                <option value="@min">@label</option>
                            }
                        </InputSelect>
                    </div>
                </fieldset>

                @* ── Local ────────────────────────────────────────────────── *@
                <fieldset class="form-section">
                    <legend>@Ui["Futsal.Venue"]</legend>

                    <div class="form-group">
                        <label>@Ui["Futsal.VenueField"] <span class="required">*</span></label>
                        <InputSelect class="input" @bind-Value="form.VenueId">
                            <option value="0">@Ui["Futsal.VenueSelectShort"]</option>
                            @foreach (var v in venues)
                            {
                                <option value="@v.Id">@v.Name — @v.City/@v.StateCode</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => form.VenueId)" class="validation-message" />
                    </div>
                </fieldset>

                @* ── Vagas ────────────────────────────────────────────────── *@
                <fieldset class="form-section">
                    <legend>@Ui["Futsal.Slots"]</legend>

                    <div class="form-row-2">
                        <div class="form-group">
                            <label>@Ui["Futsal.TotalSlots"] <span class="required">*</span></label>
                            <InputNumber class="input" @bind-Value="form.MaxPlayers" min="1" max="100" />
                            <ValidationMessage For="@(() => form.MaxPlayers)" class="validation-message" />
                        </div>
                        <div class="form-group">
                            <label>@Ui["Futsal.Goalkeepers"]</label>
                            <InputNumber class="input" @bind-Value="form.MaxGoalkeepers" min="0" max="10" />
                            <small class="form-hint">@Ui["Futsal.NoGkHint"]</small>
                        </div>
                    </div>
                </fieldset>

                @* ── Valor ────────────────────────────────────────────────── *@
                <fieldset class="form-section">
                    <legend>@Ui["Futsal.Price"]</legend>

                    <div class="form-group">
                        <label>@Ui["Futsal.PricePerPlayer"] <span class="required">*</span></label>
                        <div class="input-prefix-wrap">
                            <span class="input-prefix">R$</span>
                            <InputNumber class="input" @bind-Value="form.Price" min="0" step="0.50" />
                        </div>
                        <ValidationMessage For="@(() => form.Price)" class="validation-message" />
                        <small class="form-hint">@Ui["Futsal.PriceHint"]</small>
                    </div>
                </fieldset>

                @if (!string.IsNullOrWhiteSpace(saveError))
                {
                    <p class="validation-message">@saveError</p>
                }

                <div class="form-actions">
                    <button class="cancel-btn" type="button"
                            @onclick='() => NavigationManager.NavigateTo($"/futsal/schedule?groupId={scheduleGroupId}")'>
                        @Ui["Common.Cancel"]
                    </button>
                    <button class="save-btn" type="submit" disabled="@isSaving">
                        @(isSaving ? @Ui["Futsal.Saving"] : @Ui["Futsal.SaveChanges"])
                    </button>
                </div>
            </EditForm>
        }
    </div>
</div>
