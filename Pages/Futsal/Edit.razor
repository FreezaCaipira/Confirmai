@page "/futsal/{Id:int}/edit"

@attribute [Authorize]

@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Confirmai.Data
@using Confirmai.Enums
@using Confirmai.Models
@using Confirmai.Pages.Futsal.Components
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore


<PageTitle>Editar Partida · Futsal · Confirmai</PageTitle>

<div class="create-event-page">
    <div class="create-event-card">
        <div class="create-event-card-top">
            <h1 class="create-event-title">
                <i class="fas fa-futbol"></i> Editar Partida
            </h1>
            <a href="/futsal/@Id" class="detail-back-link"><i class="fas fa-arrow-left"></i> Voltar</a>
        </div>

        @if (isLoading)
        {
            <div class="loading-spinner">Carregando...</div>
        }
        else if (notFound)
        {
            <div class="detail-not-found">
                <h2>Partida não encontrada.</h2>
                <a href="/futsal">← Voltar</a>
            </div>
        }
        else if (accessDenied)
        {
            <div class="detail-not-found">
                <h2>Acesso negado.</h2>
                <p>Apenas o organizador pode editar esta partida.</p>
                <a href="/futsal/@Id">← Voltar</a>
            </div>
        }
        else
        {
            <EditEventForm
                Form="@form"
                Venues="@venues"
                SelectedVenue="@selectedVenue"
                IsSaving="@isSaving"
                ShowCancelButton="@(ev?.IsActive == true)"
                ShowCancelConfirm="@showCancelConfirm"
                SaveError="@saveError"
                CollisionHref="@collisionHref"
                CancelError="@cancelError"
                OnFormSubmit="@SaveCallback"
                OnVenueSelected="@VenueSelectedCallback"
                OnRotateToggled="@RotateToggledCallback"
                OnTimeChanged="@TimeChangedCallback"
                OnCancelConfirmShowChanged="@CancelConfirmShowChangedCallback"
                OnCancelConfirmedClicked="@CancelConfirmedCallback" />
        }
    </div>
</div>
