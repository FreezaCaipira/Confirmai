@page "/futsal"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

<PageTitle>Futsal · Confirmai</PageTitle>

<div class="listing-page">
    <AuthorizeView>
        <Authorized>
            <div class="listing-page-actions">
                <a href="/" class="listing-back-btn">
                    <i class="fas fa-arrow-left"></i> Voltar
                </a>
                <a href="/meus-eventos?esporte=futsal" class="my-events-link-btn">
                    <i class="fas fa-calendar-alt"></i> Minhas Partidas
                </a>
                <a href="/grupos" class="btn-view-groups">
                    <i class="fas fa-users"></i> Ver Grupos
                </a>
            </div>
        </Authorized>
    </AuthorizeView>
    <EventListingShell Sport="Sport.Futsal" SportLabel="partidas" City="@City" StateCode="@Estado">
        <EventCard Context="ev">
            @{
                var confirmedOut = ev.Confirmations.Count(c => c.Position != FutsalPosition.Goalkeeper);
                var confirmedGk  = ev.Confirmations.Count(c => c.Position == FutsalPosition.Goalkeeper);
                var totalOut     = ev.MaxGoalkeepers.HasValue
                    ? ev.MaxPlayers - ev.MaxGoalkeepers.Value
                    : ev.MaxPlayers;
                var isUserConfirmed = currentUserId is not null && ev.Confirmations.Any(c => c.UserId == currentUserId);
            }
            <article class="event-card event-card--futsal @(isUserConfirmed ? "event-card--confirmed" : string.Empty)">
                <div class="event-card-overlay"></div>
                <div class="event-card-bg-icon"><i class="fas fa-futbol"></i></div>
                <div class="event-time">@ev.StartsAt.ToString("HH:mm")</div>
                <div class="event-body">
                    <div class="event-name-row">
                        <h3 class="event-name">@ev.Group.Name</h3>
                        @if (isUserConfirmed)
                        {
                            <span class="meta-chip meta-chip--confirmed"><i class="fas fa-check" aria-hidden="true"></i> Confirmado</span>
                        }
                    </div>
                    @if (ev.Venue is not null)
                    {
                        <p class="event-venue-name">@ev.Venue.Name</p>
                        <p class="event-location">@ev.Venue.Address &middot; @ev.Venue.City - @ev.Venue.StateCode</p>
                    }
                    else
                    {
                        <p class="event-location">@ev.Location &middot; @ev.Group.City - @ev.Group.StateCode</p>
                    }
                    <div class="event-meta">
                        <span class="meta-chip">
                            <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                                 aria-hidden="true">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                                <circle cx="9" cy="7" r="4" />
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                            </svg>
                            @confirmedOut / @totalOut jogadores
                        </span>
                        @if (ev.MaxGoalkeepers > 0)
                        {
                            <span class="meta-chip meta-chip--gk"><i class="fas fa-hand-paper"></i> @confirmedGk / @ev.MaxGoalkeepers goleiros</span>
                        }
                    </div>
                </div>
                <a href="/futsal/@ev.Id" class="event-action">Confirmar →</a>
            </article>
        </EventCard>
    </EventListingShell>
</div>

@code {
    [SupplyParameterFromQuery(Name = "cidade")] public string? City   { get; set; }
    [SupplyParameterFromQuery(Name = "estado")] public string? Estado { get; set; }

    private string? currentUserId;

    [Inject] private AuthenticationStateProvider AuthProvider { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        currentUserId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
    }
}
