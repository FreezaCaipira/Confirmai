@using Confirmai.Models
@using Confirmai.Pages.Futsal

<fieldset class="form-section">
    <legend>Identidade da Partida</legend>

    @if (PreselectedGroup is null)
    {
        <div class="form-group">
            <label>Nome da partida <span class="required">*</span></label>
            <InputText class="input" @bind-Value="@Form.GroupName"
                       placeholder='Ex: "Rachão da Galera do Zé", "Pelada de Quinta"'
                       autocomplete="off" />
            <ValidationMessage For="@(() => Form.GroupName)" class="validation-message" />
        </div>
    }

    <div class="form-group">
        <label>Modalidade <span class="required">*</span></label>
        <select class="input" value="@SubFormat" @onchange="HandleSubFormatChanged">
            <option value="futsal">Futsal</option>
            <option value="society">Fut7 / Society</option>
            <option value="campo">Campo</option>
        </select>
    </div>

    <div class="form-group">
        <label>Como vocês chamam o jogo na sua região?</label>
        <InputText class="input" @bind-Value="@Form.LocalName"
                   placeholder='racha, pelada, baba, rachão…' maxlength="60"
                   autocomplete="off" />
        <small class="form-hint">Opcional — aparece nos cards para identificar o estilo da região.</small>
    </div>
</fieldset>

@code {
    [Parameter]
    public Create.CreateMatchForm Form { get; set; } = new();

    [Parameter]
    public string SubFormat { get; set; } = "futsal";

    [Parameter]
    public Group? PreselectedGroup { get; set; }

    [Parameter]
    public EventCallback<string> OnSubFormatChanged { get; set; }

    private async Task HandleSubFormatChanged(ChangeEventArgs e)
    {
        var newFormat = e.Value?.ToString() ?? "futsal";
        await OnSubFormatChanged.InvokeAsync(newFormat);
    }
}


