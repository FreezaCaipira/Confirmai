@using Confirmai.Pages.Futsal

<fieldset class="form-section">
    <legend>Data &amp; Horário</legend>

    <div class="form-row-2">
        <div class="form-group">
            <label>Data <span class="required">*</span></label>
            <InputDate class="input" @bind-Value="@Form.Date" />
            <ValidationMessage For="@(() => Form.Date)" class="validation-message" />
        </div>
        <div class="form-group">
            <label>Hora de início <span class="required">*</span></label>
            <input type="time" class="input"
                   value="@Form.Time.ToString("HH:mm")"
                   @onchange="HandleTimeChange" />
        </div>
    </div>

    <div class="form-group">
        <label>Duração <span class="required">*</span></label>
        <InputSelect class="input" @bind-Value="@Form.DurationMinutes">
            @foreach (var (min, label) in DurationOptions)
            {
                <option value="@min">@label</option>
            }
        </InputSelect>
    </div>
</fieldset>

@code {
    [Parameter]
    public Create.CreateMatchForm Form { get; set; } = new();

    [Parameter]
    public EventCallback<TimeOnly> OnTimeChange { get; set; }

    private static readonly (int Min, string Label)[] DurationOptions =
    [
        (60,  "1h"),
        (75,  "1h15min"),
        (90,  "1h30min"),
        (105, "1h45min"),
        (120, "2h"),
        (150, "2h30min"),
        (180, "3h"),
    ];

    private async Task HandleTimeChange(ChangeEventArgs e)
    {
        var newTime = TimeOnly.TryParse(e.Value?.ToString(), out var t) ? t : new TimeOnly(19, 0);
        await OnTimeChange.InvokeAsync(newTime);
    }
}
