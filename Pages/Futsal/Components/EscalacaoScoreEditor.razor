@inject Confirmai.Services.Core.UiTextService Ui

<div class="esc-score-section">
    <div class="esc-section-header">
        <h3 class="esc-section-title"><i class="fas fa-futbol"></i> @Ui["Futsal.Score"]</h3>
        @if (ScoreTeamA is not null && ScoreTeamB is not null && !EditingScore)
        {
            <button class="esc-btn esc-btn--danger-ghost esc-btn--sm" @onclick="() => HandleEditingScore(true)">
                <i class="fas fa-edit"></i> @Ui["Common.Edit"]
            </button>
        }
    </div>

    @if (ScoreTeamA is not null && ScoreTeamB is not null && !EditingScore)
    {
        <div class="esc-score-display">
            <span class="esc-score-team">🟡 @TeamAName</span>
            <span class="esc-score-value">@ScoreTeamA</span>
            <span class="esc-score-sep">×</span>
            <span class="esc-score-value">@ScoreTeamB</span>
            <span class="esc-score-team">@TeamBName 🔵</span>
        </div>

        @if (ScoreTeamA > ScoreTeamB)
        {
            <p class="esc-score-winner esc-score-winner--a">@Ui.Get("Futsal.TeamWon", TeamAName)</p>
        }
        else if (ScoreTeamB > ScoreTeamA)
        {
            <p class="esc-score-winner esc-score-winner--b">@Ui.Get("Futsal.TeamWon", TeamBName)</p>
        }
        else
        {
            <p class="esc-score-winner esc-score-winner--draw">@Ui["Futsal.Draw"]</p>
        }

        @if (ScoreRegisteredByName is not null)
        {
            <p class="esc-score-registered-by">
                <i class="fas fa-user-check"></i> @Ui.Get("Futsal.RegisteredBy", ScoreRegisteredByName)
                @if (ScoreRegisteredAt is not null)
                {
                    <span class="esc-score-registered-when">@Ui.Get("Futsal.RegisteredAt", ScoreRegisteredAt.Value.ToLocalTime().ToString("dd/MM HH:mm"))</span>
                }
            </p>
        }
    }
    else if (IsMember || IsAdmin || EditingScore)
    {
        <div class="esc-score-inputs esc-score-inputs--margin-top">
            <label class="esc-score-label">🟡 @TeamAName</label>
            <input class="esc-score-input" type="number" min="0" max="99"
                   value="@ScoreInputA" @oninput="HandleScoreInputAChanged" placeholder="0" />
            <span class="esc-score-sep">×</span>
            <input class="esc-score-input" type="number" min="0" max="99"
                   value="@ScoreInputB" @oninput="HandleScoreInputBChanged" placeholder="0" />
            <label class="esc-score-label">@TeamBName 🔵</label>
        </div>
        @if (ScoreError is not null)
        {
            <p class="esc-error">@ScoreError</p>
        }
        <div class="esc-score-actions">
            <button class="esc-btn esc-btn--primary esc-btn--sm" @onclick="HandleSaveScore" disabled="@IsSaving">
                <i class="fas fa-check"></i> @(IsSaving ? @Ui["Futsal.Saving"] : @Ui["Futsal.ConfirmScore"])
            </button>
        </div>
    }
    else
    {
        <p class="esc-hint"><i class="fas fa-clock"></i> @Ui["Futsal.ScoreNotRegistered"]</p>
    }
</div>
