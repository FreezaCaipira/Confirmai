@using Confirmai.Models
@using Microsoft.Extensions.Configuration
@inject Confirmai.Services.Core.UiTextService Ui

<hr class="detail-divider">
<section class="detail-section">
    <h2 class="detail-section-title">
        <i class="fas fa-map-marker-alt"></i> @Ui["Futsal.Location"]
    </h2>

    @* Placeholder — always rendered, visible by default *@
    <a id="@MapFallbackId" class="detail-map-placeholder" href="@MapsSearchUrl" target="_blank" rel="noopener noreferrer">
        <i class="fas fa-map-marker-alt"></i>
        <div>
            <span class="detail-map-placeholder-name">@(Event.Venue?.Name ?? MapAddress)</span>
            @if (Event.Venue is not null)
            {
                <span class="detail-map-placeholder-addr">@Event.Venue.Address · @Event.Venue.City/@Event.Venue.StateCode</span>
            }
        </div>
        <i class="fas fa-external-link-alt detail-map-placeholder-ext"></i>
    </a>

    @* Iframe — hidden initially; JS shows it only when Google responds *@
    @if (HasMapsKey)
    {
        <div id="@MapWrapId" class="detail-map-wrap detail-map-wrap--hidden">
            <iframe
                class="detail-map"
                src="@EmbedUrl"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                allowfullscreen
                title="@Ui["Futsal.LocationIframeTitle"]">
            </iframe>
        </div>
    }

    <a class="detail-map-link"
       href="@MapsSearchUrl"
       target="_blank"
       rel="noopener noreferrer">
        <i class="fas fa-external-link-alt"></i> @Ui["Futsal.OpenInMaps"]
    </a>
</section>
<hr class="detail-divider">
