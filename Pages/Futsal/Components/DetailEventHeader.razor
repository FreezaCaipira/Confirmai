@using Confirmai.Models
@inject UiTextService Ui

<header class="detail-header detail-header--futsal">
    <div class="detail-header-top">
        <a href="/grupo/@Event.GroupId" class="detail-back-link"><i class="fas fa-arrow-left"></i> @Ui["Common.Back"]</a>
    </div>
    <div class="detail-header-badge">
        <span class="detail-sport-badge">⚽ Futsal</span>
    </div>
    <div class="detail-header-content">
        <h1 class="detail-title detail-title--with-num">@Event.Group.Name <span class="detail-event-num">#@EventNumber</span></h1>
        @if (!string.IsNullOrWhiteSpace(Event.LocalName))
        {
            <p class="detail-localname">@Event.LocalName</p>
        }
        <p class="detail-location">
            <i class="fas fa-map-marker-alt"></i>
            @(Event.Venue is not null ? Event.Venue.Name : Event.Location)
            @if (!string.IsNullOrWhiteSpace(Event.Group.City))
            {
                <span> · @Event.Group.City/@Event.Group.StateCode</span>
            }
        </p>
        @if (CreatorUser is not null)
        {
            <p class="detail-organizer">
                <i class="fas fa-user"></i>
                Organizado por <a href="/profile/@CreatorUser.Id" class="detail-organizer-link">@(CreatorUser.FullName ?? CreatorUser.UserName)</a>
            </p>
        }
        <p class="detail-group-ref">
            <i class="fas fa-users"></i>
            Abrir grupo: <a class="detail-group-link" href="/grupo/@Event.GroupId">@Event.Group.Name</a>
        </p>
    </div>
</header>
