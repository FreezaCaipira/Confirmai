@using System.ComponentModel.DataAnnotations
@using Confirmai.Enums
@using Confirmai.Models
@inject Confirmai.Services.Core.UiTextService Ui

<EditForm Model="Form" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary class="validation-summary" />

    @* ── Identidade da partida──────────────────────────────────── *@
    <fieldset class="form-section">
        <legend>@Ui["Futsal.Identity"]</legend>

        <div class="form-group">
            <label>@Ui["Futsal.MatchName"] <span class="required">*</span></label>
            <InputText class="input" @bind-Value="Form.GroupName"
                       placeholder='Ex: "Rachão da Galera do Zé", "Pelada de Quinta"'
                       autocomplete="off" />
            <ValidationMessage For="@(() => Form.GroupName)" class="validation-message" />
        </div>

        <div class="form-group">
            <label>@Ui["Futsal.LocalNameLabel"]</label>
            <InputText class="input" @bind-Value="Form.LocalName"
                       placeholder='racha, pelada, baba, rachão…' maxlength="60"
                       autocomplete="off" />
            <small class="form-hint">@Ui["Futsal.LocalNameHint"]</small>
        </div>
    </fieldset>

    @* ── Quadra ──────────────────────────────────────────────────── *@
    <fieldset class="form-section">
        <legend>@Ui["Futsal.Venue"]</legend>

        <div class="form-group">
            <label>@Ui["Futsal.VenueField"] <span class="required">*</span></label>
            @if (!Venues.Any())
            {
                <p class="form-hint form-hint--warn">
                    @Ui["Futsal.NoVenueRegistered"]
                </p>
            }
            else
            {
                <InputSelect class="input" @bind-Value="Form.VenueId" @bind-Value:after="OnVenueChanged">
                    <option value="0">@Ui["Futsal.VenueSelect"]</option>
                    @foreach (var v in Venues)
                    {
                        <option value="@v.Id">@v.Name (@VenueTypeLabel(v.Type)) — @v.City/@v.StateCode</option>
                    }
                </InputSelect>
            }
        </div>

        @if (SelectedVenue is not null)
        {
            <a class="venue-preview" href="@MapsSearchUrl" target="_blank" rel="noopener noreferrer">
                <i class="fas fa-map-marker-alt"></i>
                <div class="venue-preview-info">
                    <span class="venue-preview-name">@SelectedVenue.Name</span>
                    <span class="venue-preview-addr">@SelectedVenue.Address · @SelectedVenue.City/@SelectedVenue.StateCode</span>
                </div>
                <i class="fas fa-external-link-alt venue-preview-ext"></i>
            </a>
        }
    </fieldset>

    @* ── Data, hora e duração ────────────────────────────────────── *@
    <fieldset class="form-section">
        <legend>@Ui["Futsal.DateTime"]</legend>

        <div class="form-row-2">
            <div class="form-group">
                <label>@Ui["Futsal.Date"] <span class="required">*</span></label>
                <InputDate class="input" @bind-Value="Form.Date" />
                <ValidationMessage For="@(() => Form.Date)" class="validation-message" />
            </div>
            <div class="form-group">
                <label>@Ui["Futsal.StartTime"] <span class="required">*</span></label>
                <input type="time" class="input"
                       value="@Form.Time.ToString("HH:mm")"
                       @onchange="OnTimeChange" />
            </div>
        </div>

        <div class="form-group">
            <label>@Ui["Futsal.Duration"] <span class="required">*</span></label>
            <InputSelect class="input" @bind-Value="Form.DurationMinutes">
                @foreach (var (min, label) in DurationOptions)
                {
                    <option value="@min">@label</option>
                }
            </InputSelect>
        </div>
    </fieldset>

    @* ── Vagas ───────────────────────────────────────────────────── *@
    <fieldset class="form-section">
        <legend>@Ui["Futsal.Slots"]</legend>

        <div class="form-row-2">
            <div class="form-group">
                <label>@Ui["Futsal.TotalSlots"] <span class="required">*</span></label>
                <InputNumber class="input" @bind-Value="Form.MaxPlayers" min="1" max="100" />
                <ValidationMessage For="@(() => Form.MaxPlayers)" class="validation-message" />
            </div>
            <div class="form-group">
                <label>@Ui["Futsal.Goalkeepers"]</label>
                <InputNumber class="input" @bind-Value="Form.MaxGoalkeepers" min="0" max="10" disabled="@Form.RotateInGoal" />
            </div>
        </div>

        <label class="switch-label switch-label--margin-top">
            <input type="checkbox" @bind="Form.RotateInGoal" @bind:after="OnRotateInGoalChanged" />
            @Ui["Futsal.RotateInGoal"]
        </label>
    </fieldset>

    @* ── Valor ───────────────────────────────────────────────────── *@
    <fieldset class="form-section">
        <legend>@Ui["Futsal.Price"]</legend>

        <div class="form-group">
            <label>@Ui["Futsal.PricePerPlayer"] <span class="required">*</span></label>
            <div class="input-prefix-wrap">
                <span class="input-prefix">R$</span>
                <InputNumber class="input" @bind-Value="Form.Price" min="0" step="0.50" />
            </div>
            <ValidationMessage For="@(() => Form.Price)" class="validation-message" />
            <small class="form-hint">@Ui["Futsal.PriceHint"]</small>
        </div>
    </fieldset>

    @if (!string.IsNullOrWhiteSpace(SaveError))
    {
        <p class="validation-message">
            @SaveError
            @if (!string.IsNullOrWhiteSpace(CollisionHref))
            {
                <a href="@CollisionHref" class="collision-link">@Confirmai.Services.Events.EventCollisionService.OpenExistingEventLinkText</a>
            }
        </p>
    }

    <div class="form-actions">
        @if (ShowCancelButton)
        {
            @if (!ShowCancelConfirm)
            {
                <button class="save-btn edit-cancel-btn" type="button"
                        @onclick="() => OnShowCancelConfirm(true)">
                    <i class="fas fa-ban"></i> @Ui["Futsal.CancelMatch"]
                </button>
            }
            else
            {
                <div class="cancel-confirm-block">
                    <span>@Ui["Futsal.CancelMatchConfirm"]</span>
                    <button class="save-btn edit-cancel-no-btn" type="button"
                            @onclick="() => OnShowCancelConfirm(false)">@Ui["Futsal.No"]</button>
                    <button class="save-btn edit-cancel-btn" type="button"
                            @onclick="OnCancelConfirmed">@Ui["Futsal.SimCancelar"]</button>
                </div>
            }
        }
        <button class="save-btn" type="submit" disabled="@IsSaving">
            @(IsSaving ? @Ui["Futsal.Saving"] : @Ui["Futsal.SaveChanges"])
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(CancelError))
    {
        <p class="validation-message">@CancelError</p>
    }
</EditForm>
