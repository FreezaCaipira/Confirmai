@using Confirmai.Models
@inject Confirmai.Services.Core.UiTextService Ui

<div class="quorum-bar @(IsPastEvent ? "quorum-bar--past" : (HasQuorum ? "quorum-bar--ok" : "quorum-bar--warn"))">
    @if (IsPastEvent)
    {
        <i class="fas fa-flag-checkered"></i>
        <span>@Ui["Futsal.MatchEnded"]</span>
    }
    else if (HasQuorum)
    {
        <i class="fas fa-check-circle"></i>
        <span>@Ui["Futsal.QuorumReached"]</span>
    }
    else
    {
        <i class="fas fa-exclamation-triangle"></i>
        <span>@Ui.Get("Futsal.QuorumNeeded", MinOutfield, MinGoalkeepers)</span>
    }
</div>
