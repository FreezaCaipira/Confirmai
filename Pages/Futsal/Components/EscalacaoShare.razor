<div class="esc-share-bar">
    <button class="esc-btn esc-btn--secondary" @onclick="HandleCopyToClipboard">
        <i class="fas @(Copied ? "fa-check" : "fa-copy")"></i>
        @(Copied ? "Copiado!" : "Copiar escalação")
    </button>
    <button class="esc-btn esc-btn--whatsapp" @onclick="HandleShareOnWhatsApp">
        <i class="fab fa-whatsapp"></i> Compartilhar no WhatsApp
    </button>
</div>

@code {
    [Parameter]
    public bool Copied { get; set; }

    [Parameter]
    public EventCallback OnCopyToClipboard { get; set; }

    [Parameter]
    public EventCallback OnShareOnWhatsApp { get; set; }

    private async Task HandleCopyToClipboard()
        => await OnCopyToClipboard.InvokeAsync();

    private async Task HandleShareOnWhatsApp()
        => await OnShareOnWhatsApp.InvokeAsync();
}
