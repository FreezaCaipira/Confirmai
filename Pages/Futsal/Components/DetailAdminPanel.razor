<div class="detail-admin-bar detail-admin-bar--footer">
    @if (LineupConfirmedAt is not null)
    {
        @if (IsPastEvent)
        {
            <a class="detail-admin-btn detail-admin-btn--lineup" href="/futsal/@EventId/escalacao">
                <i class="fas fa-flag-checkered"></i> Pós-Partida
            </a>
        }
        else
        {
            <a class="detail-admin-btn detail-admin-btn--lineup" href="/futsal/@EventId/escalacao">
                <i class="fas fa-clipboard-list"></i> Ver Escalação
            </a>
        }
    }
    @if (IsAdmin)
    {
        @if (IsActive && LineupConfirmedAt is null)
        {
            @if (HasQuorum)
            {
                <a class="detail-admin-btn detail-admin-btn--lineup" href="/futsal/@EventId/escalacao">
                    <i class="fas fa-list-ol"></i> Montar Escalação
                </a>
            }
            else
            {
                <span class="detail-admin-btn detail-admin-btn--lineup detail-admin-btn--disabled"
                      title="Faltam @Lacking jogador@(Lacking == 1 ? string.Empty : "es") para atingir o mínimo necessário">
                    <i class="fas fa-lock"></i> Montar Escalação
                </span>
            }
        }
    }
</div>
