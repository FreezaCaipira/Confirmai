@using Confirmai.Pages.Futsal

<fieldset class="form-section">
    <legend>Periodicidade</legend>

    <label class="switch-label">
        <input type="checkbox" @bind="@Form.RecurrenceEnabled" />
        Esta partida se repete semanalmente
    </label>

    @if (Form.RecurrenceEnabled)
    {
        <div class="form-group form-group--margin-top">
            <label>Dias da semana</label>
            <div class="weekday-grid">
                @foreach (var (dow, label) in WeekdayOptions)
                {
                    <label class="weekday-chip @(Form.SelectedDays.Contains(dow) ? "weekday-chip--on" : "")">
                        <input type="checkbox"
                               checked="@Form.SelectedDays.Contains(dow)"
                               @onchange="e => HandleToggleDay(dow, (bool)(e.Value ?? false))" />
                        @label
                    </label>
                }
            </div>
        </div>
    }
</fieldset>
