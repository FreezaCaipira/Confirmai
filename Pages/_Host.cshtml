@page "/"

@namespace Confirmai.Pages

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment

@{
    Layout = null;
    var cspNonce = (HttpContext.Items["csp-nonce"] as string) ?? string.Empty;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Confirmai</title>
    <base href="~/" />

    @* Preconnects: open TLS to CDNs in parallel with HTML parse *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />

    @* Critical CSS: preload + load. site.css is the largest stylesheet (~125 KB);
       preload tells the browser to fetch it at highest priority. *@
    <link rel="preload" href="/css/site.css" as="style" asp-append-version="true" />
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/marketplace.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/identity.css" asp-append-version="true" />
    <link rel="stylesheet" href="/Confirmai.styles.css" asp-append-version="true" />
    <link rel="icon" href="favicon.ico" />

    @* Web fonts: render-blocking by default. Load async via media-trick so
       FCP doesn't wait for them. font-display:swap (in the URL) prevents FOIT.
       The media swap from "print" to "all" is performed by a nonced inline
       script below to stay CSP-compliant (no inline `onload=` handlers). *@
    <link id="otsm-fonts-css" rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=MedievalSharp&display=swap"
          media="print" />
    <noscript>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=MedievalSharp&display=swap" />
    </noscript>

    @* Font Awesome (~350 KB) is also deferred. *@
    <link id="otsm-fa-css" rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css"
          media="print" />
    <noscript>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    </noscript>

    <script nonce="@cspNonce">
        (function () {
            ["otsm-fonts-css", "otsm-fa-css"].forEach(function (id) {
                var el = document.getElementById(id);
                if (!el) { return; }
                if (el.sheet) {
                    el.media = "all";
                } else {
                    el.addEventListener("load", function () { el.media = "all"; }, { once: true });
                }
            });
        })();
    </script>
</head>
<body>
    <app>
        <component type="typeof(App)" render-mode="ServerPrerendered" />
    </app>
    <script src="/js/ui-preferences.js"></script>
    <script nonce="@cspNonce">
        window.ConfirmaiIsDevelopment = @(HostEnvironment.IsDevelopment() ? "true" : "false");
    </script>
    <script nonce="@cspNonce">
        window.ConfirmaiCookieConsent = window.ConfirmaiCookieConsent || {
            _storageKey: "Confirmai.cookieConsent.v1",
            _consentCookie: "Confirmai.cookieConsent",
            _analyticsCookie: "Confirmai.cookieAnalytics",
            _readCookie: function (name) {
                var escaped = name.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
                var match = document.cookie.match(new RegExp("(?:^|; )" + escaped + "=([^;]*)"));
                return match ? decodeURIComponent(match[1]) : null;
            },
            _writeCookie: function (name, value, days) {
                var expires = "";
                if (typeof days === "number") {
                    var date = new Date();
                    date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
                    expires = "; expires=" + date.toUTCString();
                }
                document.cookie = name + "=" + encodeURIComponent(value) + expires + "; path=/";
            },
            _writeConsent: function (analytics) {
                var state = {
                    essential: true,
                    analytics: !!analytics,
                    updatedAtUtc: new Date().toISOString()
                };

                try {
                    localStorage.setItem(this._storageKey, JSON.stringify(state));
                } catch {
                    // Ignore storage failures.
                }

                try {
                    this._writeCookie(this._consentCookie, analytics ? "all" : "essential", 365);
                    this._writeCookie(this._analyticsCookie, analytics ? "1" : "0", 365);
                } catch {
                    // Ignore cookie failures.
                }
            },
            _loadConsent: function () {
                try {
                    var raw = localStorage.getItem(this._storageKey);
                    if (raw) {
                        var parsed = JSON.parse(raw);
                        return !!parsed.analytics;
                    }
                } catch {
                    // Ignore parse/storage failures.
                }

                var cookie = this._readCookie(this._consentCookie);
                if (cookie === "all") {
                    return true;
                }
                if (cookie === "essential") {
                    return false;
                }

                return null;
            },
            init: function () {
                var banner = document.getElementById("cookie-consent-banner");
                var modal = document.getElementById("cookie-consent-modal");
                var consent = this._loadConsent();

                if (consent === null) {
                    if (banner) {
                        banner.classList.remove("is-hidden");
                    }
                    if (modal) {
                        modal.classList.add("is-hidden");
                    }
                    return;
                }

                if (banner) {
                    banner.classList.add("is-hidden");
                }
                if (modal) {
                    modal.classList.add("is-hidden");
                }
            },
            openPreferences: function () {
                var modal = document.getElementById("cookie-consent-modal");
                var analyticsToggle = document.getElementById("cookie-analytics-toggle");
                var consent = this._loadConsent();

                if (analyticsToggle) {
                    analyticsToggle.checked = consent === null ? false : !!consent;
                }

                if (modal) {
                    modal.classList.remove("is-hidden");
                }
            },
            closePreferences: function () {
                var modal = document.getElementById("cookie-consent-modal");
                if (modal) {
                    modal.classList.add("is-hidden");
                }
            },
            acceptAll: function () {
                var banner = document.getElementById("cookie-consent-banner");
                var modal = document.getElementById("cookie-consent-modal");
                this._writeConsent(true);
                if (banner) {
                    banner.classList.add("is-hidden");
                }
                if (modal) {
                    modal.classList.add("is-hidden");
                }
            },
            rejectOptional: function () {
                var banner = document.getElementById("cookie-consent-banner");
                var modal = document.getElementById("cookie-consent-modal");
                this._writeConsent(false);
                if (banner) {
                    banner.classList.add("is-hidden");
                }
                if (modal) {
                    modal.classList.add("is-hidden");
                }
            },
            savePreferences: function () {
                var banner = document.getElementById("cookie-consent-banner");
                var modal = document.getElementById("cookie-consent-modal");
                var analyticsToggle = document.getElementById("cookie-analytics-toggle");
                this._writeConsent(!!(analyticsToggle && analyticsToggle.checked));
                if (banner) {
                    banner.classList.add("is-hidden");
                }
                if (modal) {
                    modal.classList.add("is-hidden");
                }
            }
        };
    </script>
    <script src="/js/cookie-consent.js" asp-append-version="true"></script>
    <script src="/js/admin-downloads.js"></script>
    <script src="/js/mailbox.js" asp-append-version="true"></script>
    <script src="/js/modal-a11y.js"></script>
    <script src="/_framework/blazor.server.js"></script>
</body>
</html>

