@page
@inject Confirmai.Services.UiTextService T
@{
    ViewData["Title"] = T["Identity.ResetConfirmation.Title"];
}

<h2>@T["Identity.ResetConfirmation.Heading"]</h2>
<p class="identity-muted">@T["Identity.ResetConfirmation.Message"]</p>

<div class="identity-actions">
    <a asp-page="./Login">@T["Identity.ResetConfirmation.LoginWithNewPassword"]</a>
</div>


