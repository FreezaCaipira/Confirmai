@page
@model Confirmai.Areas.Identity.Pages.Account.ResetPasswordModel
@inject Confirmai.Services.Core.UiTextService T
@{
    ViewData["Title"] = T["Identity.Reset.Title"];
}

<a href="/" class="identity-home-link">
    <span class="identity-home-arrow">&#8592;</span>
    <span class="identity-home-text">@T["Identity.Common.Home"]</span>
</a>

<h2 class="identity-heading">@T["Identity.Reset.Heading"]</h2>

<div asp-validation-summary="All" class="text-danger" role="alert"></div>

<form method="post">
    <input asp-for="Input.Code" type="hidden" />

    <div>
        <label asp-for="Input.Email">@T["Identity.Common.Email"]</label>
        @if (Model.Input.EmailReadOnly)
        {
            <input asp-for="Input.Email" value="@Model.Input.Email" readonly aria-describedby="emailHelp Input.Email-error" />
        }
        else
        {
            <input asp-for="Input.Email" autocomplete="username" aria-describedby="Input.Email-error" />
        }
        <span asp-validation-for="Input.Email" class="text-danger" id="Input.Email-error"></span>
    </div>

    <div>
        <label asp-for="Input.Password">@T["Identity.Common.Password"]</label>
        <input asp-for="Input.Password" autocomplete="new-password" aria-describedby="Input.Password-error" />
        <span asp-validation-for="Input.Password" class="text-danger" id="Input.Password-error"></span>
    </div>

    <div>
        <label asp-for="Input.ConfirmPassword">@T["Identity.Common.ConfirmPassword"]</label>
        <input asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-describedby="Input.ConfirmPassword-error" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger" id="Input.ConfirmPassword-error"></span>
    </div>

    <button type="submit">@T["Identity.Reset.Submit"]</button>
</form>

<div class="identity-actions">
    <a asp-page="./Login">@T["Identity.Common.BackToLogin"]</a>
</div>

<div class="identity-footer">
    <span>&copy; 2025 Confirmai</span>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


