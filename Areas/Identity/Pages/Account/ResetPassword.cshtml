@page
@model Confirmai.Areas.Identity.Pages.Account.ResetPasswordModel
@inject Confirmai.Services.Core.UiTextService T
@{
    ViewData["Title"] = T["Identity.Reset.Title"];
}

<h2>@T["Identity.Reset.Heading"]</h2>

<div asp-validation-summary="All" class="text-danger"></div>

<form method="post">
    <input asp-for="Input.Code" type="hidden" />

    <div>
        <label asp-for="Input.Email">@T["Identity.Common.Email"]</label>
        @if (Model.Input.EmailReadOnly)
        {
            <input asp-for="Input.Email" value="@Model.Input.Email" readonly aria-describedby="emailHelp" />
        }
        else
        {
            <input asp-for="Input.Email" autocomplete="username" />
        }
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Input.Password">@T["Identity.Common.Password"]</label>
        <input asp-for="Input.Password" autocomplete="new-password" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Input.ConfirmPassword">@T["Identity.Common.ConfirmPassword"]</label>
        <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>

    <button type="submit">@T["Identity.Reset.Submit"]</button>
</form>

<div class="identity-actions">
    <a asp-page="./Login">@T["Identity.Common.BackToLogin"]</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


