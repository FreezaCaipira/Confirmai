@page
@model Confirmai.Areas.Identity.Pages.Account.LoginModel
@inject Confirmai.Services.Core.UiTextService T
@{
    ViewData["Title"] = T["Identity.Login.Title"];
}

<a href="/" class="identity-home-link identity-home-link-login">
    <span class="identity-home-arrow">&#8592;</span>
    <span class="identity-home-text">@T["Identity.Common.Home"]</span>
</a>

<h2 class="identity-heading">@T["Identity.Login.Heading"]</h2>

<div asp-validation-summary="All" class="text-danger" role="alert"></div>

<form method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <div>
        <label asp-for="Input.Email">@T["Identity.Common.Email"]</label>
        <input asp-for="Input.Email" autocomplete="username" aria-describedby="Input.Email-error" />
        <span asp-validation-for="Input.Email" class="text-danger" id="Input.Email-error"></span>
    </div>
    <div>
        <label asp-for="Input.Password">@T["Identity.Common.Password"]</label>
        <input asp-for="Input.Password" autocomplete="current-password" aria-describedby="Input.Password-error" />
        <span asp-validation-for="Input.Password" class="text-danger" id="Input.Password-error"></span>
    </div>
    <div class="identity-remember">
        <input asp-for="Input.RememberMe" />
        <label asp-for="Input.RememberMe">@T["Identity.Login.RememberMe"]</label>
    </div>
    <button type="submit">@T["Nav.Login"]</button>
</form>

@if (Model.ExternalLogins?.Count > 0)
{
    <div class="external-login">
        <span class="external-login-divider">@T["Identity.ExternalLogin.Divider"]</span>
        @foreach (var provider in Model.ExternalLogins)
        {
            <form method="post" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl">
                <input type="hidden" name="provider" value="@provider.Name" />
                <button type="submit" class="external-login-btn external-login-btn--@provider.Name.ToLowerInvariant()">
                    @if (provider.Name.Equals("Google", StringComparison.OrdinalIgnoreCase))
                    {
                        <img src="/img/google-g.svg" alt="" class="external-login-btn-icon" width="18" height="18" />
                    }
                    @T.Get("Identity.ExternalLogin.Provider", provider.DisplayName ?? string.Empty)
                </button>
            </form>
        }
    </div>
}

<div class="identity-actions">
    <a asp-page="./ForgotPassword">@T["Identity.Login.ForgotPassword"]</a>
    <a asp-page="./Register">@T["Nav.Register"]</a>
    <a asp-page="./ResendEmailConfirmation">@T["Identity.Resend.Title"]</a>
</div>

<div class="identity-footer">
    <span>&copy; 2025 Confirmai</span>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

