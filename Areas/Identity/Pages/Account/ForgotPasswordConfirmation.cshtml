@page
@model Confirmai.Areas.Identity.Pages.Account.ForgotPasswordConfirmationModel
@inject Confirmai.Services.Core.UiTextService T
@{
    ViewData["Title"] = T["Identity.ForgotConfirmation.Title"];
}

<a href="/" class="identity-home-link">
    <span class="identity-home-arrow">&#8592;</span>
    <span class="identity-home-text">@T["Identity.Common.Home"]</span>
</a>

<h2 class="identity-heading">@T["Identity.ForgotConfirmation.Heading"]</h2>
<p class="identity-muted">
    @T["Identity.ForgotConfirmation.Message"]
</p>

@if (Model.ShowDevFallbackHint)
{
    <p class="identity-muted">
        @T["Identity.ForgotConfirmation.DevHint"]
        <b>/wwwroot/uploads/dev-emails</b>.
    </p>

    @if (!string.IsNullOrWhiteSpace(Model.LatestFallbackEmailRelativeUrl))
    {
        <p class="identity-muted">
            @T["Identity.ForgotConfirmation.LastEmail"]
            <a href="@Model.LatestFallbackEmailRelativeUrl" target="_blank" rel="noopener noreferrer">@Model.LatestFallbackEmailFileName</a>
        </p>
    }
}

<div class="identity-actions">
    <a asp-page="./Login">@T["Identity.Common.BackToLogin"]</a>
    <a asp-page="./ForgotPassword">@T["Identity.ForgotConfirmation.TryAnother"]</a>
</div>

<div class="identity-footer">
    <span>&copy; 2025 Confirmai</span>
</div>


