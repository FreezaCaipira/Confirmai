@page
@model Confirmai.Areas.Identity.Pages.Account.ExternalLoginModel
@inject Confirmai.Services.Core.UiTextService T
@{
    ViewData["Title"] = T["Identity.ExternalLogin.Title"];
}

<a href="/" class="identity-home-link">
    <span class="identity-home-arrow">&#8592;</span>
    <span class="identity-home-text">@T["Identity.Common.Home"]</span>
</a>

<h2 class="identity-heading">@T["Identity.ExternalLogin.Heading"]</h2>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="identity-status identity-status--error" role="alert">
        <i class="fas fa-exclamation-circle"></i>
        <p>@Model.ErrorMessage</p>
    </div>
    <div class="identity-actions">
        <a asp-page="./Login">@T["Identity.Common.TryAgain"]</a>
        <a asp-page="./Register">@T["Nav.Register"]</a>
    </div>
}
else
{
    <div class="identity-actions">
        <a asp-page="./Login">@T["Identity.Common.BackToLogin"]</a>
    </div>
}

<div class="identity-footer">
    <span>&copy; 2025 Confirmai</span>
</div>
