@page
@model Confirmai.Areas.Identity.Pages.Account.ConfirmEmailModel
@inject Confirmai.Services.Core.UiTextService T
@{
    ViewData["Title"] = T["Identity.ConfirmEmail.Title"];
}

<a href="/" class="identity-home-link">
    <span class="identity-home-arrow">&#8592;</span>
    <span class="identity-home-text">@T["Identity.Common.Home"]</span>
</a>

<h2 class="identity-heading">@T["Identity.ConfirmEmail.Heading"]</h2>

@if (Model.IsSuccess == true)
{
    <div class="identity-status identity-status--success" role="alert">
        <i class="fas fa-check-circle"></i>
        <p>@Model.StatusMessage</p>
    </div>
    <div class="identity-actions">
        <a asp-page="./Login" class="identity-btn-primary">@T["Identity.Common.GoToLogin"]</a>
    </div>
}
else
{
    <div class="identity-status identity-status--error" role="alert">
        <i class="fas fa-exclamation-circle"></i>
        <p>@Model.StatusMessage</p>
    </div>
    <div class="identity-actions">
        <a asp-page="./ResendEmailConfirmation">@T["Identity.ConfirmEmail.ResendCta"]</a>
        <a asp-page="./Login">@T["Identity.Common.BackToLogin"]</a>
    </div>
}

<div class="identity-footer">
    <span>&copy; 2025 Confirmai</span>
</div>