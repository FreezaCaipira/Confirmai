@page
@model Confirmai.Areas.Identity.Pages.Account.ResendEmailConfirmationModel
@inject Confirmai.Services.UiTextService T
@{
    ViewData["Title"] = T["Identity.Resend.Title"];
}

<h2>@T["Identity.Resend.Heading"]</h2>
<p class="identity-muted">@T["Identity.Resend.Subtitle"]</p>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <p class="identity-muted">@Model.StatusMessage</p>
}

<div asp-validation-summary="All" class="text-danger"></div>

<form method="post">
    <div>
        <label asp-for="Input.Email">@T["Identity.Common.Email"]</label>
        <input asp-for="Input.Email" autocomplete="username" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>

    <button type="submit">@T["Identity.Resend.Submit"]</button>
</form>

<div class="identity-actions">
    <a asp-page="./Login">@T["Identity.Common.BackToLogin"]</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


