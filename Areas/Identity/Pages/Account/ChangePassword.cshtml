@page
@model Confirmai.Areas.Identity.Pages.Account.ChangePasswordModel
@inject Confirmai.Services.Core.UiTextService T
@{
    ViewData["Title"] = T["Identity.ChangePassword.Title"];
}

<a href="/" class="identity-home-link">
    <span class="identity-home-arrow">&#8592;</span>
    <span class="identity-home-text">@T["Identity.Common.Home"]</span>
</a>

<h2 class="identity-heading">@T["Identity.ChangePassword.Heading"]</h2>

<div asp-validation-summary="All" class="text-danger" role="alert"></div>

<form method="post">
    <div>
        <label asp-for="Input.CurrentPassword">@T["Identity.ChangePassword.CurrentPassword"]</label>
        <input asp-for="Input.CurrentPassword" autocomplete="current-password" aria-describedby="Input.CurrentPassword-error" />
        <span asp-validation-for="Input.CurrentPassword" class="text-danger" id="Input.CurrentPassword-error"></span>
    </div>

    <div>
        <label asp-for="Input.NewPassword">@T["Identity.ChangePassword.NewPassword"]</label>
        <input asp-for="Input.NewPassword" autocomplete="new-password" aria-describedby="Input.NewPassword-error" />
        <span asp-validation-for="Input.NewPassword" class="text-danger" id="Input.NewPassword-error"></span>
    </div>

    <div>
        <label asp-for="Input.ConfirmPassword">@T["Identity.ChangePassword.ConfirmNewPassword"]</label>
        <input asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-describedby="Input.ConfirmPassword-error" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger" id="Input.ConfirmPassword-error"></span>
    </div>

    <button type="submit">@T["Identity.ChangePassword.Submit"]</button>
</form>

<div class="identity-actions">
    <a href="/profile">@T["Identity.Common.BackToProfile"]</a>
</div>

<div class="identity-footer">
    <span>&copy; 2025 Confirmai</span>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


