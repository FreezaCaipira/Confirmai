@page
@model Confirmai.Areas.Identity.Pages.Account.ChangePasswordModel
@inject Confirmai.Services.Core.UiTextService T
@{
    ViewData["Title"] = T["Identity.ChangePassword.Title"];
}

<h2>@T["Identity.ChangePassword.Heading"]</h2>

<div asp-validation-summary="All" class="text-danger"></div>

<form method="post">
    <div>
        <label asp-for="Input.CurrentPassword">@T["Identity.ChangePassword.CurrentPassword"]</label>
        <input asp-for="Input.CurrentPassword" autocomplete="current-password" />
        <span asp-validation-for="Input.CurrentPassword" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Input.NewPassword">@T["Identity.ChangePassword.NewPassword"]</label>
        <input asp-for="Input.NewPassword" autocomplete="new-password" />
        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Input.ConfirmPassword">@T["Identity.ChangePassword.ConfirmNewPassword"]</label>
        <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>

    <button type="submit">@T["Identity.ChangePassword.Submit"]</button>
</form>

<div class="identity-actions">
    <a href="/profile">@T["Identity.Common.BackToProfile"]</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


