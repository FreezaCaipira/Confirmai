@{
    Layout = null;
    var title = ViewData["Title"] ?? "Confirmai";
    var cspNonce = (Context.Items["csp-nonce"] as string) ?? string.Empty;
    // C46 (1.0): auth fingerprint for cross-tab auth-change detection.
    var authFp = "anon";
    var authUid = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    if (!string.IsNullOrEmpty(authUid))
    {
        var hash = System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(authUid));
        authFp = Convert.ToHexString(hash)[..16].ToLowerInvariant();
    }
}
@inject Confirmai.Services.User.LanguagePreferenceService LanguagePreferenceService
<!DOCTYPE html>
<html lang="@LanguagePreferenceService.SelectedLanguage">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title</title>
    <base href="~/" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/identity.css" asp-append-version="true" />

</head>
<body class="identity-body">
    <div class="identity-container">
        @RenderBody()
    </div>
    <script nonce="@cspNonce">
        window.__confirmaiAuthFp = "@authFp";
    </script>
    <script src="~/js/auth-changed.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>

