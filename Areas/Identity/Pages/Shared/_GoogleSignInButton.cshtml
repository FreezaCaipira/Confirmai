@inject Confirmai.Services.Core.UiTextService T
<form method="post" asp-page="/Account/ExternalLogin" asp-route-returnUrl="@ViewData["ReturnUrl"]">
    <input type="hidden" name="provider" value="Google" />
    <button type="submit" class="google-signin-btn">
        <img src="/img/google-g.svg" alt="" class="google-signin-btn-icon" width="18" height="18" />
        <span>@T["Identity.ExternalLogin.ContinueWithGoogle"]</span>
    </button>
</form>
