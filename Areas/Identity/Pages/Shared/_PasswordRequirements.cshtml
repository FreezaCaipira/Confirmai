@model Confirmai.Configuration.SecurityPolicySnapshot
@inject Confirmai.Services.Core.UiTextService T
@{
    var rules = Confirmai.Services.Identity.PasswordRequirements.Build(Model, T);
}

@* C38 F1 — requisitos gerados da politica ativa; o identity-register.js marca
   cada item conforme a digitacao. A validacao de verdade continua no servidor. *@
<div class="pwd-reqs-block">
    <p class="pwd-reqs-title">@T["Identity.PasswordRequirements"]</p>
    <ul class="pwd-reqs">
        @foreach (var rule in rules)
        {
            <li class="pwd-req" data-req="@rule.RuleId">@rule.Text</li>
        }
    </ul>
</div>
